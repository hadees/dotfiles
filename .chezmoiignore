# Entries here are TARGET paths (relative to $HOME) that chezmoi must not
# manage. This file is parsed as a template, so ignores can vary by machine.

# Repo-level files — never deployed. (Dot-prefixed source files like .macos,
# .github, and .gitignore are invisible to chezmoi already and need no entry.)
README.md
docs
LICENSE-MIT.txt
Brewfile
renovate.json5
packages-apt.txt
packages-apt-wsl.txt
bootstrap.sh
tests
init
theme
alfred
# Guidance for working on THIS repo. Deployed to $HOME it was read by every
# session in every project under it — Claude Code walks cwd upwards — and
# appeared twice in a session in this clone. Cross-machine guidance belongs
# in .claude-shared/CLAUDE.md (and its topics/ files), which both
# profiles import.
CLAUDE.md
# iTerm2 reads its prefs from the clone (PrefsCustomFolder), never from
# $HOME, so a copy here is read by nothing. Worse, iTerm2 writes to that
# folder — chezmoi's own source — so every prefs change asked chezmoi to
# re-deploy ~99KB into $HOME that nothing would open.
com.googlecode.iterm2.plist

# Package-install scripts run only on their own OS
{{ if ne .chezmoi.os "darwin" -}}
.chezmoiscripts/darwin/**
{{ end -}}
{{ if ne .chezmoi.os "linux" -}}
.chezmoiscripts/linux/**
{{ end -}}

{{ if eq .machineClass "wsl" -}}
# WSL talks to the Windows-side OpenSSH (1Password's ssh.exe forwarding), and
# that reads %USERPROFILE%\.ssh\config. A POSIX-side config here would be
# read by a client this class never uses, and its key paths mean nothing to
# the one it does.
.ssh/config
{{ end -}}

{{ if ne .chezmoi.os "darwin" -}}
# macOS GUI configuration has no business on Linux/WSL
.mackup.cfg
# Finicky (URL router) is a macOS app
.finicky.ts
.config/finicky
# The worktabs launcher drives iTerm2, which is macOS-only
bin/worktabs
# The lsof guard shadows a macOS-only lsof
bin/lsof
# iTerm2's composed preferences are macOS-only
bin/iterm2-prefs
bin/iterm2-relaunch
.config/iterm2
# The screen heads-up is a macOS notification
bin/screen-heads-up
# pane-sight drives iTerm2's API, and pane-read and pane-shot are its names
bin/pane-sight
bin/pane-read
bin/pane-shot
# The needs-you page is served by claude-tab panel, which is macOS-only
.local/share/claude-tab
# The work board opens in iTerm2's browser and runs as a LaunchAgent: macOS-only
bin/workboard
.local/libexec/workboard
.local/share/workboard
{{ end -}}

# A __pycache__ beside the work board's parts would be deployed from the working tree
.local/libexec/workboard/__pycache__

{{ if or (ne .chezmoi.os "darwin") (ne .machineClass "mac") -}}
# The work board's LaunchAgent is for the mac class on macOS only
Library/LaunchAgents/local.workboard.plist
{{ end -}}

{{ if or (ne .chezmoi.os "darwin") (ne .machineClass "mac") (not (stat (joinPath .chezmoi.homeDir ".cargo/bin/claude-codex"))) -}}
# The claude-codex LaunchAgent is for the mac class on macOS only, and only
# once the proxy is installed: a Mac that never opts in gets no plist at all
Library/LaunchAgents/local.claude-codex.plist
{{ end -}}

{{ if not (stat (joinPath .chezmoi.homeDir ".cargo/bin/claude-codex")) -}}
# plan-gpt routes through claude-codex: without the proxy installed the agent
# could only fail, so no clone gets it
.claude/agents/plan-gpt.md
.claude-hadees/agents/plan-gpt.md
.claude-shared/agents/plan-gpt.md
{{ end -}}

{{ if eq .machineClass "ephemeral" -}}
# Disposable boxes get shell config only: no package installs and no tooling
# that assumes a long-lived machine. Identity and secrets need no entry here
# any more — they come from the private overlay, which these boxes never clone.
.claude
.claude-shared
.claude-hadees
.config/claude-peer
.config/claude-codex
.config/iterm2
.chezmoiscripts/**
{{ end -}}
