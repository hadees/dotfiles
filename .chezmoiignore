# Entries here are TARGET paths (relative to $HOME) that chezmoi must not
# manage. This file is parsed as a template, so ignores can vary by machine.

# Repo-level files — never deployed. (Dot-prefixed source files like .macos,
# .github, and .gitignore are invisible to chezmoi already and need no entry.)
README.md
docs
LICENSE-MIT.txt
Brewfile
packages-apt.txt
bootstrap.sh
tests
init
theme
alfred

# Package-install scripts run only on their own OS
{{ if ne .chezmoi.os "darwin" -}}
.chezmoiscripts/darwin/**
{{ end -}}
{{ if ne .chezmoi.os "linux" -}}
.chezmoiscripts/linux/**
{{ end -}}

{{ if eq .machineClass "wsl" -}}
# WSL talks to the Windows-side OpenSSH (1Password's ssh.exe forwarding), and
# that reads %USERPROFILE%\.ssh\config. A POSIX-side config here would be
# read by a client this class never uses, and its key paths mean nothing to
# the one it does.
.ssh/config
{{ end -}}

{{ if ne .chezmoi.os "darwin" -}}
# macOS GUI configuration has no business on Linux/WSL
com.googlecode.iterm2.plist
.mackup.cfg
# Finicky (URL router) is a macOS app
.finicky.ts
.config/finicky
# The workspace launcher drives iTerm2, which is macOS-only
bin/workspace
{{ end -}}

{{ if eq .machineClass "ephemeral" -}}
# Disposable boxes get shell config only: no package installs and no tooling
# that assumes a long-lived machine. Identity and secrets need no entry here
# any more — they come from the private overlay, which these boxes never clone.
.claude
.claude-shared
.claude-hadees
CLAUDE.md
.chezmoiscripts/**
{{ end -}}
