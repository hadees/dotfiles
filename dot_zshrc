#!/usr/bin/env zsh

# Ensure ~/bin is on the PATH, keeping entries unique. -g matters: without
# it, sourcing this file from inside a function (e.g. bootstrap.sh's doIt)
# makes path/PATH function-local and empty, breaking every external command
# for the rest of the file.
typeset -gU path PATH
path=("$HOME/bin" $path)

# Load modular configuration files when present.
for file in ~/.{path,zsh_prompt,exports,aliases,functions,extra}; do
	if [[ -r "$file" && -f "$file" ]]; then
		source "$file"
	fi
done
unset file

# History configuration geared for interactive shells.
HISTFILE="${HOME}/.zsh_history"
HISTSIZE=32768
SAVEHIST=$HISTSIZE

setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_VERIFY

# Shell quality-of-life options. EXTENDED_GLOB stays off: it turns an unquoted
# `HEAD^` (as in `git show HEAD^`) into a pattern that fails with "no matches found".
setopt AUTO_CD
setopt GLOBSTARSHORT
setopt NO_CASE_GLOB
setopt PROMPT_SUBST

# Completion system setup, including Homebrew-provided definitions. A shell
# that did not source .exports has no HOMEBREW_PREFIX yet; ask brew once.
typeset -gU fpath
if (( $+commands[brew] )) && [[ -z ${HOMEBREW_PREFIX:-} ]]; then
	export HOMEBREW_PREFIX="$(brew --prefix 2>/dev/null)"
fi
if [[ -n ${HOMEBREW_PREFIX:-} ]]; then
	if [[ -d "$HOMEBREW_PREFIX/share/zsh/site-functions" ]]; then
		fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
	fi
	if [[ -d "$HOMEBREW_PREFIX/share/zsh-completions" ]]; then
		fpath=("$HOMEBREW_PREFIX/share/zsh-completions" $fpath)
	fi
fi

autoload -Uz compinit
# Full compinit when the dump is over a day old, else the faster cached -C.
_zcompdump_old=("${ZDOTDIR:-$HOME}/.zcompdump"(N.mh+24))
if (( ${#_zcompdump_old} )); then
	compinit
else
	compinit -C
fi
unset _zcompdump_old

if (( $+functions[_git] )); then
	compdef _git g
fi

_defaults_completion() {
	compadd NSGlobalDomain
}
compdef _defaults_completion defaults

_killall_completion() {
	compadd Contacts Calendar Dock Finder Mail Safari SystemUIServer Terminal
}
compdef _killall_completion killall

# Runtime environment managers.
# asdf is the preferred multi-language manager; the per-language managers below
# are no-ops when not installed, so both setups coexist safely.
if (( $+commands[asdf] )); then
	export PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH"
fi

if (( $+commands[rbenv] )); then
	eval "$(rbenv init - zsh)"
fi

if (( $+commands[nodenv] )); then
	eval "$(nodenv init - zsh)"
fi

if (( $+commands[pipenv] )); then
	eval "$(_PIPENV_COMPLETE=zsh_source pipenv)"
fi

if (( $+commands[pyenv] )); then
	eval "$(pyenv init -)"
fi

# fzf key bindings and completion, after compinit (the completion file needs
# it). The first directory carrying both wins: Homebrew's, then where Ubuntu's
# package puts them.
_fzf_shell_dirs=()
[[ -n ${HOMEBREW_PREFIX:-} ]] && _fzf_shell_dirs+="$HOMEBREW_PREFIX/opt/fzf/shell"
_fzf_shell_dirs+=/usr/share/doc/fzf/examples
for _fzf_shell_dir in $_fzf_shell_dirs; do
	[[ -f "${_fzf_shell_dir}/key-bindings.zsh" && -f "${_fzf_shell_dir}/completion.zsh" ]] || continue
	source "${_fzf_shell_dir}/key-bindings.zsh"
	source "${_fzf_shell_dir}/completion.zsh"
	break
done
unset _fzf_shell_dir _fzf_shell_dirs

# direnv: load/unload .envrc files per directory.
if (( $+commands[direnv] )); then
	eval "$(direnv hook zsh)"
fi

# zoxide: frecency-based directory jumping (replaces cd with z).
if (( $+commands[zoxide] )); then
	eval "$(zoxide init zsh)"
fi

# zsh plugins. Homebrew keeps them under its own prefix; Debian/Ubuntu ships
# them in /usr/share with the same layout below that, so one search list
# covers both and a Linux box gets them from apt. First hit wins.
# zsh-syntax-highlighting must be sourced last.
_zsh_plugin_dirs=()
[[ -n ${HOMEBREW_PREFIX:-} ]] && _zsh_plugin_dirs+="$HOMEBREW_PREFIX/share"
_zsh_plugin_dirs+=/usr/share
for _zsh_plugin_dir in $_zsh_plugin_dirs; do
	[[ -f "${_zsh_plugin_dir}/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] || continue
	source "${_zsh_plugin_dir}/zsh-autosuggestions/zsh-autosuggestions.zsh"
	break
done
for _zsh_plugin_dir in $_zsh_plugin_dirs; do
	[[ -f "${_zsh_plugin_dir}/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] || continue
	source "${_zsh_plugin_dir}/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
	break
done
unset _zsh_plugin_dir _zsh_plugin_dirs

# Commit signing uses SSH-format signatures via 1Password's op-ssh-sign
# (gpg.format=ssh + gpg.ssh.program in ~/.gitconfig.local) — no gpg-agent needed.
# The signing key's private half lives in 1Password; the repo only references
# the .pub. On a machine without 1Password, forward your local 1Password SSH
# agent or disable signing there (git config commit.gpgsign false).

# Increase how many files can be opened at once.
ulimit -n 10480 2>/dev/null
