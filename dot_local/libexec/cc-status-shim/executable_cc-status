#!/bin/sh
# cc-status (shim) — stands between Claude Code's hooks and iTerm2's cc-status.
#
# iTerm2 3.7 paints a Session Status row per tab from Claude Code hook events
# through its bundled cc-status binary. On Stop it keeps the row at "working"
# whenever the payload's background_tasks array is non-empty — and that array
# is the session's whole task registry, which nothing ages out: a backgrounded
# shell blocked on stdin, or a subagent that never reported back, keeps a tab
# "working" for days. This shim rewrites that one case, and paints subagent
# seats in their own colours. Every other event is handed to cc-status
# untouched.
#
# On Stop, StopFailure and SubagentStop with background tasks, each task is
# classified by its output file, <session dir>/tasks/<task_id>.output (the
# sibling of the payload's scratchpad_dir; for an agent it is a symlink to the
# transcript): modified within tabstatus.quiet-minutes (default 15) it is
# active, older it is quiet, and a task with no file to judge by counts as
# active — wrongly active only delays the idle, wrongly idle lies. cc-status
# is fed only the active ones, so a Stop over a running background agent still
# paints "working". When nothing is active but something is quiet, one it2
# call then paints the row idle with the quiet tasks in the detail, in amber
# (tabstatus.color.quiet, default #af8700; cc-status's own blue is its
# "waiting" colour). It stores 0 as the background-task count, never the
# quiet ones: cc-status re-reads the stored count on Notification(idle_prompt)
# a minute after Stop and repaints "working · N background tasks running".
# The paint sends the full field set, so a cc-status that failed cannot leave
# a half-painted row. Items also get the id and status keys that cc-status
# (written against an older Claude Code) reads and 2.1.289 no longer sends.
#
# Subagent seats (plan-fable, unstick-fable, review-fable, work-sonnet,
# scout-haiku, or any agent_type given a tabstatus.color.<agent_type>) get a
# colour of their own while they run, so a tab says which seat is working. The
# status stays one of cc-status's three words — the Session Status tool sorts
# by them — and only the dot and text colours change. Hooks fired inside a
# seat carry agent_type: a PreToolUse/PostToolUse there is painted by the shim
# instead of cc-status (which would paint plain orange working);
# PermissionRequest and Notification pass through, since waiting outranks a
# colour. SubagentStart and SubagentStop keep one line per running seat in
# ${XDG_STATE_HOME:-~/.local/state}/tabstatus/<session_id>.seats, so a Stop
# over a still-running background seat paints that seat's colour rather than
# amber or orange; SessionStart and SessionEnd delete the file and one older
# than a day is ignored. SessionStart also removes every .named, .tasks and
# .seats file in that directory older than seven days (a session that died
# without a SessionEnd leaves them); nothing else there is touched. The row name carries the repo (see below), so the
# detail carries only the status.
#
# The row name is the session's name, and on iTerm2 3.7.5+ the Claude Code
# integration's Enter Workgroup trigger renames the session to the workgroup
# root's displayName ("Chat") when the job `claude` starts, so every row would
# read "Chat (claude)". The shim renames it back to the repo: `it2 session
# set-name "<WORKSET or tabname --role of the payload's cwd>" --session <id>`
# ("[<WORKTABS_GROUP>] " in front when tabstatus.group-prefix is true), the
# same KEY_NAME override the workgroup wrote, held in memory by iTerm2 —
# nothing is written to its prefs. It runs on the first
# UserPromptSubmit of a session (marked by <session_id>.named beside the seats
# file, written whether or not a rename happened) and on every Stop and
# StopFailure, just before the paint, so a later
# rename by iTerm2 heals at the end of the turn. Also at SessionStart, for every
# role, so the row is named before anything is typed; the first prompt still
# renames and heals a title iTerm2 sets later. Known cost: if the workgroup
# entry comes after it, the workgroup may record this name as the title to
# restore on exit. The title
# is cut at 80 characters and control characters are dropped. $WORKSET needs
# no tabname; without it, no tabname, no cwd or no repo means no rename.
# tabname's role (peer, lead, plain) also picks a text colour at a turn end that
# nothing else painted: tabstatus.color.peer (default #8a8a8a), tabstatus.color.lead
# (no default).
#
# A turn that ends by asking the operator something is not idle: on Stop and
# StopFailure, with nothing active, a last_assistant_message whose last
# non-empty line (leading bullets and quotes stripped) ends in ? or U+FF1F is
# painted "waiting" in yellow (tabstatus.color.question, default #ffd75f) with
# that line as the detail. cc-status paints Stop-with-no-tasks idle and shows
# only the message's opening, where the question rarely is. The question paint
# follows cc-status's and outranks the quiet-task one; with something active
# the row stays working, and SubagentStop (a subagent's message) never fires it.
#
# A quiet shell task may be quiet because a long compile prints nothing, or
# because its process is wedged. For each quiet task whose output file is a
# regular file (a shell, not an agent's symlink) the shim asks `lsof -t` who
# holds the file open and sums the cumulative CPU time of those processes and
# all their descendants from one `ps -axo pid,ppid,time` (visible for every
# user, so a root child counts; no root needed). Per task it keeps
# "task_id<TAB>last_mtime<TAB>cpu_seconds<TAB>first_seen_quiet_ts" in
# ${XDG_STATE_HOME:-~/.local/state}/tabstatus/<session_id>.tasks (pruned to the
# payload's tasks, deleted on SessionStart/SessionEnd, swept when seven days old). A quiet shell task is
# stalled when nothing holds its file (the process is gone, the task still
# registered) or when it was first seen quiet tabstatus.stall-minutes (default
# 15) ago and its CPU has moved under a second since, with the file untouched.
# With nothing active a stalled task paints "waiting" in red
# (tabstatus.color.stalled, default #ff5f5f), outranking the question and quiet
# paints; CPU that moved shows as "(cpu busy)" in the quiet paint. No lsof, or
# a failed probe, means unknown, never stalled.
#
# Cost: python3 runs on every Stop and StopFailure (the rename needs it) and
# once per session on UserPromptSubmit (the marker is written whether or not a
# rename happened); the other events still cost only the sh gate. A rename adds one tabname and one it2
# start at the end of the turn. lsof and one ps run only on a Stop that has at
# least one quiet shell task.
#
#   cc-status             hook mode (legacy): payload on stdin, calls the hook itself
#   cc-status after       hook mode behind iTerm2's own `it2 handle-agent-hook`: never
#                         calls the hook, sends only what the rule file's table allows
#   cc-status explain [after]
#                         payload on stdin; print the decision, call nothing
#                         (cookie= is the API cookie's state; see iterm2-cookie)
#   cc-status settings    print the hooks block for a profile's settings.json
#
# Wiring: each profile's settings.json runs one command per hook event;
# `cc-status settings` prints it. With iTerm2 3.7.7+ (an `it2` beside the
# cc-status symlink) it is a single line: the cookie clause, `it2
# handle-agent-hook` on the payload, then `cc-status after`. 3.7.7 accepts a
# hook entry only when it runs a program inside ~/.config/iterm2, and the
# handler comes first so upstream changes flow through. Without that `it2` the
# command is this file's bare absolute path (legacy mode), which iTerm2 3.7.3's
# health check requires: it tests the literal string with isExecutableFile and
# wants it to end in /cc-status. The symlink iTerm2 maintains at
# ~/.config/iterm2/cc-status is left alone — the app recreates it over
# anything else put there — and is where the real binary is found;
# CC_STATUS_BIN overrides that (tests). it2 is taken from beside the real
# binary, where iTerm2 ships it, before PATH is tried: PATH only has it while
# an experimental iTerm2 setting is on.
#
# Fails open: no cc-status, no python3, no it2, no session id, unparsable
# JSON — the payload passes through or the shim exits 0. The status is
# cosmetic and must never cost a turn.
set -u

real=${CC_STATUS_BIN:-$HOME/.config/iterm2/cc-status}
mode=${1:-}
# `after` runs behind iTerm2's own handler, which has already painted: it never calls
# the hook and writes only what the table in the rule file allows.
after=
case $mode in after) after=1 ;; explain) [ "${2:-}" = after ] && after=1 ;; esac

if [ "$mode" = settings ]; then
  cmd="$HOME/.local/libexec/cc-status-shim/cc-status"
  if [ -x "$HOME/.config/iterm2/it2" ]; then
    # C: iTerm2's handler on the untouched payload, then the shim as a corrector.
    ckf="$HOME/.local/state/iterm2/api-cookie"
    cmd="p=\$(cat); [ $ckf -nt \"$HOME/Library/Application Support/iTerm2/private/socket\" ] && read -r ITERM2_COOKIE ITERM2_KEY <$ckf && [ -n \"\$ITERM2_KEY\" ] && export ITERM2_COOKIE ITERM2_KEY; printf '%s' \"\$p\" | $HOME/.config/iterm2/it2 handle-agent-hook; printf '%s' \"\$p\" | $cmd after"
  fi
  cmd=$(printf '%s' "$cmd" | sed 's/\\/\\\\/g; s/"/\\"/g')
  printf 'cc-status settings: the shim does not edit settings.json — each profile'"'"'s\nfile is owned by its overlay. Put this in that file, replacing iTerm2'"'"'s own\ncc-status entries (never beside them):\n\n{\n  "hooks": {\n'
  sep=
  for ev in SessionStart SessionEnd UserPromptSubmit PreToolUse PostToolUse PermissionRequest Notification Stop StopFailure SubagentStart SubagentStop; do
    printf '%s    "%s": [\n      { "hooks": [{ "type": "command", "command": "%s" }] }\n    ]' "$sep" "$ev" "$cmd"
    sep=,'
'
  done
  printf '\n  }\n}\n\n'
  cat <<'TXT'
With iTerm2 3.7.7+ (an it2 beside cc-status in ~/.config/iterm2) the command is
one line: the cookie clause, iTerm2's own `it2 handle-agent-hook` on the payload,
then `cc-status after` to correct what the handler painted. 3.7.7 only accepts a
hook entry that runs a program inside ~/.config/iterm2, and the handler comes
first so new upstream behaviour is never lost. Without that it2 the command is
the bare absolute path: iTerm2 3.7.3's health check tests the literal string
with isExecutableFile, so "~" and "$HOME" fail it. Either way, iTerm2 >
Reinstall may rewrite entries (re-apply the overlay afterwards) and Uninstall
strips raw ones. SubagentStart is not one of the ten events iTerm2 wires; the
shim uses it to track which seats are running.
TXT
  exit 0
fi

target=$(readlink "$real" 2>/dev/null || printf '%s' "$real")
if [ -n "$after" ] && [ -x "$HOME/.config/iterm2/it2" ]; then
  it2=$HOME/.config/iterm2/it2
else
  it2="$(dirname "$target")/it2"
  [ -x "$it2" ] || it2=$(command -v it2 2>/dev/null || true)
fi
sid=${ITERM_SESSION_ID:-}; sid=${sid#*:}   # two steps: dash under set -u rejects ${unset#pat}
[ -x "$real" ] || real=
[ -x "$it2" ] || it2=

# A leading dash is cc-status's own flag (--agent codex): not ours to read.
case $mode in -*) [ -n "$real" ] && exec "$real" "$@"; exit 0 ;; esac

if [ "$mode" != explain ] && [ -z "$after" ]; then   # `after` never needs the real cc-status
  [ -n "$real" ] || exit 0
  case $target in "$0"|*/cc-status-shim/cc-status) exit 0 ;; esac   # never recurse into ourselves
fi

# The API cookie (iterm2-cookie): with one in its environment it2 talks to iTerm2
# directly instead of starting an osascript per call. Used only while the file is
# newer than iTerm2's socket (recreated at each launch); a stale one is worse than
# none, so it is never exported then, nor half-read. Builtins only: no fork here.
ck=$HOME/.local/state/iterm2
sock="$HOME/Library/Application Support/iTerm2/private/socket"
if [ -n "${ITERM2_COOKIE:-}" ]; then cookie=env
elif [ -e "$ck/api-cookie" ]; then
  if [ -e "$sock" ] && ! [ "$ck/api-cookie" -nt "$sock" ]; then cookie=stale
  else
    cookie=absent; ck_a=; ck_b=
    { read -r ck_a ck_b <"$ck/api-cookie"; } 2>/dev/null
    if [ -n "$ck_a" ] && [ -n "$ck_b" ]; then cookie=fresh; ITERM2_COOKIE=$ck_a ITERM2_KEY=$ck_b; export ITERM2_COOKIE ITERM2_KEY; fi
  fi
elif [ -e "$ck/api-cookie.rejected" ]; then cookie=rejected
else cookie=absent
fi
# One byte per hook event that ran without a cookie: iterm2-cookie reports the count.
if [ "$mode" != explain ] && [ -z "${ITERM2_COOKIE:-}" ]; then
  [ -d "$ck" ] || mkdir -p -m 700 "$ck" 2>/dev/null
  { printf x >>"$ck/uncookied"; } 2>/dev/null
fi

payload=$(cat)
pass() { [ -n "$after" ] && exit 0; printf '%s' "$payload" | "$real"; exit 0; }

# Cheap gate before paying for python3: Claude Code emits compact JSON. Only
# turn-ending events (Stop and StopFailure always: the rename; SubagentStop only
# with background tasks), a session's first UserPromptSubmit (no .named marker
# yet), session start/end (the seat state file) and hooks fired inside a seat
# need the decision; the rest pass through.
# A seat is an agent_type with a default colour (keep in step with SEATS below)
# or a tabstatus.color.<agent_type> setting.
if [ "$mode" != explain ]; then
  go=
  case $payload in
    *'"hook_event_name":"Stop"'*|*'"hook_event_name":"StopFailure"'*) go=1 ;;
    *'"hook_event_name":"SubagentStop"'*)
      case $payload in *'"background_tasks":[{'*) go=1 ;; esac ;;
    *'"hook_event_name":"SessionStart"'*|*'"hook_event_name":"SessionEnd"'*) go=1 ;;
    *'"hook_event_name":"UserPromptSubmit"'*)
      # Named already? A session id that is not a plain token lets python decide.
      go=1
      case $payload in
        *'"session_id":"'*)
          nid=${payload#*'"session_id":"'}; nid=${nid%%'"'*}
          [ -e "${XDG_STATE_HOME:-$HOME/.local/state}/tabstatus/$nid.named" ] && go= ;;
      esac ;;
  esac
  case $payload in
    *'"agent_type":"'*)
      at=${payload#*'"agent_type":"'}; at=${at%%'"'*}
      case $at in
        plan-fable|unstick-fable|review-fable|work-sonnet|scout-haiku) go=1 ;;
        *) git config --get "tabstatus.color.$at" >/dev/null 2>&1 && go=1 ;;
      esac ;;
  esac
  [ -n "$go" ] || pass
  if [ -z "$sid" ] || [ -z "$it2" ] || ! command -v python3 >/dev/null 2>&1; then pass; fi
elif ! command -v python3 >/dev/null 2>&1; then
  echo 'cc-status explain: needs python3' >&2; exit 0
fi

# The script goes in via -c so stdin stays free for the payload: `python3 -`
# with a heredoc would make the heredoc the stdin and the payload vanish.
py=$(cat <<'PY'
import functools, json, os, re, shutil, subprocess, sys, time

mode, real, it2, sid, cookie, after = sys.argv[1:7]
explain = mode == "explain"
after = after == "1"
raw = sys.stdin.read()

def call(argv, data=None, timeout=5, silent=False):
    # A hung or missing helper must never cost the turn.
    # A silent call is an it2 call: its stderr is read to catch iTerm2 refusing the cookie.
    kw = {"stdout": subprocess.DEVNULL, "stderr": subprocess.PIPE} if silent else {}
    kw["input" if data else "stdin"] = data or subprocess.DEVNULL
    try:
        r = subprocess.run(argv, timeout=timeout, **kw)
    except (OSError, subprocess.SubprocessError):
        return
    if silent and r.returncode and b"Authentication failed" in r.stderr and os.environ.get("ITERM2_COOKIE"):
        # A cookie iTerm2 refuses makes every it2 fail with no rows: set it aside (iterm2-cookie status says so).
        ck = os.path.expanduser("~/.local/state/iterm2/api-cookie")
        try:
            os.rename(ck, ck + ".rejected")
        except OSError:
            pass

cfg = {}
try:
    out = subprocess.run(["git", "config", "--get-regexp", r"^tabstatus\."],
                         capture_output=True, text=True, timeout=5).stdout
    for line in out.splitlines():
        k, _, v = line.partition(" ")
        cfg[k] = v.strip()
except (OSError, subprocess.SubprocessError):
    pass

def setting(key, default, pattern):
    v = cfg.get("tabstatus." + key)
    if v is None:
        return default
    if re.fullmatch(pattern, v):
        return v
    print(f"cc-status: ignoring tabstatus.{key}={v!r}", file=sys.stderr)
    return default

HEX = r"#[0-9a-fA-F]{6}"
quiet_minutes = int(setting("quiet-minutes", "15", r"[0-9]+"))
quiet_color = setting("color.quiet", "#af8700", HEX)
question_color = setting("color.question", "#ffd75f", HEX)
stall_minutes = int(setting("stall-minutes", "15", r"[0-9]+"))
stalled_color = setting("color.stalled", "#ff5f5f", HEX)
peer_color = setting("color.peer", "#8a8a8a", HEX)
lead_color = setting("color.lead", None, HEX)   # no default: a leader keeps cc-status's colour
group_prefix = setting("group-prefix", "false", r"true|false") == "true"
SEATS = {"plan-fable": "#d787ff", "unstick-fable": "#ff5faf", "review-fable": "#af87ff",
         "work-sonnet": "#00afaf", "scout-haiku": "#87af5f"}

@functools.lru_cache(None)   # a bad setting is noted once, not per lookup
def seat_color(agent_type):
    # git lower-cases the last key component; "quiet", "question", "stalled", "peer" and "lead" are paint colours, not seats
    if not isinstance(agent_type, str) or agent_type.lower() in ("quiet", "question", "stalled", "peer", "lead"):
        return None
    return setting("color." + agent_type.lower(), SEATS.get(agent_type), HEX)

try:
    payload = json.loads(raw)
    event = payload.get("hook_event_name", "?")
except (ValueError, AttributeError):
    payload, event = {}, "?"
tasks, aid, agent_type = payload.get("background_tasks"), payload.get("agent_id"), payload.get("agent_type")
seat_col = seat_color(agent_type)
seat = agent_type if seat_col else None

# Seat state: one "<agent_id>\t<agent_type>" line per running seat of a session.
STALE_DAYS = 7
ID = re.compile(r"[A-Za-z0-9_-]+")
pid = payload.get("session_id")
state_dir = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "tabstatus")
sf = os.path.join(state_dir, pid + ".seats") if isinstance(pid, str) and ID.fullmatch(pid) else None
tf = sf[:-len(".seats")] + ".tasks" if sf else None
nf = sf[:-len(".seats")] + ".named" if sf else None

def seats_read():
    try:
        if time.time() - os.stat(sf).st_mtime > 86400:
            if not explain:
                os.remove(sf)
            return []
        with open(sf) as f:
            return [l.rstrip("\n").split("\t", 1) for l in f if "\t" in l]
    except (OSError, TypeError):
        return []

def seats_write(rows):
    try:
        if rows:
            os.makedirs(state_dir, exist_ok=True)
            with open(sf, "w") as f:
                f.writelines(f"{a}\t{t}\n" for a, t in rows)
        else:
            os.remove(sf)
    except (OSError, TypeError):
        pass

before = seats_read()
live = list(before)
if event in ("SessionStart", "SessionEnd"):
    live = []
elif event == "SubagentStart" and seat and isinstance(aid, str) and ID.fullmatch(aid) \
        and aid not in [a for a, _ in live]:
    live.append([aid, agent_type])
elif event == "SubagentStop" and aid:
    live = [r for r in live if r[0] != aid]

# What the handler arms for the row to fall back to when the turn is interrupted. A colour or
# detail sent without it cancels that; a count sent alone does not.
EXPIRY = ["--expires-on", "progress-end", "--then-status", "idle", "--then-dot-color", "#00d75f",
          "--then-text-color", "#888888", "--then-detail", ""]

def write(status=None, detail=None, dot=None, text=None, count=None, expire=False):
    # One set-status carrying only the fields given; nothing at all when none is.
    if detail is not None:
        detail = " ".join(detail.split())
        if len(detail) > 180:
            detail = detail[:180] + "…"
    argv = [it2, "set-status", "--session", sid]
    for flag, v in (("--status", status), ("--detail", detail), ("--dot-color", dot),
                    ("--text-color", text), ("--background-tasks", count)):
        if v is not None:
            argv += [flag, str(v)]
    if len(argv) > 4:
        call(argv + (EXPIRY if expire else []), silent=True)

def paint(status, detail, dot, text, count=None):
    # The full field set every time, whatever cc-status did or failed to do.
    write(status, detail, dot, text, count)

def run_out(argv, timeout=5):
    # stdout of a read-only probe; None when it is missing, hung or failed to start.
    try:
        return subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
                              text=True, errors="replace", timeout=timeout).stdout
    except (OSError, subprocess.SubprocessError):
        return None

def cpu_seconds(s):
    # ps time: [D-][HH:]MM:SS[.ss]
    days, _, rest = s.rpartition("-")
    total = 0.0
    for part in rest.split(":"):
        total = total * 60 + float(part)
    return total + (int(days) * 86400 if days else 0)

_ps = []
def ps_tree(pids):
    # Summed CPU seconds of pids and all their descendants, or None if ps failed.
    if not _ps:
        _ps.append(run_out(["ps", "-axo", "pid,ppid,time"]))
    if _ps[0] is None:
        return None
    kids, own = {}, {}
    for line in _ps[0].splitlines():
        f = line.split()
        try:
            own[f[0]] = cpu_seconds(f[2])
            kids.setdefault(f[1], []).append(f[0])
        except (IndexError, ValueError):
            pass   # the header, or a line we cannot read
    seen, todo = set(), list(pids)
    while todo:
        p = todo.pop()
        if p not in seen:
            seen.add(p)
            todo += kids.get(p, [])
    return sum(own.get(p, 0.0) for p in seen)

def holders_of(path):
    # pids holding path open: [] none, None unknown (no lsof, hung)
    out = run_out(["lsof", "-t", "--", path])
    return None if out is None else sorted({l for l in out.split() if l.isdigit()})

def tasks_read():
    recs = {}
    try:
        with open(tf) as f:
            for l in f:
                k = l.rstrip("\n").split("\t")
                try:
                    recs[k[0]] = (float(k[1]), float(k[2]), float(k[3]))
                except (IndexError, ValueError):
                    pass
    except (OSError, TypeError):
        pass
    return recs

def tasks_write(recs):
    try:
        if recs:
            os.makedirs(state_dir, exist_ok=True)
            with open(tf, "w") as f:
                f.writelines(f"{k}\t{m!r}\t{c:.2f}\t{t:.0f}\n" for k, (m, c, t) in recs.items())
        else:
            os.remove(tf)
    except (OSError, TypeError):
        pass

def label(t):
    return str(t.get("description") or t.get("task_type") or "?") if isinstance(t, dict) else "?"

now = time.time()
scratch = payload.get("scratchpad_dir")
active, quiet, rows, fed = [], [], [], None
stalled, busy_cpu, keep, quiet_ages = [], set(), {}, []
n_raw = 0   # entries a SubagentStop listed, before the stopped agent is dropped
if event in ("Stop", "StopFailure", "SubagentStop") and isinstance(tasks, list) and tasks:
    n_raw = len(tasks)
    if event == "SubagentStop" and aid:
        tasks = [t for t in tasks if not (isinstance(t, dict) and t.get("task_id") == aid)]
    prior = tasks_read()
    for t in tasks:
        tid = t.get("task_id") if isinstance(t, dict) else None
        state, age, probe = "unknown", None, ""
        if isinstance(tid, str) and tid in prior:
            keep[tid] = prior[tid]
        if tid and isinstance(tid, str) and "/" not in tid and isinstance(scratch, str) and scratch:
            p = os.path.join(os.path.dirname(scratch.rstrip("/")), "tasks", tid + ".output")
            try:
                mtime = os.stat(p).st_mtime
                age = now - mtime
                state = "active" if age < quiet_minutes * 60 else "quiet"
                if state == "quiet":
                    quiet_ages.append(age)
                if state == "quiet" and not os.path.islink(p):
                    # A quiet shell: who holds the file, and is that process getting CPU?
                    holders = holders_of(p)
                    cpu = ps_tree(holders) if holders else None
                    rec = prior.get(tid)
                    if rec and abs(rec[0] - mtime) >= 1:
                        rec = None   # written since: not the same silence
                    stalled_min = None
                    if holders == []:
                        stalled_min = int(age // 60)
                    elif cpu is not None:
                        if rec and cpu - rec[1] >= 1:
                            busy_cpu.add(tid)
                            keep[tid] = (mtime, cpu, now)
                        elif rec:
                            if now - rec[2] >= stall_minutes * 60:
                                stalled_min = int((now - rec[2]) // 60)
                        else:
                            keep[tid] = (mtime, cpu, now)
                    if stalled_min is not None:
                        stalled.append((t, stalled_min))
                    probe = (f" holder={','.join(holders) if holders else 'none' if holders == [] else 'unknown'}"
                             f" cpu={'-' if cpu is None else f'{cpu:.2f}'} stalled={'no' if stalled_min is None else 'yes'}")
            except OSError:
                if os.path.islink(p):   # an agent whose transcript is gone
                    state = "quiet"
        (quiet if state == "quiet" else active).append(t)
        kind, d = (t.get("task_type"), t.get("description")) if isinstance(t, dict) else (None, None)
        rows.append(f"task {tid} {kind} {state} age={'-' if age is None else int(age)}{probe}  {d or ''}")
    fed = [{**t, "id": t["task_id"], "status": "running"} if isinstance(t, dict) and "task_id" in t else t
           for t in active]
    if not explain:
        tasks_write(keep)

# A turn ending in a question: the last non-empty line, bullets and quotes off.
question = None
msg = payload.get("last_assistant_message")
if event in ("Stop", "StopFailure") and not active and isinstance(msg, str):
    lines = [l for l in msg.splitlines() if l.strip()]
    q = re.sub(r"^[\s>*+-]+", "", lines[-1]).rstrip() if lines else ""
    if q.endswith(("?", "？")):
        question = q

# The session's name and role: "<WORKSET or tabname of cwd>", behind "[<group>] " when
# tabstatus.group-prefix is true. Returns (title or None, the reason it is not renamed, role).
def session_title():
    if seat or event not in ("SessionStart", "UserPromptSubmit", "Stop", "StopFailure"):
        return None, "event", "plain"
    if event == "UserPromptSubmit" and nf and os.path.exists(nf):
        return None, "already named", "plain"
    if not sid:
        return None, "no session id", "plain"
    if not it2:
        return None, "no it2", "plain"
    clean = lambda v: re.sub(r"[\x00-\x1f\x7f]", "", v or "").strip()
    name, role = clean(os.environ.get("WORKSET")), "plain"   # a set names the row; no tabname needed
    if not name:
        tn = shutil.which("tabname") or os.path.join(os.path.expanduser("~"), "bin", "tabname")
        if not os.access(tn, os.X_OK):
            return None, "no tabname", "plain"
        cwd = payload.get("cwd")
        out = run_out([tn, "--role", cwd]) if isinstance(cwd, str) and cwd else None
        # "<role><TAB><label>"; an older tabname prints the bare label
        r, tab, label = (out or "").partition("\t")
        if tab and r in ("plain", "peer", "lead"):
            role, out = r, label
        name = clean(out)
        if not name:
            return None, "not a repo", "plain"
    group = clean(os.environ.get("WORKTABS_GROUP")) if group_prefix else ""
    return ((f"[{group}] " if group else "") + name)[:80], "", role

# A running seat among the active tasks: the row stays that seat's colour, not the parent's.
ids = {t.get("task_id") for t in active if isinstance(t, dict)}
busy = [t for a, t in live if a in ids and seat_color(t)]
in_seat_tool = bool(seat) and event in ("PreToolUse", "PostToolUse")
paint_stalled = bool(stalled) and not active
paint_idle = bool(quiet) and not active and not question and not paint_stalled

def stalled_text():
    m = max(m for _, m in stalled)
    return f"stalled {m} min: {', '.join(label(t) for t, _ in stalled)}"

def quiet_text():
    n = len(quiet)
    what = ", ".join(label(t) + (" (cpu busy)" if isinstance(t, dict) and t.get("task_id") in busy_cpu else "")
                     for t in quiet)
    # the shortest silence among the quiet tasks; a task with no file has no age
    since = f", quiet {int(min(quiet_ages) // 60)} min" if quiet_ages else ""
    return f"idle · {n} quiet background task{'s' if n != 1 else ''}{since}: {what}"

def seat_text():
    k = len(active)
    return f"{', '.join(dict.fromkeys(busy))} running · {k} background task{'s' if k != 1 else ''} running"

# After mode, turn ends: the writes that correct what the handler just painted. Status words
# only when nothing is active and the handler's row would be wrong (stale working, or a done
# hiding a question); never over an error.
plan, title, why, role = [], None, "", "plain"
if explain or after:
    title, why, role = session_title()
if after and event in ("Stop", "StopFailure"):
    if paint_stalled:
        plan.append(dict(status="waiting", detail=stalled_text(), dot=stalled_color, text=stalled_color, count=0))
    elif question and event == "Stop":
        plan.append(dict(status="waiting", detail=question, dot=question_color, text=question_color, count=0))
    elif paint_idle or (event == "StopFailure" and question and quiet and not active):
        plan.append(dict(status="idle", detail=quiet_text(), dot=quiet_color, text="#888888", count=0))
    elif busy:
        c = seat_color(busy[0])
        plan.append(dict(detail=seat_text(), dot=c, text=c, count=len(active)))
    elif active and quiet:
        k = len(active)
        plan.append(dict(detail=f"{k} background task{'s' if k != 1 else ''} running", count=k))
    elif not active and role in ("peer", "lead") and (peer_color if role == "peer" else lead_color):
        plan.append(dict(text=peer_color if role == "peer" else lead_color))
elif after and in_seat_tool:
    tool = payload.get("tool_name")
    plan.append(dict(detail=f"{seat}: {tool}" if tool else seat, dot=seat_col, text=seat_col, expire=True))
elif after and event == "SubagentStart" and seat:
    plan.append(dict(detail=f"{seat} running", dot=seat_col, text=seat_col, expire=True))
elif after and event == "SubagentStop" and fed is not None:
    # Mid-turn: never a status word. The count alone is bookkeeping and keeps the handler's expiry;
    # anything more is an assertion and carries the expiry again.
    k = len(active)
    if busy:
        c = seat_color(busy[0])
        plan.append(dict(detail=seat_text(), dot=c, text=c, count=k, expire=True))
    elif k and k != n_raw:
        plan.append(dict(detail=f"{k} background task{'s' if k != 1 else ''} running", count=k, expire=True))
    elif k != n_raw:
        plan.append(dict(count=0))

if explain:
    action = ("seat-paint" if in_seat_tool else "passthrough" if fed is None else
              "rewrite+idle" if paint_idle else "rewrite+stalled" if paint_stalled else "rewrite")
    if busy or (event == "SubagentStart" and seat):
        action += "+seat"
    if question and not paint_stalled:
        action += "+question"
    print(f"event={event}")
    print(f"session={sid or 'none'}")
    for r in rows:
        print(r)
    print(f"seat={seat or 'none'} colour={seat_col or 'none'} state={len(live)}")
    print(f"question={'yes ' + question if question else 'no'}")
    print(f"action={action}")
    print(f"name={title or 'none'}")
    print(f"role={role}")
    print(f"colour={(peer_color if role == 'peer' else lead_color if role == 'lead' else None) or 'none'}")
    print(f"rename={'yes' if title else 'no'} ({why or 'ok'})")
    print(f"marker={'present' if nf and os.path.exists(nf) else 'none'}")
    print(f"cookie={cookie}")
    print(f"cc-status={real or 'absent'}")
    print(f"it2={it2 or 'absent'}")
    print(f"mode={'after' if after else 'legacy'}")
    if after:
        got = {"name"} if title else set()
        for kw in plan:
            got |= {"expiry" if k == "expire" else k for k, v in kw.items() if v is not None and v is not False}
        print("writes=" + (",".join(n for n in ("name", "status", "detail", "dot", "text", "count", "expiry") if n in got) or "none"))
    sys.exit(0)

if live != before or event in ("SessionStart", "SessionEnd"):
    seats_write(live)
    if event in ("SessionStart", "SessionEnd"):
        tasks_write({})
        try:
            os.remove(nf)
        except (OSError, TypeError):
            pass
    if event == "SessionStart":
        # A session that died without a SessionEnd leaves its files for good; sweep them by suffix.
        try:
            for e in os.scandir(state_dir):
                try:
                    if e.name.endswith((".named", ".tasks", ".seats")) and time.time() - e.stat().st_mtime > STALE_DAYS * 86400:
                        os.remove(e.path)
                except OSError:
                    pass
        except OSError:
            pass
if in_seat_tool and not after:
    tool = payload.get("tool_name")
    paint("working", f"{seat}: {tool}" if tool else seat, seat_col, seat_col)
    sys.exit(0)

if after:
    pass   # iTerm2's handler already saw the real payload
elif fed is None:
    call([real], raw.encode(), 10)
else:
    payload["background_tasks"] = fed
    call([real], json.dumps(payload).encode(), 10)

# Before the paints, so the last it2 call of a turn end is still the paint.
if not after:
    title, _, role = session_title()
# The first prompt is marked whatever the outcome, so python starts once per session for it.
if event == "UserPromptSubmit" and nf and not seat:
    try:
        os.makedirs(state_dir, exist_ok=True)
        open(nf, "w").close()
    except OSError:
        pass
if title:
    call([it2, "session", "set-name", title, "--session", sid], silent=True)
if after:
    for kw in plan:
        write(**kw)
    sys.exit(0)
if event == "SubagentStart" and seat:
    paint("working", f"{seat} running", seat_col, seat_col)
if paint_stalled:
    paint("waiting", stalled_text(), stalled_color, stalled_color, 0)
elif question:
    paint("waiting", question, question_color, question_color, 0)
elif paint_idle:
    paint("idle", quiet_text(), quiet_color, "#888888", 0)
elif busy:
    c = seat_color(busy[0])
    paint("working", seat_text(), c, c, len(active))
elif event in ("Stop", "StopFailure") and not active and role in ("peer", "lead"):
    # Only the text colour: set-status keeps every field it is not given, so the dot stays the status colour.
    c = peer_color if role == "peer" else lead_color
    if c:
        call([it2, "set-status", "--session", sid, "--text-color", c], silent=True)
PY
)
