{{- /* Valid classes: mac, linux, wsl, ephemeral — see CLAUDE.md.
     The prompt text stays exactly "machineClass" so scripts can answer it
     with --promptString machineClass=<class>. */ -}}
{{- $machineClass := promptStringOnce . "machineClass" "machineClass" -}}
{{- if not (has $machineClass (list "mac" "linux" "wsl" "ephemeral")) -}}
{{-   fail (printf "machineClass %q is invalid: must be one of mac, linux, wsl, ephemeral" $machineClass) -}}
{{- end -}}

{{- /* Pinned only when the clone is there: since chezmoi 2.74.1, init --apply
     reloads this config and applies from sourceDir, so a pin to a missing
     directory fails a fresh `init --apply` that cloned elsewhere. */ -}}
{{ if and (eq $machineClass "mac") (stat (joinPath .chezmoi.homeDir "code/dotfiles")) -}}
# The development clone doubles as the chezmoi source directory on macs.
sourceDir = "~/code/dotfiles"

{{ end -}}
[data]
    machineClass = {{ $machineClass | quote }}
