#!/usr/bin/env zsh

# Create a new directory and enter it
function mkd() {
	mkdir -p "$@" && cd "$_";
}

# Change working directory to the top-most Finder window location
function cdf() { # short for `cdfinder`
	cd "$(osascript -e 'tell app "Finder" to POSIX path of (insertion location as alias)')";
}

# Create a .tar.gz archive, using `zopfli`, `pigz` or `gzip` for compression
function targz() {
	local tmpFile="${@%/}.tar";
	tar -cvf "${tmpFile}" --exclude=".DS_Store" "${@}" || return 1;

	size=$(
		stat -f"%z" "${tmpFile}" 2> /dev/null; # macOS `stat`
		stat -c"%s" "${tmpFile}" 2> /dev/null;  # GNU `stat`
	);

	local cmd="";
	if (( size < 52428800 )) && (( $+commands[zopfli] )); then
		# the .tar file is smaller than 50 MB and Zopfli is available; use it
		cmd="zopfli";
	else
		if (( $+commands[pigz] )); then
			cmd="pigz";
		else
			cmd="gzip";
		fi;
	fi;

	echo "Compressing .tar ($((size / 1000)) kB) using \`${cmd}\`…";
	"${cmd}" -v "${tmpFile}" || return 1;
	[ -f "${tmpFile}" ] && rm "${tmpFile}";

	zippedSize=$(
		stat -f"%z" "${tmpFile}.gz" 2> /dev/null; # macOS `stat`
		stat -c"%s" "${tmpFile}.gz" 2> /dev/null; # GNU `stat`
	);

	echo "${tmpFile}.gz ($((zippedSize / 1000)) kB) created successfully.";
}

# Determine size of a file or total size of a directory
function fs() {
	if du -b /dev/null > /dev/null 2>&1; then
		local arg=-sbh;
	else
		local arg=-sh;
	fi
	if [[ -n "$@" ]]; then
		du $arg -- "$@";
	else
		du $arg .[^.]* ./*;
	fi;
}

# Use Git’s colored diff when available
	if (( $+commands[git] )); then
		function diff() {
			git diff --no-index --color-words "$@";
		}
fi;

# Create a data URL from a file
function dataurl() {
	local mimeType=$(file -b --mime-type "$1");
	if [[ $mimeType == text/* ]]; then
		mimeType="${mimeType};charset=utf-8";
	fi
	echo "data:${mimeType};base64,$(openssl base64 -in "$1" | tr -d '\n')";
}

# Start an HTTP server from a directory, optionally specifying the port
function server() {
	local port="${1:-8000}";
	sleep 1 && open "http://localhost:${port}/" &
	# Set the default Content-Type to `text/plain` instead of `application/octet-stream`
	# And serve everything as UTF-8 (although not technically correct, this doesn’t break anything for binary files)
	python3 -c $'import http.server, functools;\nhandler = http.server.SimpleHTTPRequestHandler;\nhandler.extensions_map[""] = "text/plain";\nfor key in list(handler.extensions_map):\n\thandler.extensions_map[key] += ";charset=UTF-8";\nhttp.server.test(HandlerClass=handler, port=int("'"$port"'"))' 2>&1;
}

# Start a PHP server from a directory, optionally specifying the port
# (Requires PHP 5.4.0+.)
function phpserver() {
	local port="${1:-4000}";
	local ip=$(ipconfig getifaddr en1);
	sleep 1 && open "http://${ip}:${port}/" &
	php -S "${ip}:${port}";
}

# Compare original and gzipped file size
function gz() {
	local origsize=$(wc -c < "$1");
	local gzipsize=$(gzip -c "$1" | wc -c);
	local ratio=$(echo "$gzipsize * 100 / $origsize" | bc -l);
	printf "orig: %d bytes\n" "$origsize";
	printf "gzip: %d bytes (%2.2f%%)\n" "$gzipsize" "$ratio";
}

# Syntax-highlight JSON strings or files
# Usage: `json '{"foo":42}'` or `echo '{"foo":42}' | json`
function json() {
	if [ -t 0 ]; then # argument
		python -mjson.tool <<< "$*" | pygmentize -l javascript;
	else # pipe
		python -mjson.tool | pygmentize -l javascript;
	fi;
}

# Run `dig` and display the most useful info
function digga() {
	dig +nocmd "$1" any +multiline +noall +answer;
}

# UTF-8-encode a string of Unicode symbols
function escape() {
	printf "\\\x%s" $(printf "$@" | xxd -p -c1 -u);
	# print a newline unless we’re piping the output to another program
	if [ -t 1 ]; then
		echo ""; # newline
	fi;
}

# Show all the names (CNs and SANs) listed in the SSL certificate
# for a given domain
function getcertnames() {
	if [ -z "${1}" ]; then
		echo "ERROR: No domain specified.";
		return 1;
	fi;

	local domain="${1}";
	echo "Testing ${domain}…";
	echo ""; # newline

	local tmp=$(echo -e "GET / HTTP/1.0\nEOT" \
		| openssl s_client -connect "${domain}:443" -servername "${domain}" 2>&1);

	if [[ "${tmp}" = *"-----BEGIN CERTIFICATE-----"* ]]; then
		local certText=$(echo "${tmp}" \
			| openssl x509 -text -certopt "no_aux, no_header, no_issuer, no_pubkey, \
			no_serial, no_sigdump, no_signame, no_validity, no_version");
		echo "Common Name:";
		echo ""; # newline
		echo "${certText}" | grep "Subject:" | sed -e "s/^.*CN=//" | sed -e "s/\/emailAddress=.*//";
		echo ""; # newline
		echo "Subject Alternative Name(s):";
		echo ""; # newline
		echo "${certText}" | grep -A 1 "Subject Alternative Name:" \
			| sed -e "2s/DNS://g" -e "s/ //g" | tr "," "\n" | tail -n +2;
		return 0;
	else
		echo "ERROR: Certificate not found.";
		return 1;
	fi;
}

# `v` with no arguments opens the current directory in Vim, otherwise opens the
# given location
function v() {
	if [ $# -eq 0 ]; then
		vim .;
	else
		vim "$@";
	fi;
}

# `o` with no arguments opens the current directory, otherwise opens the given
# location
function o() {
	if [ $# -eq 0 ]; then
		open .;
	else
		open "$@";
	fi;
}

# `tre` is a shorthand for `tree` with hidden files and color enabled, ignoring
# the `.git` directory, listing directories first. The output gets piped into
# `less` with options to preserve color and line numbers, unless the output is
# small enough for one screen.
function tre() {
	tree -aC -I '.git|node_modules|bower_components' --dirsfirst "$@" | less -FRNX;
}

# Sync this repo to $HOME: the public source first, then every private
# overlay that is set up. chezmoi supports one source directory per config
# file, so each overlay is its own config in ~/.config/chezmoi/*.toml
# pointing at its own source; see each overlay repo's README for the
# one-time init. An overlay whose source clone is missing is skipped, so
# machines without any overlay — including every `ephemeral` box — get the
# public pass only, which is why nothing in the public source depends on
# one existing. Which overlays a machine carries defines what it is: a
# personal box gets the personal overlay, a work box the work one, a
# machine used for both gets both.
function dotfiles() {
	# The overlay glob needs bare glob qualifiers, which not every shell
	# sourcing this file has on (Claude Code's Bash tool sets
	# NO_BARE_GLOB_QUAL, making `(N)` literal and NOMATCH fatal).
	emulate -L zsh;
	chezmoi apply "$@" || return;
	local cfg src;
	for cfg in ~/.config/chezmoi/*.toml(N); do
		[[ ${cfg:t} == chezmoi.toml ]] && continue;
		src="$(chezmoi --config "$cfg" source-path 2>/dev/null)" && [[ -d $src ]] || continue;
		chezmoi --config "$cfg" apply "$@" || return;
	done;
	# Finicky caches its bundled config keyed on ~/.finicky.ts's mtime, so an
	# overlay's rule fragment (imported by it) changing is invisible until the
	# entry file is touched. Cheap and idempotent; skipped where Finicky
	# isn't deployed.
	[[ -f ~/.finicky.ts ]] && command touch ~/.finicky.ts;
	return 0;
}

# Resolve the GitHub account implied by the cwd's origin remote, from the
# `credential.<url>.username` pins in git config. The OWNER path segment is
# parsed positionally from ssh/scp-alias/https URL shapes, lowercased, and
# looked up against the pins. Prints nothing and returns 1 when nothing
# matches. Shared by gh() and claude() so the two can never disagree about
# which account a repo belongs to.
#
# NO helper here may have an underscore-prefixed name: Claude Code's shell
# snapshot (used by its Bash tool and `!` commands) carries over shell
# functions but silently drops underscore-prefixed ones, leaving callers
# like claude() half-defined in those shells. tests/claude-profiles.bats
# enforces this.
function gh_account_for_cwd() {
	local slug owner acct;
	slug="$(git_origin_slug)" || return 1;
	# The OWNER is parsed positionally instead of trying every segment, so a
	# repo that happens to be named after a pinned owner can never hijack the
	# lookup.
	owner=${slug%%/*};
	[[ -n $owner ]] || return 1;
	acct="$(command git config --get "credential.https://github.com/$owner.username" 2>/dev/null)";
	[[ -n $acct ]] && { print -r -- "$acct"; return 0; };
	return 1;
}

# The cwd's origin remote as a lowercase `owner/repo` slug (the path after
# the host, `.git` stripped), from ssh, scp-alias, or https URL shapes.
# Lowercased because GitHub owners and repos are case-insensitive and the
# pins are recorded lowercase. Prints nothing and returns 1 for a local path
# or no origin.
function git_origin_slug() {
	local url slug;
	url="$(command git config --get remote.origin.url 2>/dev/null)";
	[[ -n $url ]] || return 1;
	url=${url%/};
	url=${url%.git};
	case $url in
		(*://*) slug=${url#*://*/};;  # https://host/owner/repo
		(*:*)   slug=${url#*:};;      # [user@]host:owner/repo (ssh, incl. aliases)
		(*)     return 1;;            # local path or something else — no owner
	esac;
	slug=${(L)slug};
	[[ $slug == */* ]] || return 1;
	print -r -- "$slug";
}

# For the doctors: are the helper functions a wrapper (and the doctor itself)
# call actually defined in this shell? Prints "ok (N helpers)" or names the
# missing ones. A wrapper whose callee is gone does not fail loudly: the
# doctor's own `acct="$(gh_account_for_cwd)"` just yields empty and the
# `account:` line confidently reports "no pin matched" — so every doctor
# prints this before any line that depends on a helper. The failure this
# catches is real: Claude Code's shell snapshot once dropped functions on
# their name alone (see the note above gh_account_for_cwd), leaving the
# wrappers half-defined only inside its sessions. Each doctor's list is
# checked against the function bodies by tests/git-doctor.bats, so it
# cannot quietly go stale.
function defined_trace() {
	emulate -L zsh;
	local f;
	local -a missing;
	for f in "$@"; do
		(( $+functions[$f] )) || missing+=("$f");
	done;
	if (( ${#missing} )); then
		print -r -- "MISSING ${missing[*]} — a shell snapshot or partial source dropped them; source ~/.functions again";
		return 0;
	fi;
	print -r -- "ok ($# helpers)";
}

# For the doctors: describe the executable $1 without running it — where a
# version manager's shim points for this cwd (asdf, nodenv), and the version
# when it can be read off the install itself: an npm package's package.json
# (npm -g and node_modules/.bin symlink into one) or a version segment in the
# resolved path (Homebrew casks, Claude's native installer). Prints
# "<path>[ -> <shim target>][ (<version>)]"; a shim whose manager selects a
# node with no such command is reported as "-> <not installed under the
# selected node>", which is exactly why running it would fail.
function bin_trace() {
	local bin=$1 target real ver seg pkg;
	if [[ $bin == */shims/* ]]; then
		if (( $+commands[asdf] )) && [[ $bin == "${ASDF_DATA_DIR:-$HOME/.asdf}"/shims/* ]]; then
			target="$(command asdf which "${bin:t}" 2>/dev/null)" || target="";
		elif (( $+commands[nodenv] )); then
			target="$(command nodenv which "${bin:t}" 2>/dev/null)" || target="";
		fi;
		[[ -n $target ]] || { print -r -- "$bin -> <not installed under the selected node>"; return 0; };
		# A version manager whose data dir is missing (e.g. a sandboxed HOME)
		# answers `which` with the shim itself — nothing to follow.
		[[ $target == "$bin" ]] && target="";
	fi;
	real=${${target:-$bin}:A};
	if [[ -e $real ]]; then
		for pkg in "${real:h}/package.json" "${real:h:h}/package.json"; do
			[[ -r $pkg ]] || continue;
			ver="$(command sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$pkg" | command head -n1)";
			[[ -n $ver ]] && break;
		done;
		if [[ -z $ver && $real != *node_modules* ]]; then
			for seg in "${(@s:/:)real}"; do
				[[ $seg == <->.<->.<->* ]] && ver=$seg;
			done;
		fi;
	fi;
	print -r -- "$bin${target:+ -> $target}${ver:+ ($ver)}";
}

# Claude Code keeps each account in its own config directory — separate login,
# settings, plugins, and session history — selected by CLAUDE_CONFIG_DIR. Each
# profile must be logged in once with `claude auth login`; credentials live in
# the macOS Keychain and cannot be copied between profiles.
#
# Which profile applies is derived from the repo you are standing in, using the
# same credential pins that drive gh(), so work repos get the work Claude
# account and personal repos the personal one with no flag to remember.
#
# The account -> directory mapping lives in machine-local git config
# (`claude.profile.<account>`, set by the private overlay), so no account names
# appear here. Override with CLAUDE_PROFILE, which takes either an account name
# or a literal directory. With no mapping at all, this is plain `claude` on the
# default ~/.claude config dir.
function claude() {
	local dir;
	dir="$(claude_profile_dir)" || { command claude "$@"; return; };
	# The default profile must run with CLAUDE_CONFIG_DIR UNSET, not set to
	# its own path — setting the variable at all switches Claude Code to
	# per-profile credentials (a separate Keychain entry keyed on the dir),
	# so the default dir with the variable set reports logged out. Unset it
	# in a subshell: the parent environment may carry another profile's dir
	# (e.g. `claude-as` to the default profile from inside a non-default
	# Claude session, whose shells inherit CLAUDE_CONFIG_DIR).
	[[ $dir == "$HOME/.claude" ]] && { (unset CLAUDE_CONFIG_DIR; command claude "$@"); return; };
	CLAUDE_CONFIG_DIR="$dir" command claude "$@";
}

# The profile-directory decision claude() acts on, extracted so claude-doctor
# reports the same answer claude() uses — the two can never drift. Prints the
# tilde-expanded directory; prints nothing and returns 1 when claude() would
# fall through to a bare `claude`.
function claude_profile_dir() {
	local acct dir;
	if [[ -n $CLAUDE_PROFILE ]]; then
		dir="$(command git config --get "claude.profile.$CLAUDE_PROFILE" 2>/dev/null)";
		if [[ -z $dir ]]; then
			# A literal directory is fine; a typo'd account name is not —
			# without this check it would become a relative CLAUDE_CONFIG_DIR.
			if [[ $CLAUDE_PROFILE == (\~|/)* || -d $CLAUDE_PROFILE ]]; then
				dir=$CLAUDE_PROFILE;
			else
				print -ru2 -- "claude: CLAUDE_PROFILE='$CLAUDE_PROFILE' is neither a mapped account nor a directory; falling back to the default profile";
				return 1;
			fi;
		fi;
	else
		# No pin match (not a repo, no origin, unpinned owner) falls back to
		# the machine-local default profile, `claude.profile.default` — set it
		# in the overlay of whichever identity should own stray directories on
		# this machine. Unset, this stays plain `claude`.
		acct="$(gh_account_for_cwd)" || acct=default;
		dir="$(command git config --get "claude.profile.$acct" 2>/dev/null)";
	fi;
	[[ -n $dir ]] || return 1;
	print -r -- "${dir/#\~/$HOME}";
}

# Launch Claude Code pinned to an explicit profile, ignoring the cwd:
# `claude-as <profile> [args...]`. The profile is an account or alias mapped in
# `claude.profile.*` (machine-local git config, set by the private overlay) or
# a literal directory; anything else is an error — an explicit request must
# never silently fall back to another account. Remaining args and stdin pass
# through untouched, so piping a prompt in works. Resolution and the
# default-profile unset-variable special case stay in claude(); this only
# vets the name and sets CLAUDE_PROFILE for one invocation.
function claude-as() {
	local profile names;
	names="$(command git config --get-regexp '^claude\.profile\.' 2>/dev/null | command sed 's/^claude\.profile\.//; s/ .*//')";
	[[ -n $names ]] || names="<none mapped in claude.profile.*>";
	if (( $# == 0 )); then
		print -ru2 -- "usage: claude-as <profile> [claude args...]";
		print -ru2 -- "available profiles:";
		print -ru2 -- "$names";
		return 1;
	fi;
	profile=$1;
	shift;
	# Vet the name with the same resolver claude() uses (its warning is
	# suppressed — ours names the command). Mapped accounts, absolute or
	# tilde-prefixed paths, and existing directories resolve; typos do not.
	if ! CLAUDE_PROFILE=$profile claude_profile_dir >/dev/null 2>&1; then
		print -ru2 -- "claude-as: unknown profile '$profile'";
		print -ru2 -- "available profiles:";
		print -ru2 -- "$names";
		return 1;
	fi;
	CLAUDE_PROFILE=$profile claude "$@";
}

# Diagnose what `claude` would do right here: is the wrapper loaded, what does
# the cwd resolve to, which profile directory launches, and does that profile
# hold a login. Run it in any terminal tab and paste the output when profile
# selection misbehaves. If the command itself is not found, the tab's shell
# predates the last `chezmoi apply` — open a new shell.
function claude-doctor() {
	local origin acct map dir cred email;
	print -r -- "wrapper: $(whence -w claude)";
	print -r -- "defined: $(defined_trace claude_profile_dir gh_account_for_cwd git_origin_slug bin_trace)";
	print -r -- "binary:  $(bin="$(whence -p claude)" && bin_trace "$bin" || print -r -- 'NOT FOUND on PATH')";
	print -r -- "cwd:     $PWD";
	origin="$(command git config --get remote.origin.url 2>/dev/null)";
	print -r -- "origin:  ${origin:-<none — not a git repo or no origin>}";
	acct="$(gh_account_for_cwd)";
	print -r -- "account: ${acct:-<no credential pin matched>}";
	map="";
	if [[ -n $acct ]]; then
		map="$(command git config --get "claude.profile.$acct" 2>/dev/null)";
	else
		map="$(command git config --get claude.profile.default 2>/dev/null)";
		[[ -n $map ]] && map="$map (claude.profile.default)";
	fi;
	print -r -- "mapping: ${map:-<none>}";
	print -r -- "env:     CLAUDE_PROFILE=${CLAUDE_PROFILE-<unset>} CLAUDE_CONFIG_DIR=${CLAUDE_CONFIG_DIR-<unset>}";
	if dir="$(claude_profile_dir)"; then
		print -r -- "launch:  $dir";
	else
		dir="$HOME/.claude";
		print -r -- "launch:  $dir (bare claude fallback)";
	fi;
	if [[ $dir == "$HOME/.claude" ]]; then
		# The default profile authenticates via the shared Keychain entry and
		# records no account metadata on disk — presence is all we can check.
		if ! command -v security >/dev/null; then
			cred="default profile uses the macOS Keychain; cannot check from here";
		elif command security find-generic-password -s "Claude Code-credentials" >/dev/null 2>&1; then
			cred="Keychain entry present (run /status in the session to see which account)";
		else
			cred="NOT LOGGED IN — run: claude auth login";
		fi;
	else
		# Non-default profiles get their own Keychain entry and record the
		# account email in the profile's .claude.json at login.
		email="$(command sed -n 's/.*"emailAddress"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$dir/.claude.json" 2>/dev/null | command head -n1)";
		if [[ -n $email ]]; then
			cred="logged in as $email";
		else
			cred="NOT LOGGED IN — run: CLAUDE_CONFIG_DIR=$dir claude auth login";
		fi;
	fi;
	print -r -- "creds:   $cred";
}

# Diagnose what `workspace` would put on screen: is the script deployed, is the
# AutoLaunch trigger installed, what does the machine-local config ask for, and
# which of those tabs are open right now. The entry table comes from the
# script's own `status` — one decision, reported once. Report-only: it opens
# nothing, and it never asks iTerm2 for anything the script would not.
function workspace-doctor() {
	emulate -L zsh;
	local ver scpt prof;
	print -r -- "wrapper: <none — workspace is a script, not a shell wrapper>";
	print -r -- "defined: <none — this doctor calls no helpers>";
	if (( $+commands[workspace] )); then
		print -r -- "script:  ${commands[workspace]}";
	else
		print -r -- "script:  NOT FOUND — ~/bin/workspace is not on PATH (chezmoi apply; macOS only)";
	fi;
	if [[ -d /Applications/iTerm.app ]]; then
		# Read off the bundle, never by running it — same rule as the other
		# doctors' binary: lines.
		ver="$(command defaults read /Applications/iTerm.app/Contents/Info CFBundleShortVersionString 2>/dev/null)";
		print -r -- "iterm:   /Applications/iTerm.app${ver:+ ($ver)}";
	elif [[ $(uname -s) == Darwin ]]; then
		print -r -- "iterm:   NOT INSTALLED — brew install --cask iterm2";
	else
		print -r -- "iterm:   n/a — iTerm2 is macOS-only, the launcher does nothing here";
	fi;
	scpt="$HOME/Library/Application Support/iTerm2/Scripts/AutoLaunch.scpt";
	if [[ -e $scpt ]]; then
		if command grep -q workspace $scpt 2>/dev/null; then
			print -r -- "trigger: AutoLaunch.scpt installed — iTerm2 runs it at launch, so no Automation grant is involved";
		else
			print -r -- "trigger: AutoLaunch.scpt exists but is NOT ours — install would refuse rather than clobber it";
		fi;
	else
		print -r -- "trigger: not installed — workspace install";
	fi;
	prof="$HOME/Library/Application Support/iTerm2/DynamicProfiles/workspace.json";
	if [[ -e $prof ]]; then
		print -r -- "profile: installed — every tab workspace opens carries it, so its own windows are distinguishable from yours";
	else
		print -r -- "profile: not installed — tabs open with the default profile and are told apart by their tag alone (workspace install)";
	fi;
	# iTerm2 opens a window of its own at launch that workspace neither created
	# nor reuses. Report it; changing a preference is the user's call.
	if [[ $(uname -s) == Darwin ]]; then
		if [[ "$(command defaults read com.googlecode.iterm2 OpenNoWindowsAtStartup 2>/dev/null)" == 1 ]]; then
			print -r -- "startup: iTerm2 opens no window of its own — only the ones workspace starts";
		else
			print -r -- "startup: iTerm2 also opens one window of its own at launch — defaults write com.googlecode.iterm2 OpenNoWindowsAtStartup -bool true";
		fi;
	fi;
	if (( $+commands[workspace] )); then
		command workspace status 2>&1 | sed 's/^/  /';
	fi;
	print -r -- "cwd:     $PWD";
}

# The Hermes harness (NousResearch/hermes-agent) keeps per-agent state in
# profiles (`hermes profile create <name>` — each its own HERMES_HOME with its
# own config, approval rules, memory, and .env keys). A repo that must only
# ever run Hermes under a hardened profile pins that in its own .git/config
# (machine-local, so a fresh clone re-pins deliberately):
#
#   git config hermes.profile <name>   # route `hermes` through -p <name>
#   git config hermes.model <model>    # optional: also append --model <model>
#
# In a pinned repo an explicit -p/--profile naming a *different* profile is a
# loud error, never an override (same stance as claude-as/wrangler: an
# explicit pin must not silently run as something else). It was never a
# working override anyway: hermes' pre-argparse scanner honours the first
# -p it sees and the leftover second flag then dies as an argparse usage
# error. Naming the pinned profile explicitly is a harmless no-op, and
# `command hermes` stays the bypass — this is routing, not a sandbox.
# `hermes.model` covers the light case (same profile, memory, and keys —
# different LLM, CLI args outrank config); full isolation is a profile per
# purpose, whose own config/.env carry that provider. The old
# hermes.launcher pin is retired (with the server handling below its only
# remaining job was -p); a lingering one is refused with the migration
# printed, never silently ignored. Unpinned directories pass through, flags
# untouched. The arg scan stops at `--` and at `--args` (`mcp add --args`
# is child-command passthrough, mirroring hermes itself) and mirrors
# hermes' profile-name check so a non-name value (pytest's `-p no:xdist`)
# is never mistaken for a profile.
#
# Most profiles here point model.base_url at a local Ollama server, and
# hermes only ever speaks HTTP to that URL — nothing in it starts the
# server (that was `ollama launch`'s only real job). So before launching,
# the wrapper reads the effective profile's config.yaml and, only when
# model.provider is ollama-ish AND base_url is loopback, probes the port
# and starts `ollama serve` disowned (with a bounded readiness wait) when
# nothing answers. A cloud profile (Anthropic/OpenAI/OpenRouter, or a LAN
# ollama) never waits on or spawns anything. Every failure here warns and
# falls open — hermes prints the real connection error; launching is the
# point. The config lookup mirrors hermes' own resolution approximately
# (explicit flag > pin > profile-dir HERMES_HOME > sticky active_profile >
# root) and skips the probe when no config is readable.
# Read one key out of a profile config.yaml's top-level model: block —
# `hermes_model_get <config> <key>`. The awk stops at the next top-level key
# so a providers: section below never bleeds in. Shared by the wrapper's
# server check and hermes-doctor so the two read the same answer.
function hermes_model_get() {
	emulate -L zsh;
	local cfg=$1 key=$2;
	[[ -r $cfg ]] || return 1;
	command awk '/^model:/{f=1;next} f&&/^[^[:space:]]/{exit} f' "$cfg" 2>/dev/null \
		| command sed -n "s/^[[:space:]]*$key:[[:space:]]*//p" | command head -n1;
}
# The config file the wrapper's server check reads for effective profile $1
# (may be empty), mirroring hermes' own resolution approximately: profile >
# HERMES_HOME > sticky active_profile > root config. Extracted so
# hermes-doctor reports the same path hermes() acts on — the two can never
# drift.
function hermes_cfg_path() {
	emulate -L zsh;
	local eff=$1 active;
	if [[ -n $eff ]]; then
		[[ $eff == default ]] || { print -r -- "$HOME/.hermes/profiles/$eff/config.yaml"; return; };
	elif [[ -n $HERMES_HOME ]]; then
		print -r -- "$HERMES_HOME/config.yaml"; return;
	else
		active="";
		[[ -r $HOME/.hermes/active_profile ]] && active="$(<"$HOME/.hermes/active_profile")";
		if [[ -n $active && $active != default ]]; then
			print -r -- "$HOME/.hermes/profiles/$active/config.yaml"; return;
		fi;
	fi;
	print -r -- "$HOME/.hermes/config.yaml";
}
function hermes_ensure_ollama() {
	emulate -L zsh;
	local cfg=$1 provider base hostport i;
	[[ -r $cfg ]] || return 0;
	provider="$(hermes_model_get "$cfg" provider)";
	base="$(hermes_model_get "$cfg" base_url)";
	[[ $provider == *ollama* ]] || return 0;
	[[ -n $base ]] || base="http://127.0.0.1:11434/v1";
	[[ $base == http://127.0.0.1:* || $base == http://localhost:* ]] || return 0;
	hostport="${${base#http://}%%/*}";
	command curl -sf -m 1 -o /dev/null "http://$hostport/" 2>/dev/null && return 0;
	if ! command -v ollama >/dev/null 2>&1; then
		print -ru2 -- "hermes: profile wants a local ollama at $hostport but no ollama is on PATH; launching anyway";
		return 0;
	fi;
	( OLLAMA_HOST="127.0.0.1:${hostport##*:}" command ollama serve >/dev/null 2>&1 & ) 2>/dev/null;
	for i in {1..50}; do
		command curl -sf -m 1 -o /dev/null "http://$hostport/" 2>/dev/null && return 0;
		command sleep 0.2;
	done;
	print -ru2 -- "hermes: started 'ollama serve' but $hostport never answered; launching anyway";
	return 0;
}
function hermes() {
	emulate -L zsh;
	local launcher pin model a uprofile='' uflag='' umodel=0 eff='';
	local -a args inject;
	launcher="$(command git config --get hermes.launcher 2>/dev/null)";
	if [[ -n $launcher ]]; then
		print -ru2 -- "hermes: the hermes.launcher pin is retired — pin the profile instead:";
		print -ru2 -- "  git config --unset hermes.launcher";
		print -ru2 -- "  git config hermes.profile <name>";
		return 1;
	fi;
	pin="$(command git config --get hermes.profile 2>/dev/null)";
	model="$(command git config --get hermes.model 2>/dev/null)";
	args=("$@");
	local i=1 n=$#args;
	while (( i <= n )); do
		a=${args[i]};
		case $a in
			--|--args) break ;;
			-p|--profile)
				if [[ -z $uflag ]] && (( i < n )) \
					&& [[ ${args[i+1]} =~ '^[a-z0-9][a-z0-9_-]{0,63}$' ]]; then
					uprofile=${args[i+1]}; uflag=$a;
				fi;
				(( i++ )) ;;
			--profile=*)
				[[ -z $uflag ]] && { uprofile=${a#--profile=}; uflag='--profile'; } ;;
			-m|--model) umodel=1; (( i++ )) ;;
			--model=*) umodel=1 ;;
		esac;
		(( i++ ));
	done;
	if [[ -n $pin && -n $uprofile && $uprofile != "$pin" ]]; then
		print -ru2 -- "hermes: this repo is pinned to profile '$pin'; refusing explicit '$uflag $uprofile' (bypass: command hermes)";
		return 1;
	fi;
	[[ -n $pin && -z $uflag ]] && inject+=(-p "$pin");
	[[ -n $model ]] && (( ! umodel )) && inject+=(--model "$model");
	[[ -n $uprofile ]] && eff=$uprofile;
	[[ -z $eff ]] && eff=$pin;
	hermes_ensure_ollama "$(hermes_cfg_path "$eff")";
	command hermes "${inject[@]}" "$@";
}

# Diagnose what `hermes` would do right here: is the wrapper loaded, which
# binary runs, which pins apply, the effective profile and its config, and —
# only when that config wants a local Ollama — whether the server answers.
# Report-only: unlike the wrapper it never starts `ollama serve`. The config
# path and the model keys come from the same helpers the wrapper calls, so
# doctor and wrapper cannot drift. Mirrors gh-/claude-/wrangler-doctor.
function hermes-doctor() {
	local pin model launcher eff src cfg provider base hostport bin;
	print -r -- "wrapper: $(whence -w hermes)";
	print -r -- "defined: $(defined_trace hermes_cfg_path hermes_model_get hermes_ensure_ollama bin_trace)";
	print -r -- "binary:  $(bin="$(whence -p hermes)" && bin_trace "$bin" || print -r -- 'NOT FOUND on PATH')";
	print -r -- "cwd:     $PWD";
	launcher="$(command git config --get hermes.launcher 2>/dev/null)";
	[[ -n $launcher ]] && print -r -- "stale:   hermes.launcher='$launcher' is RETIRED and the wrapper refuses to run — git config --unset hermes.launcher";
	pin="$(command git config --get hermes.profile 2>/dev/null)";
	print -r -- "pin:     ${pin:-<none — flags and hermes' own resolution apply>} (hermes.profile)";
	model="$(command git config --get hermes.model 2>/dev/null)";
	[[ -n $model ]] && print -r -- "model:   $model (hermes.model — appended as --model; an explicit -m/--model outranks it)";
	cfg="$(hermes_cfg_path "$pin")";
	eff=$pin; src="pinned";
	if [[ -z $pin ]]; then
		if [[ -n $HERMES_HOME ]]; then
			src="HERMES_HOME";
		elif [[ $cfg == */profiles/*/config.yaml ]]; then
			eff=${${cfg:h}:t}; src="sticky ~/.hermes/active_profile";
		else
			src="root config";
		fi;
	fi;
	print -r -- "profile: ${eff:-<none>} ($src)";
	if [[ -n $eff && $eff != default && ! -d ${cfg:h} ]]; then
		print -r -- "config:  $cfg (profile MISSING — run: hermes profile create $eff)";
	elif [[ ! -r $cfg ]]; then
		print -r -- "config:  $cfg (missing — the wrapper skips the server check)";
	else
		print -r -- "config:  $cfg";
	fi;
	provider="$(hermes_model_get "$cfg" provider)";
	base="$(hermes_model_get "$cfg" base_url)";
	if [[ ! -r $cfg ]]; then
		print -r -- "ollama:  unknown (no readable config)";
	elif [[ $provider != *ollama* ]]; then
		print -r -- "ollama:  not involved (model.provider: ${provider:-<unset>})";
	else
		[[ -n $base ]] || base="http://127.0.0.1:11434/v1";
		if [[ $base != http://127.0.0.1:* && $base != http://localhost:* ]]; then
			print -r -- "ollama:  $base is not loopback — the wrapper leaves it alone";
		else
			hostport="${${base#http://}%%/*}";
			if command curl -sf -m 1 -o /dev/null "http://$hostport/" 2>/dev/null; then
				print -r -- "ollama:  listening at $hostport (model.provider: $provider)";
			elif command -v ollama >/dev/null 2>&1; then
				print -r -- "ollama:  DOWN at $hostport — the wrapper will start 'ollama serve' at launch";
			else
				print -r -- "ollama:  DOWN at $hostport and no ollama on PATH — the wrapper will warn and launch anyway";
			fi;
		fi;
	fi;
}

# Wrangler (Cloudflare) keeps one OAuth login per *auth profile* — a named
# login created with `wrangler auth create <name>`, plus the unnamed `default`
# one that `wrangler login` manages. Wrangler picks the profile for a command
# as: CLOUDFLARE_API_TOKEN (overrides everything) > `--profile <name>` >
# the nearest ancestor directory bound with `wrangler auth activate <name>
# <dir>` > `default`. That per-directory binding is the mechanism this wrapper
# drives, rather than injecting a flag: bindings are what wrangler itself
# consults, so `whoami`, `npx wrangler`, and package.json scripts all agree
# with the wrapper, and `login`/`logout`/`whoami`/`auth *` — which reject
# `--profile` outright — behave normally.
#
# Which profile a repo gets is derived as claude() derives its config dir:
# the cwd's origin remote -> GitHub account (credential pins) ->
# `wrangler.profile.<account>` in machine-local git config (set by the
# private overlays, so no account names live here). A repo that deploys to
# some other Cloudflare account — a side project with its own login, hosted
# under a personal GitHub account — is pinned by slug instead:
# `wrangler.<owner>/<repo>.profile`, which outranks the account mapping. Both
# lookups are done at run time from git config. The wrapper binds the
# repo root to that profile the first time it sees the repo (or whenever the
# binding disagrees), then runs the command; a repo whose owner is unpinned or
# unmapped is left to wrangler's own resolution. Mapping an account to
# `default` means "wrangler's default login" and manages no binding.
#
# Override for one run with WRANGLER_PROFILE=<mapped name or existing
# profile> or `wrangler-as <name> [args...]`, both of which pass wrangler's
# own `--profile=` flag (so they cannot be combined with the commands that
# reject it). Each profile must be created once with `wrangler auth create
# <name>` — the wrapper never logs in for you and refuses to run a command as
# another account when the mapped profile is missing.
#
# Which wrangler runs is resolved the way `npx wrangler` resolves it (see
# wrangler_bin): a project that vendors wrangler in its package.json gets its
# own node_modules/.bin/wrangler — the version it pinned, on the node it was
# installed under — and everything else gets whatever `wrangler` is on PATH
# (an asdf/nodenv shim, `npm -g`, ...). Profiles and bindings live in
# wrangler's per-user config dir either way, so every install sees the same
# logins.
function wrangler() {
	local profile bin;
	bin="$(wrangler_bin)" || {
		print -ru2 -- "wrangler: not found — no node_modules/.bin/wrangler at or above $PWD and none on PATH";
		return 127;
	};
	# Account management passes straight through (as gh() does with `gh
	# auth`); an API token in the environment overrides every profile and
	# makes wrangler refuse binding changes, so there is nothing to manage.
	case $1 in
		(auth|login|logout) "$bin" "$@"; return;;
	esac;
	[[ -n $CLOUDFLARE_API_TOKEN ]] && { "$bin" "$@"; return; };
	if [[ -n $WRANGLER_PROFILE ]]; then
		if profile="$(wrangler_profile)"; then
			# One-shot override: wrangler's flag outranks any binding. Left
			# alone when the caller already passed one — duplicating the
			# flag makes yargs reject the command.
			[[ " $* " == *" --profile "* || " $* " == *" --profile="* ]] \
				|| set -- --profile="$profile" "$@";
			"$bin" "$@";
			return;
		fi;
		# A typo'd override warned on stderr; fall through to the cwd.
	fi;
	profile="$(WRANGLER_PROFILE= wrangler_profile)" || { "$bin" "$@"; return; };
	wrangler_bind "$profile" "$bin" || return;
	"$bin" "$@";
}

# The wrangler executable a command in the cwd should run, resolved as npx
# and package.json scripts resolve it: the nearest node_modules/.bin/wrangler
# at or above the cwd — a project that vendors wrangler pinned that version
# for a reason, and it is what its own scripts run — else whatever `wrangler`
# is on PATH, shims included (a version manager's shim picks the node it
# selects for the cwd; if that node has no wrangler, the shim's own error
# shows through). Prints the path; prints nothing and returns 1 when there
# is none anywhere.
function wrangler_bin() {
	local d=$PWD;
	while :; do
		[[ -x $d/node_modules/.bin/wrangler ]] && { print -r -- "$d/node_modules/.bin/wrangler"; return 0; };
		[[ $d == / ]] && break;
		d=${d:h};
	done;
	whence -p wrangler;
}

# The profile name wrangler() acts on: WRANGLER_PROFILE (a mapped account or
# alias from `wrangler.profile.*`, else an existing profile name — a typo must
# not become a fresh OAuth login under the misspelled name) or, unset, the
# cwd's repo: a per-repo pin `wrangler.<owner>/<repo>.profile` first (for a
# repo that deploys to a Cloudflare account other than its GitHub owner's
# usual one), else the pinned account's `wrangler.profile.<account>`. Prints
# nothing and returns 1 when wrangler() should leave resolution to wrangler
# itself.
function wrangler_profile() {
	local slug acct name;
	if [[ -n $WRANGLER_PROFILE ]]; then
		name="$(command git config --get "wrangler.profile.$WRANGLER_PROFILE" 2>/dev/null)";
		if [[ -z $name ]]; then
			if wrangler_profile_exists "$WRANGLER_PROFILE"; then
				name=$WRANGLER_PROFILE;
			else
				print -ru2 -- "wrangler: WRANGLER_PROFILE='$WRANGLER_PROFILE' is neither a mapped account nor an existing wrangler profile; ignoring it";
				return 1;
			fi;
		fi;
	else
		slug="$(git_origin_slug)" || return 1;
		name="$(command git config --get "wrangler.$slug.profile" 2>/dev/null)";
		if [[ -z $name ]]; then
			acct="$(gh_account_for_cwd)" || return 1;
			name="$(command git config --get "wrangler.profile.$acct" 2>/dev/null)";
		fi;
	fi;
	[[ -n $name ]] || return 1;
	print -r -- "$name";
}

# Wrangler's global config directory, resolved the way wrangler does it:
# legacy ~/.wrangler if that directory exists, else $XDG_CONFIG_HOME, else the
# platform default (~/Library/Preferences on macOS, ~/.config elsewhere), each
# with a `.wrangler` segment appended. Profiles live in config/<name>.toml
# (or .enc), directory bindings in profiles/directory-bindings.json.
function wrangler_config_dir() {
	[[ -d ~/.wrangler ]] && { print -r -- ~/.wrangler; return; };
	local base=$XDG_CONFIG_HOME;
	if [[ -z $base ]]; then
		[[ $OSTYPE == darwin* ]] && base=~/Library/Preferences || base=~/.config;
	fi;
	print -r -- "$base/.wrangler";
}

function wrangler_profile_exists() {
	local dir;
	[[ $1 == default ]] && return 0;
	dir="$(wrangler_config_dir)/config";
	[[ -e "$dir/$1.toml" || -e "$dir/$1.enc" ]];
}

# Make sure the cwd's repo root is bound to profile $1, binding it with
# wrangler's own `auth activate` (run via the executable $2, default
# wrangler_bin) when it is not. Returns 1 — and the caller must not run its
# command — when the bind fails, e.g. the profile has not been created yet:
# running on would silently use another account.
function wrangler_bind() {
	local top file out bin;
	[[ $1 == default ]] && return 0;
	top="$(command git rev-parse --show-toplevel 2>/dev/null)" || return 0;
	file="$(wrangler_config_dir)/profiles/directory-bindings.json";
	# wrangler stores bindings as {"<abs dir>": "<profile>"}; a matching pair
	# means nothing to do. A wrong guess at the file (or a future format
	# change) only costs a redundant, idempotent activate per command.
	command grep -Fq -- "\"$top\": \"$1\"" "$file" 2>/dev/null && return 0;
	bin=${2:-$(wrangler_bin)};
	if out="$("$bin" auth activate "$1" "$top" 2>&1)"; then
		print -ru2 -- "wrangler: bound $top to profile '$1'";
	else
		# Keep wrangler's error, drop its banner / experimental-warning /
		# log-path chatter and blank lines.
		local -a lines;
		lines=("${(@f)out}");
		lines=("${(@)lines:#(|*experimental command*|*Logs were written to*|*wrangler [0-9]*|*───*)}");
		print -ru2 -- "${(F)lines}";
		# The usual cause is a profile that was never created; when it does
		# exist the error above (an old wrangler without `auth activate`, a
		# version-manager shim with no wrangler under the selected node, ...)
		# is the whole story, so don't send anyone to `auth create`.
		if wrangler_profile_exists "$1"; then
			print -ru2 -- "wrangler: cannot bind $top to profile '$1' (see above; \`wrangler-doctor\` shows which wrangler ran); refusing to run as another account";
		else
			print -ru2 -- "wrangler: cannot bind $top to profile '$1'; refusing to run as another account (create it with: wrangler auth create $1)";
		fi;
		return 1;
	fi;
}

# Run wrangler pinned to an explicit profile for this one command, ignoring
# the cwd: `wrangler-as <profile> [args...]`. The profile is an account or
# alias mapped in `wrangler.profile.*` or an existing wrangler profile;
# anything else is an error — an explicit request must never silently run as
# another account. Uses wrangler's `--profile=` flag, which the auth, login,
# logout, and whoami commands reject.
function wrangler-as() {
	local profile names;
	names="$(command git config --get-regexp '^wrangler\.profile\.' 2>/dev/null | command sed 's/^wrangler\.profile\.//; s/ .*//')";
	[[ -n $names ]] || names="<none mapped in wrangler.profile.*>";
	if (( $# == 0 )); then
		print -ru2 -- "usage: wrangler-as <profile> [wrangler args...]";
		print -ru2 -- "available profiles:";
		print -ru2 -- "$names";
		return 1;
	fi;
	profile=$1;
	shift;
	if ! WRANGLER_PROFILE=$profile wrangler_profile >/dev/null 2>&1; then
		print -ru2 -- "wrangler-as: unknown profile '$profile'";
		print -ru2 -- "available profiles:";
		print -ru2 -- "$names";
		return 1;
	fi;
	WRANGLER_PROFILE=$profile wrangler "$@";
}

# Diagnose what `wrangler` would do right here: is the wrapper loaded, what
# do the cwd's origin, repo pin, and account mapping resolve to, does that
# profile exist, what is the repo root bound to, and which profile wrangler
# itself will therefore use. Paste the output when profile selection
# misbehaves. Reads the same files wrangler does; never runs wrangler (the
# binary line is derived from the filesystem, see bin_trace).
function wrangler-doctor() {
	local origin slug acct repopin map profile cfg top bound line dir prof best bin onpath;
	print -r -- "wrapper: $(whence -w wrangler)";
	print -r -- "defined: $(defined_trace wrangler_bin wrangler_profile wrangler_bind wrangler_config_dir wrangler_profile_exists gh_account_for_cwd git_origin_slug bin_trace)";
	if bin="$(wrangler_bin)"; then
		onpath="$(whence -p wrangler)";
		if [[ $bin == */node_modules/.bin/wrangler ]]; then
			print -r -- "binary:  $(bin_trace "$bin") [repo-local, as npx would run; PATH has ${onpath:-none}]";
		else
			print -r -- "binary:  $(bin_trace "$bin")";
		fi;
	else
		print -r -- "binary:  NOT FOUND — no node_modules/.bin/wrangler at or above the cwd and none on PATH";
	fi;
	print -r -- "cwd:     $PWD";
	origin="$(command git config --get remote.origin.url 2>/dev/null)";
	print -r -- "origin:  ${origin:-<none — not a git repo or no origin>}";
	slug="$(git_origin_slug)";
	acct="$(gh_account_for_cwd)";
	print -r -- "account: ${acct:-<no credential pin matched>}";
	repopin="";
	[[ -n $slug ]] && repopin="$(command git config --get "wrangler.$slug.profile" 2>/dev/null)";
	if [[ -n $repopin ]]; then
		print -r -- "repo pin: wrangler.$slug.profile = $repopin";
	else
		print -r -- "repo pin: <none>";
	fi;
	map="";
	[[ -n $acct ]] && map="$(command git config --get "wrangler.profile.$acct" 2>/dev/null)";
	if [[ -n $map ]]; then
		print -r -- "mapping: wrangler.profile.$acct = $map";
	else
		print -r -- "mapping: <none>";
	fi;
	# Never echo the token itself — only whether it is set.
	print -r -- "env:     WRANGLER_PROFILE=${WRANGLER_PROFILE-<unset>} CLOUDFLARE_API_TOKEN=$([[ -n $CLOUDFLARE_API_TOKEN ]] && print -r -- '<set — overrides every profile>' || print -r -- '<unset>')";
	if profile="$(wrangler_profile 2>/dev/null)"; then
		print -r -- "wants:   $profile${WRANGLER_PROFILE:+ (via WRANGLER_PROFILE, passed as --profile=)}";
	else
		profile="";
		print -r -- "wants:   <nothing mapped — wrangler's own resolution>";
	fi;
	cfg="$(wrangler_config_dir)";
	print -r -- "config:  $cfg";
	if [[ -n $profile ]]; then
		if wrangler_profile_exists "$profile"; then
			print -r -- "profile: '$profile' exists";
		else
			print -r -- "profile: '$profile' NOT CREATED — run: wrangler auth create $profile";
		fi;
	fi;
	# Bindings: what the repo root is bound to, and the longest-prefix match
	# for the cwd, which is what wrangler will use absent --profile.
	top="$(command git rev-parse --show-toplevel 2>/dev/null)";
	bound=""; best="";
	if [[ -r $cfg/profiles/directory-bindings.json ]]; then
		while IFS= read -r line; do
			dir="${${line#*\"}%%\"*}";
			prof="${${line##*: \"}%\"*}";
			[[ -n $dir && -n $prof ]] || continue;
			[[ -n $top && $dir == "$top" ]] && bound=$prof;
			if [[ $PWD == "$dir" || $PWD == "$dir"/* ]] && (( ${#dir} > ${#best%%:*} )); then
				best="$dir: $prof";
			fi;
		done < <(command grep -E '^[[:space:]]*"/' "$cfg/profiles/directory-bindings.json" 2>/dev/null);
	fi;
	if [[ -n $top ]]; then
		local note="";
		if [[ -n $profile && $profile != default && -z $WRANGLER_PROFILE ]]; then
			if [[ -z $bound ]]; then
				note="  (wrapper will bind it to '$profile' on the next run)";
			elif [[ $bound != "$profile" ]]; then
				note="  (wrapper will rebind it to '$profile' on the next run)";
			fi;
		fi;
		if [[ -n $bound ]]; then
			print -r -- "binding: $top -> $bound$note";
		else
			print -r -- "binding: <repo root not bound>$note";
		fi;
	fi;
	if [[ -n $CLOUDFLARE_API_TOKEN ]]; then
		print -r -- "uses:    CLOUDFLARE_API_TOKEN";
	elif [[ -n $WRANGLER_PROFILE && -n $profile ]]; then
		print -r -- "uses:    $profile (--profile=)";
	elif [[ -n $best ]]; then
		print -r -- "uses:    ${best#*: } (bound at ${best%%: *})";
	else
		print -r -- "uses:    default (no binding covers this directory)";
	fi;
}

# Two (or more) Tailscale networks at once. The Tailscale app — or a root
# tailscaled — is *on* one tailnet at a time; ~/bin/tailnet runs an always-on
# unprivileged userspace tailscaled per additional tailnet, each with a local
# SOCKS5/HTTP proxy, so whichever tailnet the app is on, the others stay
# reachable from the terminal. The script owns the machine side (daemons,
# ports, sockets, the routing decision); these functions own the repo side —
# which tailnet the cwd prefers — and wrap ssh/scp/sftp/curl to act on it,
# the way claude()/wrangler() pick an account from the cwd.
#
# The account -> tailnet mapping is `tailnet.profile.<account>` in machine-local
# git config (set by the private overlays; nothing here names one), with a
# per-repo pin `tailnet.<owner>/<repo>.profile` outranking it (a side project
# living in one account's repos but deployed on another tailnet). The cwd's
# tailnet is only a *preference*: for a target host, `tailnet route` asks each
# installed daemon whether the host is one of its nodes — the cwd's tailnet
# first, then the rest — and the first hit wins; a host that is a node nowhere
# (github.com, a VPS) runs untouched, and a hit on the tailnet the app is
# currently on also runs direct (kernel networking, the app's MagicDNS). Only
# a hit on another tailnet is routed: ssh/scp/sftp get a ProxyCommand through
# that daemon (`tailnet nc`), curl a `--proxy socks5h://` on its port. Hosts
# whose shape cannot be a tailnet node (public FQDNs, non-CGNAT IPs,
# localhost) cost nothing — that shape check is a pure string match and runs
# before the state dir or a daemon is even looked at. And the wrappers fail
# open: the whole routing decision runs in a subshell, so a helper that
# breaks leaves the command running direct, never blocked.
#
# TAILNET=<name> (an installed tailnet, or an account/alias mapped in
# `tailnet.profile.*`) forces that tailnet for one command regardless of the
# node check — the way to reach subnet-router destinations the daemons can't
# vouch for — and `tailnet-as <name> <cmd…>` does that plus exports the proxy
# environment (ALL_PROXY/HTTPS_PROXY/…) so any proxy-aware tool follows.
# `tailnet-doctor [host]` traces every step without routing anything.
#
# Every function below starts with `emulate -L zsh`: they glob and
# pattern-match, and the shells that source this file do not all share the
# interactive shell's options. Claude Code's Bash tool runs zsh with
# NO_BARE_GLOB_QUAL (and NOMATCH), where a bare `(N)` qualifier is literal
# text, the pattern matches nothing, and the whole function aborts — the
# first real-world failure was every `curl` in such a session dying with
# "no matches found: …/tailnet/*/port(N)", localhost included, the moment
# the first tailnet was installed. `emulate -L zsh` gives each function the
# default option set for its own scope (and its callees') whatever the
# caller's shell has set, so the behaviour is the same everywhere.

# The tailnet name the cwd prefers: TAILNET (vetted: an installed name, or a
# `tailnet.profile.*` key naming one) -> the repo pin `tailnet.<slug>.profile`
# -> the pinned account's `tailnet.profile.<account>`. Prints nothing and
# returns 1 when nothing applies (the wrappers then just try every installed
# tailnet in order).
function tailnet_for_cwd() {
	emulate -L zsh;
	local slug acct name;
	if [[ -n $TAILNET ]]; then
		name="$(command git config --get "tailnet.profile.$TAILNET" 2>/dev/null)";
		[[ -n $name ]] || name=$TAILNET;
		if tailnet_installed "$name"; then
			print -r -- "$name";
			return 0;
		fi;
		print -ru2 -- "tailnet: TAILNET='$TAILNET' is neither an installed tailnet nor a mapped account (tailnet names); ignoring it";
		return 1;
	fi;
	slug="$(git_origin_slug)" || return 1;
	name="$(command git config --get "tailnet.$slug.profile" 2>/dev/null)";
	if [[ -z $name ]]; then
		acct="$(gh_account_for_cwd)" || return 1;
		name="$(command git config --get "tailnet.profile.$acct" 2>/dev/null)";
	fi;
	[[ -n $name ]] || return 1;
	print -r -- "$name";
}

# Where ~/bin/tailnet keeps its per-tailnet state; mirrors the script's default
# so "is anything installed" is answerable without running it.
function tailnet_state_root() {
	print -r -- "${TAILNET_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/tailnet}";
}

function tailnet_installed() {
	emulate -L zsh;
	[[ -n $1 && $1 != */* && -f "$(tailnet_state_root)/$1/port" ]];
}

# Is the machinery there at all: the script on PATH and at least one tailnet
# installed. When not, every wrapper is a plain passthrough at zero cost.
function tailnet_active() {
	emulate -L zsh;
	(( $+commands[tailnet] )) || return 1;
	local d;
	for d in "$(tailnet_state_root)"/*/port(N); do
		return 0;
	done;
	return 1;
}

# Could $1 be a node of some tailnet? Only shapes that can are worth asking the
# daemons about: a bare label (MagicDNS short name), *.ts.net, a CGNAT
# 100.64/10 IPv4, or a fd7a:115c:a1e0::/48 IPv6. Everything else — a public
# FQDN, localhost, another IP — runs direct without a single tailscale call.
function tailnet_hostish() {
	emulate -L zsh;
	local h=${(L)1};
	h=${h%.};
	[[ -n $h ]] || return 1;
	case $h in
		(localhost) return 1;;
		(*.ts.net) return 0;;
		(100.<64-127>.<0-255>.<0-255>) return 0;;
		(fd7a:115c:a1e0:*) return 0;;
		(*[.:]*) return 1;;
		(*) return 0;;
	esac;
}

# The routing verdict for host $1: prints the tailnet to proxy through, prints
# nothing when the host should be reached directly — its shape cannot be a
# node, it is a node nowhere or of the tailnet the app is on, or the
# machinery is absent. Cheapest test first: the shape check is a pure string
# match and runs before any state or daemon is consulted, so a host that
# cannot be a node costs nothing and is never exposed to the machinery at
# all. TAILNET, when valid, forces its tailnet and skips the shape check
# (subnet-router destinations the daemons cannot vouch for). Always returns
# 0: no verdict is not an error.
function tailnet_route() {
	emulate -L zsh;
	local prefer;
	[[ -n $TAILNET ]] || tailnet_hostish "$1" || return 0;
	tailnet_active || return 0;
	prefer="$(tailnet_for_cwd)";
	if [[ -n $TAILNET && -n $prefer ]]; then
		command tailnet route --force --prefer "$prefer" -- "$1" 2>/dev/null;
		return 0;
	fi;
	# TAILNET set but rejected (warned about above): ordinary routing.
	tailnet_hostish "$1" || return 0;
	if [[ -n $prefer ]]; then
		command tailnet route --prefer "$prefer" -- "$1" 2>/dev/null;
	else
		command tailnet route -- "$1" 2>/dev/null;
	fi;
	return 0;
}

# The destination ssh will actually connect to, from ssh's own parsing of the
# arguments and config (`ssh -G` prints the resolved `hostname`). Prints
# nothing when ssh cannot make sense of the arguments, or when a ProxyCommand /
# ProxyJump is already in play (config or -J/-o): a `-o ProxyCommand` on the
# command line would silently override a configured ProxyJump, so those hosts
# are left entirely alone.
function tailnet_ssh_host() {
	emulate -L zsh;
	local out l host;
	out="$(command ssh -G "$@" 2>/dev/null)" || return 1;
	for l in "${(@f)out}"; do
		case $l in
			(hostname\ *) host=${l#hostname };;
			(proxycommand\ none|proxyjump\ none) ;;
			(proxycommand\ *|proxyjump\ *) return 1;;
		esac;
	done;
	[[ -n $host ]] || return 1;
	print -r -- "$host";
}

# The remote host of an scp ($1=scp: needs a `[user@]host:path` or scp:// /
# sftp:// operand) or sftp ($1=sftp: that, or the first bare operand) command
# line, then resolved through ssh's config like tailnet_ssh_host. Prints
# nothing when unsure — unsure means untouched.
function tailnet_scp_host() {
	emulate -L zsh;
	local mode=$1 a host skip=0;
	shift;
	for a in "$@"; do
		if (( skip )); then skip=0; continue; fi;
		case $a in
			(-b|-B|-c|-D|-F|-i|-J|-l|-o|-P|-R|-S|-s|-X) skip=1; continue;;
			(-*) continue;;
			(scp://*|sftp://*)
				host=${a#*://};
				host=${host%%/*};
				host=${host##*@};
				if [[ $host == \[* ]]; then host=${host#\[}; host=${host%%\]*};
				else host=${host%%:*}; fi;
				;;
			(*:*)
				# A local path with a colon after a slash (./a:b) is not remote.
				[[ ${a%%:*} == */* ]] && continue;
				host=${a%%:*};
				;;
			(*)
				[[ $mode == sftp ]] || continue;
				host=$a;
				;;
		esac;
		host=${host##*@};
		host=${host#\[};
		host=${host%\]};
		[[ -n $host ]] || return 1;
		tailnet_ssh_host "$host";
		return;
	done;
	return 1;
}

# The host curl will talk to: the first URL argument, else the first bare
# `host[:port][/path]` argument whose host could be a tailnet node (curl takes
# URLs anywhere among options, so an option's value can be mistaken for one —
# the only cost is a lookup, and at worst a public URL is fetched through a
# daemon's ordinary outbound path). Prints nothing when the user is already
# proxying (-x/--proxy/--socks*/--noproxy, or proxy variables in the
# environment) — the user's choice wins.
function tailnet_curl_host() {
	emulate -L zsh;
	local a host bare;
	[[ -z $ALL_PROXY$all_proxy$HTTPS_PROXY$https_proxy$HTTP_PROXY$http_proxy ]] || return 1;
	for a in "$@"; do
		case $a in
			(-x|--proxy|--proxy=*|--socks4*|--socks5*|--noproxy|--noproxy=*|--preproxy*) return 1;;
		esac;
	done;
	for a in "$@"; do
		case $a in
			(-*) continue;;
			(*://*)
				host=${a#*://};
				host=${host%%[/?#]*};
				host=${host##*@};
				if [[ $host == \[* ]]; then host=${host#\[}; host=${host%%\]*};
				else host=${host%%:*}; fi;
				[[ -n $host ]] && { print -r -- "$host"; return 0; };
				;;
			(*)
				[[ -n $bare ]] && continue;
				host=${a%%[/?#]*};
				host=${host##*@};
				if [[ $host == \[* ]]; then host=${host#\[}; host=${host%%\]*};
				else host=${host%%:*}; fi;
				tailnet_hostish "$host" && bare=$host;
				;;
		esac;
	done;
	[[ -n $bare ]] || return 1;
	print -r -- "$bare";
}

# The routing verdict for a whole command line: the tailnet that <ssh|scp|
# sftp|curl> "$@" should go through, or nothing. The script on PATH first (a
# hash lookup — absent, every wrapper is a passthrough at zero cost), then the
# destination parsed from the arguments (unparseable, or the user already
# proxying: nothing), then tailnet_route's shape -> machinery -> daemon
# ladder. A verdict naming a tailnet that is not installed (the script
# misbehaving) is no verdict. Always returns 0.
function tailnet_for_cmd() {
	emulate -L zsh;
	local cmd=$1 host name;
	shift;
	(( $+commands[tailnet] )) || return 0;
	case $cmd in
		(ssh) host="$(tailnet_ssh_host "$@")" || return 0;;
		(scp|sftp) host="$(tailnet_scp_host "$cmd" "$@")" || return 0;;
		(curl) host="$(tailnet_curl_host "$@")" || return 0;;
		(*) return 0;;
	esac;
	name="$(tailnet_route "$host")";
	[[ -n $name ]] && tailnet_installed "$name" && print -r -- "$name";
	return 0;
}

# Run <ssh|scp|sftp|curl> "$@", routed through a tailnet when — and only
# when — tailnet_for_cmd says so: ssh/scp/sftp get a ProxyCommand through
# that daemon, curl its SOCKS proxy. The decision runs inside a command
# substitution, so whatever goes wrong in the helpers — a glob aborting the
# function, a broken state dir, the script misbehaving — the verdict is empty
# and the command runs direct, exactly as typed. Routing is an optimization;
# the command is the point. Nothing outside that substitution may call a
# helper that could fail.
function tailnet_exec() {
	emulate -L zsh;
	local cmd=$1 name url;
	shift;
	name="$(tailnet_for_cmd "$cmd" "$@")";
	if [[ -n $name ]]; then
		case $cmd in
			(curl)
				if url="$(command tailnet proxy-url "$name" 2>/dev/null)" && [[ -n $url ]]; then
					command curl --proxy "$url" "$@";
					return;
				fi;;
			(*)
				# Tailscale SSH "check mode" prints a login.tailscale.com URL
				# on ssh's stderr mid-session and blocks until it is visited —
				# and that URL is identical for every tailnet, so clicked by
				# hand it lands in whatever browser profile was active last.
				# We know the tailnet here, so: stderr streams through tee
				# byte-for-byte (prompts and progress meters intact) into a
				# copy that a disowned watcher greps, and the first auth URL
				# is auto-opened via `open-as <name>` (~/bin), which tags it
				# for the link router so it lands in this tailnet's browser
				# profile. All of it is best-effort: no open-as and the URL
				# stays a line in the terminal; no copy and the command runs
				# exactly as before.
				local copy;
				if copy="$(command mktemp "${TMPDIR:-/tmp}/tailnet-auth.XXXXXX" 2>/dev/null)"; then
					(
						local authurl i;
						# Bounded: the copy is removed when the command ends,
						# but if that cleanup is ever skipped the watcher must
						# still die (a leftover held bats' fd on a CI runner
						# for 97 minutes once), so ~1h is the hard ceiling.
						for i in {1..3600}; do
							[[ -e $copy ]] || break;
							authurl="$(command grep -oam1 'https://login\.tailscale\.com/[A-Za-z0-9/_-]*' "$copy" 2>/dev/null)";
							if [[ -n $authurl ]]; then
								(( $+commands[open-as] )) && command open-as "$name" "$authurl" >/dev/null 2>&1;
								break;
							fi;
							command sleep 1;
						done;
						# Stdio detached and fd 3 closed so the watcher never
						# holds open a pipe belonging to whatever ran the
						# wrapper — a captured `$(ssh …)` would wait out the
						# last poll, and bats blocks on fd 3 until every
						# background holder exits.
					) >/dev/null 2>&1 </dev/null 3>&- &!
					{
						command "$cmd" -o "ProxyCommand=${commands[tailnet]} nc $name %h %p" "$@" 2> >(command tee -a -- "$copy" >&2);
					} always {
						command rm -f -- "$copy";
					};
					return;
				fi;
				command "$cmd" -o "ProxyCommand=${commands[tailnet]} nc $name %h %p" "$@";
				return;;
		esac;
	fi;
	command "$cmd" "$@";
}

function ssh() { tailnet_exec ssh "$@"; }
function scp() { tailnet_exec scp "$@"; }
function sftp() { tailnet_exec sftp "$@"; }
function curl() { tailnet_exec curl "$@"; }

# Run one command pinned to a tailnet: `tailnet-as <name> <cmd…>`. <name> is
# an installed tailnet or an account/alias mapped in `tailnet.profile.*`;
# anything else errors out listing what exists. Sets TAILNET (so the
# ssh/scp/sftp/curl wrappers force that tailnet, node check skipped) and the
# proxy environment (ALL_PROXY, HTTP(S)_PROXY and lowercase twins, NO_PROXY for
# loopback) so proxy-aware tools — gh, git over https, kubectl, pip, Go and
# curl-based programs — go through that tailnet's daemon too. Runs in this
# shell, so the wrappers apply and functions/aliases work.
function tailnet-as() {
	emulate -L zsh;
	local req name names url;
	names="$(command tailnet names 2>/dev/null)";
	[[ -n $names ]] || names="<none installed — tailnet install <name>>";
	if (( $# < 2 )); then
		print -ru2 -- "usage: tailnet-as <name> <command> [args...]";
		print -ru2 -- "installed tailnets:";
		print -ru2 -- "$names";
		return 1;
	fi;
	req=$1;
	shift;
	if ! name="$(TAILNET=$req tailnet_for_cwd 2>/dev/null)"; then
		print -ru2 -- "tailnet-as: unknown tailnet '$req'";
		print -ru2 -- "installed tailnets:";
		print -ru2 -- "$names";
		return 1;
	fi;
	url="$(command tailnet proxy-url "$name")" || return 1;
	TAILNET=$name ALL_PROXY=$url all_proxy=$url HTTPS_PROXY=$url https_proxy=$url \
		HTTP_PROXY=$url http_proxy=$url NO_PROXY=localhost,127.0.0.1,::1 no_proxy=localhost,127.0.0.1,::1 \
		"$@";
}

# Diagnose the tailnet setup and what the wrappers would do right here:
# machinery, the app's tailnet, every installed daemon's state, the cwd's
# preference, and — given a host — the routing verdict for it. Reads state
# and asks the daemons for status; never routes anything.
function tailnet-doctor() {
	emulate -L zsh;
	local root n origin slug acct repopin map prefer host verdict probe prc;
	local -a pref;
	print -r -- "wrapper: $(whence -w ssh) / $(whence -w curl)";
	print -r -- "defined: $(defined_trace tailnet_exec tailnet_for_cmd tailnet_route tailnet_active tailnet_installed tailnet_state_root tailnet_hostish tailnet_for_cwd tailnet_ssh_host tailnet_scp_host tailnet_curl_host gh_account_for_cwd git_origin_slug bin_trace)";
	# Self-test: run the wrappers' real decision path (tailnet_for_cmd, the
	# function tailnet_exec calls) on two probes — a loopback URL, which the
	# shape gate must answer before any state is touched, and a node-shaped
	# name no tailnet has, which walks the whole ladder (ssh -G, shape,
	# state, daemons). The wrappers fail open, so a broken helper is silent
	# there; this is where it shows. Anything on stderr, a non-zero exit,
	# or a verdict for a host that is a node nowhere means BROKEN — the
	# first stderr line already names the function (zsh prefixes errors
	# with it). Captured in one command substitution: a NOMATCH-style
	# error aborts a non-interactive shell outright, so the probe must not
	# run bare — and this line comes before the doctor's own bare helper
	# calls below for the same reason. TAILNET is blanked so a forced
	# tailnet (tailnet-as) does not read as a wrong verdict.
	probe="$( { TAILNET= tailnet_for_cmd curl http://127.0.0.1/; TAILNET= tailnet_for_cmd ssh tailnet-doctor-probe; } 2>&1 )"; prc=$?;
	if [[ -z $probe && $prc -eq 0 ]]; then
		print -r -- "helpers: ok";
	elif [[ -n $probe && $probe != *[[:space:]]* ]] && tailnet_installed "$probe"; then
		print -r -- "helpers: BROKEN — verdict '$probe' for tailnet-doctor-probe, a host no tailnet has (the wrappers would proxy hosts that are nodes nowhere)";
	elif [[ -n $probe ]]; then
		print -r -- "helpers: BROKEN — ${probe%%$'\n'*} (the wrappers run every command direct until this is fixed)";
	else
		print -r -- "helpers: BROKEN — tailnet_for_cmd exited $prc silently (the wrappers run every command direct until this is fixed)";
	fi;
	if (( $+commands[tailnet] )); then
		print -r -- "script:  ${commands[tailnet]}";
	else
		print -r -- "script:  NOT FOUND — ~/bin/tailnet is not on PATH; the wrappers are plain passthroughs";
	fi;
	if (( $+commands[tailscaled] )); then
		print -r -- "binary:  $(bin_trace "${commands[tailscaled]}")";
	else
		print -r -- "binary:  tailscaled NOT FOUND — install the tailscale package (Homebrew formula, not the app)";
	fi;
	if (( $+commands[tailnet] )); then
		print -r -- "cli:     $(command tailnet cli 2>/dev/null || print -r -- 'NONE USABLE (only the Tailscale.app CLI found)')";
		command tailnet system 2>/dev/null || print -r -- "system:  <no tailscale on PATH>";
	fi;
	root="$(tailnet_state_root)";
	print -r -- "state:   $root";
	if tailnet_active; then
		command tailnet status 2>/dev/null | sed 's/^/  /';
	else
		print -r -- "  <no tailnet installed — tailnet install <name> && tailnet up <name>>";
	fi;
	# Mounts (tailnet mount): reported only when a tailnet-mount.* key is
	# configured, so machines without the overlay stay noise-free. The list
	# body comes from the script itself — single source of truth.
	if command git config --get-regexp '^tailnet-mount\.' >/dev/null 2>&1; then
		if (( $+commands[rclone] )); then
			print -r -- "rclone:  $(bin_trace "${commands[rclone]}")";
		else
			print -r -- "rclone:  NOT FOUND — brew install rclone (tailnet mount needs it)";
		fi;
		if (( $+commands[tailnet] )); then
			print -r -- "mounts:";
			command tailnet mounts 2>/dev/null | sed 's/^/  /';
		fi;
	fi;
	print -r -- "cwd:     $PWD";
	origin="$(command git config --get remote.origin.url 2>/dev/null)";
	print -r -- "origin:  ${origin:-<none — not a git repo or no origin>}";
	slug="$(git_origin_slug)";
	acct="$(gh_account_for_cwd)";
	print -r -- "account: ${acct:-<no credential pin matched>}";
	repopin="";
	[[ -n $slug ]] && repopin="$(command git config --get "tailnet.$slug.profile" 2>/dev/null)";
	if [[ -n $repopin ]]; then
		print -r -- "repo pin: tailnet.$slug.profile = $repopin";
	else
		print -r -- "repo pin: <none>";
	fi;
	map="";
	[[ -n $acct ]] && map="$(command git config --get "tailnet.profile.$acct" 2>/dev/null)";
	if [[ -n $map ]]; then
		print -r -- "mapping: tailnet.profile.$acct = $map";
	else
		print -r -- "mapping: <none>";
	fi;
	print -r -- "env:     TAILNET=${TAILNET-<unset>}";
	if prefer="$(tailnet_for_cwd 2>/dev/null)" && tailnet_installed "$prefer"; then
		if [[ -n $TAILNET ]]; then
			print -r -- "wants:   $prefer (forced via TAILNET — node check skipped)";
		else
			print -r -- "wants:   $prefer first, then the other installed tailnets";
		fi;
	else
		# The mapping names something no daemon was installed for (the
		# wrappers skip it and try the rest), or nothing is mapped at all.
		n="${prefer:-${repopin:-$map}}";
		prefer="";
		if [[ -n $n ]] && ! tailnet_installed "$n"; then
			print -r -- "wants:   $n — NOT INSTALLED — run: tailnet install $n && tailnet up $n";
		else
			print -r -- "wants:   <no preference — installed tailnets in order>";
		fi;
	fi;
	if [[ -n $1 ]]; then
		host=$1;
		if [[ -z $TAILNET ]] && ! tailnet_hostish "$host"; then
			verdict="direct (shape cannot be a tailnet node; no daemon asked)";
		elif ! tailnet_active; then
			verdict="direct (no tailnet machinery)";
		else
			# Empty verdict + exit 0 from the script means "a node of the
			# system tailnet"; exit 1 means a node of nothing.
			[[ -n $prefer ]] && pref=(--prefer "$prefer");
			n="$(tailnet_route "$host")";
			if [[ -n $n ]]; then
				verdict="via $n (ProxyCommand=${commands[tailnet]} nc $n %h %p; curl --proxy $(command tailnet proxy-url "$n" 2>/dev/null))";
			elif [[ -n $TAILNET ]] || command tailnet route "${pref[@]}" -- "$host" >/dev/null 2>&1; then
				verdict="direct (a node of the tailnet the app is on)";
			else
				verdict="direct (a node of no installed tailnet)";
			fi;
		fi;
		print -r -- "route:   $host -> $verdict";
	fi;
}

# `gh` wrapper that picks the GitHub account for each invocation, mirroring
# the git identity scheme in ~/.gitconfig.local. It injects GH_TOKEN for the
# single gh invocation rather than running `gh auth switch`, so it never
# mutates the global active account — other shells are unaffected and there is
# no state left stale. `gh auth …` is passed straight through so account
# management still works normally.
#
# No account or org names live here. The owner -> account mapping is read at
# runtime from the `credential.<url>.username` pins in git config, which are
# machine-local (~/.gitconfig.local) and are also what
# ~/bin/git-credential-gh-user uses for plain git over HTTPS. Adding an org is
# a one-line gitconfig change; this function needs no edit. A machine with no
# such pins gets plain `gh` behaviour.
#
# An explicit org/owner in the arguments outranks the cwd's origin remote:
# org-scoped commands (`gh repo list <org>`, `gh api orgs/<org>`) name their
# target, and the repo you happen to be standing in says nothing about it.
# Without this, `gh repo list <work-org>` run from a personal repo queries as
# the personal account — not an org member, so it silently sees only public
# repos.
function gh() {
	[[ $1 == auth ]] && { command gh "$@"; return; };
	local -A gh_owners;
	local key val owner acct arg seg;

	# Unscoped `git config` is required here: --global does not traverse the
	# include that defines these pins, so it returns nothing.
	while IFS=' ' read -r key val; do
		owner=${key#credential.https://github.com/};
		owner=${owner%.username};
		[[ -n $owner && -n $val ]] && gh_owners[$owner]=$val;
	done < <(command git config --get-regexp \
		'^credential\.https://github\.com/.*\.username' 2>/dev/null);
	(( ${#gh_owners} )) || { command gh "$@"; return; };

	# Every `/`- and `:`-delimited segment of every target-shaped argument is
	# a candidate, so `<org>`, `<org>/<repo>`, `orgs/<org>`, `<host>:<org>/<repo>`
	# and full URLs all match. First hit wins. Local paths are skipped so a
	# file argument that happens to contain a pinned owner's name (e.g.
	# `gh gist create ./notes/<org>.md`) cannot hijack the account.
	for arg in "$@"; do
		# Skip filesystem-path arguments only: ./ or ../ relative forms and
		# anything that actually exists. A bare leading / must NOT be
		# skipped — `gh api /repos/<owner>/<repo>` is a documented endpoint
		# form and its owner segment has to outrank the cwd.
		[[ $arg == (.|..)/* || -e $arg ]] && continue;
		for seg in ${(s./.)${${arg%.git}//:/\/}}; do
			if [[ -n ${gh_owners[${(L)seg}]} ]]; then
				acct=${gh_owners[${(L)seg}]};
				break 2;
			fi;
		done;
	done;

	[[ -n $acct ]] || acct="$(gh_account_for_cwd)";

	[[ -n $acct ]] || { command gh "$@"; return; };
	local tok;
	tok="$(command gh auth token --user "$acct" 2>/dev/null)";
	if [[ -z $tok ]]; then
		# Running on silently would use whichever account happens to be
		# active — the exact wrong-account failure the pins exist to prevent.
		print -ru2 -- "gh: no token for pinned account '$acct'; running as the active account";
		command gh "$@";
		return;
	fi;
	GH_TOKEN="$tok" command gh "$@";
}

# Diagnose what `gh` would do right here: is the wrapper loaded, which
# account does the cwd's origin pin, is a token stored for it, and — the part
# that has bitten before — does that token actually authenticate as that
# account (gh's keyring can hand back another user's token). Makes one API
# call; says so if it cannot. Note gh() also lets an explicit owner in the
# arguments outrank the cwd, which this only describes.
function gh-doctor() {
	local origin acct tok who;
	print -r -- "wrapper: $(whence -w gh)";
	print -r -- "defined: $(defined_trace gh_account_for_cwd git_origin_slug bin_trace)";
	print -r -- "binary:  $(bin="$(whence -p gh)" && bin_trace "$bin" || print -r -- 'NOT FOUND on PATH')";
	print -r -- "cwd:     $PWD";
	origin="$(command git config --get remote.origin.url 2>/dev/null)";
	print -r -- "origin:  ${origin:-<none — not a git repo or no origin>}";
	acct="$(gh_account_for_cwd)";
	print -r -- "account: ${acct:-<no credential pin matched — gh runs as its active account>}";
	# Never echo the token itself — only whether it is set.
	print -r -- "env:     GH_TOKEN=$([[ -n $GH_TOKEN ]] && print -r -- '<set — gh ignores stored logins>' || print -r -- '<unset>')";
	print -r -- "pins:    $(command git config --get-regexp '^credential\.https://github\.com/.*\.username' 2>/dev/null | command sed 's|credential.https://github.com/||; s|\.username | -> |' | command paste -sd, - | command sed 's/,/, /g')";
	[[ -n $acct ]] || return 0;
	tok="$(command gh auth token --user "$acct" 2>/dev/null)";
	if [[ -z $tok ]]; then
		print -r -- "token:   NONE for '$acct' — run: gh auth login (as $acct); until then gh runs as the active account";
		return 0;
	fi;
	print -r -- "token:   present for '$acct'";
	who="$(GH_TOKEN=$tok command gh api user --jq .login 2>/dev/null)";
	if [[ -z $who ]]; then
		print -r -- "verify:  could not reach the API (offline?) — identity unverified";
	elif [[ ${(L)who} == ${(L)acct} ]]; then
		print -r -- "verify:  token authenticates as $who — OK";
	else
		print -r -- "verify:  MISMATCH — token for '$acct' authenticates as '$who'; re-run: gh auth login (as $acct)";
	fi;
}

# Diagnose what `git` itself would do right here — the third per-repo
# routing mechanism next to gh()/claude()/wrangler(): which commit identity
# the includeIf chain selects (and which file supplied it), whether signing
# is on and its signer/key actually exist, how the origin's SSH alias
# resolves, and which account https pushes would authenticate as. A wrong
# author email is the leak the private overlay's tests police after the
# fact; this shows it before the commit. Read-only, no network.
function git-doctor() {
	local origin acct name email src sign fmt key prog agent alias hostname idfile;
	print -r -- "defined: $(defined_trace gh_account_for_cwd git_origin_slug)";
	print -r -- "cwd:     $PWD";
	origin="$(command git config --get remote.origin.url 2>/dev/null)";
	print -r -- "origin:  ${origin:-<none — not a git repo or no origin>}";
	if command git rev-parse --git-dir >/dev/null 2>&1; then
		print -r -- "root:    $(command git rev-parse --show-toplevel 2>/dev/null)";
	fi;
	acct="$(gh_account_for_cwd)";
	print -r -- "account: ${acct:-<no credential pin matched>}";
	# Identity, with the file it came from — that is what shows whether the
	# includeIf for this remote fired.
	name="$(command git config --get user.name 2>/dev/null)";
	email="$(command git config --get user.email 2>/dev/null)";
	src="$(command git config --show-origin --get user.email 2>/dev/null)";
	src=${src%%	*}; src=${src#file:};
	if [[ -n $email ]]; then
		print -r -- "author:  ${name:-<no user.name>} <$email>";
		print -r -- "from:    ${src:-<unknown>}";
	else
		print -r -- "author:  NOT SET — no user.email in effect here (public-only clone, or no include matched this remote); git will refuse or guess";
	fi;
	# Signing: entirely machine-local (see CLAUDE.md), so report what is on
	# and whether the parts it points at exist.
	sign="$(command git config --get commit.gpgsign 2>/dev/null)";
	if [[ ${(L)sign} == true ]]; then
		fmt="$(command git config --get gpg.format 2>/dev/null)";
		key="$(command git config --get user.signingkey 2>/dev/null)";
		prog="$(command git config --get "gpg.${fmt:-openpgp}.program" 2>/dev/null)";
		[[ -n $prog ]] || prog="$(command git config --get gpg.program 2>/dev/null)";
		print -r -- "signing: on (format ${fmt:-openpgp}), key ${key:-<user.signingkey NOT SET>}";
		if [[ -n $key && $key == (\~|/)* && ! -e ${key/#\~/$HOME} ]]; then
			print -r -- "         WARNING: signing key file ${key} does not exist";
		fi;
		if [[ -n $prog ]]; then
			if [[ -x ${prog/#\~/$HOME} ]] || command -v "$prog" >/dev/null 2>&1; then
				print -r -- "signer:  $prog";
			else
				print -r -- "signer:  $prog — NOT FOUND (commits will fail; on a remote box, unset commit.gpgsign or forward the agent)";
			fi;
		fi;
	else
		print -r -- "signing: off";
	fi;
	# SSH: an scp-style origin's host part is often an alias picking the key;
	# show what ssh resolves it to (no connection made).
	if [[ -n $origin && $origin != *://* && $origin == *:* ]]; then
		alias=${origin%%:*}; alias=${alias#*@};
		if command -v ssh >/dev/null 2>&1; then
			local sshcfg;
			sshcfg="$(command ssh -G "$alias" 2>/dev/null)";
			hostname="$(print -r -- "$sshcfg" | command sed -n 's/^hostname //p' | command head -n1)";
			idfile="$(print -r -- "$sshcfg" | command sed -n 's/^identityfile //p' | command head -n1)";
			agent="$(print -r -- "$sshcfg" | command sed -n 's/^identityagent //p' | command head -n1)";
			agent=${agent/#$HOME/\~};
			print -r -- "ssh:     $alias -> ${hostname:-?}${idfile:+, key $idfile}${agent:+, agent $agent}";
		fi;
	elif [[ $origin == https://github.com/* ]]; then
		print -r -- "https:   pushes authenticate via credential helper as '${acct:-<active gh account>}'";
	fi;
	# The pre-commit identity gate (~/.git-hooks/pre-commit): is it installed
	# for this repo, and what would it decide about the identity above?
	local hooks expected;
	hooks="$(command git config --get core.hooksPath 2>/dev/null)";
	if [[ -z $hooks ]]; then
		print -r -- "gate:    OFF — core.hooksPath unset (no pre-commit identity check)";
	elif [[ ! -x ${hooks/#\~/$HOME}/pre-commit ]]; then
		print -r -- "gate:    OFF — core.hooksPath=$hooks has no executable pre-commit";
	elif [[ -z $acct ]]; then
		print -r -- "gate:    on, no opinion here (owner unpinned)";
	else
		local slug key;
		slug="$(git_origin_slug)";
		key="identity.$acct.email";
		expected="";
		[[ -n $slug ]] && expected="$(command git config --get-all "identity.$slug.email" 2>/dev/null | command paste -sd, - | command sed 's/,/, /g')";
		[[ -n $expected ]] && key="identity.$slug.email (per-repo pin)";
		[[ -n $expected ]] || expected="$(command git config --get-all "identity.$acct.email" 2>/dev/null | command paste -sd, - | command sed 's/,/, /g')";
		if [[ -z $expected ]]; then
			print -r -- "gate:    on, cannot verify — no identity.$acct.email declared for '$acct' (declare it in the overlay)";
		elif [[ -n $email && ", ${(L)expected}, " == *", ${(L)email}, "* ]]; then
			print -r -- "gate:    on — '$email' is an $key; commits pass";
		else
			print -r -- "gate:    on — WOULD REFUSE: '${email:-<no email>}' is not one of $key ($expected)";
		fi;
	fi;
	# Every config file consulted from here — the include chain made visible.
	print -r -- "configs: $(command git config --list --show-origin --name-only 2>/dev/null | command awk -F'\t' '$1 ~ /^file:/ {print substr($1, 6)}' | command awk '!seen[$0]++' | command paste -sd, - | command sed 's/,/, /g')";
}

# Where iTerm2 is installed, or nothing. $ITERM2_APP names a non-standard
# location and, when set, is used *exclusively* — an override that quietly
# fell back to /Applications would make every answer below a lie about a
# different app. Returns a path and never launches anything: every fact this
# doctor reports is read off disk.
function iterm2_app_path() {
	emulate -L zsh;
	local p;
	if [[ -n $ITERM2_APP ]]; then
		[[ -d $ITERM2_APP ]] && print -r -- "$ITERM2_APP";
		return;
	fi;
	for p in /Applications/iTerm.app "$HOME/Applications/iTerm.app"; do
		[[ -d $p ]] || continue;
		print -r -- "$p";
		return 0;
	done;
	return 1;
}

# An app bundle's marketing version, read off its Info.plist. This is the
# house rule for version lines — never execute the thing to ask it what it
# is — and here it is also the only correct source: iTerm2 updates itself
# through Sparkle, so Homebrew's Caskroom records the version it last
# installed, not the one on disk.
function iterm2_bundle_version() {
	emulate -L zsh;
	local app=$1 v;
	[[ -n $app && -r $app/Contents/Info.plist ]] || return 1;
	(( $+commands[defaults] )) || return 1;
	v="$(command defaults read "$app/Contents/Info" CFBundleShortVersionString 2>/dev/null)";
	[[ -n $v ]] || return 1;
	print -r -- "$v";
}

# One key from iTerm2's preference domain, rendered for a doctor line. Reads
# the domain, not a file, so a custom prefs folder resolves the way the app
# sees it. An absent key prints <unset> rather than nothing, because "the
# key is missing" and "the key is empty" mean different things here.
function iterm2_pref() {
	emulate -L zsh;
	local v;
	(( $+commands[defaults] )) || { print -r -- "$1=<no defaults(1)>"; return 0; };
	v="$(command defaults read com.googlecode.iterm2 "$1" 2>/dev/null)";
	print -r -- "$1=${v:-<unset>}";
}

# Diagnose the iTerm2 this machine actually has: the bundle and its version,
# whether that still matches the version the .claude/skills/iterm2 skill was
# researched against, which release channel Homebrew thinks it installed,
# the plugin bundles, and the handful of preferences that change how the app
# behaves at startup and towards scripts. Report-only — it reads plists and
# directory listings and never talks to a running iTerm2, so it is safe from
# inside one.
#
# The stamp is the point. A skill that describes an app is a claim about a
# version; when the app updates underneath it the claim silently rots. Here
# the drift is a line of output instead. The literal below mirrors the
# skill's own stamp and tests/iterm2-doctor.bats pins the two together, so
# refreshing one without the other fails the suite.
function iterm2-doctor() {
	emulate -L zsh;
	local stamp=3.6.11;
	local app ver skill c d v cmp;
	local -a chans vers plugs profiles autopy;
	print -r -- "defined: $(defined_trace iterm2_app_path iterm2_bundle_version iterm2_pref)";
	app="$(iterm2_app_path)";
	if [[ -z $app ]]; then
		print -r -- "app:     NOT INSTALLED — no iTerm.app in /Applications or ~/Applications$([[ $(uname) == Darwin ]] || print -r -- ' (macOS-only app)')";
		print -r -- "skill:   written against iTerm2 $stamp";
		return 0;
	fi;
	ver="$(iterm2_bundle_version "$app")";
	print -r -- "app:     $app (${ver:-<version unreadable>})";
	# Direction matters for what to do about a mismatch, so work it out with
	# zsh's own version comparison — but only after proving it loaded, or a
	# missing autoload would read as "older" and send you the wrong way.
	autoload -Uz is-at-least;
	if is-at-least 0 0 2>/dev/null; then
		is-at-least "$stamp" "$ver" && cmp=newer || cmp=older;
	fi;
	if [[ -z $ver ]]; then
		print -r -- "skill:   written against iTerm2 $stamp — installed version unreadable, cannot compare";
	elif [[ $ver == "$stamp" ]]; then
		print -r -- "skill:   written against iTerm2 $stamp — matches";
	elif [[ $cmp == older ]]; then
		print -r -- "skill:   written against iTerm2 $stamp — installed is $ver, which is OLDER; the skill may describe features this app does not have";
	else
		print -r -- "skill:   written against iTerm2 $stamp — installed is $ver; refresh it and check the changelog (see .claude/skills/iterm2/references/releases.md)";
	fi;
	# Which channel Homebrew last installed. Read straight out of the
	# Caskroom rather than by running brew: brew is slow, and the answer is
	# a directory name. A version here that trails the bundle above is
	# normal and expected — Sparkle updated the app in place.
	for c in iterm2 iterm2@beta iterm2@nightly; do
		for d in "$HOMEBREW_PREFIX/Caskroom" /opt/homebrew/Caskroom /usr/local/Caskroom; do
			[[ -n $d && -d $d/$c ]] || continue;
			vers=("$d"/"$c"/*(N/:t));
			chans+=("$c ${${(j:,:)vers}:-<no version dir>}");
			break;
		done;
	done;
	if (( ${#chans} )); then
		print -r -- "channel: ${(j:; :)chans} (Homebrew's record; iTerm2 self-updates via Sparkle, so the bundle version above wins)";
	else
		print -r -- "channel: no iterm2 cask in the Caskroom — installed by hand or by another manager";
	fi;
	# The generative-AI and browser features ship as separate bundles since
	# 3.5; their absence is why an AI menu item can be missing on an app that
	# otherwise looks current. They install alongside iTerm.app, so look
	# beside it and nowhere else — searching /Applications regardless would
	# report plugins for an app that is not the one named above.
	for c in iTermAI iTermBrowserPlugin; do
		d="${app:h}/$c.app";
		[[ -d $d ]] || continue;
		v="$(iterm2_bundle_version "$d")";
		plugs+=("$c ${v:-<version unreadable>}");
	done;
	print -r -- "plugins: ${${(j:, :)plugs}:-none installed (no iTermAI.app / iTermBrowserPlugin.app)}";
	print -r -- "prefs:   $(iterm2_pref LoadPrefsFromCustomFolder), $(iterm2_pref PrefsCustomFolder)";
	print -r -- "api:     $(iterm2_pref EnableAPIServer)";
	print -r -- "startup: $(iterm2_pref OpenNoWindowsAtStartup), $(iterm2_pref OpenArrangementAtStartup), $(iterm2_pref AlwaysOpenWindowAtStartup)";
	# Counts, never names: a dynamic profile or an autolaunch script is
	# usually named after the host or client it exists for.
	local support="$HOME/Library/Application Support/iTerm2";
	profiles=("$support"/DynamicProfiles/*(N.));
	autopy=("$support"/Scripts/AutoLaunch/**/*.py(N.));
	print -r -- "dynamic: ${#profiles} profile file(s) in ~/Library/Application Support/iTerm2/DynamicProfiles";
	print -r -- "scripts: AutoLaunch.scpt $([[ -e $support/Scripts/AutoLaunch.scpt ]] && print -r -- present || print -r -- absent), ${#autopy} AutoLaunch python script(s)";
	# Shell integration is opt-in and per-shell; without it the marks,
	# prompt navigation, and `is at shell prompt` all quietly do nothing.
	local -a si;
	si=("$HOME"/.iterm2_shell_integration.*(N.:e));
	print -r -- "integ:   ${${(j:, :)si}:-not installed (~/.iterm2_shell_integration.* absent)}; utilities $([[ -d $HOME/.iterm2 ]] && print -r -- "in ~/.iterm2" || print -r -- "only in the app bundle")";
	print -r -- "session: ${TERM_PROGRAM:-<TERM_PROGRAM unset>}${ITERM_SESSION_ID:+, ITERM_SESSION_ID set}";
	skill="${ITERM2_SKILL_DIR:-$HOME/code/dotfiles/.claude/skills/iterm2}";
	if [[ -x $skill/scripts/verify.sh ]]; then
		print -r -- "verify:  $skill/scripts/verify.sh re-checks every recorded fact against this app";
	else
		print -r -- "verify:  skill not found at $skill (set ITERM2_SKILL_DIR); its scripts/verify.sh is what re-checks the recorded facts";
	fi;
}

# Where the 1Password skill's version stamp lives. The skill is part of the
# dotfiles SOURCE (`.claude/` is dot-prefixed, so chezmoi never deploys it)
# while this function ships to ~/.functions, so the stamp has to be located
# rather than assumed. ONEPASSWORD_SKILL_STAMP wins — that is how a test or a
# worktree points at its own copy — then the source dir a mac pins, then
# chezmoi's own answer, which is the portable one and the only one that costs
# a process, so it goes last. Prints nothing and returns 1 when no stamp is
# reachable, which is simply the normal state on a box with no clone of the
# source; onepassword-doctor treats that as "unknown", never as a problem.
function onepassword_stamp_file() {
	emulate -L zsh;
	local rel=.claude/skills/onepassword/VERSIONS c src;
	local -a cands;
	[[ -n $ONEPASSWORD_SKILL_STAMP ]] && cands+=("$ONEPASSWORD_SKILL_STAMP");
	cands+=("$HOME/code/dotfiles/$rel");
	for c in "${cands[@]}"; do
		[[ -r $c ]] && { print -r -- "$c"; return 0; };
	done;
	if (( $+commands[chezmoi] )); then
		src="$(command chezmoi source-path 2>/dev/null)";
		[[ -n $src && -r $src/$rel ]] && { print -r -- "$src/$rel"; return 0; };
	fi;
	return 1;
}

# The 1Password desktop app's version, read out of its Info.plist — the app is
# never launched to be asked, the same rule the other doctors' `binary:` lines
# follow. Prints nothing where there is no app bundle (a Linux box, or a mac
# carrying only the CLI).
function onepassword_app_version() {
	emulate -L zsh;
	local plist=/Applications/1Password.app/Contents/Info.plist;
	[[ -r $plist ]] || return 1;
	command plutil -extract CFBundleShortVersionString raw -o - "$plist" 2>/dev/null;
}

# The op CLI's version without running op: bin_trace reads it off the resolved
# install path (Homebrew's cask parks it at .../Caskroom/1password-cli/<ver>/op),
# and a build whose path carries no version segment simply leaves this empty
# rather than executing the binary to find out.
function onepassword_cli_version() {
	emulate -L zsh;
	local bin out;
	bin="$(whence -p op)" || return 1;
	out="$(bin_trace "$bin")";
	[[ $out == *\(*\) ]] || return 1;
	print -r -- "${${out##*\(}%\)}";
}

# 1Password reaches this machine over three connections that fail
# independently, and the standing confusion is treating them as one:
#
#   1. the `op` CLI -> the desktop app, via ~/.config/op/op-daemon.sock,
#      gated by `op signin` and a session that lapses on its own;
#   2. ssh and git-over-ssh -> the SSH agent socket named by ~/.ssh/config's
#      IdentityAgent (on macOS inside the app's group container; on Linux
#      ~/.1password/agent.sock);
#   3. op-ssh-sign, the commit signer -> its own connection to the app.
#
# (3) is the one that catches people out. Verified on this machine:
# op-ssh-sign signs with SSH_AUTH_SOCK unset, at the launchd default, and
# pointed at a path that does not exist — it never reads the variable. So
# `ssh-add -l` listing keys is NOT evidence that a commit will sign, and a
# signed-out `op` is evidence about neither. That is exactly the shape of the
# "1Password: failed to fill whole buffer" signing failure: a short read on
# that third connection while every other indicator still looks healthy.
# `ssh-add` compounds it by never reading ssh_config at all — it speaks only
# to $SSH_AUTH_SOCK — which is why the `agent:` and `ssh-add:` lines below are
# reported separately instead of as one verdict.
#
# Read-only like every other doctor here: it starts nothing, signs nothing,
# unlocks nothing, and prints variable and file names but never a value.
# .claude/skills/onepassword/ in the dotfiles source holds the long form.
function onepassword-doctor() {
	emulate -L zsh;
	local bin app cli stamp sop sapp idagent keys routed;
	print -r -- "defined: $(defined_trace onepassword_stamp_file onepassword_app_version onepassword_cli_version bin_trace)";
	print -r -- "binary:  $(bin="$(whence -p op)" && bin_trace "$bin" || print -r -- 'NOT FOUND on PATH — install the 1password-cli cask')";
	app="$(onepassword_app_version)";
	if [[ -n $app ]]; then
		print -r -- "app:     /Applications/1Password.app ($app)";
	elif [[ "$(command uname 2>/dev/null)" == Darwin ]]; then
		print -r -- "app:     NOT INSTALLED — no /Applications/1Password.app; the CLI integration, the agent, and op-ssh-sign all need it";
	else
		print -r -- "app:     n/a — no macOS app bundle on this platform";
	fi;
	# Connection 1. `op whoami` is the cheapest read there is and never
	# prompts; it just reports that the session lapsed (exit 1).
	if (( $+commands[op] )); then
		if command op whoami >/dev/null 2>&1; then
			print -r -- "cli:     signed in";
		else
			print -r -- "cli:     NOT signed in — run: op signin (needs 1Password > Settings > Developer > 'Integrate with 1Password CLI')";
		fi;
	else
		print -r -- "cli:     no op on PATH";
	fi;
	# Connection 2, in two parts that are genuinely different questions.
	# What ssh will use comes from ssh's own config parsing, never a guess.
	if (( $+commands[ssh] )); then
		idagent="$(command ssh -G github.com 2>/dev/null | command sed -n 's/^identityagent //p' | command head -n1)";
	fi;
	if [[ -z $idagent ]]; then
		print -r -- "agent:   no IdentityAgent in ssh_config for github.com — ssh falls back to \$SSH_AUTH_SOCK";
	elif [[ -S $idagent ]]; then
		print -r -- "agent:   ${idagent/#$HOME/\~} (socket present)";
	else
		print -r -- "agent:   ${idagent/#$HOME/\~} — MISSING; start 1Password and turn on Settings > Developer > 'Use the SSH agent'";
	fi;
	# What `ssh-add` will use is $SSH_AUTH_SOCK and nothing else. Under
	# Claude Code's Bash tool that is the launchd agent, so "no identities"
	# here is routine and says nothing about ssh, git, or signing.
	print -r -- "env:     SSH_AUTH_SOCK=${SSH_AUTH_SOCK:-<unset>}";
	if (( $+commands[ssh-add] )); then
		keys="$(command ssh-add -l 2>&1)";
		if (( $? == 0 )); then
			print -r -- "ssh-add: $(print -r -- "$keys" | command grep -c .) key(s) offered by \$SSH_AUTH_SOCK (not necessarily the 1Password agent)";
		else
			print -r -- "ssh-add: none from \$SSH_AUTH_SOCK — expected unless it points at the agent above; ssh-add never reads ssh_config";
		fi;
	fi;
	# Connection 3. Existence only: running it would ask 1Password to sign.
	if [[ -x /Applications/1Password.app/Contents/MacOS/op-ssh-sign ]]; then
		print -r -- "signer:  /Applications/1Password.app/Contents/MacOS/op-ssh-sign (present — git-doctor says whether git is pointed at it)";
	elif [[ "$(command uname 2>/dev/null)" == Darwin ]]; then
		print -r -- "signer:  op-ssh-sign NOT FOUND in the app bundle — SSH signing cannot work here";
	else
		print -r -- "signer:  n/a — op-ssh-sign is macOS/Windows only; on a remote box set user.signingkey to the literal public key";
	fi;
	# ~/.extra is sourced by every shell, so a token there that one of the
	# per-repo wrappers routes overrides that routing everywhere (CLAUDE.md).
	# Names only — this must never print a value.
	if [[ -r $HOME/.extra ]]; then
		routed="$(command grep -oE '\b(GH_TOKEN|GITHUB_TOKEN|CLOUDFLARE_API_TOKEN|ANTHROPIC_API_KEY|CLAUDE_CONFIG_DIR)\b' "$HOME/.extra" 2>/dev/null | command sort -u | command paste -sd, - | command sed 's/,/, /g')";
		if [[ -n $routed ]]; then
			print -r -- "extra:   ~/.extra mentions ROUTED $routed — every shell sources it, so that outranks the per-repo wrappers; move it to the project's own op run --env-file";
		else
			print -r -- "extra:   ~/.extra present, no routed token names in it";
		fi;
	else
		print -r -- "extra:   ~/.extra absent (no personal overlay here)";
	fi;
	# Does the skill still describe the software that is installed? The
	# notes are worth what their currency is worth, so say when they drift.
	stamp="$(onepassword_stamp_file)";
	if [[ -z $stamp ]]; then
		print -r -- "skill:   no version stamp reachable — .claude/skills/onepassword/VERSIONS is not in the dotfiles source (no clone here, or a checkout predating the skill)";
		return 0;
	fi;
	sop="$(command awk '$1 == "op" {print $2; exit}' "$stamp" 2>/dev/null)";
	sapp="$(command awk '$1 == "app" {print $2; exit}' "$stamp" 2>/dev/null)";
	cli="$(onepassword_cli_version)"; : ${cli:=unknown}; : ${app:=unknown};
	if [[ $cli == "$sop" && $app == "$sapp" ]]; then
		print -r -- "skill:   written against op $sop / app $sapp — matches what is installed";
	else
		print -r -- "skill:   written against op $sop / app $sapp — installed is op $cli / app $app; refresh it (${stamp:h})";
	fi;
}

# For doctor: the calling shell's version and the non-default options that
# change how patterns, globs, and words behave — the context a pasted
# transcript otherwise lacks. Reads the CALLER's options: `setopt` lists
# deviations from the defaults, captured before this function emulates
# anything (under `emulate -L zsh` the picture would be the defaults'), so
# neither this nor doctor() may start with `emulate`. Claude Code's Bash
# tool sets CLAUDECODE and runs zsh with NO_BARE_GLOB_QUAL and friends —
# the shell that made every wrapped curl die until the tailnet functions
# learned to emulate their own options; those are unaffected now, but
# anything else sourced (~/.extra, overlay functions) still runs under
# whatever this reports.
function shell_trace() {
	local -a all opts;
	local o ia="" list;
	all=(${(f)"$(setopt)"});
	[[ -o interactive ]] && ia=", interactive";
	emulate -L zsh;
	for o in "${all[@]}"; do
		case $o in
			((no|)(bareglobqual|caseglob|casematch|extendedglob|glob|globassign|globdots|globstarshort|globsubst|ksharrays|kshglob|kshtypeset|magicequalsubst|nomatch|nullglob|cshnullglob|shglob|shwordsplit)) opts+=("$o");;
		esac;
	done;
	list="${(j: :)opts}";
	print -r -- "zsh $ZSH_VERSION$ia${CLAUDECODE:+, under Claude Code}, options: ${list:-none}${list:+ (the tailnet wrappers reset these with emulate -L zsh)}";
}

# Every routing and credential diagnosis for the cwd in one go — git
# identity, gh account, Claude Code profile, the terminal-tab launcher,
# wrangler profile, hermes profile, tailnet routing — plus the two that are
# not per-repo but underpin everything that is: 1Password, which git signing
# and ~/.extra rest on, so a machine-wide failure there surfaces as a
# per-repo one; and iterm2, the terminal all of the above run inside, whose
# version drifting past what the skill documents is exactly the kind of
# silent change this command exists to surface. Headed by the calling
# shell's version and pattern
# options (shell_trace; this function must not emulate, see there). First
# thing to run when a repo "behaves weird" on a machine.
function doctor() {
	local d;
	print -r -- "shell:   $(shell_trace)";
	print -r -- "";
	for d in git gh claude wrangler hermes tailnet workspace onepassword iterm2; do
		print -r -- "== $d-doctor";
		"$d-doctor";
		print -r -- "";
	done;
}

# Get macOS Software Updates, and update installed Ruby gems, Homebrew, npm, uv, and their installed packages
function update() {
	setopt localoptions nomonitor nonotify;

	# No-sudo work first. brew can't share an upfront sudo session
	# anyway: every brew invocation wipes the sudo timestamp (brew.sh
	# runs `sudo --reset-timestamp`), so sudo steps are clustered after
	# it behind a single prompt instead.
	# HOMEBREW_NO_ASK: brew >=4.5 "ask mode" prompts before upgrades
	# with dependencies; suppress it so the run is unattended. Casks
	# that install privileged helpers (e.g. docker-desktop) may still
	# prompt — brew resets the timestamp by design.
	command -v brew > /dev/null 2>&1 && { brew update; HOMEBREW_NO_ASK=1 brew upgrade; brew cleanup; };
	command -v npm > /dev/null 2>&1 && npm install npm -g;
	command -v npm > /dev/null 2>&1 && npm update -g;
	command -v uv > /dev/null 2>&1 && uv tool upgrade --all;

	# One password prompt for the rest; keep the sudo timestamp alive
	# until the updates finish (same pattern as ~/.macos). Disowned (&!):
	# the localoptions above are restored before the shell would report
	# the trap's kill, so a job-table entry prints "terminated" anyway.
	sudo -v || return;
	while true; do sudo -n true; sleep 60; kill -0 $$ 2>/dev/null || exit; done 2>/dev/null &!
	local keepalive_pid=$!;
	# Expand the PID now: by the time the trap fires the local is gone.
	trap "kill $keepalive_pid 2>/dev/null" EXIT;

	[[ $(uname) == Darwin ]] && sudo softwareupdate -i -a;
	# gem --version guards against version-manager shims with no ruby
	# selected (asdf prints an error for every gem call otherwise).
	if [[ $(which ruby) != /usr/bin/ruby ]] && gem --version > /dev/null 2>&1; then
		sudo gem update --system;
		sudo gem update;
		sudo gem cleanup;
	fi;
}
