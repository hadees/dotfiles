#!/bin/bash
# Installs/updates Homebrew packages whenever the Brewfile changes.
# Brewfile hash: {{ include "Brewfile" | sha256sum }}
set -e

if ! command -v brew > /dev/null 2>&1; then
	echo "Homebrew not installed — skipping brew bundle (install from https://brew.sh)";
	exit 0;
fi

# --no-upgrade: install what is missing, never upgrade. A bare `brew bundle`
# also upgrades, which re-downloads casks that update themselves (their
# Caskroom record only looks stale) and fails outright on a mas app or .pkg
# whose installer wants a password — and this script runs with no terminal to
# answer one. A failure here is recorded as a completed run by chezmoi, so the
# install would then never be retried. Upgrades belong to `update`.
brew bundle --no-upgrade --file={{ joinPath .chezmoi.sourceDir "Brewfile" | quote }}
