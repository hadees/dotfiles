#!/bin/sh
# shared-memory — adds the shared Claude memory's on-demand topics to a
# session when they apply.
#
# ~/.claude-shared/CLAUDE.md imports the topics every session needs and lists
# the rest. An import is loaded whether or not it is used, so the rest are
# added by hooks instead: `hook start` (SessionStart) for the topics about
# the kind of session this is, `hook main` (SessionStart too) for the topics
# only a main conversation needs (a subagent runs no SessionStart, so it never
# holds them), and `hook tool` (PostToolUse and
# PostToolUseFailure) for the topics about something that just went wrong or
# was just started: a commit that failed to sign, an ssh that could not
# connect, Claude in Chrome. Each profile's settings.json is owned by its
# overlay, so this script ships the block to paste (`settings`) and never
# edits one.
#
# Every `hook` route exits 0 and fails open: a broken hook must never block a
# session (there is deliberately no way to exit non-zero from one, and none
# may be added). A topic the index still imports is never added, so nothing
# is loaded twice. The log holds counts of what was added, never a session id,
# tool input or output, or topic text: the state directory is readable by
# every profile.
#
# Usage:
#   shared-memory topics [DIR]      one line per topic: slug, load class
#                                   (always|start|main|tool|pointer|unreachable),
#                                   listed in the index (yes|no|-); exits 1
#                                   unless every topic is imported or listed
#   shared-memory settings          the hooks block each overlay pastes
#   shared-memory hook start        SessionStart JSON on stdin; always exits 0
#   shared-memory hook main         SessionStart JSON on stdin; always exits 0
#   shared-memory hook tool         PostToolUse/PostToolUseFailure JSON on stdin; always exits 0
#   shared-memory log [--since DAYS]
# env:
#   SHARED_MEMORY_DIR          the memory directory (else ~/.claude-shared).
#   SHARED_MEMORY_CLAUDE_PEER  the claude-peer executable (else ~/bin/claude-peer).
#   CLAUDE_CONFIG_DIR          the profile directory (else $HOME/.claude).
#   XDG_STATE_HOME             where the log and the told files live.
set -eu

# A profile label and an event are all a log row needs from sh, so a session
# on a box without python3 still leaves a trace.
nopython() {
  np_dir=${XDG_STATE_HOME:-${HOME:-}/.local/state}/shared-memory
  np_cfg=${CLAUDE_CONFIG_DIR:-${HOME:-}/.claude}
  np_cfg=${np_cfg%/}
  mkdir -p "$np_dir" 2>/dev/null &&
    printf '%s\t%s\t%s\t-\tnopython\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${np_cfg##*/}" "$1" >>"$np_dir/injections.tsv" 2>/dev/null
  return 0
}

# The payload reaches python on fd 3 through an already-unlinked file, because
# python's stdin carries its program.
case "${1:-}" in
hook)
  [ -z "${MEMORYGUARD_DEPTH:-}" ] || exit 0
  case "${2:-}" in start | main | tool) ;; *) exit 0 ;; esac
  payload=$(cat) || exit 0
  # `hook tool` runs on every Bash call, so a payload that holds none of the
  # strings python could match (the SIGNING and CONNECT lists below, the
  # Claude in Chrome name, the WebFetch tool, and the peer, mail, gh and workboard commands) never starts python.
  # Keep these in step with them.
  if [ "$2" = tool ]; then
    case "$payload" in
    *"failed to fill whole buffer"* | *"failed to write commit object"* | *"op-ssh-sign"* | *"No SSH private key found"*) ;;
    *"Could not resolve host"* | *"Connection refused"* | *"Connection timed out"* | *"Operation timed out"* | *"No route to host"*) ;;
    *"Connection closed by"* | *"kex_exchange_identification"* | *"Failed to connect to"* | *"Couldn't connect to server"*) ;;
    *"Network is unreachable"* | *"SOCKS"* | *"claude-in-chrome"*) ;;
    *'"gh '* | *'"command gh '* | *"gh issue "* | *"workboard add"* | *"workboard take"* | *"workboard show"* | *"workboard list"* | *"claude-peer start"* | *"claude-peer stop"* | *"claude-peer log"* | *"am mail"* | *SendMessage* | *mcp__postbox__* | *WebFetch*) ;;
    *) exit 0 ;;
    esac
  fi
  command -v python3 >/dev/null 2>&1 || {
    nopython "$2"
    exit 0
  }
  tmp=$(mktemp "${TMPDIR:-/tmp}/shared-memory.XXXXXX") || exit 0
  trap 'rm -f "$tmp"' EXIT
  printf '%s' "$payload" >"$tmp" || exit 0
  exec 3<"$tmp"
  rm -f "$tmp"
  ;;
*)
  command -v python3 >/dev/null 2>&1 || {
    printf 'shared-memory: python3 not found\n' >&2
    exit 1
  }
  ;;
esac

rc=0
python3 -I - "$@" <<'PY' || rc=$?
import fcntl
import json
import os
import re
import signal
import stat
import subprocess
import sys
import time
from contextlib import contextmanager

# slug -> when it is added: at session start, or by a tool event (a later
# hook route). Every other topic file is imported by the index, or a pointer.
TRIGGERS = {
    "talking-to-sessions": "start",
    "claude-peers": "start",
    "peer-seat": "start",
    "lead": "start",
    "approvals": "start",
    "delegation-and-model-routing": "main",
    "peer-lifetime": "tool",
    "github-accounts": "tool",
    "issues": "tool",
    "issue-reading": "tool",
    "session-mail": "tool",
    "commit-signing": "tool",
    "tailnet-routed-ssh": "tool",
    "claude-in-chrome": "tool",
    "web-fetching": "tool",
}
# Claude Code caps one hook output at 10,000 characters and, over it, hands
# Claude a file path and a short preview instead. Stay under it.
INJECT_MAX = 9000
PEER_TIMEOUT = 3
TOLD_MAX_DAYS = 14
START_ORDER = ("talking-to-sessions", "claude-peers", "peer-seat", "lead", "approvals")
# Topics `hook main` adds to every main conversation, whatever its role.
MAIN_ORDER = ("delegation-and-model-routing",)
# What a failed commit signature and a failed connection print. "Could not
# resolve host" also covers "... hostname". The sh prefilter above repeats them.
SIGNING = ("failed to fill whole buffer", "failed to write commit object", "No SSH private key found")
# The signer's own name is in ordinary output too (git config -l, a diff), so
# it counts only from a failed tool call or beside a git error line.
SIGNER = "op-ssh-sign"
ERROR_LINE = re.compile(r"^\s*(error|fatal):", re.M)
CONNECT = ("Could not resolve hostname", "Could not resolve host", "Connection refused", "Connection timed out",
           "Operation timed out", "No route to host", "Connection closed by", "kex_exchange_identification",
           "Failed to connect to", "Couldn't connect to server", "Network is unreachable", "SOCKS")
NET_COMMAND = re.compile(r"(^|[;&|(\x60]\s*|\$\(\s*|\s)(ssh|scp|sftp|curl)(\s|$)")
CHROME_PREFIX = "mcp__claude-in-chrome__"
POSTBOX_PREFIX = "mcp__postbox__"
# What starts, stops or logs a peer's work, and what sends mail. The sh prefilter
# above repeats their literal parts.
PEER_COMMAND = re.compile(r"(^|[;&|(\x60]\s*|\$\(\s*|\s|/)claude-peer\s+(start|stop|log\s+(--as\s+\S+\s+)?(claim|note|done))(\s|$)")
MAIL_COMMAND = re.compile(r"(^|[;&|(\x60]\s*|\$\(\s*|\s|/)am\s+mail(\s|$)")
# A session's first `gh` command: the command starts with `gh ` or `command gh `.
GH_COMMAND = re.compile(r"^(command\s+)?gh\s")
# Writing or reading a GitHub issue, anywhere in the command line; the sh prefilter
# above repeats `gh issue ` and the `workboard` words.
ISSUE_WRITE = re.compile(r"(^|[;&|(\x60]\s*|\$\(\s*|\s|/)(gh\s+issue\s+(create|new|edit|comment)|workboard\s+add)(\s|$)")
ISSUE_READ = re.compile(r"(^|[;&|(\x60]\s*|\$\(\s*|\s|/)(gh\s+issue\s+(view|list|status|develop)|workboard\s+(take|show|list))(\s|$)")

HOME = os.environ.get("HOME", "")
DIR = os.environ.get("SHARED_MEMORY_DIR") or os.path.join(HOME, ".claude-shared")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local", "state"), "shared-memory")
LOG = os.path.join(STATE, "injections.tsv")
TOLD = os.path.join(STATE, "told")
DAY = 86400


def read_text(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except (OSError, UnicodeDecodeError):
        return ""


def import_re(slug):
    return re.compile(r"^@topics/%s\.md\s*$" % re.escape(slug))


def is_imported(index, slug):
    return any(import_re(slug).match(line) for line in index.split("\n"))


def is_listed(index, slug):
    # Named in backticks on a line that is not itself an import.
    needle = "`%s.md`" % slug
    return any(needle in line and not import_re(slug).match(line) for line in index.split("\n"))


def log_row(event, slug, outcome):
    try:
        cfg = (os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(HOME, ".claude")).rstrip("/")
        os.makedirs(STATE, exist_ok=True)
        stamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        with open(LOG, "a", encoding="utf-8") as f:
            f.write("\t".join((stamp, os.path.basename(cfg) or ".claude", event, slug, outcome)) + "\n")
    except OSError:
        pass


def cmd_topics(argv):
    if len(argv) > 1:
        return usage()
    root = argv[0] if argv else DIR
    tdir = os.path.join(root, "topics")
    if not os.path.isdir(tdir):
        sys.stderr.write("shared-memory: no topics directory at %s\n" % tdir)
        return 1
    index = read_text(os.path.join(root, "CLAUDE.md"))
    rc = 0
    for name in sorted(os.listdir(tdir)):
        if not name.endswith(".md"):
            continue
        slug = name[:-3]
        listed = "yes" if is_listed(index, slug) else "no"
        if is_imported(index, slug):
            load, listed = "always", "-"
        elif slug in TRIGGERS:
            load = TRIGGERS[slug]
        else:
            load = "pointer" if listed == "yes" else "unreachable"
        if listed == "no":
            rc = 1
        print("%s\t%s\t%s" % (slug, load, listed))
    return rc


def cmd_log(argv):
    cutoff = ""
    if argv:
        if len(argv) != 2 or argv[0] != "--since" or not argv[1].isdigit():
            return usage()
        cutoff = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() - int(argv[1]) * DAY))
    counts = {}
    for line in read_text(LOG).split("\n"):
        f = line.split("\t")
        if len(f) != 5 or f[0] < cutoff:
            continue
        counts[(f[4], f[3])] = counts.get((f[4], f[3]), 0) + 1
    for (outcome, slug), n in sorted(counts.items()):
        print("%s\t%s\t%d" % (outcome, slug, n))
    return 0


SETTINGS = """shared-memory does not edit settings.json — each profile's file is owned by
its overlay. Add these to that file's "hooks" (merging with what is there):

  "SessionStart": [
    { "hooks": [
      { "type": "command", "timeout": 10, "command": "[ -x ~/bin/shared-memory ] && exec ~/bin/shared-memory hook start || true" },
      { "type": "command", "timeout": 5, "command": "[ -x ~/bin/shared-memory ] && exec ~/bin/shared-memory hook main || true" }
    ] }
  ],
  "PostToolUse": [
    { "matcher": "Bash|Skill|SendMessage|WebFetch|mcp__claude-in-chrome__.*|mcp__postbox__.*",
      "hooks": [{ "type": "command", "timeout": 5, "command": "[ -x ~/bin/shared-memory ] && exec ~/bin/shared-memory hook tool || true" }] }
  ],
  "PostToolUseFailure": [
    { "matcher": "Bash|Skill|SendMessage|WebFetch|mcp__claude-in-chrome__.*|mcp__postbox__.*",
      "hooks": [{ "type": "command", "timeout": 5, "command": "[ -x ~/bin/shared-memory ] && exec ~/bin/shared-memory hook tool || true" }] }
  ]

SessionStart adds the messaging, Claude Peers, peer and Lead topics to a
session they apply to and, through `hook main`, the delegation rules to every
session (a subagent runs neither); the two tool events add the commit-signing,
tailnet, Claude in Chrome, peer lifetime, session mail, GitHub accounts, web
fetching and issues topics once per session when their trigger appears. Every entry fails open, and
a topic the shared index still imports is never added."""


def cmd_settings(argv):
    if argv:
        return usage()
    print(SETTINGS)
    return 0


def read_payload():
    try:
        with os.fdopen(3, encoding="utf-8") as f:
            payload = json.load(f)
    except (OSError, ValueError):
        return None
    return payload if isinstance(payload, dict) else None


def told_path(session_id):
    return os.path.join(TOLD, re.sub(r"[^A-Za-z0-9._-]", "_", session_id))


def lock_path(session_id):
    # "~" is outside the characters told_path keeps, so no session id can name it.
    return told_path(session_id) + "~lock"


@contextmanager
def told_lock(session_id):
    # Held from reading the told file to appending to it, so two hooks of one
    # session running at once do not both inject. Fails open: with no lock the
    # hook behaves as it did before.
    fd = None
    try:
        os.makedirs(TOLD, exist_ok=True)
        fd = os.open(lock_path(session_id), os.O_RDWR | os.O_CREAT, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX)
    except OSError:
        pass
    try:
        yield
    finally:
        if fd is not None:
            os.close(fd)


def tidy_told(payload):
    # A cleared or compacted session has lost what the tool events told it.
    # Housekeeping only: a failure here must not cost the injection.
    try:
        sid = payload.get("session_id")
        if payload.get("source") in ("clear", "compact") and isinstance(sid, str) and sid:
            for path in (told_path(sid), lock_path(sid)):
                if os.path.isfile(path):
                    os.remove(path)
        old = time.time() - TOLD_MAX_DAYS * DAY
        for name in os.listdir(TOLD) if os.path.isdir(TOLD) else ():
            path = os.path.join(TOLD, name)
            if os.path.isfile(path) and os.path.getmtime(path) < old:
                os.remove(path)
    except OSError:
        pass


def peers_here(payload):
    exe = os.environ.get("SHARED_MEMORY_CLAUDE_PEER") or os.path.join(HOME, "bin", "claude-peer")
    if not (os.path.isfile(exe) and os.access(exe, os.X_OK)):
        return False
    where = os.environ.get("CLAUDE_PROJECT_DIR", "")
    if not os.path.isdir(where):
        where = payload.get("cwd") if isinstance(payload.get("cwd"), str) else ""
    if not where:
        return False
    # Its own session, so a stub that outlives the timeout dies with its children.
    proc = subprocess.Popen([exe, "slots", where], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL, start_new_session=True)
    try:
        out, _ = proc.communicate(timeout=PEER_TIMEOUT)
    except subprocess.TimeoutExpired:
        os.killpg(proc.pid, signal.SIGKILL)
        proc.communicate()
        return False
    return bool(out.strip())


def postbox_wired():
    exe = os.path.join(HOME, "bin", "postbox")
    if not (os.path.isfile(exe) and os.access(exe, os.X_OK)):
        return False
    cfg = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(HOME, ".claude")
    return "postbox hook start" in read_text(os.path.join(cfg, "settings.json"))


def has_inbox():
    sock = os.environ.get("CLAUDE_CODE_MESSAGING_SOCKET", "")
    try:
        return bool(sock) and stat.S_ISSOCK(os.stat(sock).st_mode)
    except OSError:
        return False


def hook_start():
    payload = read_payload()
    if payload is None:
        return
    tidy_told(payload)
    title = payload.get("session_title")
    why = {
        "a Claude Peers tab": bool(os.environ.get("CLAUDE_PEER_WORKTREE")),
        "the Lead session": isinstance(title, str) and title.endswith("-lead"),
        "a repo with Claude Peers": peers_here(payload),
        "postbox wired": postbox_wired(),
        "a native inbox": has_inbox(),
    }
    flags = list(why.values())
    wanted = set()
    peer, lead = flags[0], flags[1]
    if any(flags[:3]):
        wanted.add("claude-peers")
    if peer:
        wanted.add("peer-seat")
    elif lead:
        wanted |= {"lead", "approvals"}
    if any(flags):
        wanted.add("talking-to-sessions")
    index = read_text(os.path.join(DIR, "CLAUDE.md"))
    slugs, texts = [], []
    for slug in START_ORDER:
        path = os.path.join(DIR, "topics", slug + ".md")
        if slug not in wanted or not os.path.isfile(path):
            continue
        if is_imported(index, slug):
            log_row("start", slug, "imported")
            continue
        slugs.append(slug)
        texts.append(read_text(path).rstrip())
    if not slugs:
        return
    header = "shared-memory: these shared-memory topics apply to this session (%s), so they are added here:" % ", ".join(k for k, v in why.items() if v)
    out, outcome = header + "\n\n" + "\n\n".join(texts), "injected"
    if len(out) > INJECT_MAX:
        out = header + "\n" + "\n".join("read ~/.claude-shared/topics/%s.md now: it applies to this session and is too long to add here." % s for s in slugs)
        outcome = "oversize"
    sys.stdout.write(out + "\n")
    sys.stdout.flush()
    for slug in slugs:
        log_row("start", slug, outcome)


def hook_main():
    payload = read_payload()
    if payload is None:
        return
    index = read_text(os.path.join(DIR, "CLAUDE.md"))
    slugs, texts = [], []
    for slug in MAIN_ORDER:
        path = os.path.join(DIR, "topics", slug + ".md")
        if not os.path.isfile(path):
            continue
        if is_imported(index, slug):
            log_row("main", slug, "imported")
            continue
        slugs.append(slug)
        texts.append(read_text(path).rstrip())
    if not slugs:
        return
    header = "shared-memory: these shared-memory topics apply to this session (a main conversation), so they are added here:"
    out, outcome = header + "\n\n" + "\n\n".join(texts), "injected"
    if len(out) > INJECT_MAX:
        out = header + "\n" + "\n".join("read ~/.claude-shared/topics/%s.md now: it applies to this session and is too long to add here." % s for s in slugs)
        outcome = "oversize"
    sys.stdout.write(out + "\n")
    sys.stdout.flush()
    for slug in slugs:
        log_row("main", slug, outcome)


def tool_text(payload):
    if payload.get("hook_event_name") == "PostToolUseFailure":
        err = payload.get("error")
        return err if isinstance(err, str) else ""
    resp = payload.get("tool_response")
    if isinstance(resp, dict):
        return "\n".join(v for v in (resp.get("stdout"), resp.get("stderr")) if isinstance(v, str))
    return resp if isinstance(resp, str) else ""


def tool_slugs(payload):
    name = payload.get("tool_name")
    args = payload.get("tool_input")
    args = args if isinstance(args, dict) else {}
    text = tool_text(payload)
    slugs = []
    if name == "Bash":
        cmd = args.get("command")
        failed = payload.get("hook_event_name") == "PostToolUseFailure"
        if any(s in text for s in SIGNING) or (SIGNER in text and (failed or ERROR_LINE.search(text))):
            slugs.append("commit-signing")
        if isinstance(cmd, str) and NET_COMMAND.search(cmd) and any(s in text for s in CONNECT):
            slugs.append("tailnet-routed-ssh")
        if isinstance(cmd, str) and PEER_COMMAND.search(cmd):
            slugs.append("peer-lifetime")
        if isinstance(cmd, str) and MAIL_COMMAND.search(cmd):
            slugs.append("session-mail")
        if isinstance(cmd, str) and GH_COMMAND.match(cmd):
            slugs.append("github-accounts")
        if isinstance(cmd, str) and ISSUE_WRITE.search(cmd):
            slugs.append("issues")
        if isinstance(cmd, str) and ISSUE_READ.search(cmd):
            slugs.append("issue-reading")
    if isinstance(name, str) and (name == "SendMessage" or name.startswith(POSTBOX_PREFIX)):
        slugs.append("session-mail")
    if name == "WebFetch":
        slugs.append("web-fetching")
    skill = args.get("skill")
    if (isinstance(name, str) and name.startswith(CHROME_PREFIX)) or (
            name == "Skill" and isinstance(skill, str) and (skill == "claude-in-chrome" or skill.endswith(":claude-in-chrome"))):
        slugs.append("claude-in-chrome")
    return slugs


def hook_tool():
    payload = read_payload()
    if payload is None:
        return
    event, sid = payload.get("hook_event_name"), payload.get("session_id")
    if event not in ("PostToolUse", "PostToolUseFailure") or not isinstance(sid, str) or not sid:
        return
    agent = payload.get("agent_id")
    who = re.sub(r"[^A-Za-z0-9._-]", "_", agent) if isinstance(agent, str) and agent else "main"
    with told_lock(sid):
        tell_tool(payload, event, sid, who)


def tell_tool(payload, event, sid, who):
    index = read_text(os.path.join(DIR, "CLAUDE.md"))
    path = told_path(sid)
    told = read_text(path).split("\n")
    slugs, texts = [], []
    for slug in tool_slugs(payload):
        topic = os.path.join(DIR, "topics", slug + ".md")
        if not os.path.isfile(topic):
            continue
        if is_imported(index, slug):
            log_row("tool", slug, "imported")
        elif "%s\t%s" % (who, slug) in told:
            log_row("tool", slug, "told")
        else:
            slugs.append(slug)
            texts.append(read_text(topic).rstrip())
    if not slugs:
        return
    ctx, outcome = "shared-memory: %s applies to what just happened; from the shared memory:\n\n%s" % (", ".join(slugs), "\n\n".join(texts)), "injected"
    if len(ctx) > INJECT_MAX:
        ctx = "shared-memory: %s applies to what just happened:\n%s" % (", ".join(slugs), "\n".join(
            "read ~/.claude-shared/topics/%s.md now: it applies to what just happened and is too long to add here." % s for s in slugs))
        outcome = "oversize"
    sys.stdout.write(json.dumps({"hookSpecificOutput": {"hookEventName": event, "additionalContext": ctx}}) + "\n")
    sys.stdout.flush()
    try:
        os.makedirs(TOLD, exist_ok=True)
        with open(path, "a", encoding="utf-8") as f:
            f.write("".join("%s\t%s\n" % (who, s) for s in slugs))
    except OSError:
        pass
    for slug in slugs:
        log_row("tool", slug, outcome)


def hook(argv):
    # Every route returns 0: a hook that fails must not block a session.
    if os.environ.get("MEMORYGUARD_DEPTH"):
        return 0
    try:
        if argv[:1] == ["start"]:
            hook_start()
        elif argv[:1] == ["main"]:
            hook_main()
        elif argv[:1] == ["tool"]:
            hook_tool()
    except BaseException:
        log_row(argv[0], "-", "error")
    return 0


def usage():
    sys.stderr.write(
        "usage: shared-memory topics [DIR]\n"
        "       shared-memory settings\n"
        "       shared-memory hook start|main|tool\n"
        "       shared-memory log [--since DAYS]\n")
    return 64


def main():
    cmds = {"topics": cmd_topics, "settings": cmd_settings, "hook": hook, "log": cmd_log}
    argv = sys.argv[1:]
    if not argv or argv[0] not in cmds:
        return usage()
    return cmds[argv[0]](argv[1:])


sys.exit(main())
PY
[ "${1:-}" = hook ] && exit 0
exit "$rc"
