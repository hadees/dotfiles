#!/bin/sh
# pane-sight — read and picture another iTerm2 pane, behind a scope gate.
#
# Usage:
#   pane-sight read <name> [--lines <n>]       also: pane-read <name> [--lines <n>]
#   pane-sight shot <name> [--out <file>]      also: pane-shot <name> [--out <file>]
#   pane-sight why  <name>                     resolution and verdict; asks the pane nothing
#   pane-sight list                            every pane it can name, with its verdict
#   pane-sight status [--line]
#
# Exit codes: 0 done; 1 failed; 2 usage or not macOS; 3 refused by scope; 4 no
# such pane, more than one, or a pane that cannot be addressed.
#
# A name is a claude-peer slot, a session name, a tabname label or a pid.
# Scope is decided on the pane's terminal before iTerm2 is asked for anything:
# a terminal that carries a Claude session of another profile is refused, a
# directory this profile's deny list covers is refused (denyguard), and a
# terminal with no session in a directory that routes to another profile is
# refused. Every doubt refuses. `why` and `list` print names, pids, directories
# and profile labels, never what a pane shows.
#
# The registry is every profile's `sessions/<pid>.json`, an observed layout as
# in claude-tab. `read` and `shot` are not built yet.
#
# Seams (tests): PANE_SIGHT_PEER, PANE_SIGHT_DENYGUARD, PANE_SIGHT_TABNAME,
# PANE_SIGHT_FUNCTIONS, PANE_SIGHT_ZSH, PANE_SIGHT_IT2, PANE_SIGHT_PYTHON,
# PANE_SIGHT_SUPPORT.

usage() { sed -n '/^# Usage:/,/^#$/{ /^#$/d; s/^# \{0,1\}//p; }' "$0" >&2; exit 2; }
say() { printf 'pane-sight: %s\n' "$*" >&2; }
fail4() { say "$*"; exit 4; }

TAB=$(printf '\t')
PEER=${PANE_SIGHT_PEER:-$HOME/bin/claude-peer}
DENY=${PANE_SIGHT_DENYGUARD:-$HOME/bin/denyguard}
TABNAME=${PANE_SIGHT_TABNAME:-$HOME/bin/tabname}
FUNCS=${PANE_SIGHT_FUNCTIONS:-$HOME/.functions}
ZSH=${PANE_SIGHT_ZSH:-zsh}
SUPPORT=${PANE_SIGHT_SUPPORT:-$HOME/Library/Application Support}
AUDIT_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/pane-sight
AUDIT=$AUDIT_DIR/audit.log

need_macos() {
  [ "$(uname -s 2>/dev/null)" = Darwin ] || { say "needs macOS: iTerm2 runs nowhere else"; exit 2; }
}

# --- profiles and the registry -------------------------------------------------

norm() { python3 -c 'import os,sys; print(os.path.normpath(os.path.expanduser(sys.argv[1])))' "$1"; }

# Every Claude profile directory that exists, one per line (as claude-tab).
profile_dirs() {
  { printf '%s\n' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
    printf '%s\n' "$HOME/.claude"
    git config --get-regexp '^claude\.profile\.' 2>/dev/null | cut -d' ' -f2-
  } | while IFS= read -r d; do
        [ -n "$d" ] || continue
        case $d in "~/"*) d="$HOME/${d#\~/}" ;; esac
        [ -d "$d" ] && printf '%s\n' "$d"
      done
}

profile_label() {
  b=$(basename "$1")
  case $b in
    .claude) printf 'default\n' ;;
    .claude-*) printf '%s\n' "${b#.claude-}" ;;
    *) printf '%s\n' "$b" ;;
  esac
}

# Live sessions of every profile: pid, profile dir, cwd, name ("-" for empty).
registry() {
  PANE_SIGHT_DIRS=$(profile_dirs) python3 - <<'REG'
import glob, json, os, re
def field(v):
    s = re.sub(r"[\t\r\n]", " ", str(v)).strip()
    return s if s else "-"
seen = set()
for d in os.environ.get("PANE_SIGHT_DIRS", "").split("\n"):
    d = os.path.normpath(d) if d else ""
    if not d or d in seen:
        continue
    seen.add(d)
    for f in sorted(glob.glob(os.path.join(d, "sessions", "*.json"))):
        if not re.fullmatch(r"\d+\.json", os.path.basename(f)):
            continue
        try:
            with open(f) as fh:
                r = json.load(fh)
            pid = r["pid"]
            if type(pid) is not int or pid <= 0:
                continue
            os.kill(pid, 0)
        except PermissionError:
            pass  # alive, just not ours
        except Exception:
            continue
        print("\t".join(field(x) for x in (pid, d, r.get("cwd"), r.get("name"))))
REG
}

# --- small readers ---------------------------------------------------------------

# /dev/<tty> of a pid; fails for a process with no terminal.
tty_of() {
  t=$(ps -o tty= -p "$1" 2>/dev/null | tr -d ' \t')
  case $t in ''|'?'|'??') return 1 ;; esac
  printf '/dev/%s\n' "${t#/dev/}"
}

# The last word of a process's environment that starts with <sed prefix>,
# the prefix removed. Only a claude process shows its environment to ps.
env_word() {
  ps -Eww -o command= -p "$1" 2>/dev/null | tr ' ' '\n' | sed -n "s/^$2//p" | tail -n 1
}

same_dir() { a=$(cd "$1" 2>/dev/null && pwd -P) && b=$(cd "$2" 2>/dev/null && pwd -P) && [ "$a" = "$b" ]; }

dir_label() { [ -x "$TABNAME" ] && "$TABNAME" "$1" 2>/dev/null </dev/null | sed -n 1p; }

# <slot> with its first letter upper-cased.
cap() { printf '%s' "$1" | awk '{ print toupper(substr($0, 1, 1)) substr($0, 2) }'; }

# Rows of $REG for the pids that own <tty>.
sessions_on() {
  p=$(ps -o pid= -t "${1#/dev/}" 2>/dev/null | awk '{ printf " %s", $1 } END { print " " }')
  printf '%s\n' "$REG" | awk -F'\t' -v p="$p" 'NF && index(p, " " $1 " ")'
}

# --- resolution --------------------------------------------------------------------

t_kind= t_label= t_sid= t_suite=- t_tty= t_dir= t_pid=-

# A session row (pid, profile dir, cwd, name) becomes the target.
session_target() { # <arg> <pid> <pdir> <cwd> <name>
  s_tty=$(tty_of "$2") || fail4 "$1 (pid $2) has no terminal"
  s_sid=$(env_word "$2" 'ITERM_SESSION_ID=[^:]*:')
  [ -n "$s_sid" ] || fail4 "pid $2 is not in an iTerm2 session pane-sight can address"
  s_suite=$(env_word "$2" 'IT2_SUITE=')
  s_lab=$(dir_label "$4")
  [ -n "$s_lab" ] || { [ "$5" != - ] && s_lab=$5; }
  [ -n "$s_lab" ] || s_lab=$(basename "$4")
  t_kind=session t_label=$s_lab t_sid=$s_sid t_suite=${s_suite:--} t_tty=$s_tty
  t_dir=$4 t_pid=$2
  [ "$t_dir" != - ] || t_dir=
}

# A claude-peer panes row (slot state pid leader worktree sid suite) becomes the target.
peer_target() { # <arg> <row>
  IFS=$TAB read -r p_slot p_state p_pid p_leader p_wt p_sid p_suite <<EOF_ROW
$2
EOF_ROW
  p_tty=$(tty_of "$p_pid") || fail4 "$1 (pid $p_pid) has no terminal"
  if [ "$p_state" = running ]; then
    p_lab=$("$TABNAME" --role "$p_wt" 2>/dev/null </dev/null | sed -n 1p | cut -f2)
    [ -n "$p_lab" ] || p_lab=$(cap "$p_slot")
    p_dir=$p_wt
  else
    p_lab=$(cap "$p_slot")
    p_dir=$p_leader
  fi
  if [ "$p_sid" = - ]; then
    [ "$p_state" = running ] || fail4 "$p_lab's pane has no recorded iTerm2 session (it was opened before claude-peer wrote one); reopen its tab"
    e_pid=$p_pid
    while IFS=$TAB read -r r_pid _ r_cwd _; do
      [ -n "$r_pid" ] && same_dir "$r_cwd" "$p_wt" && { e_pid=$r_pid; break; }
    done <<EOF_REG
$REG
EOF_REG
    p_sid=$(env_word "$e_pid" 'ITERM_SESSION_ID=[^:]*:')
    [ -n "$p_sid" ] || fail4 "pid $e_pid is not in an iTerm2 session pane-sight can address"
    p_suite=$(env_word "$e_pid" 'IT2_SUITE=')
  fi
  t_kind=peer-$p_state t_label=$p_lab t_sid=$p_sid t_suite=${p_suite:--} t_tty=$p_tty
  t_dir=$p_dir t_pid=$p_pid
}

# resolve <name>: sets t_*; otherwise prints the exit-4 line and exits 4.
resolve() {
  name=$1
  case $name in
    *[!0-9]*|'') ;;
    *)
      row=$(printf '%s\n' "$REG" | awk -F'\t' -v p="$name" '$1 == p')
      if [ -n "$row" ]; then
        IFS=$TAB read -r r_pid r_pdir r_cwd r_name <<EOF_ROW
$row
EOF_ROW
        session_target "$name" "$r_pid" "$r_pdir" "$r_cwd" "$r_name"
        return 0
      fi
      row=$(printf '%s\n' "$PANES" | awk -F'\t' -v p="$name" '$3 == p')
      [ -z "$row" ] || { peer_target "$name" "$(printf '%s\n' "$row" | sed -n 1p)"; return 0; }
      ;;
  esac

  rows=$(printf '%s\n' "$PANES" | awk -F'\t' -v n="$name" '$1 == n')
  if [ -n "$rows" ]; then
    run=$(printf '%s\n' "$rows" | awk -F'\t' '$2 == "running"')
    if [ -n "$run" ]; then
      [ "$(printf '%s\n' "$run" | wc -l)" -le 1 ] ||
        fail4 "$name names more than one running pane: pid $(printf '%s\n' "$run" | cut -f3 | paste -sd, - | sed 's/,/, /g')"
      peer_target "$name" "$run"
      return 0
    fi
    # Waiting panes: only those with a terminal, then the caller's own leader.
    live=$(printf '%s\n' "$rows" | while IFS=$TAB read -r sl st p l w si su; do
             tty_of "$p" >/dev/null && printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$sl" "$st" "$p" "$l" "$w" "$si" "$su"
           done)
    [ -n "$live" ] || fail4 "$name (pid $(printf '%s\n' "$rows" | sed -n 1p | cut -f3)) has no terminal"
    mine=$(printf '%s\n' "$live" | while IFS=$TAB read -r sl st p l w si su; do
             [ -n "$TOP" ] && same_dir "$l" "$TOP" && printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$sl" "$st" "$p" "$l" "$w" "$si" "$su"
           done)
    [ -z "$mine" ] || live=$mine
    [ "$(printf '%s\n' "$live" | wc -l)" -le 1 ] ||
      fail4 "$name names more than one waiting pane: pid $(printf '%s\n' "$live" | cut -f3 | paste -sd, - | sed 's/,/, /g')"
    peer_target "$name" "$live"
    return 0
  fi

  # A session by name or by its tabname label.
  hits=$(printf '%s\n' "$REG" | while IFS=$TAB read -r pid pdir cwd sname; do
           [ -n "$pid" ] || continue
           if [ "$sname" = "$name" ] || [ "$(dir_label "$cwd")" = "$name" ]; then
             printf '%s\t%s\t%s\t%s\n' "$pid" "$pdir" "$cwd" "$sname"
           fi
         done)
  if [ -n "$hits" ]; then
    [ "$(printf '%s\n' "$hits" | wc -l)" -le 1 ] ||
      fail4 "$name names more than one session: pid $(printf '%s\n' "$hits" | cut -f1 | paste -sd, - | sed 's/,/, /g')"
    IFS=$TAB read -r r_pid r_pdir r_cwd r_name <<EOF_ROW
$hits
EOF_ROW
    session_target "$name" "$r_pid" "$r_pdir" "$r_cwd" "$r_name"
    return 0
  fi
  fail4 "no pane named $name (pane-sight list)"
}

# --- scope ---------------------------------------------------------------------------

s_code= s_text= s_prof=-

# The profile `claude` would use in <dir>, asked of the wrapper's own resolver
# in a zsh of its own. Prints "same", or "other" and then the directory.
route_of() { # <dir>
  "$ZSH" -fc 'emulate -L zsh
    source "$1" 2>/dev/null || exit 3
    (( $+functions[claude_profile_dir] )) || exit 3
    cd -q -- "$2" 2>/dev/null || exit 3
    unset CLAUDE_PROFILE
    d=$(claude_profile_dir 2>/dev/null) || d=$HOME/.claude
    [[ -n $d ]] || d=$HOME/.claude
    if [[ ${d:a} == ${3:a} ]]; then print same; else print other; print -r -- ${d:a}; fi' \
    zsh "$FUNCS" "$1" "$CALLER" 2>/dev/null </dev/null
}

refuse() { s_code=$1 s_text="refused: $t_label: $2"; return 3; }

# scope: reads t_*; returns 0, or sets s_code and s_text and returns 3.
# Nothing here asks iTerm2 anything.
scope() {
  s_code= s_text= s_prof=-
  S=$(sessions_on "$t_tty")
  if [ -n "$S" ]; then
    s_prof=$(profile_label "$(printf '%s\n' "$S" | sed -n 1p | cut -f2)")
    other=$(printf '%s\n' "$S" | awk -F'\t' -v c="$CALLER" '$2 != c { print $2; exit }')
    if [ -n "$other" ]; then
      s_prof=$(profile_label "$other")
      refuse other-profile "its pane runs a Claude session of the $s_prof profile; this session is $OWN"
      return 3
    fi
    D=$(printf '%s\n' "$S" | cut -f3)
  else
    D=$t_dir
  fi
  [ -n "$D" ] || { refuse no-directory "cannot tell which directory its pane is in"; return 3; }
  while IFS= read -r d; do
    case $d in /*) ;; *) refuse no-directory "cannot tell which directory its pane is in"; return 3 ;; esac
    if [ -x "$DENY" ]; then "$DENY" check --profile "$CALLER" "$d" >/dev/null 2>&1 </dev/null; rc=$?; else rc=127; fi
    case $rc in
      0) ;;
      1) refuse denied "its directory is inside a deny rule of this profile"; return 3 ;;
      *) refuse deny-unknown "denyguard could not say whether its directory is allowed"; return 3 ;;
    esac
  done <<EOF_D
$D
EOF_D
  if [ -z "$S" ]; then
    ans=$(route_of "$t_dir") || ans=
    case $ans in
      same) ;;
      other*)
        refuse other-route "no Claude session runs there and its directory routes to the $(profile_label "$(printf '%s\n' "$ans" | sed -n 2p)") profile; this session is $OWN"
        return 3 ;;
      *) refuse route-unknown "could not ask which profile its directory routes to"; return 3 ;;
    esac
  fi
  return 0
}

# --- audit ---------------------------------------------------------------------------

# audit <verb> <result> <detail>: one row; non-zero when it could not be written.
audit() {
  c=$(printf '%s' "$t_label" | tr '\t\n\r' '   ')
  ( umask 077
    mkdir -p "$AUDIT_DIR" && chmod 700 "$AUDIT_DIR" &&
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" "$t_kind" "$c" \
      "${CLAUDE_CODE_SESSION_ID:--}" "$3" >> "$AUDIT" ) 2>/dev/null
}

# --- verbs ---------------------------------------------------------------------------

# init: the caller, its repository's panes, and the registry.
init() {
  CALLER=$(norm "${CLAUDE_CONFIG_DIR:-$HOME/.claude}")
  OWN=$(profile_label "$CALLER")
  TOP=$(git rev-parse --show-toplevel 2>/dev/null)
  PANES=
  [ -x "$PEER" ] && PANES=$("$PEER" panes 2>/dev/null </dev/null)
  REG=$(registry)
}

cmd_why() {
  [ $# -eq 1 ] || usage
  if printf '%s' "$1" | grep -Eiq '^(w[0-9]+t[0-9]+p[0-9]+[:.])?[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$'; then
    say "session ids are not built yet"; exit 2
  fi
  init
  resolve "$1"
  scope; rc=$?
  verdict=readable
  [ "$rc" -eq 0 ] || verdict="refused: $s_code"
  printf 'name\t%s\nkind\t%s\nlabel\t%s\npid\t%s\ntty\t%s\nsession\t%s\nsuite\t%s\ndir\t%s\nverdict\t%s\n' \
    "$1" "$t_kind" "$t_label" "$t_pid" "$t_tty" "$t_sid" "$t_suite" "${t_dir:--}" "$verdict"
  [ "$rc" -eq 0 ] || say "$s_text"
  exit "$rc"
}

# verdict_of <name>: "profile<TAB>verdict", never exits.
verdict_of() {
  v=$( ( resolve "$1" 2>/dev/null
         scope; rc=$?
         if [ "$rc" -eq 0 ]; then vv=readable; else vv="refused: $s_code"; fi
         printf '%s\t%s\n' "$s_prof" "$vv" ) )
  printf '%s\n' "${v:-$(printf -- '-\tunaddressable')}"
}

# shown <pid> <cwd>: does a peer row already show this session?
shown() {
  printf '%s\n' "$PANES" | awk -F'\t' -v p="$1" '$3 == p { f = 1 } END { exit !f }' && return 0
  printf '%s\n' "$PANES" | awk -F'\t' '$2 == "running" { print $5 }' |
    { while IFS= read -r w; do same_dir "$w" "$2" && exit 0; done; exit 1; }
}

cmd_list() {
  [ $# -eq 0 ] || usage
  init
  printf '%s\n' "$PANES" | while IFS=$TAB read -r sl st p l w _; do
    [ -n "$sl" ] || continue
    n=$sl
    [ "$(printf '%s\n' "$PANES" | awk -F'\t' -v s="$sl" '$1 == s' | wc -l)" -le 1 ] || n=$p
    printf '%s\tpeer-%s\t%s\t%s\n' "$n" "$st" "$p" "$(verdict_of "$n")"
  done
  printf '%s\n' "$REG" | while IFS=$TAB read -r pid pdir cwd sname; do
    [ -n "$pid" ] || continue
    shown "$pid" "$cwd" && continue
    n=$sname
    if [ "$n" = - ] || [ "$(printf '%s\n' "$REG" | awk -F'\t' -v s="$n" '$4 == s' | wc -l)" -gt 1 ]; then n=$pid; fi
    v=$(verdict_of "$pid")
    printf '%s\tsession\t%s\t%s\t%s\n' "$n" "$pid" "$(profile_label "$pdir")" "${v#*"$TAB"}"
  done
}

first_exe() { for f in "$@"; do [ -x "$f" ] && r=$f; done; printf '%s\n' "${r:-}"; }

cmd_status() {
  line=
  case ${1-} in --line) line=1; shift ;; esac
  [ $# -eq 0 ] || usage
  it2=${PANE_SIGHT_IT2:-}
  [ -n "$it2" ] || { it2=$HOME/.config/iterm2/it2; [ -x "$it2" ] || it2=/Applications/iTerm.app/Contents/Resources/utilities/it2; }
  [ -x "$it2" ] || it2=
  py=${PANE_SIGHT_PYTHON:-}
  [ -n "$py" ] || py=$(first_exe "$SUPPORT"/iTerm2/iterm2env/versions/*/bin/python3 "$SUPPORT"/iTerm2/uv/venvs/*/bin/python3)
  [ -x "$py" ] || py=
  api=off
  [ "$(defaults read com.googlecode.iterm2 EnableAPIServer 2>/dev/null)" = 1 ] && api=on
  dg=; [ -x "$DENY" ] && dg=$DENY
  rs=; zp=$(command -v "$ZSH" 2>/dev/null) && [ -r "$FUNCS" ] && rs="$zp $FUNCS"
  counts=$(awk -F'\t' '
    $2 == "read" && $3 == "ok" { r++ }  $2 == "shot" && $3 == "ok" { s++ }
    $3 ~ /^refused:/ { x++ }  $3 ~ /^failed:/ { f++ }
    END { printf "%d reads, %d shots, %d refused, %d failed", r, s, x, f }' "$AUDIT" 2>/dev/null) ||
    counts='0 reads, 0 shots, 0 refused, 0 failed'
  [ -n "$counts" ] || counts='0 reads, 0 shots, 0 refused, 0 failed'
  if [ -n "$line" ]; then
    missing=
    [ -n "$it2" ] || missing='it2 is missing'
    [ -n "$missing" ] || [ -n "$py" ] || missing='no Python runtime with the iterm2 library'
    [ -n "$missing" ] || [ "$api" = on ] || missing="iTerm2's API is off"
    [ -n "$missing" ] || [ -n "$dg" ] || missing='denyguard is missing'
    [ -n "$missing" ] || [ -n "$rs" ] || missing='the profile resolver is missing'
    if [ -n "$missing" ]; then printf 'not ready: %s\n' "$missing"
    else printf 'ready (%s)\n' "$(printf '%s' "$counts" | awk -F', ' '{ print $1 ", " $2 ", " $3 }')"; fi
    return 0
  fi
  printf 'it2:       %s\nruntime:   %s\napi:       %s\ndenyguard: %s\nresolver:  %s\naudit:     %s\n' \
    "${it2:-MISSING}" "${py:-MISSING}" "$api" "${dg:-MISSING}" "${rs:-MISSING}" "$counts"
}

# --- dispatch ------------------------------------------------------------------------

case ${0##*/} in
  pane-read) set -- read "$@" ;;
  pane-shot) set -- shot "$@" ;;
esac
[ $# -ge 1 ] || usage
verb=$1; shift
case $verb in
  read|shot|why|list|status) ;;
  *) usage ;;
esac
need_macos
case $verb in
  read|shot) say "$verb: not built yet"; exit 2 ;;
  why) cmd_why "$@" ;;
  list) cmd_list "$@" ;;
  status) cmd_status "$@" ;;
esac
