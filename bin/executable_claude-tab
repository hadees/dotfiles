#!/bin/sh
# claude-tab — list the live Claude Code sessions across every profile and
# bring the chosen one's iTerm2 tab forward.
#
# The sessions come from the registry every Claude profile keeps of its live
# ones, `<config dir>/sessions/<pid>.json` — an observed layout, not a
# documented interface; `claude_sessions_here` in .functions and `postbox`
# read the same files. A session's terminal is the controlling tty of its
# claude process, read with `ps`; iTerm2 is asked once which of its sessions
# own which tty, and the join is on that.
#
# The label is whatever `~/bin/tabname <cwd>` prints, so this list, the tab
# title and the Session Status row are one string and cannot drift. It is
# called by absolute path: Alfred runs scripts with a PATH that excludes
# ~/bin.
#
# Usage: claude-tab <command> [args]
#   list                     one row per live session, tab-separated: pid,
#                            profile, label, place, status, name, tty, where,
#                            window, title, cwd ("-" for empty)
#   tabs                     iTerm2's sessions: window, tty, title
#   focus <pid>              bring that session's iTerm2 tab forward
#   save [file]              write the live sessions to a file (default
#                            $XDG_STATE_HOME/claude-tab/saved.tsv; the old one
#                            becomes <file>.prev); peers and headless sessions
#                            are left out of it, and the running slot peers of
#                            the saved tabs go to <file>.peers
#   restore [--dry-run] [--window <id>] [--delay <seconds>] [--prompt <text>]
#           [--prompt-for <session id> <text>] [--no-peers] [--peer-wait <s>] [file]
#                            resume the saved sessions inside ONE existing
#                            window: empty tabs first, new tabs after, never a
#                            new window (macOS; --dry-run prints the plan).
#                            --prompt: given to every session that was not idle
#                            when saved (one line, no tab). --prompt-for: that
#                            text, to the one session with that id, idle or not;
#                            if it is still alive the text is typed into its own
#                            tab. --no-peers: do not restart the noted slot
#                            peers (claude-peer start --continue, retried up to
#                            --peer-wait seconds, default 60, while their pane
#                            is not waiting yet)
set -u

TAB=$(printf '\t')
TABNAME=${CLAUDE_TAB_TABNAME:-$HOME/bin/tabname}
PEERCMD=${CLAUDE_TAB_PEER:-$HOME/bin/claude-peer}
NL='
'
CR=$(printf '\r')
OSA_HINT="osascript could not drive iTerm2 — if macOS asked for Automation permission and was denied, grant it in System Settings > Privacy & Security > Automation"

die() { printf 'claude-tab: %s\n' "$*" >&2; exit 1; }
warn() { printf 'claude-tab: %s\n' "$*" >&2; }
usage() { sed -n '/^# Usage:/,/^set -u/{ /^set -u/d; s/^# \{0,1\}//p; }' "$0" >&2; exit 2; }

os() { uname -s 2>/dev/null; }
need_macos() {
  [ "$(os)" = Darwin ] || { warn "$1 needs macOS — iTerm2 runs nowhere else"; exit 2; }
}
need_python() { command -v python3 >/dev/null 2>&1 || die "python3 is required"; }

# `ps` rather than pgrep: pgrep reports nothing for processes in the caller's
# own session under some sandboxes (Claude Code's Bash tool is one — it cannot
# see the very iTerm2 it is running inside).
proc_running() {
  ps -Ao ucomm= 2>/dev/null |
    awk -v n="$1" '{ sub(/[ \t]+$/, "", $0); if ($0 == n) f = 1 } END { exit !f }'
}

# --- profiles and the registry -----------------------------------------------

# Every Claude profile directory that exists, one per line.
profile_dirs() {
  { printf '%s\n' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
    printf '%s\n' "$HOME/.claude"
    git config --get-regexp '^claude\.profile\.' 2>/dev/null | cut -d' ' -f2-
  } | while IFS= read -r d; do
        [ -n "$d" ] || continue
        case $d in "~/"*) d="$HOME/${d#\~/}" ;; esac
        [ -d "$d" ] && printf '%s\n' "$d"
      done | awk '!seen[$0]++'
}

profile_label() {
  case $(basename "$1") in
    .claude) printf 'default\n' ;;
    .claude-*) b=$(basename "$1"); printf '%s\n' "${b#.claude-}" ;;
    *) basename "$1" ;;
  esac
}

# Live records of every profile: pid, profile, name, status, cwd.
registry_rows() {
  profile_dirs | while IFS= read -r d; do
    [ -d "$d/sessions" ] || continue
    python3 - "$d" "$(profile_label "$d")" <<'REG'
import glob, json, os, re, sys
d, profile = sys.argv[1:3]
def field(v):
    s = re.sub(r"[\t\r\n]", " ", str(v)).strip()
    return s if s else "-"
for f in sorted(glob.glob(os.path.join(d, "sessions", "*.json"))):
    if not re.fullmatch(r"\d+\.json", os.path.basename(f)):
        continue
    try:
        with open(f) as fh:
            r = json.load(fh)
        pid = r["pid"]
        if type(pid) is not int or pid <= 0:
            continue
        os.kill(pid, 0)
    except PermissionError:
        pass  # alive, just not ours
    except Exception:
        continue
    print("\t".join(field(x) for x in (pid, profile, r.get("name"), r.get("status"), r.get("cwd"))))
REG
  done
}

# Live records of every profile for save/restore: pid, profile dir, session id,
# kind, cwd, name, status. A second reader so registry_rows keeps the five fields
# that list and focus parse.
registry_full() {
  profile_dirs | while IFS= read -r d; do
    [ -d "$d/sessions" ] || continue
    python3 - "$d" <<'REG'
import glob, json, os, re, sys
d = sys.argv[1]
def field(v):
    s = "" if v is None else re.sub(r"[\t\r\n]", " ", str(v)).strip()
    return s if s else "-"
for f in sorted(glob.glob(os.path.join(d, "sessions", "*.json"))):
    if not re.fullmatch(r"\d+\.json", os.path.basename(f)):
        continue
    try:
        with open(f) as fh:
            r = json.load(fh)
        pid = r["pid"]
        if type(pid) is not int or pid <= 0:
            continue
        os.kill(pid, 0)
    except PermissionError:
        pass  # alive, just not ours
    except Exception:
        continue
    print("\t".join(field(x) for x in (pid, d, r.get("sessionId"), r.get("kind"), r.get("cwd"), r.get("name"), r.get("status"))))
REG
  done
}

# --- pid -> tty --------------------------------------------------------------

# "/dev/<tty>" for a ps tty column, nothing for "no terminal" (macOS "??",
# Linux "?").
real_tty() {
  case ${1-} in ''|'?'|'??') ;; *) printf '/dev/%s\n' "$1" ;; esac
}

# The first real tty up the parent chain from pid $1, "-" if there is none.
# Read, never `set -- $line`: an unquoted "??" is a glob.
walk_tty() {
  p=$1 hops=0
  while [ "$hops" -lt 8 ] && [ -n "$p" ] && [ "$p" -gt 1 ] 2>/dev/null; do
    read -r pp tt <<EOF_PS
$(ps -o ppid=,tty= -p "$p" 2>/dev/null)
EOF_PS
    t=$(real_tty "${tt-}")
    [ -z "$t" ] || { printf '%s\n' "$t"; return; }
    p=${pp-}
    hops=$((hops + 1))
  done
  printf -- '-\n'
}

# pid, tty for the pids given. A claude process holds its tty itself; the
# parent walk is the fallback for one that does not.
tty_table() {
  [ $# -gt 0 ] || return 0
  ids=$(printf '%s,' "$@")
  ps -o pid=,ppid=,tty= -p "${ids%,}" 2>/dev/null | while read -r pid ppid tty; do
    [ -n "$pid" ] || continue
    t=$(real_tty "${tty-}")
    [ -n "$t" ] || t=$(walk_tty "${ppid-}")
    printf '%s\t%s\n' "$pid" "$t"
  done
}

# --- the label ---------------------------------------------------------------

init_tabname() {
  if [ -x "$TABNAME" ]; then have_tabname=1; else
    have_tabname=0
    warn "tabname not found at $TABNAME — labels fall back to directory names (chezmoi apply)"
  fi
}

# label <TAB> place for a directory: "-" at the toplevel, "subdir=<rel>" below
# it, "nogit" when tabname declines (not a work tree, or the directory is
# gone), "nolabel" when there is no tabname to ask.
label_of() {
  if [ "$have_tabname" != 1 ]; then
    printf '%s\t%s\n' "$(basename "$1")" nolabel
  elif l=$("$TABNAME" "$1" 2>/dev/null) && [ -n "$l" ]; then
    pre=$(git -C "$1" rev-parse --show-prefix 2>/dev/null)
    case $pre in
      '') printf '%s\t-\n' "$l" ;;
      *) printf '%s\tsubdir=%s\n' "$l" "${pre%/}" ;;
    esac
  else
    printf '%s\tnogit\n' "$(basename "$1")"
  fi
}

# --- iTerm2 ------------------------------------------------------------------

as_string() { printf '%s' "${1-}" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# Read-only: window id, tty and name of every iTerm2 session. `index of t`
# is not read — it fails coercion inside `repeat with` (-1700).
tabs_script() {
  cat <<'APPLESCRIPT'
set out to ""
-- The word tab inside a tell to iTerm2 is its tab class, not a tab character.
set sep to (character id 9)
tell application "iTerm2"
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        set out to out & (id of w) & sep & (tty of s) & sep & (name of s) & linefeed
      end repeat
    end repeat
  end repeat
end tell
return out
APPLESCRIPT
}

# Session, then tab, then window, then the app: `select` on a session makes it
# the tab's active pane, on a tab is selectTabViewItemWithIdentifier:, on a
# window is setCurrentTerminal: (makeKeyAndOrderFront: when it is not key) —
# PTYTab+Scripting.m, iTermWindowScriptingImpl.m — and `activate` (Standard
# Suite) brings iTerm2 itself forward. Only iTerm2 is addressed, so the one
# Automation grant is Alfred -> iTerm2.
focus_script() {
  cat <<APPLESCRIPT
tell application "iTerm2"
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        if (tty of s) is "$(as_string "$1")" then
          select s
          select t
          select w
          activate
          return "ok"
        end if
      end repeat
    end repeat
  end repeat
end tell
return ""
APPLESCRIPT
}

# Read-only, for restore: window id, tab ordinal (own counter — `index of t`
# fails inside `repeat with`), sessions in the tab, tty, and 1 when the window
# is the current one.
restore_tabs_script() {
  cat <<'APPLESCRIPT'
-- restore: window, tab, sessions in tab, tty, current
set out to ""
set sep to (character id 9)
tell application "iTerm2"
  set cw to 0
  try
    set cw to (id of current window)
  end try
  repeat with w in windows
    set ti to 0
    repeat with t in tabs of w
      set ti to ti + 1
      set n to (count of sessions of t)
      repeat with s in sessions of t
        set cur to 0
        if (id of w) is cw then set cur to 1
        set out to out & (id of w) & sep & ti & sep & n & sep & (tty of s) & sep & cur & linefeed
      end repeat
    end repeat
  end repeat
end tell
return out
APPLESCRIPT
}

# Type $3 into the session on tty $2 of window $1. `write text`, never a tab
# command: the login shell must run it, so the `claude` wrapper does.
fill_script() {
  cat <<APPLESCRIPT
tell application "iTerm2"
  set w to (first window whose id is $1)
  repeat with t in tabs of w
    repeat with s in sessions of t
      if (tty of s) is "$(as_string "$2")" then
        tell s to write text "$(as_string "$3")"
        return "ok"
      end if
    end repeat
  end repeat
end tell
return ""
APPLESCRIPT
}

# Type $2 into the session on tty $1, in whichever window it is.
tell_script() {
  cat <<APPLESCRIPT
tell application "iTerm2"
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        if (tty of s) is "$(as_string "$1")" then
          tell s to write text "$(as_string "$2")"
          return "ok"
        end if
      end repeat
    end repeat
  end repeat
end tell
return ""
APPLESCRIPT
}

# A new tab in window $1 (never a new window), $2 typed into it.
newtab_script() {
  cat <<APPLESCRIPT
tell application "iTerm2"
  set w to (first window whose id is $1)
  tell w
    set t to (create tab with default profile)
  end tell
  tell current session of t to write text "$(as_string "$2")"
  return "ok"
end tell
APPLESCRIPT
}

run_script() { # applescript on stdin
  s=$(cat)
  i=0
  while : ; do
    if out=$(printf '%s\n' "$s" | osascript - 2>&1); then
      [ -n "$out" ] && printf '%s\n' "$out"
      return 0
    fi
    i=$((i + 1))
    [ "$i" -ge 3 ] && break
    sleep 1
  done
  printf '%s\n' "$out" >&2
  return 1
}

# --- commands ----------------------------------------------------------------

cmd_tabs() {
  { [ "$(os)" = Darwin ] && proc_running iTerm2; } || return 0
  out=$(tabs_script | osascript - 2>&1) || { printf '%s\n' "$out" >&2; return 1; }
  [ -z "$out" ] || printf '%s\n' "$out"
}

cmd_focus() {
  need_macos focus
  case ${1-} in ''|*[!0-9]*) usage;; esac
  pid=$1
  need_python
  registry_rows | awk -F'\t' -v p="$pid" '$1 == p { f = 1 } END { exit !f }' ||
    die "no live session with pid $pid"
  tty=$(tty_table "$pid" | cut -f2)
  { [ -n "$tty" ] && [ "$tty" != - ]; } || die "pid $pid has no terminal (headless)"
  proc_running iTerm2 || die "iTerm2 is not running"
  out=$(focus_script "$tty" | run_script) ||
    die "$OSA_HINT"
  [ "$out" = ok ] || die "pid $pid is on $tty, which is not an iTerm2 tab"
}

cmd_list() {
  need_python
  rows=$(registry_rows)
  [ -n "$rows" ] || return 0
  init_tabname
  # shellcheck disable=SC2046
  ttys=$(tty_table $(printf '%s\n' "$rows" | cut -f1))
  # One listing per call, not per row; "unknown" when there is none to join.
  tabs='' listed=0
  if [ "$(os)" = Darwin ] && proc_running iTerm2; then
    tabs=$(cmd_tabs 2>/dev/null) && listed=1
  fi
  printf '%s\n' "$rows" | while IFS=$TAB read -r pid profile name status cwd; do
    tty=$(printf '%s\n' "$ttys" | awk -F'\t' -v p="$pid" '$1 == p { print $2; exit }')
    [ -n "$tty" ] || tty=-
    where=unknown win=- title=-
    if [ "$tty" = - ]; then
      where=headless
    elif [ "$listed" = 1 ]; then
      where=other
      hit=$(printf '%s\n' "$tabs" | awk -F'\t' -v t="$tty" '$2 == t { print; exit }')
      if [ -n "$hit" ]; then
        where=iterm2
        IFS=$TAB read -r win _ title <<EOF_HIT
$hit
EOF_HIT
        title=$(printf '%s' "${title-}" | tr '\t' ' ')
        [ -n "$title" ] || title=-
      fi
    fi
    lp=$(label_of "$cwd")
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$pid" "$profile" "${lp%"$TAB"*}" "${lp##*"$TAB"}" "$status" "$name" "$tty" "$where" "$win" "$title" "$cwd"
  done | LC_ALL=C sort -t"$TAB" -k3,3 -k1,1n
}

# Single-quoted for a POSIX shell.
sq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# Is the directory a peer worktree? claude-peer knows; without it there are no peers.
is_peer() {
  [ -x "$PEERCMD" ] || return 1
  phys=$(cd "$1" 2>/dev/null && pwd -P) || phys=$1
  "$PEERCMD" peers "$1" 2>/dev/null </dev/null | cut -f1 | grep -Fxq -e "$1" -e "$phys"
}

# Is the tty sitting at a bare shell prompt? At least one foreground process,
# every one of them a shell (a pane whose process ended has none).
tty_idle() {
  ps -o stat=,ucomm= -t "${1#/dev/}" 2>/dev/null | awk '
    $1 ~ /\+/ { n++; if ($2 !~ /^-?(zsh|bash|fish)$/ && $2 != "login") bad = 1 }
    END { exit !(n > 0 && !bad) }'
}

DEFAULT_SAVED=${XDG_STATE_HOME:-$HOME/.local/state}/claude-tab/saved.tsv

cmd_save() {
  need_python
  [ $# -le 1 ] || usage
  file=${1:-$DEFAULT_SAVED}
  rows=$(registry_full)
  if [ -n "$rows" ]; then
    init_tabname
    # shellcheck disable=SC2046
    ttys=$(tty_table $(printf '%s\n' "$rows" | cut -f1))
    tabs='' listed=0
    if [ "$(os)" = Darwin ] && proc_running iTerm2; then
      tabs=$(cmd_tabs 2>/dev/null) && listed=1
    fi
  fi
  kept='' n=0 n_peer=0 n_head=0 n_other=0
  while IFS=$TAB read -r pid pdir sid kind cwd name st; do
    [ -n "$pid" ] || continue
    tty=$(printf '%s\n' "$ttys" | awk -F'\t' -v p="$pid" '$1 == p { print $2; exit }')
    if [ -z "$tty" ] || [ "$tty" = - ]; then n_head=$((n_head + 1)); continue; fi
    case $kind in -|interactive) ;; *) n_other=$((n_other + 1)); continue;; esac
    case $sid in -|*[!A-Za-z0-9_-]*) n_other=$((n_other + 1)); continue;; esac
    [ -d "$cwd" ] || { n_other=$((n_other + 1)); continue; }
    if is_peer "$cwd"; then n_peer=$((n_peer + 1)); continue; fi
    where=- win=- idx=999999
    if [ "$listed" = 1 ]; then
      where=other
      hit=$(printf '%s\n' "$tabs" | awk -F'\t' -v t="$tty" '$2 == t { print NR "\t" $1; exit }')
      if [ -n "$hit" ]; then where=iterm2 idx=${hit%%"$TAB"*} win=${hit#*"$TAB"}; fi
    fi
    lp=$(label_of "$cwd" </dev/null)
    label=${lp%"$TAB"*}
    # sort key (tab order in iTerm2, then label), then the row
    kept="$kept$(printf '%06d\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' "$idx" "$label" \
      "$pdir" "$sid" "$cwd" "$label" "$name" "$tty" "$where" "$win" "$st")$NL"
    n=$((n + 1))
  done <<EOF_ROWS
$rows
EOF_ROWS
  left="$n_peer peers, $n_head headless, $n_other other"
  if [ "$n" -eq 0 ]; then
    warn "no sessions to save (left out: $left); $file left untouched"
    return 1
  fi
  mkdir -p "$(dirname "$file")" || die "cannot create $(dirname "$file")"
  [ ! -e "$file" ] || mv -f "$file" "$file.prev" || die "cannot rotate $file"
  [ ! -e "$file.peers" ] || mv -f "$file.peers" "$file.peers.prev" || die "cannot rotate $file.peers"
  # Running slot peers of each saved tab's directory: cwd<TAB>slot. Overlay peers
  # never show in the leader's `slots`, so they are not noted.
  peers=''
  if [ -x "$PEERCMD" ]; then
    while IFS= read -r c; do
      [ -n "$c" ] || continue
      phys=$(cd "$c" 2>/dev/null && pwd -P) || phys=$c
      found=$("$PEERCMD" slots "$c" 2>/dev/null </dev/null |
        C=$c P=$phys awk -F'\t' '$2 == "running" && ($5 == ENVIRON["C"] || $5 == ENVIRON["P"]) { print ENVIRON["C"] "\t" $1 }')
      [ -z "$found" ] || peers="$peers$found$NL"
    done <<EOF_CWDS
$(printf '%s' "$kept" | cut -f5 | awk '!seen[$0]++')
EOF_CWDS
  fi
  {
    printf '# claude-tab save %s %s sessions\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$n"
    printf '%s' "$kept" | LC_ALL=C sort -t"$TAB" -k1,1n -k2,2 | cut -f3-
  } > "$file" || die "cannot write $file"
  warn "saved $n sessions to $file (left out: $left)"
  if [ -n "$peers" ]; then
    printf '%s' "$peers" > "$file.peers" || die "cannot write $file.peers"
    warn "noted $(printf '%s' "$peers" | grep -c .) running peers in $file.peers"
  fi
}

# A prompt is one non-empty line: it is typed into a shell and a session.
one_line() { case $1 in ''|*"$NL"*|*"$TAB"*|*"$CR"*) usage;; esac; }

cmd_restore() {
  need_macos restore
  dry=0 win='' delay=3 file='' ptext='' pfor='' pfor_text='' nopeers=0 peerwait=60
  while [ $# -gt 0 ]; do
    case $1 in
      --dry-run) dry=1;;
      --window) [ $# -ge 2 ] || usage; win=$2; shift;;
      --delay) [ $# -ge 2 ] || usage; delay=$2; shift;;
      --prompt) [ $# -ge 2 ] || usage; ptext=$2; one_line "$ptext"; shift;;
      --prompt-for) [ $# -ge 3 ] || usage; pfor=$2 pfor_text=$3; one_line "$pfor_text"
        case $pfor in ''|*[!A-Za-z0-9_-]*) usage;; esac; shift 2;;
      --no-peers) nopeers=1;;
      --peer-wait) [ $# -ge 2 ] || usage; peerwait=$2; shift;;
      -*) usage;;
      *) [ -z "$file" ] || usage; file=$1;;
    esac
    shift
  done
  case $delay in ''|*[!0-9.]*|.*|*.*.*) usage;; esac
  case $win in *[!0-9]*) usage;; esac
  case $peerwait in ''|*[!0-9]*) usage;; esac
  file=${file:-$DEFAULT_SAVED}
  [ -s "$file" ] || die "no saved sessions at $file (claude-tab save)"
  need_python
  proc_running iTerm2 || die "iTerm2 is not running"
  listing=$(restore_tabs_script | run_script) || die "$OSA_HINT"
  [ -n "$win" ] || win=$(printf '%s\n' "$listing" | awk -F'\t' '$5 == 1 { print $1; exit }')
  [ -n "$win" ] || die "no iTerm2 window to restore into (open one, or pass --window)"

  # Empty tabs: one session, not the one running this, sitting at a shell.
  own=$(walk_tty "$$")
  empty='' other_empty=0
  while IFS=$TAB read -r w _ cnt tty _; do
    [ "$cnt" = 1 ] && [ "$tty" != "$own" ] && tty_idle "$tty" || continue
    if [ "$w" = "$win" ]; then empty="$empty$tty$NL"; else other_empty=$((other_empty + 1)); fi
  done <<EOF_TABS
$listing
EOF_TABS

  live=$(registry_full)
  plan='' f=0 n=0 s=0
  while IFS=$TAB read -r profile sid cwd label _ _ _ _ st; do
    case $profile in ''|'#'*) continue;; esac
    cmd=- tty=-
    if printf '%s\n' "$live" | P=$profile S=$sid C=$cwd awk -F'\t' \
        '$2 == ENVIRON["P"] && ($3 == ENVIRON["S"] || $5 == ENVIRON["C"]) { f = 1 } END { exit !f }'; then
      act=skip:live
      # The session that asked for the relaunch is still alive: nothing else would
      # wake it, so its text goes into its own tab. No other live row is touched.
      if [ -n "$pfor" ] && [ "$sid" = "$pfor" ]; then
        lpid=$(printf '%s\n' "$live" | P=$profile S=$sid awk -F'\t' \
          '$2 == ENVIRON["P"] && $3 == ENVIRON["S"] { print $1; exit }')
        if [ -n "$lpid" ]; then
          ltty=$(tty_table "$lpid" | cut -f2)
          if [ -n "$ltty" ] && [ "$ltty" != - ]; then act=tell tty=$ltty cmd=$pfor_text; fi
        fi
      fi
    elif [ ! -d "$cwd" ]; then act=skip:cwd-gone
    elif [ ! -d "$profile" ]; then act=skip:profile-gone
    else
      case $sid in ''|-|*[!A-Za-z0-9_-]*) act=skip:bad-id;; *) act='' ;; esac
    fi
    if [ -z "${act-}" ]; then
      cmd="cd -- $(sq "$cwd") && CLAUDE_PROFILE=$(sq "$profile") claude --resume $sid"
      if [ -n "$pfor" ] && [ "$sid" = "$pfor" ]; then cmd="$cmd $(sq "$pfor_text")"
      elif [ -n "$ptext" ] && [ "${st-}" != idle ]; then cmd="$cmd $(sq "$ptext")"; fi
      if [ -n "$empty" ]; then
        act=fill tty=${empty%%"$NL"*} empty=${empty#*"$NL"} f=$((f + 1))
      else
        act=new n=$((n + 1))
      fi
    else
      s=$((s + 1))
    fi
    plan="$plan$act$TAB$tty$TAB$label$TAB$cmd$NL"
    act=''
  done < "$file"
  if [ "$dry" = 1 ]; then
    printf '%s' "$plan"
    if [ "$nopeers" = 0 ] && [ -s "$file.peers" ]; then
      while IFS=$TAB read -r pleader pslot; do
        [ -n "$pleader" ] && [ -n "$pslot" ] && printf 'peer\t-\t%s\t%s\n' "$pslot" "$pleader"
      done < "$file.peers"
    fi
    return 0
  fi

  first=1
  while IFS=$TAB read -r act tty label cmd; do
    case $act in fill|new|tell) ;; *) continue;; esac
    [ "$first" = 1 ] || sleep "$delay"
    first=0
    case $act in
      fill) scr=$(fill_script "$win" "$tty" "$cmd");;
      new) scr=$(newtab_script "$win" "$cmd");;
      tell) scr=$(tell_script "$tty" "$cmd");;
    esac
    out=$(printf '%s\n' "$scr" | run_script) || die "$OSA_HINT"
    if [ "$act" = tell ]; then
      if [ "$out" = ok ]; then warn "told the live session $label in its tab"
      else warn "$tty is no longer a tab; could not tell the live session $label"; fi
    elif [ "$out" != ok ]; then
      warn "$tty is no longer a tab of window $win; skipped $label"
      if [ "$act" = fill ]; then f=$((f - 1)); else n=$((n - 1)); fi
      s=$((s + 1))
    fi
  done <<EOF_PLAN
$plan
EOF_PLAN
  warn "restored $f into empty tabs, $n in new tabs, $s skipped; $other_empty empty tabs in other windows left alone"

  # Peers last: their panes reappear waiting once the leader's claude has entered
  # its workgroup, which the typed commands above only just started.
  if [ "$nopeers" = 0 ] && [ -s "$file.peers" ]; then
    pk_s=0 pk_a=0 pk_f=0
    while IFS=$TAB read -r pleader pslot; do
      [ -n "$pleader" ] && [ -n "$pslot" ] || continue
      waited=0
      while :; do
        ( cd "$pleader" && "$PEERCMD" start "$pslot" --continue ${ptext:+-- "$ptext"} ) >/dev/null 2>&1 </dev/null
        case $? in
          0) pk_s=$((pk_s + 1)); break;;
          3) pk_a=$((pk_a + 1)); break;;
          4) if [ "$waited" -ge "$peerwait" ]; then pk_f=$((pk_f + 1)); break; fi
             sleep 2; waited=$((waited + 2));;
          *) pk_f=$((pk_f + 1)); break;;
        esac
      done
    done < "$file.peers"
    warn "peers: $pk_s started, $pk_a already running, $pk_f not started"
  fi
}

# --- dispatch ----------------------------------------------------------------

[ $# -ge 1 ] || usage
cmd=$1
shift
case $cmd in
  list)      cmd_list;;
  tabs)      cmd_tabs;;
  focus)     cmd_focus "$@";;
  save)      cmd_save "$@";;
  restore)   cmd_restore "$@";;
  -h|--help|help) usage;;
  *)         die "unknown command '$cmd' (claude-tab help)";;
esac
