#!/bin/sh
# claude-tab — list the live Claude Code sessions across every profile and
# bring the chosen one's iTerm2 tab forward.
#
# The sessions come from the registry every Claude profile keeps of its live
# ones, `<config dir>/sessions/<pid>.json` — an observed layout, not a
# documented interface; `claude_sessions_here` in .functions and `postbox`
# read the same files. A session's terminal is the controlling tty of its
# claude process, read with `ps`; iTerm2 is asked once which of its sessions
# own which tty, and the join is on that.
#
# The label is whatever `~/bin/tabname <cwd>` prints, so this list, the tab
# title and the Session Status row are one string and cannot drift. It is
# called by absolute path: Alfred runs scripts with a PATH that excludes
# ~/bin.
#
# Usage: claude-tab <command> [args]
#   list                     one row per live session, tab-separated: pid,
#                            profile, label, place, status, name, tty, where,
#                            window, title, cwd ("-" for empty)
#   attention                one row per session waiting on you, longest wait
#                            first, tab-separated: pid, profile, label,
#                            waited seconds, reason, tty, where, iTerm2 session
#                            guid, cwd ("-" for empty; nothing when none waits)
#   next [--dry-run]         go to the session that has waited longest: its tab
#                            when it is in front, else swapped in (it2), else
#                            the tab of a visible member of its workgroup
#                            (macOS; exit 3 when nobody waits). --dry-run
#                            prints label, where, guid and goes nowhere
#   alfred                   the attention rows as Alfred Script Filter JSON
#                            (title label, subtitle reason, wait, profile,
#                            arg pid; one "Nobody is waiting" row when none)
#   tabs                     iTerm2's sessions: window, tty, title
#   focus <pid>              bring that session's iTerm2 tab forward (a buried
#                            workgroup peer is swapped in, or its group shown)
#   save [file]              write the live sessions to a file (default
#                            $XDG_STATE_HOME/claude-tab/saved.tsv; the old one
#                            becomes <file>.prev); peers and headless sessions
#                            are left out of it, and the running slot peers of
#                            the saved tabs go to <file>.peers
#   restore [--dry-run] [--window <id>] [--delay <seconds>] [--prompt <text>]
#           [--prompt-for <session id> <text>] [--no-peers] [--peer-wait <s>] [file]
#                            resume the saved sessions inside ONE existing
#                            window: empty tabs first, new tabs after, never a
#                            new window (macOS; --dry-run prints the plan).
#                            --prompt: given to every session that was not idle
#                            when saved (one line, no tab). --prompt-for: that
#                            text, to the one session with that id, idle or not;
#                            if it is still alive the text is typed into its own
#                            tab. --no-peers: do not restart the noted slot
#                            peers (claude-peer start --continue, retried up to
#                            --peer-wait seconds, default 60, while their pane
#                            is not waiting yet)
#   panel tick [--state <file>] [--now <epoch>] [--focus <tty>|-|?]
#                            one pass of the needs-you list: reads the registry
#                            of every profile, updates the state file, prints
#                            the snapshot as one line of JSON (--focus: the tty
#                            in front, - for none, ? for unknown)
set -u

TAB=$(printf '\t')
TABNAME=${CLAUDE_TAB_TABNAME:-$HOME/bin/tabname}
PEERCMD=${CLAUDE_TAB_PEER:-$HOME/bin/claude-peer}
IT2=${CLAUDE_TAB_IT2:-$HOME/.config/iterm2/it2}
NL='
'
CR=$(printf '\r')
OSA_HINT="osascript could not drive iTerm2 — if macOS asked for Automation permission and was denied, grant it in System Settings > Privacy & Security > Automation"

die() { printf 'claude-tab: %s\n' "$*" >&2; exit 1; }
warn() { printf 'claude-tab: %s\n' "$*" >&2; }
usage() { sed -n '/^# Usage:/,/^set -u/{ /^set -u/d; s/^# \{0,1\}//p; }' "$0" >&2; exit 2; }

os() { uname -s 2>/dev/null; }
need_macos() {
  [ "$(os)" = Darwin ] || { warn "$1 needs macOS — iTerm2 runs nowhere else"; exit 2; }
}
need_python() { command -v python3 >/dev/null 2>&1 || die "python3 is required"; }

# `ps` rather than pgrep: pgrep reports nothing for processes in the caller's
# own session under some sandboxes (Claude Code's Bash tool is one — it cannot
# see the very iTerm2 it is running inside).
proc_running() {
  ps -Ao ucomm= 2>/dev/null |
    awk -v n="$1" '{ sub(/[ \t]+$/, "", $0); if ($0 == n) f = 1 } END { exit !f }'
}

# --- profiles and the registry -----------------------------------------------

# Every Claude profile directory that exists, one per line. SAVED_PROFILES (restore
# sets it) adds the directories a saved file names, for a runner whose environment
# no longer says where an unpinned profile lives.
profile_dirs() {
  { printf '%s\n' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
    printf '%s\n' "$HOME/.claude"
    printf '%s\n' "${SAVED_PROFILES-}"
    git config --get-regexp '^claude\.profile\.' 2>/dev/null | cut -d' ' -f2-
  } | while IFS= read -r d; do
        [ -n "$d" ] || continue
        case $d in "~/"*) d="$HOME/${d#\~/}" ;; esac
        [ -d "$d" ] && printf '%s\n' "$d"
      done | awk '!seen[$0]++'
}

profile_label() {
  case $(basename "$1") in
    .claude) printf 'default\n' ;;
    .claude-*) b=$(basename "$1"); printf '%s\n' "${b#.claude-}" ;;
    *) basename "$1" ;;
  esac
}

# Live records of every profile: pid, profile, name, status, cwd.
registry_rows() {
  profile_dirs | while IFS= read -r d; do
    [ -d "$d/sessions" ] || continue
    python3 - "$d" "$(profile_label "$d")" <<'REG'
import glob, json, os, re, sys
d, profile = sys.argv[1:3]
def field(v):
    s = re.sub(r"[\t\r\n]", " ", str(v)).strip()
    return s if s else "-"
for f in sorted(glob.glob(os.path.join(d, "sessions", "*.json"))):
    if not re.fullmatch(r"\d+\.json", os.path.basename(f)):
        continue
    try:
        with open(f) as fh:
            r = json.load(fh)
        pid = r["pid"]
        if type(pid) is not int or pid <= 0:
            continue
        os.kill(pid, 0)
    except PermissionError:
        pass  # alive, just not ours
    except Exception:
        continue
    print("\t".join(field(x) for x in (pid, profile, r.get("name"), r.get("status"), r.get("cwd"))))
REG
  done
}

# Live records of every profile for save/restore: pid, profile dir, session id,
# kind, cwd, name, status. A second reader so registry_rows keeps the five fields
# that list and focus parse.
registry_full() {
  profile_dirs | while IFS= read -r d; do
    [ -d "$d/sessions" ] || continue
    python3 - "$d" <<'REG'
import glob, json, os, re, sys
d = sys.argv[1]
def field(v):
    s = "" if v is None else re.sub(r"[\t\r\n]", " ", str(v)).strip()
    return s if s else "-"
for f in sorted(glob.glob(os.path.join(d, "sessions", "*.json"))):
    if not re.fullmatch(r"\d+\.json", os.path.basename(f)):
        continue
    try:
        with open(f) as fh:
            r = json.load(fh)
        pid = r["pid"]
        if type(pid) is not int or pid <= 0:
            continue
        os.kill(pid, 0)
    except PermissionError:
        pass  # alive, just not ours
    except Exception:
        continue
    print("\t".join(field(x) for x in (pid, d, r.get("sessionId"), r.get("kind"), r.get("cwd"), r.get("name"), r.get("status"))))
REG
  done
}

# Live records of every profile that are waiting on the user: pid, profile,
# since (statusUpdatedAt, epoch ms; 0 when missing or not a number), reason
# (waitingFor), cwd. A third reader, for the same reason as registry_full.
registry_waiting() {
  profile_dirs | while IFS= read -r d; do
    [ -d "$d/sessions" ] || continue
    python3 - "$d" "$(profile_label "$d")" <<'REG'
import glob, json, os, re, sys
d, profile = sys.argv[1:3]
def field(v):
    s = "" if v is None else re.sub(r"[\t\r\n]", " ", str(v)).strip()
    return s if s else "-"
for f in sorted(glob.glob(os.path.join(d, "sessions", "*.json"))):
    if not re.fullmatch(r"\d+\.json", os.path.basename(f)):
        continue
    try:
        with open(f) as fh:
            r = json.load(fh)
        pid = r["pid"]
        if type(pid) is not int or pid <= 0:
            continue
        os.kill(pid, 0)
    except PermissionError:
        pass  # alive, just not ours
    except Exception:
        continue
    if r.get("status") != "waiting":
        continue
    since = r.get("statusUpdatedAt")
    since = int(since) if type(since) in (int, float) and since > 0 else 0
    print("\t".join(field(x) for x in (pid, profile, since, r.get("waitingFor"), r.get("cwd"))))
REG
  done
}

# --- pid -> tty --------------------------------------------------------------

# "/dev/<tty>" for a ps tty column, nothing for "no terminal" (macOS "??",
# Linux "?").
real_tty() {
  case ${1-} in ''|'?'|'??') ;; *) printf '/dev/%s\n' "$1" ;; esac
}

# The first real tty up the parent chain from pid $1, "-" if there is none.
# Read, never `set -- $line`: an unquoted "??" is a glob.
walk_tty() {
  p=$1 hops=0
  while [ "$hops" -lt 8 ] && [ -n "$p" ] && [ "$p" -gt 1 ] 2>/dev/null; do
    read -r pp tt <<EOF_PS
$(ps -o ppid=,tty= -p "$p" 2>/dev/null)
EOF_PS
    t=$(real_tty "${tt-}")
    [ -z "$t" ] || { printf '%s\n' "$t"; return; }
    p=${pp-}
    hops=$((hops + 1))
  done
  printf -- '-\n'
}

# pid, tty for the pids given. A claude process holds its tty itself; the
# parent walk is the fallback for one that does not.
tty_table() {
  [ $# -gt 0 ] || return 0
  ids=$(printf '%s,' "$@")
  ps -o pid=,ppid=,tty= -p "${ids%,}" 2>/dev/null | while read -r pid ppid tty; do
    [ -n "$pid" ] || continue
    t=$(real_tty "${tty-}")
    [ -n "$t" ] || t=$(walk_tty "${ppid-}")
    printf '%s\t%s\n' "$pid" "$t"
  done
}

# The iTerm2 session GUID of process $1, from the ITERM_SESSION_ID in its
# start-up environment (w0t0p0:<guid>); "-" when it has none.
guid_of() {
  g=$(ps eww -o command= -p "$1" 2>/dev/null |
    awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^ITERM_SESSION_ID=/) { sub(/^[^:]*:/, "", $i); print $i; exit } }')
  printf '%s\n' "${g:--}"
}

# --- the label ---------------------------------------------------------------

init_tabname() {
  if [ -x "$TABNAME" ]; then have_tabname=1; else
    have_tabname=0
    warn "tabname not found at $TABNAME — labels fall back to directory names (chezmoi apply)"
  fi
}

# label <TAB> place for a directory: "-" at the toplevel, "subdir=<rel>" below
# it, "nogit" when tabname declines (not a work tree, or the directory is
# gone), "nolabel" when there is no tabname to ask.
label_of() {
  if [ "$have_tabname" != 1 ]; then
    printf '%s\t%s\n' "$(basename "$1")" nolabel
  elif l=$("$TABNAME" "$1" 2>/dev/null) && [ -n "$l" ]; then
    pre=$(git -C "$1" rev-parse --show-prefix 2>/dev/null)
    case $pre in
      '') printf '%s\t-\n' "$l" ;;
      *) printf '%s\tsubdir=%s\n' "$l" "${pre%/}" ;;
    esac
  else
    printf '%s\tnogit\n' "$(basename "$1")"
  fi
}

# --- iTerm2 ------------------------------------------------------------------

as_string() { printf '%s' "${1-}" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# Read-only: window id, tty and name of every iTerm2 session. `index of t`
# is not read — it fails coercion inside `repeat with` (-1700).
tabs_script() {
  cat <<'APPLESCRIPT'
set out to ""
-- The word tab inside a tell to iTerm2 is its tab class, not a tab character.
set sep to (character id 9)
tell application "iTerm2"
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        set out to out & (id of w) & sep & (tty of s) & sep & (name of s) & linefeed
      end repeat
    end repeat
  end repeat
end tell
return out
APPLESCRIPT
}

# Session, then tab, then window, then the app: `select` on a session makes it
# the tab's active pane, on a tab is selectTabViewItemWithIdentifier:, on a
# window is setCurrentTerminal: (makeKeyAndOrderFront: when it is not key) —
# PTYTab+Scripting.m, iTermWindowScriptingImpl.m — and `activate` (Standard
# Suite) brings iTerm2 itself forward. Only iTerm2 is addressed, so the one
# Automation grant is Alfred -> iTerm2.
focus_script() {
  cat <<APPLESCRIPT
tell application "iTerm2"
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        if (tty of s) is "$(as_string "$1")" then
          select s
          select t
          select w
          activate
          return "ok"
        end if
      end repeat
    end repeat
  end repeat
end tell
return ""
APPLESCRIPT
}

# Read-only, for restore: window id, tab ordinal (own counter — `index of t`
# fails inside `repeat with`), sessions in the tab, tty, and 1 when the window
# is the current one.
restore_tabs_script() {
  cat <<'APPLESCRIPT'
-- restore: window, tab, sessions in tab, tty, current
set out to ""
set sep to (character id 9)
tell application "iTerm2"
  set cw to 0
  try
    set cw to (id of current window)
  end try
  repeat with w in windows
    set ti to 0
    repeat with t in tabs of w
      set ti to ti + 1
      set n to (count of sessions of t)
      repeat with s in sessions of t
        set cur to 0
        if (id of w) is cw then set cur to 1
        set out to out & (id of w) & sep & ti & sep & n & sep & (tty of s) & sep & cur & linefeed
      end repeat
    end repeat
  end repeat
end tell
return out
APPLESCRIPT
}

# Type $3 into the session on tty $2 of window $1. `write text`, never a tab
# command: the login shell must run it, so the `claude` wrapper does.
fill_script() {
  cat <<APPLESCRIPT
tell application "iTerm2"
  set w to (first window whose id is $1)
  repeat with t in tabs of w
    repeat with s in sessions of t
      if (tty of s) is "$(as_string "$2")" then
        tell s to write text "$(as_string "$3")"
        return "ok"
      end if
    end repeat
  end repeat
end tell
return ""
APPLESCRIPT
}

# Type $2 into the session on tty $1, in whichever window it is.
tell_script() {
  cat <<APPLESCRIPT
tell application "iTerm2"
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        if (tty of s) is "$(as_string "$1")" then
          tell s to write text "$(as_string "$2")"
          return "ok"
        end if
      end repeat
    end repeat
  end repeat
end tell
return ""
APPLESCRIPT
}

# A new tab in window $1 (never a new window), $2 typed into it.
newtab_script() {
  cat <<APPLESCRIPT
tell application "iTerm2"
  set w to (first window whose id is $1)
  tell w
    set t to (create tab with default profile)
  end tell
  tell current session of t to write text "$(as_string "$2")"
  return "ok"
end tell
APPLESCRIPT
}

run_script() { # applescript on stdin
  s=$(cat)
  i=0
  while : ; do
    if out=$(printf '%s\n' "$s" | osascript - 2>&1); then
      [ -n "$out" ] && printf '%s\n' "$out"
      return 0
    fi
    i=$((i + 1))
    [ "$i" -ge 3 ] && break
    sleep 1
  done
  printf '%s\n' "$out" >&2
  return 1
}

# `it2 session focus <guid>`, five seconds at most (no `timeout` on macOS; python3
# is needed anyway). A fresh API cookie is exported, a stale or absent one is not
# (a wrong cookie is worse than none): the shim's clause, cc-status-shim.md.
it2_focus() {
  [ -x "$IT2" ] || return 1
  (
    ck=$HOME/.local/state/iterm2/api-cookie
    if [ -z "${ITERM2_COOKIE-}" ] && [ -r "$ck" ] && [ "$ck" -nt "$HOME/Library/Application Support/iTerm2/private/socket" ]; then
      read -r c k < "$ck"
      [ -z "${k-}" ] || { ITERM2_COOKIE=$c ITERM2_KEY=$k; export ITERM2_COOKIE ITERM2_KEY; }
    fi
    exec python3 -I -c 'import subprocess, sys
try:
    sys.exit(subprocess.run([sys.argv[1], "session", "focus", sys.argv[2]], stdin=subprocess.DEVNULL,
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5).returncode)
except subprocess.TimeoutExpired:
    sys.exit(124)' "$IT2" "$1"
  )
}

# The tty of the first member of the workgroup of directory $1 that sits in a
# visible iTerm2 tab, nothing when none does. The leader is the claim's, else the
# directory itself (a buried Lead); the members are the leader and its peers.
group_tty() {
  gt_leader=''
  if [ -x "$PEERCMD" ]; then
    gt_leader=$("$PEERCMD" claim "$1" 2>/dev/null </dev/null | awk -F'\t' '$1 == "leader" { print $2; exit }')
  fi
  [ -n "$gt_leader" ] || gt_leader=$1
  gt_members=$gt_leader
  if [ -x "$PEERCMD" ]; then
    gt_members=$gt_leader$NL$("$PEERCMD" peers --leader "$gt_leader" "$gt_leader" 2>/dev/null </dev/null | cut -f1)
  fi
  gt_list=$(cmd_list </dev/null)
  printf '%s\n' "$gt_members" | while IFS= read -r m; do
    [ -n "$m" ] || continue
    printf '%s\n' "$gt_list" | M=$m awk -F'\t' '$8 == "iterm2" && $11 == ENVIRON["M"] { print $7; f = 1; exit } END { exit !f }' && break
  done
}

# Bring session <pid> forward; FOCUS_ROUTE says how: tab (its own tab is in
# front), swap (buried, `it2 session focus` took it), group (buried, a visible
# member of its workgroup came forward instead). Returns 1 with one line when
# none applies. <where> is list's: "other" is a buried one, so its tab is not tried.
focus_session() { # pid tty where guid cwd
  fs_pid=$1 fs_tty=$2 fs_where=$3 fs_guid=$4 fs_cwd=$5
  FOCUS_ROUTE=''
  { [ -n "$fs_tty" ] && [ "$fs_tty" != - ]; } || { warn "pid $fs_pid has no terminal (headless)"; return 1; }
  proc_running iTerm2 || { warn "iTerm2 is not running"; return 1; }
  if [ "$fs_where" != other ]; then
    fs_out=$(focus_script "$fs_tty" | run_script) || { warn "$OSA_HINT"; return 1; }
    [ "$fs_out" != ok ] || { FOCUS_ROUTE=tab; return 0; }
  fi
  if [ "$fs_guid" != - ] && it2_focus "$fs_guid"; then FOCUS_ROUTE=swap; return 0; fi
  fs_gtty=$(group_tty "$fs_cwd")
  if [ -n "$fs_gtty" ]; then
    fs_out=$(focus_script "$fs_gtty" | run_script) || { warn "$OSA_HINT"; return 1; }
    [ "$fs_out" != ok ] || { FOCUS_ROUTE=group; return 0; }
  fi
  if [ "$fs_where" = other ]; then
    warn "pid $fs_pid is on $fs_tty, a buried peer, and no tab of its workgroup is in front"
  else
    warn "pid $fs_pid is on $fs_tty, which is not an iTerm2 tab"
  fi
  return 1
}

# --- commands ----------------------------------------------------------------

cmd_tabs() {
  { [ "$(os)" = Darwin ] && proc_running iTerm2; } || return 0
  out=$(tabs_script | osascript - 2>&1) || { printf '%s\n' "$out" >&2; return 1; }
  [ -z "$out" ] || printf '%s\n' "$out"
}

cmd_focus() {
  need_macos focus
  case ${1-} in ''|*[!0-9]*) usage;; esac
  pid=$1
  need_python
  row=$(registry_rows | awk -F'\t' -v p="$pid" '$1 == p { print; exit }')
  [ -n "$row" ] || die "no live session with pid $pid"
  tty=$(tty_table "$pid" | cut -f2)
  focus_session "$pid" "$tty" unknown "$(guid_of "$pid")" "$(printf '%s\n' "$row" | cut -f5)" || exit 1
}

cmd_list() {
  need_python
  rows=$(registry_rows)
  [ -n "$rows" ] || return 0
  init_tabname
  # shellcheck disable=SC2046
  ttys=$(tty_table $(printf '%s\n' "$rows" | cut -f1))
  # One listing per call, not per row; "unknown" when there is none to join.
  tabs='' listed=0
  if [ "$(os)" = Darwin ] && proc_running iTerm2; then
    tabs=$(cmd_tabs 2>/dev/null) && listed=1
  fi
  printf '%s\n' "$rows" | while IFS=$TAB read -r pid profile name status cwd; do
    tty=$(printf '%s\n' "$ttys" | awk -F'\t' -v p="$pid" '$1 == p { print $2; exit }')
    [ -n "$tty" ] || tty=-
    where=unknown win=- title=-
    if [ "$tty" = - ]; then
      where=headless
    elif [ "$listed" = 1 ]; then
      where=other
      hit=$(printf '%s\n' "$tabs" | awk -F'\t' -v t="$tty" '$2 == t { print; exit }')
      if [ -n "$hit" ]; then
        where=iterm2
        IFS=$TAB read -r win _ title <<EOF_HIT
$hit
EOF_HIT
        title=$(printf '%s' "${title-}" | tr '\t' ' ')
        [ -n "$title" ] || title=-
      fi
    fi
    lp=$(label_of "$cwd")
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$pid" "$profile" "${lp%"$TAB"*}" "${lp##*"$TAB"}" "$status" "$name" "$tty" "$where" "$win" "$title" "$cwd"
  done | LC_ALL=C sort -t"$TAB" -k3,3 -k1,1n
}

cmd_attention() {
  [ $# -eq 0 ] || usage
  need_python
  rows=$(registry_waiting)
  [ -n "$rows" ] || return 0
  init_tabname
  # shellcheck disable=SC2046
  ttys=$(tty_table $(printf '%s\n' "$rows" | cut -f1))
  tabs='' listed=0
  if [ "$(os)" = Darwin ] && proc_running iTerm2; then
    tabs=$(cmd_tabs 2>/dev/null) && listed=1
  fi
  now=$(date +%s)
  printf '%s\n' "$rows" | while IFS=$TAB read -r pid profile since reason cwd; do
    tty=$(printf '%s\n' "$ttys" | awk -F'\t' -v p="$pid" '$1 == p { print $2; exit }')
    [ -n "$tty" ] || tty=-
    where=unknown
    if [ "$tty" = - ]; then
      where=headless
    elif [ "$listed" = 1 ]; then
      where=other
      printf '%s\n' "$tabs" | awk -F'\t' -v t="$tty" '$2 == t { f = 1 } END { exit !f }' && where=iterm2
    fi
    waited=0
    [ "$since" -le 0 ] || waited=$((now - since / 1000))
    [ "$waited" -ge 0 ] || waited=0
    guid=-
    [ "$(os)" != Darwin ] || guid=$(guid_of "$pid")
    lp=$(label_of "$cwd" </dev/null)
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$pid" "$profile" "${lp%"$TAB"*}" "$waited" "$reason" "$tty" "$where" "$guid" "$cwd"
  done | LC_ALL=C sort -t"$TAB" -k4,4nr -k1,1n
}

# 45s, 12m, 3h, 2d
dur_of() {
  if [ "$1" -lt 60 ]; then printf '%ss' "$1"
  elif [ "$1" -lt 3600 ]; then printf '%sm' $(($1 / 60))
  elif [ "$1" -lt 86400 ]; then printf '%sh' $(($1 / 3600))
  else printf '%sd' $(($1 / 86400)); fi
}

cmd_next() {
  need_macos next
  dry=0
  case ${1-} in --dry-run) dry=1; shift;; esac
  [ $# -eq 0 ] || usage
  need_python
  rows=$(cmd_attention)
  [ -n "$rows" ] || { warn "nobody is waiting"; exit 3; }
  IFS=$TAB read -r pid _ label waited reason tty where guid cwd <<EOF_ROW
${rows%%"$NL"*}
EOF_ROW
  if [ "$dry" = 1 ]; then
    printf '%s\t%s\t%s\n' "$label" "$where" "$guid"
    return 0
  fi
  focus_session "$pid" "$tty" "$where" "$guid" "$cwd" || exit 1
  note=''
  [ "$FOCUS_ROUTE" != group ] || note=' (its tab is in front; pick it in the peer bar)'
  printf '%s: %s, waiting %s%s\n' "$label" "$reason" "$(dur_of "$waited")" "$note"
}

# Alfred Script Filter JSON, always exit 0 so Alfred shows a list, not an error.
cmd_alfred() {
  [ $# -eq 0 ] || usage
  need_python
  cmd_attention 2>/dev/null | while IFS=$TAB read -r pid profile label waited reason _; do
    printf '%s\t%s\t%s\t%s\t%s\n' "$pid" "$label" "$reason" "$(dur_of "$waited")" "$profile"
  done | python3 -I -c '
import json, sys
items = []
for line in sys.stdin:
    pid, label, reason, dur, profile = line.rstrip("\n").split("\t")
    items.append({"uid": pid, "title": label, "arg": pid, "valid": True,
                  "subtitle": f"{reason} \u00b7 waiting {dur} \u00b7 {profile}"})
if not items:
    items = [{"title": "Nobody is waiting", "valid": False}]
print(json.dumps({"items": items}))
'
}

# Single-quoted for a POSIX shell.
sq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# Is the directory a peer worktree? claude-peer knows; without it there are no peers.
is_peer() {
  [ -x "$PEERCMD" ] || return 1
  phys=$(cd "$1" 2>/dev/null && pwd -P) || phys=$1
  "$PEERCMD" peers "$1" 2>/dev/null </dev/null | cut -f1 | grep -Fxq -e "$1" -e "$phys"
}

# Is the tty sitting at a bare shell prompt? At least one foreground process,
# every one of them a shell (a pane whose process ended has none).
tty_idle() {
  ps -o stat=,ucomm= -t "${1#/dev/}" 2>/dev/null | awk '
    $1 ~ /\+/ { n++; if ($2 !~ /^-?(zsh|bash|fish)$/ && $2 != "login") bad = 1 }
    END { exit !(n > 0 && !bad) }'
}

DEFAULT_SAVED=${XDG_STATE_HOME:-$HOME/.local/state}/claude-tab/saved.tsv

cmd_save() {
  need_python
  [ $# -le 1 ] || usage
  file=${1:-$DEFAULT_SAVED}
  rows=$(registry_full)
  if [ -n "$rows" ]; then
    init_tabname
    # shellcheck disable=SC2046
    ttys=$(tty_table $(printf '%s\n' "$rows" | cut -f1))
    tabs='' listed=0
    if [ "$(os)" = Darwin ] && proc_running iTerm2; then
      tabs=$(cmd_tabs 2>/dev/null) && listed=1
    fi
  fi
  kept='' n=0 n_peer=0 n_head=0 n_other=0
  while IFS=$TAB read -r pid pdir sid kind cwd name st; do
    [ -n "$pid" ] || continue
    tty=$(printf '%s\n' "$ttys" | awk -F'\t' -v p="$pid" '$1 == p { print $2; exit }')
    if [ -z "$tty" ] || [ "$tty" = - ]; then n_head=$((n_head + 1)); continue; fi
    case $kind in -|interactive) ;; *) n_other=$((n_other + 1)); continue;; esac
    case $sid in -|*[!A-Za-z0-9_-]*) n_other=$((n_other + 1)); continue;; esac
    [ -d "$cwd" ] || { n_other=$((n_other + 1)); continue; }
    if is_peer "$cwd"; then n_peer=$((n_peer + 1)); continue; fi
    where=- win=- idx=999999
    if [ "$listed" = 1 ]; then
      where=other
      hit=$(printf '%s\n' "$tabs" | awk -F'\t' -v t="$tty" '$2 == t { print NR "\t" $1; exit }')
      if [ -n "$hit" ]; then where=iterm2 idx=${hit%%"$TAB"*} win=${hit#*"$TAB"}; fi
    fi
    lp=$(label_of "$cwd" </dev/null)
    label=${lp%"$TAB"*}
    # sort key (tab order in iTerm2, then label), then the row
    kept="$kept$(printf '%06d\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' "$idx" "$label" \
      "$pdir" "$sid" "$cwd" "$label" "$name" "$tty" "$where" "$win" "$st")$NL"
    n=$((n + 1))
  done <<EOF_ROWS
$rows
EOF_ROWS
  left="$n_peer peers, $n_head headless, $n_other other"
  if [ "$n" -eq 0 ]; then
    warn "no sessions to save (left out: $left); $file left untouched"
    return 1
  fi
  mkdir -p "$(dirname "$file")" || die "cannot create $(dirname "$file")"
  [ ! -e "$file" ] || mv -f "$file" "$file.prev" || die "cannot rotate $file"
  [ ! -e "$file.peers" ] || mv -f "$file.peers" "$file.peers.prev" || die "cannot rotate $file.peers"
  # Running slot peers of each saved tab's directory: cwd<TAB>slot. Overlay peers
  # never show in the leader's `slots`, so they are not noted.
  peers=''
  if [ -x "$PEERCMD" ]; then
    while IFS= read -r c; do
      [ -n "$c" ] || continue
      phys=$(cd "$c" 2>/dev/null && pwd -P) || phys=$c
      found=$("$PEERCMD" slots "$c" 2>/dev/null </dev/null |
        C=$c P=$phys awk -F'\t' '$2 == "running" && ($5 == ENVIRON["C"] || $5 == ENVIRON["P"]) { print ENVIRON["C"] "\t" $1 }')
      [ -z "$found" ] || peers="$peers$found$NL"
    done <<EOF_CWDS
$(printf '%s' "$kept" | cut -f5 | awk '!seen[$0]++')
EOF_CWDS
  fi
  {
    printf '# claude-tab save %s %s sessions\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$n"
    printf '%s' "$kept" | LC_ALL=C sort -t"$TAB" -k1,1n -k2,2 | cut -f3-
  } > "$file" || die "cannot write $file"
  warn "saved $n sessions to $file (left out: $left)"
  if [ -n "$peers" ]; then
    printf '%s' "$peers" > "$file.peers" || die "cannot write $file.peers"
    warn "noted $(printf '%s' "$peers" | grep -c .) running peers in $file.peers"
  fi
}

# A prompt is one non-empty line: it is typed into a shell and a session.
one_line() { case $1 in ''|*"$NL"*|*"$TAB"*|*"$CR"*) usage;; esac; }

cmd_restore() {
  need_macos restore
  dry=0 win='' delay=3 file='' ptext='' pfor='' pfor_text='' nopeers=0 peerwait=60
  while [ $# -gt 0 ]; do
    case $1 in
      --dry-run) dry=1;;
      --window) [ $# -ge 2 ] || usage; win=$2; shift;;
      --delay) [ $# -ge 2 ] || usage; delay=$2; shift;;
      --prompt) [ $# -ge 2 ] || usage; ptext=$2; one_line "$ptext"; shift;;
      --prompt-for) [ $# -ge 3 ] || usage; pfor=$2 pfor_text=$3; one_line "$pfor_text"
        case $pfor in ''|*[!A-Za-z0-9_-]*) usage;; esac; shift 2;;
      --no-peers) nopeers=1;;
      --peer-wait) [ $# -ge 2 ] || usage; peerwait=$2; shift;;
      -*) usage;;
      *) [ -z "$file" ] || usage; file=$1;;
    esac
    shift
  done
  case $delay in ''|*[!0-9.]*|.*|*.*.*) usage;; esac
  case $win in *[!0-9]*) usage;; esac
  case $peerwait in ''|*[!0-9]*) usage;; esac
  file=${file:-$DEFAULT_SAVED}
  [ -s "$file" ] || die "no saved sessions at $file (claude-tab save)"
  need_python
  proc_running iTerm2 || die "iTerm2 is not running"
  listing=$(restore_tabs_script | run_script) || die "$OSA_HINT"
  [ -n "$win" ] || win=$(printf '%s\n' "$listing" | awk -F'\t' '$5 == 1 { print $1; exit }')
  [ -n "$win" ] || die "no iTerm2 window to restore into (open one, or pass --window)"

  # Empty tabs: one session, not the one running this, sitting at a shell.
  own=$(walk_tty "$$")
  empty='' other_empty=0
  while IFS=$TAB read -r w _ cnt tty _; do
    [ "$cnt" = 1 ] && [ "$tty" != "$own" ] && tty_idle "$tty" || continue
    if [ "$w" = "$win" ]; then empty="$empty$tty$NL"; else other_empty=$((other_empty + 1)); fi
  done <<EOF_TABS
$listing
EOF_TABS

  SAVED_PROFILES=$(awk -F'\t' '$1 != "" && $1 !~ /^#/ { print $1 }' "$file")
  live=$(registry_full)
  plan='' f=0 n=0 s=0
  while IFS=$TAB read -r profile sid cwd label _ _ _ _ st; do
    case $profile in ''|'#'*) continue;; esac
    cmd=- tty=-
    if printf '%s\n' "$live" | P=$profile S=$sid C=$cwd awk -F'\t' \
        '$2 == ENVIRON["P"] && ($3 == ENVIRON["S"] || $5 == ENVIRON["C"]) { f = 1 } END { exit !f }'; then
      act=skip:live
      # The session that asked for the relaunch is still alive: nothing else would
      # wake it, so its text goes into its own tab. No other live row is touched.
      if [ -n "$pfor" ] && [ "$sid" = "$pfor" ]; then
        lpid=$(printf '%s\n' "$live" | P=$profile S=$sid awk -F'\t' \
          '$2 == ENVIRON["P"] && $3 == ENVIRON["S"] { print $1; exit }')
        if [ -n "$lpid" ]; then
          ltty=$(tty_table "$lpid" | cut -f2)
          if [ -n "$ltty" ] && [ "$ltty" != - ]; then act=tell tty=$ltty cmd=$pfor_text; fi
        fi
      fi
    elif [ ! -d "$cwd" ]; then act=skip:cwd-gone
    elif [ ! -d "$profile" ]; then act=skip:profile-gone
    else
      case $sid in ''|-|*[!A-Za-z0-9_-]*) act=skip:bad-id;; *) act='' ;; esac
    fi
    if [ -z "${act-}" ]; then
      cmd="cd -- $(sq "$cwd") && CLAUDE_PROFILE=$(sq "$profile") claude --resume $sid"
      if [ -n "$pfor" ] && [ "$sid" = "$pfor" ]; then cmd="$cmd $(sq "$pfor_text")"
      elif [ -n "$ptext" ] && [ "${st-}" != idle ]; then cmd="$cmd $(sq "$ptext")"; fi
      if [ -n "$empty" ]; then
        act=fill tty=${empty%%"$NL"*} empty=${empty#*"$NL"} f=$((f + 1))
      else
        act=new n=$((n + 1))
      fi
    else
      s=$((s + 1))
    fi
    plan="$plan$act$TAB$tty$TAB$label$TAB$cmd$NL"
    act=''
  done < "$file"
  if [ "$dry" = 1 ]; then
    printf '%s' "$plan"
    if [ "$nopeers" = 0 ] && [ -s "$file.peers" ]; then
      while IFS=$TAB read -r pleader pslot; do
        [ -n "$pleader" ] && [ -n "$pslot" ] && printf 'peer\t-\t%s\t%s\n' "$pslot" "$pleader"
      done < "$file.peers"
    fi
    return 0
  fi

  first=1
  while IFS=$TAB read -r act tty label cmd; do
    case $act in fill|new|tell) ;; *) continue;; esac
    [ "$first" = 1 ] || sleep "$delay"
    first=0
    case $act in
      fill) scr=$(fill_script "$win" "$tty" "$cmd");;
      new) scr=$(newtab_script "$win" "$cmd");;
      tell) scr=$(tell_script "$tty" "$cmd");;
    esac
    out=$(printf '%s\n' "$scr" | run_script) || die "$OSA_HINT"
    if [ "$act" = tell ]; then
      if [ "$out" = ok ]; then warn "told the live session $label in its tab"
      else warn "$tty is no longer a tab; could not tell the live session $label"; fi
    elif [ "$out" != ok ]; then
      warn "$tty is no longer a tab of window $win; skipped $label"
      if [ "$act" = fill ]; then f=$((f - 1)); else n=$((n - 1)); fi
      s=$((s + 1))
    fi
  done <<EOF_PLAN
$plan
EOF_PLAN
  warn "restored $f into empty tabs, $n in new tabs, $s skipped; $other_empty empty tabs in other windows left alone"

  # Peers last: their panes reappear waiting once the leader's claude has entered
  # its workgroup, which the typed commands above only just started.
  if [ "$nopeers" = 0 ] && [ -s "$file.peers" ]; then
    pk_s=0 pk_a=0 pk_f=0
    while IFS=$TAB read -r pleader pslot; do
      [ -n "$pleader" ] && [ -n "$pslot" ] || continue
      waited=0
      while :; do
        ( cd "$pleader" && "$PEERCMD" start "$pslot" --continue ${ptext:+-- "$ptext"} ) >/dev/null 2>&1 </dev/null
        case $? in
          0) pk_s=$((pk_s + 1)); break;;
          3) pk_a=$((pk_a + 1)); break;;
          4) if [ "$waited" -ge "$peerwait" ]; then pk_f=$((pk_f + 1)); break; fi
             sleep 2; waited=$((waited + 2));;
          *) pk_f=$((pk_f + 1)); break;;
        esac
      done
    done < "$file.peers"
    warn "peers: $pk_s started, $pk_a already running, $pk_f not started"
  fi
}

# --- the needs-you list ------------------------------------------------------

# One pass of the list: the registry of every profile in, a state file and one
# line of JSON out (the snapshot). Every rule of the list lives in this program;
# .claude/rules/claude-tab-panel.md says what they are. A fourth registry reader,
# for the reason of the other three, and it keeps the same filter: only
# `<digits>.json`, a positive int pid that answers kill 0 (PermissionError is
# alive). The mode word is the first argument.
panel_py() {
  python3 -I - "$@" <<'PANEL_PY'
import json, os, re, subprocess, sys, time

V = 1
APPEAR = {"blocked": 4, "asked": 4, "failed": 4, "quiet": 0, "unknown": 60}
RANK = {"blocked": 0, "failed": 1, "asked": 1, "finished": 2, "finished-bg": 2,
        "quiet": 3, "unknown": 3}
STICKY = ("blocked", "asked", "failed")
CALM = ("finished", "finished-bg", "quiet", "unknown")
TALLY = ("ticks", "transitions", "entered", "left", "hidden_prompts",
         "seen_focus", "seen_click", "focus_reads", "focus_failures")
IDLE_KIND = {"busy": "working", "idle": "idle", "shell": "idle-bg"}


def die(msg):
    sys.stderr.write("claude-tab: panel tick: %s\n" % msg)
    sys.exit(2)


def num(v):
    return type(v) in (int, float)


def posint(v, default):
    try:
        n = int(v)
    except (TypeError, ValueError):
        return default
    return n if n > 0 else default


def parse(argv):
    o = {"state": None, "now": None, "focus": "?", "profiles": [], "quiet": 900,
         "finished": 60, "life": {}, "build": "-"}
    i = 0
    while i < len(argv):
        k = argv[i]
        if k not in ("--state", "--now", "--focus", "--profile", "--quiet",
                     "--finished", "--life", "--build") or i + 1 >= len(argv):
            die("bad argument '%s'" % k)
        v = argv[i + 1]
        i += 2
        if k == "--profile":
            d, _, label = v.rpartition("=")
            o["profiles"].append((d, label))
        elif k == "--life":
            p, _, t = v.partition("=")
            try:
                o["life"][int(p)] = float(t)
            except ValueError:
                die("bad --life '%s'" % v)
        elif k == "--now":
            try:
                o["now"] = float(v)
            except ValueError:
                die("bad --now '%s'" % v)
        elif k in ("--quiet", "--finished"):
            o[k[2:]] = posint(v, o[k[2:]])
        else:
            o[k[2:]] = v
    return o


def state_base():
    return os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")


def read_registry(profiles):
    recs, unreadable, nprof, headless = [], 0, 0, 0
    for d, label in profiles:
        sd = os.path.join(d, "sessions")
        try:
            names = sorted(os.listdir(sd))
        except OSError:
            continue
        nprof += 1
        for n in names:
            if not re.fullmatch(r"\d+\.json", n):
                continue
            try:
                with open(os.path.join(sd, n)) as fh:
                    r = json.load(fh)
            except FileNotFoundError:
                continue
            except (OSError, ValueError):
                unreadable += 1
                continue
            if type(r) is not dict:
                unreadable += 1
                continue
            pid = r.get("pid")
            if type(pid) is not int or pid <= 0:
                continue
            try:
                os.kill(pid, 0)
            except PermissionError:
                pass  # alive, just not ours
            except OSError:
                continue
            if "kind" in r and r["kind"] != "interactive":
                headless += 1
                continue
            recs.append({"dir": d, "profile": label, "pid": pid, "r": r})
    return recs, unreadable, nprof, headless


def load_state(path):
    try:
        with open(path) as fh:
            st = json.load(fh)
    except (OSError, ValueError):
        return None
    if type(st) is not dict or st.get("v") != 1 or not num(st.get("saved_at")):
        return None
    if type(st.get("sessions")) is not dict or type(st.get("tally")) is not dict:
        return None
    return st


def sane(e):
    return (type(e) is dict and type(e.get("status")) is str and num(e.get("since"))
            and (e.get("kind") is None or type(e["kind"]) is str)
            and (e.get("cond_since") is None or num(e["cond_since"]))
            and (e.get("seen_at") is None or num(e["seen_at"]))
            and (e.get("entered_at") is None or num(e["entered_at"]))
            and type(e.get("hits")) is int and type(e.get("listed")) is bool)


def read_tty(pid):
    try:
        out = subprocess.run(["ps", "-o", "tty=", "-p", str(pid)], capture_output=True,
                             text=True, timeout=3).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return None
    return None if out in ("", "?", "??") else "/dev/" + out


def turn_record(sid, since, now):
    """The turn record of a session when it is valid, else None."""
    if not re.fullmatch(r"[A-Za-z0-9_-]+", sid):
        return None
    try:
        with open(os.path.join(state_base(), "tabstatus", sid + ".turn")) as fh:
            t = json.loads(fh.readline())
    except (OSError, ValueError):
        return None
    if type(t) is not dict or type(t.get("at")) is not int or t.get("end") not in ("question", "error", "plain"):
        return None
    return t if since - 15 <= t["at"] <= now + 5 else None


def condition(status, since, now, wait_for, turn, life, quiet):
    """(kind, cond_since, reason) of a session, first match wins; kind None is no condition."""
    if status == "waiting":
        return "blocked", since, wait_for or "waiting"
    if status in ("idle", "shell"):
        if turn and turn["end"] == "error":
            return "failed", since, "failed"
        if turn and turn["end"] == "question":
            return "asked", since, "asked"
        if status == "idle":
            return "finished", since, "finished"
        return "finished-bg", since, "finished, background task"
    if status == "busy":
        if life is not None and now - max(since, life) >= quiet:
            return "quiet", max(since, life) + quiet, "quiet"
        return None, None, None
    return "unknown", since, "unknown: %s" % status


def end_instance(e, tally):
    """An instance ended: a row leaving, or a prompt that was never shown."""
    if e["kind"] is None:
        return
    if e["listed"]:
        tally["left"] += 1
    elif e["kind"] == "blocked" and e["entered_at"] is None:
        tally["hidden_prompts"] += 1


def mark_seen(state, pid, now):
    """A click on the row of pid: its current instance counts as seen."""
    for key, e in state["sessions"].items():
        if key.rsplit("|", 2)[1] == str(pid) and e["kind"] is not None and e["seen_at"] is None:
            e["seen_at"] = now
            state["tally"]["seen_click"] += 1


def tick(prev, o, now):
    recs, unreadable, nprof, headless = read_registry(o["profiles"])
    fresh = prev is None or now - prev["saved_at"] > 86400
    old_sessions = {} if prev is None else prev["sessions"]
    tally = dict((k, 0) for k in TALLY)
    if prev is not None:
        for k in TALLY:
            if type(prev["tally"].get(k)) is int:
                tally[k] = prev["tally"][k]
    tally["ticks"] += 1
    focus = o["focus"]
    sessions, rows = {}, []
    turn_records = life_unknown = 0
    for rec in recs:
        r, pid = rec["r"], rec["pid"]
        sid = r.get("sessionId")
        sid = sid if type(sid) is str and sid else "-"
        key = "%s|%d|%s" % (rec["dir"], pid, sid)
        old = old_sessions.get(key)
        if old is not None and not sane(old):
            old = None
        st = r.get("status")
        status = st if type(st) is str else ("" if st is None else str(st))
        sa = r.get("statusUpdatedAt")
        if num(sa) and sa > 0:
            since = sa / 1000.0
        elif old is not None and old["status"] == status:
            since = old["since"]
        else:
            since = now
        if old is not None and old["status"] != status:
            tally["transitions"] += 1
        turn = None
        if status in ("idle", "shell"):
            turn = turn_record(sid, since, now)
            if turn:
                turn_records += 1
        life = None
        if status == "busy" and now - since >= o["quiet"]:
            life = o["life"].get(pid)
            if life is None:
                life_unknown += 1
        wf = r.get("waitingFor")
        kind, cond_since, reason = condition(status, since, now, wf if type(wf) is str and wf else None,
                                             turn, life, o["quiet"])
        if old is not None and old["kind"] == kind and old["cond_since"] == cond_since:
            e = dict(old)
        else:
            if old is not None:
                end_instance(old, tally)
            e = {"kind": kind, "cond_since": cond_since, "seen_at": None, "hits": 0,
                 "listed": False, "entered_at": None}
            # starting calm: what finished before the list had a memory is not news
            if kind in CALM and (fresh or (old is None and cond_since <= prev["saved_at"])):
                e["seen_at"] = now
        e["status"], e["since"] = status, since
        e["tty"] = old["tty"] if old is not None and "tty" in old else read_tty(pid)
        # capped at 2: a session left in front must not make the state change every tick
        e["hits"] = min(e["hits"] + 1, 2) if focus[:1] == "/" and e["tty"] == focus else 0
        if kind is not None and e["seen_at"] is None and e["hits"] >= 2:
            e["seen_at"] = now
            tally["seen_focus"] += 1
        eligible = False
        if kind is not None:
            appear = {"finished": o["finished"], "finished-bg": o["quiet"]}.get(kind, APPEAR.get(kind))
            eligible = (now - cond_since >= appear and e["hits"] == 0
                        and (kind in STICKY or e["seen_at"] is None))
        if eligible and not e["listed"]:
            e["listed"], e["entered_at"] = True, now
            tally["entered"] += 1
        elif not eligible and e["listed"]:
            e["listed"] = False
            tally["left"] += 1
        sessions[key] = e
        cwd = r.get("cwd")
        label = (os.path.basename(cwd.rstrip("/")) if type(cwd) is str else "") or "-"
        rk = kind if e["listed"] or kind not in (None, "finished", "finished-bg") else IDLE_KIND.get(status, kind)
        rows.append((e, {"pid": pid, "profile": rec["profile"], "label": label, "group": label,
                         "role": "plain", "kind": rk, "reason": reason or status,
                         "since": int(since), "seen": e["seen_at"] is not None, "tty": e["tty"]}))
    for key, old in old_sessions.items():
        if key not in sessions and sane(old):
            end_instance(old, tally)
    needs, groups = [], {}
    for e, row in rows:
        if e["listed"]:
            needs.append((RANK[e["kind"]], e["entered_at"], row["pid"], dict(row, since=int(e["cond_since"]))))
        g = groups.setdefault(row["group"], {"group": row["group"], "needs": 0, "working": 0,
                                             "idle": 0, "rows": []})
        g["rows"].append(row)
        g["needs" if e["listed"] else "working" if e["status"] == "busy" else "idle"] += 1
    needs.sort(key=lambda t: t[:3])
    for g in groups.values():
        g["rows"].sort(key=lambda x: (x["label"], x["pid"]))
    snap = {"v": 1, "generated_at": float(now), "build": o["build"],
            "health": {"profiles": nprof, "sessions": len(recs), "headless": headless,
                       "unreadable": unreadable,
                       "focus": "ok" if focus[:1] == "/" else ("none" if focus == "-" else "unknown"),
                       "turn_records": turn_records, "life_unknown": life_unknown,
                       "want_focus": any(e["kind"] is not None and e["seen_at"] is None for e, _ in rows)},
            "needs": [t[3] for t in needs], "others": [groups[k] for k in sorted(groups)],
            "tally": tally}
    return {"v": 1, "saved_at": now, "sessions": sessions, "tally": tally}, snap


def save_state(path, state, prev, now):
    """Write when something changed, or the file is a minute old."""
    def core(st):
        return (st["sessions"], dict((k, v) for k, v in st["tally"].items() if k != "ticks"))
    if prev is not None and now - prev["saved_at"] < 60 and core(prev) == core(state):
        return
    try:
        os.makedirs(os.path.dirname(path) or ".", mode=0o700, exist_ok=True)
        tmp = "%s.%d.tmp" % (path, os.getpid())
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as fh:
            json.dump(state, fh, sort_keys=True)
        os.replace(tmp, path)
    except OSError as err:
        sys.stderr.write("claude-tab: cannot write %s: %s\n" % (path, err))


def main(argv):
    if not argv or argv[0] != "tick":
        die("unknown mode")
    o = parse(argv[1:])
    now = o["now"] if o["now"] is not None else time.time()
    path = o["state"] or os.path.join(state_base(), "claude-tab", "panel-state.json")
    prev = load_state(path)
    state, snap = tick(prev, o, now)
    save_state(path, state, prev, now)
    sys.stdout.write(json.dumps(snap, sort_keys=True) + "\n")


main(sys.argv[1:])
PANEL_PY
}

cmd_panel_tick() {
  need_python
  q=$(git config --get tabstatus.quiet-minutes 2>/dev/null) || q=''
  case $q in ''|*[!0-9]*|0*) q=15;; esac
  f=$(git config --get claude-tab.finished-seconds 2>/dev/null) || f=''
  case $f in ''|*[!0-9]*|0*) f=60;; esac
  set -- --quiet "$((q * 60))" --finished "$f" "$@"
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    set -- --profile "$d=$(profile_label "$d")" "$@"
  done <<EOF_PROFILES
$(profile_dirs)
EOF_PROFILES
  panel_py tick "$@"
}

cmd_panel() {
  [ $# -ge 1 ] || usage
  verb=$1
  shift
  case $verb in
    tick) cmd_panel_tick "$@";;
    *)    usage;;
  esac
}

# --- dispatch ----------------------------------------------------------------

[ $# -ge 1 ] || usage
cmd=$1
shift
case $cmd in
  list)      cmd_list;;
  attention) cmd_attention "$@";;
  next)      cmd_next "$@";;
  alfred)    cmd_alfred "$@";;
  tabs)      cmd_tabs;;
  focus)     cmd_focus "$@";;
  save)      cmd_save "$@";;
  restore)   cmd_restore "$@";;
  panel)     cmd_panel "$@";;
  -h|--help|help) usage;;
  *)         die "unknown command '$cmd' (claude-tab help)";;
esac
