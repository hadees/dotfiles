#!/bin/sh
# git-allowed-signers — compose ~/.config/git/allowed_signers from the
# fragments the private overlays drop in ~/.config/git/allowed_signers.d/.
#
#   git-allowed-signers            regenerate the file (default)
#   git-allowed-signers --print    write the composition to stdout instead
#   git-allowed-signers --check    exit 1 if the file is stale, touching nothing
#
# Why a generator, when ~/.ssh/config solves the same problem with Include:
# git has no include for this file. gpg.ssh.allowedSignersFile names exactly
# ONE path and reads exactly that file, so the only way to compose a list out
# of separately-owned pieces is to concatenate them.
#
# The pieces are separately owned because the list mixes identities — one
# line per signer, and each identity is private to a different overlay. A
# single tracked file could therefore live in neither: chezmoi allows one
# source per target, and the work overlay must not name the personal identity
# or vice versa. Fragments dodge that entirely, and give the property that
# motivated all of this: a machine without an overlay simply composes a file
# without its lines, with no conditionals anywhere.
#
# Run AFTER every overlay has applied — the `dotfiles` function in
# ~/.functions does exactly that, for the same reason it touches
# ~/.finicky.ts there. A chezmoi run_after_ script in any one source would
# fire before the other sources had deployed their fragments, and compose a
# file that is one apply stale.
#
# Never edit the output by hand; it is overwritten. Add a fragment instead.
set -eu

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
dir="${GIT_ALLOWED_SIGNERS_DIR:-$config_home/git/allowed_signers.d}"
out="${GIT_ALLOWED_SIGNERS_FILE:-$config_home/git/allowed_signers}"

mode=write
case "${1:-}" in
	--print) mode=print ;;
	--check) mode=check ;;
	'') ;;
	*) echo "git-allowed-signers: unknown option: $1" >&2; exit 2 ;;
esac

compose() {
	echo "# GENERATED by git-allowed-signers — do not edit."
	echo "# Source: $dir/*  (one fragment per overlay; add lines there)"
	# Lexical order, which is only cosmetic here: git matches a signature
	# against the whole list by principal and key, so no line shadows another.
	# The numbering exists to keep fragments diffable in a fixed order.
	found=
	for f in "$dir"/*; do
		[ -f "$f" ] || continue
		found=1
		echo
		echo "# --- ${f##*/} ---"
		cat "$f"
	done
	# A header-only file is deliberate when no overlay is present. Git's
	# error for a MISSING file ("needs to be configured and exist") reads
	# like a misconfiguration; for an empty one it says no principal matched,
	# which is the truth: this machine simply knows no signers.
	[ -n "$found" ] || echo "# (no overlay fragments on this machine)"
}

case "$mode" in
	print) compose ;;
	check)
		[ -f "$out" ] || { echo "git-allowed-signers: $out is missing" >&2; exit 1; }
		compose | cmp -s - "$out" || {
			echo "git-allowed-signers: $out is stale — run git-allowed-signers" >&2
			exit 1
		}
		;;
	write)
		mkdir -p "$(dirname "$out")"
		# Write through a temp file so a reader never sees a half-composed
		# list, and so a failure leaves the previous one intact.
		tmp="$out.tmp.$$"
		trap 'rm -f "$tmp"' EXIT INT TERM
		compose > "$tmp"
		chmod 0644 "$tmp"
		mv "$tmp" "$out"
		;;
esac
