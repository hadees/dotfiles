#!/bin/sh
# iterm2-prefs — compose iTerm2's preferences from per-owner fragments.
#
# Usage:
#   iterm2-prefs lint [--public] <file>...
#   iterm2-prefs compose [--auto] [--reset] [--print]
#   iterm2-prefs status [--line]
#   iterm2-prefs capture [--from domain|store|<plist>] [--all] [--values]
#                        [--owned <fragment>] [<unit>...] [--into <fragment> | --file <plist>]
#   iterm2-prefs install [--dry-run] [--no-seed]
#
# Exit codes: 0 done, 1 failed or refused, 2 usage or not macOS.
#
# Each owner (this repository, and each private overlay that has a key of its
# own) deploys an XML property list of iTerm2 preference keys into
# ~/.config/iterm2/prefs.d/NN-<name>.plist, the same shape as
# ~/.config/git/allowed_signers.d. This script merges them, in name order and
# with the later fragment winning a key both set, into the one store iTerm2
# loads from its custom folder, which lives outside every git repository.
#
# Why a merge, when git-allowed-signers can simply concatenate: iTerm2 is a
# second writer. At every quit it writes every syncable key of the domain back
# to that folder, so a composer that regenerated the file would undo every
# change made in Settings. The merge is three-way per key against a record of
# what the sources said at the last compose, so a key iTerm2 changed is kept
# and counted until `capture` moves it into the fragment that owns it.
#
# Why only while iTerm2 is quit: it holds the truth in memory and overwrites
# the file at quit, and a file that changed under it raises "changed since
# iTerm2 started". `compose` and `install` therefore write nothing while it
# runs. `lint` and `compose --print` read and print only, and need no macOS.
#
# Reserved, never composed: Workgroups and each profile's Triggers (written by
# claude-peer and by iTerm2's own onboarding), the keys iTerm2 itself does not
# sync, and a profile's Dynamic Profile* keys. A fragment that sets one has it
# ignored and counted. Unit names (keys and profile/<guid>/<key>) are printed;
# values never are, except by `capture --values`.
#
# Who captures where: `capture` writes only the destination it is given, never the
# store, the record or a deployed fragment. A session writes with --file into its
# own worktree (on a mac the public source's path from `chezmoi source-path` is the
# live checkout, which a session must not edit on main); --into <fragment> is the
# operator's shortcut and resolves the chezmoi source of the deployed fragment. An
# overlay's fragment is captured by that overlay's own session.
#
# Built so far: lint, compose, status and capture. install answers "not built yet".
set -u

warn() { printf 'iterm2-prefs: %s\n' "$*" >&2; }
die() { warn "$*"; exit 1; }

usage() { sed -n '/^# Usage:/,/^# Exit codes/p' "$0" | sed 's/^# \{0,1\}//'; }

os() { uname -s 2>/dev/null; }
# Exit 2 as for usage: the verb cannot be used here at all, nothing was refused.
need_macos() { [ "$(os)" = Darwin ] || { warn "$1 needs macOS"; exit 2; }; }

# `ps` rather than pgrep, as bin/executable_claude-peer: pgrep cannot see
# processes of the caller's own session under some sandboxes.
proc_running() {
  ps -Ao ucomm= 2>/dev/null |
    awk -v n="$1" '{ sub(/[ \t]+$/, "", $0); if ($0 == n) f = 1 } END { exit !f }'
}

# The stdlib only, and Python 3.9 clean (no match, no `X | Y` annotations):
# /usr/bin/python3 is all a fresh mac has.
prefs_py() {
  python3 -I - "$@" <<'PYEOF'
import datetime, os, plistlib, re, subprocess, sys, tempfile

MISSING = type("Missing", (), {"__repr__": lambda self: "MISSING"})()

# iTerm2's own filter (iTermRemotePreferences.m): these never reach the folder.
EXEMPT = frozenset((
    "LoadPrefsFromCustomFolder", "PrefsCustomFolder", "Secure Input",
    "moveToApplicationsFolderAlertSuppress", "iTerm Version",
    "CGFontRenderingFontSmoothingDisabled", "PreventEscapeSequenceFromChangingProfile",
    "PreventEscapeSequenceFromClearingHistory", "Coprocess MRU", "MetalCaptureEnabled",
    "MetalCaptureEnabledDate", "Snippets", "AppleAntiAliasingThreshold",
    "AppleSmoothFixedFontsSizeThreshold", "AppleWindowTabbingMode",
    "AppleScrollAnimationEnabled", "ApplePressAndHoldEnabled"))
NO_SYNC_PREFIXES = ("NS", "SU", "NoSync", "UK")
FRAGMENT_NAME = re.compile(r"[0-9]{2}-[a-z0-9_-]+\.plist")
# profile keys that carry a host, a command or free text: empty in the public base
EMPTY_ONLY = ("Bound Hosts", "Command", "Initial Text", "Badge Text", "Tags")


def syncable(key):
    return key not in EXEMPT and not key.startswith(NO_SYNC_PREFIXES)


# A unit is ("top", key) or ("profile", guid, key); key None is a whole profile.
def reserved(unit):
    if unit[0] == "top":
        return unit[1] == "Workgroups" or not syncable(unit[1])
    return unit[2] is not None and (unit[2] == "Triggers" or unit[2].startswith("Dynamic Profile"))


def unit_text(unit):
    if unit[0] == "top":
        return unit[1]
    return "profile/%s" % unit[1] if unit[2] is None else "profile/%s/%s" % unit[1:]


def parse_unit(text):
    if text.startswith("profile/"):
        parts = text.split("/", 2)
        return ("profile", parts[1], parts[2] if len(parts) == 3 else None)
    return ("top", text)


def same(a, b):
    """Deep equality with exact types: True, 1 and 1.0 are three values."""
    if a is MISSING or b is MISSING:
        return a is b
    if type(a) is not type(b):
        return False
    if isinstance(a, dict):
        return a.keys() == b.keys() and all(same(a[k], b[k]) for k in a)
    if isinstance(a, list):
        return len(a) == len(b) and all(same(x, y) for x, y in zip(a, b))
    return a == b


def split_units(prefs):
    """(units, reserved units, profile Guids in order) of a preferences dictionary."""
    units, res, guids = {}, [], []

    def put(unit, value):
        if reserved(unit):
            res.append(unit)
        else:
            units[unit] = value

    for key, value in prefs.items():
        if key != "New Bookmarks":
            put(("top", key), value)
            continue
        for prof in value if isinstance(value, list) else []:
            guid = prof.get("Guid") if isinstance(prof, dict) else None
            if not isinstance(guid, str):
                continue
            guids.append(guid)
            for pkey, pvalue in prof.items():
                if pkey != "Guid":
                    put(("profile", guid, pkey), pvalue)
    return units, res, guids


def units_of(prefs):
    return split_units(prefs)[0]


def load_plist(path):
    with open(path, "rb") as f:
        return plistlib.load(f)


def dump_plist(prefs):
    return plistlib.dumps(prefs, fmt=plistlib.FMT_XML, sort_keys=True)


def leaves(value):
    if isinstance(value, dict):
        for v in value.values():
            yield from leaves(v)
    elif isinstance(value, list):
        for v in value:
            yield from leaves(v)
    else:
        yield value


def lint_file(path, public):
    """(preferences or None, problems) for one file; None when it cannot be read as a fragment."""
    try:
        with open(path, "rb") as f:
            raw = f.read()
    except OSError as e:
        return None, ["cannot read: %s" % e.strerror]
    if raw.startswith(b"bplist"):
        return None, ["binary property list (fragments are XML)"]
    try:
        prefs = plistlib.loads(raw)
    except Exception:
        return None, ["not a property list"]
    if not isinstance(prefs, dict):
        return None, ["root is not a dictionary"]

    probs = []
    if "New Bookmarks" in prefs:
        nb = prefs["New Bookmarks"]
        if not (isinstance(nb, list) and all(isinstance(p, dict) for p in nb)):
            probs.append("New Bookmarks is not an array of dictionaries")
        else:
            seen = set()
            for i, prof in enumerate(nb):
                guid = prof.get("Guid")
                if not isinstance(guid, str) or not guid:
                    probs.append("profile %d has no Guid" % i)
                elif guid in seen:
                    probs.append("profile Guid %s appears twice" % guid)
                else:
                    seen.add(guid)
    units, res, _ = split_units(prefs)
    probs += ["reserved key " + unit_text(u) for u in res]
    if public:
        for u, value in units.items():
            text = unit_text(u)
            for leaf in leaves(value):
                if isinstance(leaf, bytes):
                    probs.append("data value at " + text)
                elif isinstance(leaf, datetime.datetime):
                    probs.append("date value at " + text)
                elif isinstance(leaf, str):
                    if "/Users/" in leaf or "/home/" in leaf:
                        probs.append("home path in " + text)
                    if u != ("top", "AitermURL") and (leaf.startswith(("/", "~/")) or "://" in leaf):
                        probs.append("path or URL in " + text)
                    if "@" in leaf:
                        probs.append("address in " + text)
            if u[0] == "profile" and u[2] in EMPTY_ONLY and not (isinstance(value, (str, list)) and not value):
                probs.append(text + " must be empty or absent")
        for u in res:
            if u[0] == "profile" and u[2].startswith("Dynamic Profile"):
                probs.append("dynamic profile " + u[1])
        probs = list(dict.fromkeys(probs))
    return prefs, probs


def read_fragments(frag_dir):
    """[(name, preferences or None, problems)] for the NN-<name>.plist files, in name order."""
    try:
        names = sorted(os.listdir(frag_dir))
    except OSError:
        return []
    out = []
    for n in names:
        path = os.path.join(frag_dir, n)
        if FRAGMENT_NAME.fullmatch(n) and os.path.isfile(path):
            prefs, probs = lint_file(path, False)
            out.append((n[:-len(".plist")], prefs, probs))
    return out


def merge(fragments):
    """(new, owner, order, ignored): the last fragment's value per unit."""
    new, owner, order, ignored = {}, {}, [], []
    for name, prefs, _ in fragments:
        if prefs is None:
            continue
        units, res, guids = split_units(prefs)
        for u, value in units.items():
            new[u], owner[u] = value, name
        ignored += [(name, unit_text(u)) for u in res]
        order += [g for g in guids if g not in order]
    return new, owner, order, ignored


class Fail(Exception):
    pass


def three_way(new, rec, cur, reset=False):
    """(apply, kept): what to write to the store, and the units iTerm2 changed that stay as they are."""
    apply, kept = {}, []
    for u in list(new) + [u for u in rec if u not in new]:
        n, r, c = new.get(u, MISSING), rec.get(u, MISSING), cur.get(u, MISSING)
        if same(c, n):
            continue
        if reset or same(c, r):
            apply[u] = n
        else:
            kept.append(u)
    # a profile no fragment lists any more stays whole when iTerm2 changed any key of it
    listed = {u[1] for u in new if u[0] == "profile"}
    held = {u[1] for u in kept if u[0] == "profile"} - listed
    for u in [u for u in apply if u[0] == "profile" and u[1] in held and apply[u] is MISSING]:
        del apply[u]
    return apply, kept


def apply_units(prefs, apply, order):
    """Mutate prefs by three_way's apply, profiles in order; returns the profiles dropped."""
    profs = prefs.get("New Bookmarks")
    if not isinstance(profs, list):
        profs = []
    by_guid = {p["Guid"]: p for p in profs if isinstance(p, dict) and isinstance(p.get("Guid"), str)}
    gone = set()
    for u, value in apply.items():
        if u[0] == "top":
            if value is MISSING:
                prefs.pop(u[1], None)
            else:
                prefs[u[1]] = value
    for g in order + sorted({u[1] for u in apply if u[0] == "profile"} - set(order)):
        for u, value in apply.items():
            if u[0] != "profile" or u[1] != g:
                continue
            if value is MISSING:
                if g in by_guid:
                    by_guid[g].pop(u[2], None)
                if g not in order:
                    gone.add(g)
            else:
                if g not in by_guid:
                    by_guid[g] = {"Guid": g}
                    profs.append(by_guid[g])
                by_guid[g][u[2]] = value
    if profs or "New Bookmarks" in prefs:
        prefs["New Bookmarks"] = [p for p in profs if not (isinstance(p, dict) and p.get("Guid") in gone)]
    return len(gone & set(by_guid))


def state_home():
    return os.environ.get("XDG_STATE_HOME") or os.path.join(os.environ["HOME"], ".local", "state")


def store_dir():
    return os.environ.get("ITERM2_PREFS_DIR") or os.path.join(state_home(), "iterm2", "prefs")


def live_path():
    return os.path.join(store_dir(), "com.googlecode.iterm2.plist")


def record_path():
    return os.environ.get("ITERM2_PREFS_RECORD") or os.path.join(state_home(), "iterm2", "prefs-sourced.plist")


def defaults(*args):
    try:
        p = subprocess.run(("defaults",) + args, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except OSError:
        return None
    return p.stdout if p.returncode == 0 else None


def current_store():
    """("domain", None), ("folder", plist path) or ("url", the URL): what iTerm2 loads, as claude-peer's prefs_store reads it."""
    load = defaults("read", "com.googlecode.iterm2", "LoadPrefsFromCustomFolder")
    if load is None or load.decode().strip() != "1":
        return "domain", None
    folder = defaults("read", "com.googlecode.iterm2", "PrefsCustomFolder")
    folder = folder.decode().strip() if folder else ""
    if not folder:
        return "domain", None
    if "://" in folder:
        return "url", folder
    if folder == "~" or folder.startswith("~/"):
        folder = os.environ["HOME"] + folder[1:]
    return "folder", folder.rstrip("/") + "/com.googlecode.iterm2.plist"


def is_installed(kind, plist):
    return kind == "folder" and os.path.realpath(os.path.dirname(plist)) == os.path.realpath(store_dir())


def git_top(plist):
    """The repository top the folder of plist lies in, or None."""
    d = os.path.dirname(plist)
    while not os.path.isdir(d) and os.path.dirname(d) != d:
        d = os.path.dirname(d)
    try:
        p = subprocess.run(["git", "-C", d, "rev-parse", "--show-toplevel"],
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except OSError:
        return None
    return p.stdout.decode().strip() if p.returncode == 0 and p.stdout.strip() else None


def load_or_empty(path):
    if not os.path.exists(path):
        return {}
    try:
        prefs = load_plist(path)
    except Exception:
        raise Fail("cannot read %s" % path)
    if not isinstance(prefs, dict):
        raise Fail("cannot read %s" % path)
    return prefs


def domain_prefs():
    raw = defaults("export", "com.googlecode.iterm2", "-")
    try:
        prefs = plistlib.loads(raw or b"")
    except Exception:
        raise Fail("cannot read the iTerm2 domain")
    return {k: v for k, v in prefs.items() if syncable(k)}


def truth(kind):
    """The preferences to compare against: "store" (what iTerm2 loads), "domain", or a plist path."""
    if kind == "domain":
        return domain_prefs()
    if kind != "store":
        return load_plist(kind)
    where, plist = current_store()
    if where == "url":
        raise Fail("iTerm2 loads its preferences from a URL")
    return domain_prefs() if where == "domain" else load_or_empty(plist)


def write_atomic(path, data, mode=0o600):
    d = os.path.dirname(path)
    os.makedirs(d, mode=0o700, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".iterm2-prefs.")
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def load_record():
    """The sources as of the last compose, as units."""
    raw = load_or_empty(record_path())
    rec = {}
    try:
        for k, v in raw.get("top", {}).items():
            rec[("top", k)] = v
        for g, keys in raw.get("profiles", {}).items():
            for k, v in keys.items():
                rec[("profile", g, k)] = v
    except AttributeError:
        raise Fail("cannot read %s" % record_path())
    return rec


def dump_record(new):
    raw = {"top": {}, "profiles": {}}
    for u, value in new.items():
        if u[0] == "top":
            raw["top"][u[1]] = value
        else:
            raw["profiles"].setdefault(u[1], {})[u[2]] = value
    return dump_plist(raw)


def frag_dir():
    if os.environ.get("ITERM2_PREFS_FRAGMENTS"):
        return os.environ["ITERM2_PREFS_FRAGMENTS"]
    config = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.environ["HOME"], ".config")
    return os.path.join(config, "iterm2", "prefs.d")


def usage(text):
    sys.stderr.write("iterm2-prefs: usage: iterm2-prefs %s\n" % text)
    return 2


def cmd_lint(args):
    public = args[:1] == ["--public"]
    files = args[1:] if public else args
    if not files or any(a.startswith("-") for a in files):
        return usage("lint [--public] <file>...")
    bad = False
    for path in files:
        for problem in lint_file(path, public)[1]:
            sys.stderr.write("%s: %s\n" % (path, problem))
            bad = True
    return 1 if bad else 0


def sourced(strict=True):
    """(fragments, new, owner, order, ignored) of the fragment directory. A broken fragment fails the
    run when strict; status passes strict=False, it reports and does not refuse."""
    fragments = read_fragments(frag_dir())
    for name, _, probs in fragments if strict else ():
        # a broken fragment would make its keys look as if they had left the sources
        broken = [p for p in probs if not p.startswith("reserved key ")]
        if broken:
            raise Fail("%s: %s; nothing composed" % (os.path.join(frag_dir(), name + ".plist"), broken[0]))
    return (fragments,) + merge(fragments)


def running():
    return os.environ.get("ITERM2_PREFS_RUNNING") == "1"


def moment_truth(running):
    """The domain while iTerm2 runs (its memory is what counts), else the composed file."""
    return domain_prefs() if running else load_or_empty(live_path())


def cmd_compose(args):
    if any(a not in ("--print", "--auto", "--reset") for a in args):
        return usage("compose [--auto] [--reset] [--print]")
    auto, reset, printing = "--auto" in args, "--reset" in args, "--print" in args
    fragments, new, owner, order, ignored = sourced()
    rec = load_record()
    if printing:
        prefs = load_or_empty(live_path())
        apply, kept = three_way(new, rec, units_of(prefs), reset)
        apply_units(prefs, apply, order)
        sys.stdout.buffer.write(dump_plist(prefs))
        return 0
    kind, plist = current_store()
    if not is_installed(kind, plist):
        if auto:
            return 0
        sys.stderr.write("iterm2-prefs: iTerm2 does not load %s (iterm2-prefs install)\n" % store_dir())
        return 1
    if running():
        waiting = len(three_way(new, rec, units_of(domain_prefs()))[0])
        if not auto:
            sys.stderr.write("iterm2-prefs: iTerm2 is running and writes its preferences at quit; "
                             "quit it first (%d source changes wait)\n" % waiting)
            return 1
        if waiting:
            print("iterm2-prefs: %d source changes wait for iTerm2 to quit (then: iterm2-prefs compose)" % waiting)
        return 0
    fresh = not os.path.exists(live_path())
    prefs = load_or_empty(live_path())
    apply, kept = three_way(new, rec, units_of(prefs), reset)
    apply_units(prefs, apply, order)
    if apply or fresh:
        write_atomic(live_path(), dump_plist(prefs))
    write_atomic(record_path(), dump_record(new))
    if apply or kept or ignored:
        print("iterm2-prefs: %d units applied from %d fragments; %d kept as changed in iTerm2 "
              "(iterm2-prefs capture); %d reserved keys ignored" % (len(apply), len(fragments), len(kept), len(ignored)))
    return 0


def cmd_status(args):
    if args not in ([], ["--line"]):
        return usage("status [--line]")
    kind, plist = current_store()
    installed = is_installed(kind, plist)
    waiting = kept = 0
    fragments, new, owner, order, ignored = sourced(False)
    if installed:
        apply, held = three_way(new, load_record(), units_of(moment_truth(running())))
        waiting, kept = len(apply), len(held)
    top = None if installed or kind != "folder" else git_top(plist)
    if args:
        if installed:
            print("composed, in sync" if not (waiting or kept) else "composed, %d waiting, %d kept" % (waiting, kept))
        elif kind == "domain":
            print("not composed (domain)")
        else:
            print("not composed (folder %s%s)" % (plist, ", inside a git repository" if top else ""))
        return 0
    if installed:
        print("store: composed " + live_path())
    elif kind == "domain":
        print("store: domain; not the composed folder (iterm2-prefs install)")
    else:
        print("store: folder %s%s; not the composed folder (iterm2-prefs install)"
              % (plist, ", inside the git repository " + top if top else ""))
    print("iterm2: " + ("running" if running() else "not running"))
    print("fragments: %d%s" % (len(fragments), " (%s)" % " ".join(f[0] for f in fragments) if fragments else ""))
    profile_units = [u for u in new if u[0] == "profile"]
    print("sourced: %d units (%d top-level, %d keys in %d profiles)"
          % (len(new), len(new) - len(profile_units), len(profile_units), len({u[1] for u in profile_units})))
    if installed:
        print("waiting: %d source changes not in the store" % waiting)
        print("kept: %d units changed in iTerm2 (iterm2-prefs capture)" % kept)
    print("ignored: %d reserved keys in fragments%s"
          % (len(ignored), ": " + " ".join("%s:%s" % i for i in ignored) if ignored else ""))
    try:
        skipped = len([n for n in os.listdir(frag_dir()) if not (FRAGMENT_NAME.fullmatch(n) and os.path.isfile(os.path.join(frag_dir(), n)))])
    except OSError:
        skipped = 0
    if skipped:
        print("skipped: %d files in %s not named NN-<name>.plist" % (skipped, frag_dir()))
    return 0


class Raw:
    def __init__(self, text):
        self.text = text

    def __repr__(self):
        return self.text


def show(value):
    """repr cut at 200 characters, a data value as <data N bytes>."""
    def hide(v):
        if isinstance(v, bytes):
            return Raw("<data %d bytes>" % len(v))
        if isinstance(v, list):
            return [hide(x) for x in v]
        if isinstance(v, dict):
            return {k: hide(x) for k, x in v.items()}
        return v
    return repr(hide(value))[:200]


CAPTURE_USAGE = ("capture [--from domain|store|<plist>] [--all] [--values] [--owned <fragment>] "
                 "[<unit>...] [--into <fragment> | --file <plist>]")


def cmd_capture(args):
    flags, opts, positional = set(), {}, []
    rest = iter(args)
    for a in rest:
        if a in ("--all", "--values"):
            flags.add(a)
        elif a in ("--from", "--owned", "--file"):
            v = next(rest, None)
            if v is None or a in opts:
                return usage(CAPTURE_USAGE)
            opts[a] = v
        elif a.startswith("-"):
            return usage(CAPTURE_USAGE)
        else:
            positional.append(a)
    dest = opts.get("--file")
    if bool(dest) != bool(positional or "--owned" in opts):
        return usage(CAPTURE_USAGE)
    fragments, new, owner, order, ignored = sourced(False)
    where = opts.get("--from") or ("domain" if running() else "store")
    try:
        tp = truth(where)
    except Fail:
        raise
    except Exception:
        raise Fail("cannot read %s" % where)
    if not isinstance(tp, dict):
        raise Fail("cannot read %s" % where)
    cur = units_of(tp)
    differ = [u for u in new if not same(cur.get(u, MISSING), new[u])]

    if dest:
        sel = []
        for text in positional:
            u = parse_unit(text)
            if reserved(u):
                raise Fail("%s is reserved and cannot be captured" % text)
            if u == ("top", "New Bookmarks") or (u[0] == "profile" and (not u[1] or u[2] == "Guid")):
                raise Fail("%s is not a unit" % text)
            sel += [x for x in cur if x[:2] == u[:2]] if u[0] == "profile" and u[2] is None else [u]
        if "--owned" in opts:
            if opts["--owned"] not in [f[0] for f in fragments]:
                raise Fail("no fragment named %s" % opts["--owned"])
            sel += [u for u in differ if owner[u] == opts["--owned"]]
        sel = list(dict.fromkeys(sel))
        real = os.path.realpath(dest)
        if real in (os.path.realpath(live_path()), os.path.realpath(record_path())) \
                or os.path.dirname(real) == os.path.realpath(frag_dir()):
            raise Fail("%s is a deployed file, not a source; capture into the chezmoi source" % dest)
        out = load_or_empty(dest)
        guids = list(dict.fromkeys(u[1] for u in sel if u[0] == "profile"))
        apply_units(out, {u: cur.get(u, MISSING) for u in sel}, guids)
        profs = out.get("New Bookmarks")
        if isinstance(profs, list):
            out["New Bookmarks"] = [p for p in profs if not (isinstance(p, dict) and p.get("Guid") in guids and len(p) == 1)]
            if not out["New Bookmarks"]:
                del out["New Bookmarks"]
        os.makedirs(os.path.dirname(real), exist_ok=True)
        write_atomic(dest, dump_plist(out), os.stat(dest).st_mode & 0o777 if os.path.exists(dest) else 0o644)
        print("iterm2-prefs: wrote %d units to %s; commit it there, then run dotfiles" % (len(sel), dest))
        return 0

    changed = absent = 0
    for u in differ:
        c = cur.get(u, MISSING)
        if c is MISSING:
            absent += 1
            print("absent\t%s\t%s" % (unit_text(u), owner[u]))
        else:
            changed += 1
            row = "changed\t%s\t%s" % (unit_text(u), owner[u])
            print(row + ("\t%s\t%s" % (show(new[u]), show(c)) if "--values" in flags else ""))
    summary = "%d changed, %d absent" % (changed, absent)
    if "--all" in flags:
        profs = tp.get("New Bookmarks")
        dyn = {p["Guid"] for p in (profs if isinstance(profs, list) else [])
               if isinstance(p, dict) and isinstance(p.get("Guid"), str) and any(k.startswith("Dynamic Profile") for k in p)}
        extra = sorted((u for u in cur if u not in new and (u[0] == "top" or u[1] not in dyn)), key=unit_text)
        for u in extra:
            print("unsourced\t%s\t-" % unit_text(u))
        summary += ", %d unsourced" % len(extra) + ("; %d dynamic profiles not listed" % len(dyn) if dyn else "")
    sys.stderr.write("iterm2-prefs: %s\n" % summary)
    return 0


def main():
    verb, args = sys.argv[1], sys.argv[2:]
    try:
        return {"lint": cmd_lint, "compose": cmd_compose, "status": cmd_status, "capture": cmd_capture}[verb](args)
    except Fail as e:
        sys.stderr.write("iterm2-prefs: %s\n" % e)
        return 1


sys.exit(main())
PYEOF
}

# The Python reads whether iTerm2 runs from this, so ps is asked once and in shell.
go() {
  if proc_running iTerm2; then ITERM2_PREFS_RUNNING=1; else ITERM2_PREFS_RUNNING=0; fi
  export ITERM2_PREFS_RUNNING
  prefs_py "$@"
}

# The chezmoi source path of a deployed fragment: the default config first, then
# each overlay config, as dotfiles() enumerates them. The first answer that is a
# file wins; `source-path` of an unmanaged target exits 1.
frag_source() {
  _t=${ITERM2_PREFS_FRAGMENTS:-${XDG_CONFIG_HOME:-$HOME/.config}/iterm2/prefs.d}/$1.plist
  _p=$(chezmoi source-path "$_t" 2>/dev/null) && [ -f "$_p" ] && { printf '%s\n' "$_p"; return 0; }
  for _c in "${XDG_CONFIG_HOME:-$HOME/.config}"/chezmoi/*.toml; do
    [ -f "$_c" ] && [ "${_c##*/}" != chezmoi.toml ] || continue
    _p=$(chezmoi --config "$_c" source-path "$_t" 2>/dev/null) && [ -f "$_p" ] && { printf '%s\n' "$_p"; return 0; }
  done
  warn "no chezmoi source manages $_t"
  return 1
}

case ${1:-} in
  lint) shift; prefs_py lint "$@";;
  compose)
    case " $* " in
      *" --print "*) ;;
      *) need_macos compose;;
    esac
    shift; go compose "$@";;
  status) need_macos status; shift; go status "$@";;
  capture)
    shift
    # --into <fragment> becomes --file <chezmoi source path>; --from decides whether this needs macOS
    from='' n=$#
    while [ "$n" -gt 0 ]; do
      a=$1; shift; n=$((n - 1))
      case $a in
        --from) from=${1:-}; set -- "$@" "$a";;
        --into)
          if [ "$n" -gt 0 ]; then
            p=$(frag_source "$1") || exit 1
            shift; n=$((n - 1))
            set -- "$@" --file "$p"
          else
            set -- "$@" "$a"
          fi;;
        *) set -- "$@" "$a";;
      esac
    done
    case $from in ''|domain|store) need_macos capture;; esac
    go capture "$@";;
  install) die "$1 is not built yet";;
  -h|--help|help) usage;;
  '') usage >&2; exit 2;;
  *) warn "unknown verb: $1"; usage >&2; exit 2;;
esac
