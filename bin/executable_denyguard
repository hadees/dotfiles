#!/bin/sh
# denyguard — a profile's permissions.deny, enforced on Bash too.
#
# Claude Code's Read/Edit deny rules only ever bind those two tools. Bash is
# not covered: `grep -c foo ~/code/<denied>/CLAUDE.md` from a session whose
# profile denies Read on that tree returns a count anyway, and Claude Code's
# own auto mode *prefers* Bash (cat, grep, sed) over Read — so the bypass is
# the default path, not an exotic one. denyguard is a PreToolUse hook on
# Bash that reads the same `permissions.deny` list the profile already
# carries — no second list anywhere — and refuses any command whose literal
# path tokens, glob prefixes, or cwd land inside a denied tree.
#
# Honesty about reach, up front: Claude Code already applies Read/Edit deny
# rules to the Bash commands it recognises (cat, head, tail, sed, tee) and to
# redirection targets, and its own docs say plainly that this does not cover
# "a command that reads files without naming them, such as `grep -r pattern
# .`" or a script that opens files itself (permissions doc, "Read and Edit",
# Warning box). denyguard widens coverage to *every* command that names a
# denied path in its literal text — grep, rg, ls, find, wc, awk, diff,
# git -C, python file arguments, -exec arguments, heredoc bodies, the whole
# command string is scanned — to globs that could expand into one, to
# relative paths and `cd` targets resolved against the hook's cwd, to
# symlinks whose target is denied, and to a session whose cwd already is.
#
# It is still a LEXICAL guard, not a sandbox, and cannot see a path that
# only exists at run time: a shell variable other than $HOME, `$(...)`
# output, a script file's own contents, `find <parent> -exec` without a
# recursive tell, `eval`, base64, or a program that computes the path by any
# means. Also invisible: a heredoc written to a FILE by cat/tee and executed
# later — the write itself is data (so it is scanned for a direct hit only,
# never an ancestor guess, letting prose that names a denied path pass), but
# whatever ends up in that file is unseen the moment it runs as its own
# command. The line that OPENS a heredoc is not data: it is scanned whole,
# less the `<<WORD` operator, so a redirect or a command written after the
# marker is read like any other. And only a `<<WORD` that a later line
# terminates opens one — `<<<`, a shift inside `$(( ))`, and an opener with
# no terminator leave every line under the full rule set.
# That is a guard against the accidental and default case (Bash
# preferred over Read), not against a determined command. OS-level
# enforcement exists — the Bash sandbox's `sandbox.filesystem.denyRead`
# applies to "all commands running inside the sandbox, including their
# child processes" — and is deliberately NOT this change: it needs the
# sandbox on, changes what a session can do with paths it is allowed to
# read too, and is a bigger step than closing the one hole this fixes. If
# the lexical gaps above ever matter more than the setup cost, that key is
# the upgrade path.
#
# Fails CLOSED, on purpose, and this is the one place in this repo that
# does. The tailnet wrappers fail open because routing there is an
# optimisation and the command is the point; here the *refusal* is the
# point, and a guard that silently becomes a no-op would leave the operator
# believing the hole is closed — worse than the hole itself. Missing
# python3, an unreadable or unparsable settings.json: exit 2, which blocks
# the tool call (hooks reference §3: exit 2 blocks unconditionally, with or
# without JSON on stdout). An ABSENT permissions.deny is read as zero rules
# and allowed — that is the correct reading of an empty list, not a
# failure. The one way this still fails open is documented by Claude Code
# itself and cannot be fixed from here: a hook that TIMES OUT does not
# block ("don't count on a stalled hook to act as a gate" — hooks reference
# §4). So this script does no network, no subprocesses, and only stats
# paths it has not already ruled on lexically; the wiring's `timeout: 10`
# (see `denyguard settings`) exists so a wedged mount cannot hold a whole
# turn for the 600s default instead.
#
# Usage:
#   denyguard hook               PreToolUse hook body; reads the event JSON
#                                 from stdin, examines tool_input.command for
#                                 Bash and every string leaf otherwise.
#   denyguard rules [--profile DIR]
#                                 one line per Read/Edit path rule in the
#                                 profile's settings.json: tool, rule as
#                                 written, resolved absolute prefix, kind.
#   denyguard check [--profile DIR] PATH...
#                                 does PATH fall inside (or contain) one of
#                                 the profile's denied trees? — the boundary
#                                 test a working-set opener can reuse rather
#                                 than carrying its own scanner.
#   denyguard settings            the PreToolUse hook block to paste into a
#                                 profile's settings.json (overlay-owned;
#                                 this script never edits one).
#   denyguard dir                 the profile directory this invocation reads.
# env:
#   CLAUDE_CONFIG_DIR   the profile directory (else $HOME/.claude — the same
#                       default claude() and postbox use unset, not spelled
#                       out, so the default profile is addressed the same
#                       way everywhere).
#   DENYGUARD_LOG       overrides the denial log path (tests).
set -eu

command -v python3 >/dev/null 2>&1 || {
  printf 'denyguard: python3 not found; refusing Bash until python3 is installed (Brewfile / packages-apt.txt declare it)\n' >&2
  exit 2
}

# `python3 -` reads its own program from stdin, which the heredoc below
# already occupies — so `hook`'s PreToolUse payload (also arriving on
# stdin) is saved to fd 3 first and read from there once inside. postbox's
# heredocs sidestep it by passing a filename in argv instead, which a hook
# has none of.
exec 3<&0
rc=0
python3 - "$@" <<'PY' || rc=$?
import fnmatch
import json
import os
import re
import sys
import time

HOME = os.environ.get("HOME", "")
GLOB_CHARS = set("*?[")
# Directories one command line is followed through (scan). A relative `cd`
# is joined to every directory already listed, so the list doubles at each
# one: 64 holds six descending relative `cd`s. Past it scan refuses.
MAX_BASES = 64
# A command word that is recursive by nature — no flag needed.
DEFAULT_RECURSIVE = {
    "find", "fd", "rg", "ag", "ack", "du", "tree", "tar", "zip", "rsync",
}
# A command word that is recursive only with one of these flags present,
# as a standalone `--long` form or inside a `-xyz` short-flag cluster.
FLAG_RECURSIVE = {
    "cp": {"-r", "-R", "-a", "--recursive", "--archive"},
    "scp": {"-r", "-R", "--recursive"},
    "rm": {"-r", "-R", "--recursive"},
    "chmod": {"-r", "-R", "--recursive"},
    "chown": {"-r", "-R", "--recursive"},
    "chgrp": {"-r", "-R", "--recursive"},
    "diff": {"-r", "-R", "--recursive"},
    "ls": {"-R", "--recursive"},
}
# A command word that, with no path argument, searches the directory it
# stands in (implicit_cwd adds grep -r and ls -R).
IMPLICIT_CWD = {"find", "fd", "rg", "ag", "ack", "du", "tree"}
GREP_LIKE = {"grep", "egrep", "fgrep"}
GREP_RECURSIVE_FLAGS = {"-r", "-R", "--recursive", "--dereference-recursive"}
# Commands whose first positional is a search pattern, never a place (names_root).
PATTERN_FIRST = GREP_LIKE | {"rg", "ag", "ack", "fd"}
# Programs that read stdin, not the directory, when a pipe feeds them and
# they are given no path (rg's usage text lists `command | rg PATTERN`).
STDIN_SEARCHERS = {"rg", "ack"}
RULE_RE = re.compile(r"^(Read|Edit)\((.+)\)$")
# Split a command string the way a lexical (not a real shell) scanner can:
# on whitespace, the metacharacters that separate commands/arguments, and
# both quote characters — good enough to find path-shaped tokens, not a
# parser.
SPLIT_RE = re.compile(r"""[\s;|&()<>'"]+""")
# Split a heredoc-free fragment into simple commands on the separators a
# shell would treat as ending one command and starting the next.
SEP_RE = re.compile(r"(\|\||&&|[;|&()])")
# `<<WORD`, `<<-WORD`, `<<'WORD'`, `<<"WORD"` — the body runs to a line
# that equals WORD (leading whitespace ignored only for the `<<-` form).
# Never `<<<`: a here-string takes one word and has no body. A match is
# only a candidate — `heredoc_of` decides whether it opens anything.
HEREDOC_RE = re.compile(r"(?<!<)<<(?!<)(-)?\s*(['\"]?)(\w+)\2")
# A heredoc fed to one of these, unpiped, is DATA being written — text
# about a path, not a path being opened — so only a direct hit still
# refuses it; every other consumer (an interpreter, or any piped body)
# keeps the full rule set, including the ancestor/recursion check.
DATA_HEREDOC_CONSUMERS = {"cat", "tee", "printf"}
# `cat <<EOF` inside `$( )` hands its output to the command around it. Under
# these that output is text (a message, a body, a value); under anything else
# (`bash -c`, `ssh`, `eval`, an unknown tool) it may be run.
SUBSTITUTION_HOSTS = {"git", "gh", "local", "export", "declare", "typeset", "readonly"}
ASSIGNMENT_RE = re.compile(r"^[A-Za-z_]\w*=")
# `~` counts as $HOME only at the start of a token or right after `=`/`:`
# (VAR=~/x, --opt=~/x) — a bare `~` elsewhere is an ordinary character.
TILDE_RE = re.compile(r"""(?:(?<=[\s;|&()<>'"=:])~|^~)(?=/|$)""")


def profile_dir(explicit=None):
    if explicit:
        return os.path.expanduser(explicit)
    return os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(HOME, ".claude")


def load_deny(dir_):
    # A settings.json that is simply ABSENT means no rules, not a failure. The
    # public repo ships none — every profile's is overlay-owned — so a stranger
    # who wires this hook through a project-level .claude/settings.json has no
    # profile settings file at all, and refusing there would deny every Bash
    # call in the project while naming a remedy that cannot exist for them.
    # Unreadable or unparsable is the opposite case: something is configured
    # and we cannot tell what it forbids, so refuse and name the file we tried.
    path = os.path.join(dir_, "settings.json")
    try:
        with open(path) as f:
            data = json.load(f)
    except FileNotFoundError:
        return []
    except Exception as exc:
        sys.stderr.write(
            "denyguard: cannot read %s: %s; refusing Bash until that file is "
            "readable JSON\n" % (path, exc)
        )
        sys.exit(2)
    bad = None
    if not isinstance(data, dict):
        bad = "the top level is not an object"
    else:
        perms = data.get("permissions")
        if perms is not None and not isinstance(perms, dict):
            bad = "permissions is not an object"
        else:
            deny_list = (perms or {}).get("deny")
            if deny_list is not None and not isinstance(deny_list, list):
                bad = "permissions.deny is not a list"
            elif deny_list and not all(isinstance(r, str) for r in deny_list):
                bad = "permissions.deny holds an entry that is not a string"
    if bad:
        sys.stderr.write(
            "denyguard: cannot read %s: %s; refusing Bash until that file is "
            "readable JSON\n" % (path, bad)
        )
        sys.exit(2)
    return (data.get("permissions") or {}).get("deny") or []


FIRMLINK = "/System/Volumes/Data"


def fold(text):
    """The case a comparison is made in: the default macOS volume is case-
    insensitive, so two spellings of one path differ only in case there.
    On a case-sensitive volume that over-refuses, the strict side."""
    return text.casefold() if sys.platform == "darwin" else text


def canon(path):
    """One spelling for two spellings of a path: normalised, a leading
    double slash (which normpath keeps) collapsed, the Data-volume firmlink
    prefix (which realpath does not resolve) dropped on macOS, then folded."""
    path = os.path.normpath(path)
    if path.startswith("//"):
        path = path[1:]
    if sys.platform == "darwin" and path.startswith(FIRMLINK + "/"):
        path = path[len(FIRMLINK):]
    return fold(path)


class Rule:
    __slots__ = ("tool", "raw", "anchor", "prefix", "kind", "pattern",
                 "evaluable", "keys", "pattern_key")

    def __init__(self, tool, raw, anchor, prefix, kind, pattern, evaluable):
        self.tool = tool
        self.raw = raw
        self.anchor = anchor
        self.prefix = prefix
        self.kind = kind
        self.pattern = pattern
        self.evaluable = evaluable
        # prefix and pattern stay as written, for display; comparisons use
        # these. The prefix as written and its realpath: a rule named
        # through a symlinked ancestor binds the real spelling too.
        self.keys = () if prefix is None else tuple(dict.fromkeys(
            (canon(prefix), canon(os.path.realpath(prefix)))))
        self.pattern_key = fold(pattern)


def inside(key, rule):
    """Is the canonical `key` one of the rule's trees, or under one?"""
    return any(key == k or key.startswith(os.path.join(k, "")) for k in rule.keys)


def ancestor_of(key, rule):
    """Is the canonical `key` a strict ancestor of one of the rule's trees?"""
    return any(k != key and k.startswith(os.path.join(key, "")) for k in rule.keys)


def strip_recursive_suffix(s):
    for suf in ("/**/*", "/**"):
        if s.endswith(suf):
            return s[: -len(suf)]
    return s


def literal_prefix(path):
    """Text before the first glob character, cut back to the last `/` —
    a glob rule's fixed directory (a command's glob goes to glob_reach)."""
    idx = next((i for i, c in enumerate(path) if c in GLOB_CHARS), None)
    if idx is None:
        return path
    head = path[:idx]
    pos = head.rfind("/")
    return head[:pos] if pos >= 0 else ""


def parse_rule(tool, path_str, cwd):
    """cwd resolves a project-relative rule (hook); None (check, rules)
    leaves it unevaluable — the frozen normalisation table's own split."""
    raw = "%s(%s)" % (tool, path_str)
    if path_str == "~":
        anchor, core = "home", ""
    elif path_str.startswith("~/"):
        anchor, core = "home", path_str[2:]
    elif path_str.startswith("//"):
        anchor, core = "root", path_str[1:]
    elif path_str.startswith("/"):
        anchor, core = "project-relative", path_str[1:]
    else:
        anchor, core = "any-depth", path_str

    trimmed = strip_recursive_suffix(core)
    has_glob = any(c in trimmed for c in GLOB_CHARS)

    if anchor == "any-depth":
        # A gitignore-style bare pattern matches at any depth, so it never
        # has one absolute prefix — always "glob" kind, matched separately.
        return Rule(tool, raw, anchor, None, "glob", trimmed, True)

    kind = "glob" if has_glob else "prefix"
    literal = literal_prefix(trimmed) if kind == "glob" else trimmed

    if anchor == "home":
        prefix = os.path.normpath(os.path.join(HOME, literal)) if literal else HOME
        evaluable = True
    elif anchor == "root":
        prefix = os.path.normpath(literal) if literal else "/"
        evaluable = True
    else:  # project-relative
        if cwd is None:
            prefix, evaluable = None, False
        else:
            prefix = os.path.normpath(os.path.join(cwd, literal)) if literal else os.path.normpath(cwd)
            evaluable = True

    return Rule(tool, raw, anchor, prefix, kind, trimmed, evaluable)


def parse_deny_list(deny_list, cwd):
    rules = []
    for entry in deny_list:
        m = RULE_RE.match(entry)
        if not m:
            continue  # Write(...)/Glob(...) etc. carry no path rule (doc).
        rules.append(parse_rule(m.group(1), m.group(2), cwd))
    return rules


def match_any_depth(path, pattern):
    """Both arguments already canonical (case is fold's business alone)."""
    if fnmatch.fnmatchcase(path, pattern) or fnmatch.fnmatchcase(path, "*/" + pattern):
        return True
    return any(fnmatch.fnmatchcase(part, pattern) for part in path.split(os.sep) if part)


def split_words(text):
    return [t for t in SPLIT_RE.split(text) if t]


def command_word_of(words):
    return os.path.basename(words[0]) if words else ""


def has_short_or_long_flag(words, flags):
    """`flags` holds `-x`/`-X`/`--long` spellings; a `-x` also matches
    inside a short cluster like `-ltr` or `-Rf`, never `--long`."""
    short_letters = {f[1] for f in flags if len(f) == 2 and f[0] == "-"}
    longs = {f for f in flags if f.startswith("--")}
    for w in words[1:]:
        if w in longs:
            return True
        if w.startswith("--"):
            continue
        if w.startswith("-") and len(w) > 1:
            if any(c in short_letters for c in w[1:]):
                return True
    return False


def recursion_signal(words, command_word):
    """Is this ONE simple command, by itself, a real recursion signal? —
    a command word that always recurses, or one that recurses only with an
    explicit flag. A bare mention of a recursive-sounding word, or a flag
    cluster that merely contains the letter r/R for an unrelated reason
    (`sort -nr`, `ls -ltr`, `sed -r`, `xargs -r`), is not a signal."""
    if not words:
        return False
    if command_word in DEFAULT_RECURSIVE:
        return True
    if command_word in GREP_LIKE:
        if has_short_or_long_flag(words, GREP_RECURSIVE_FLAGS):
            return True
        for i, w in enumerate(words[1:-1], 1):
            if w == "-d" and words[i + 1] == "recurse":
                return True
        return False
    flags = FLAG_RECURSIVE.get(command_word)
    return bool(flags) and has_short_or_long_flag(words, flags)


def split_simple_commands(text):
    """A heredoc-free fragment, split on `; && || | & ( )` into simple
    commands: (words, command_word, is_heredoc_body=False, is_data=False,
    piped_in) — piped_in is true when exactly `|` or `|&` sits between this
    command and the previous one on the line."""
    segments = []
    current = []
    seps = ""
    for part in SEP_RE.split(text) + [None]:
        if part is not None and not SEP_RE.fullmatch(part):
            current.append(part)
            continue
        words = split_words("".join(current))
        current = []
        if words:
            segments.append((words, command_word_of(words), False, False,
                             bool(segments) and seps in ("|", "|&")))
            seps = ""
        if part is not None:
            seps += part
    return segments


def heredoc_consumer(head):
    """Whose heredoc is it? `head` is the opener line up to the `<<`: the
    consumer is the command word of its LAST simple command, the one the
    operator is written in. `substituted` is true when that command is opened
    by `$(`; `host` is then the command that takes the substitution's output
    as an argument (assignment words skipped; empty for a plain assignment)."""
    parts = SEP_RE.split(head)  # text, separator, text, separator, ...
    for k in range(len(parts) - 1, -1, -2):
        words = split_words(parts[k])
        if words:
            break
    else:
        return "", False, ""
    if k < 2 or parts[k - 1] != "(" or not parts[k - 2].endswith("$"):
        return command_word_of(words), False, ""
    host_words = split_words(parts[k - 2][:-1])
    while host_words and ASSIGNMENT_RE.match(host_words[0]):
        host_words.pop(0)
    return command_word_of(words), True, command_word_of(host_words)


def heredoc_of(lines, i, last_exact, last_stripped):
    """The heredoc `lines[i]` opens, as (match, terminator_index) — or None.
    Reading a line as a heredoc opener only ever RELAXES the scan (a data
    body is checked for a direct hit only), so every doubtful candidate is
    turned down: a shift inside `$(( ))`, and any `<<WORD` that no later
    line terminates. A real shell reads an unterminated heredoc to end of
    input as body; scanning those lines as commands is the stricter
    reading. `last_exact`/`last_stripped` map a line (as written /
    whitespace-stripped, for `<<-`) to the last index it occurs at, so a
    candidate with no terminator costs one lookup, not a walk to the end."""
    line = lines[i]
    for m in HEREDOC_RE.finditer(line):
        head = line[: m.start()]
        if head.count("((") > head.count("))"):
            continue  # inside an unclosed `((`: arithmetic, not a redirection
        dash, delim = m.group(1), m.group(3)
        last = (last_stripped if dash else last_exact).get(delim, -1)
        for j in range(i + 1, last + 1):
            if (lines[j].strip() if dash else lines[j]) == delim:
                return m, j
    return None


def segments_of(text):
    """Every simple command in `text`, in order, as (words, command_word,
    is_heredoc_body, is_data, piped_in) — a heredoc body is its own run of
    segments carrying the word that opened it and whether that body is DATA
    (fed to cat/tee/printf, unpiped) or kept under the full rule set. The line that
    opens a heredoc is a command line like any other: it is scanned whole,
    less the `<<WORD` operator itself, so a redirect, an argument or a
    chained command written after the marker is never skipped."""
    lines = text.split("\n")
    segments = []
    last_exact, last_stripped = {}, {}
    if "<<" in text:
        for k, entry in enumerate(lines):
            last_exact[entry] = k
            last_stripped[entry.strip()] = k
    i, n = 0, len(lines)
    while i < n:
        line = lines[i]
        opener = heredoc_of(lines, i, last_exact, last_stripped) if "<<" in line else None
        if opener is None:
            segments.extend(split_simple_commands(line))
            i += 1
            continue
        m, end = opener
        head, tail = line[: m.start()], line[m.end():]
        # Head and tail are one command line with the operator lifted out —
        # joined, not scanned apart, so `grep -r x <<EOF dir` keeps its
        # recursion signal and its directory in the same simple command.
        segments.extend(split_simple_commands(head + " " + tail))
        consumer, substituted, host = heredoc_consumer(head)
        is_data = (consumer in DATA_HEREDOC_CONSUMERS and "|" not in tail
                   and (not substituted or not host or host in SUBSTITUTION_HOSTS))
        for body_line in lines[i + 1:end]:
            if is_data:
                words = split_words(body_line)
                if words:
                    segments.append((words, consumer, True, True, False))
            else:
                for words, cw, _, _, piped in split_simple_commands(body_line):
                    segments.append((words, cw, True, False, piped))
        i = end + 1
    return segments


def substitute_home(text):
    if not HOME:
        return text
    text = text.replace("${HOME}", HOME).replace("$HOME", HOME)
    return TILDE_RE.sub(HOME, text)


def candidate_of_token(raw_tok, cwd, recursive=False):
    """`raw_tok`, resolved against `cwd`, plus a realpath variant (deny rules
    apply to a symlink and its target alike — doc, "Symlinks"); a path that
    does not exist yet gets one too, resolved as far as it exists. Each
    item is (raw_token, resolved_absolute_path, has_glob_chars); empty when
    the token is a bare word matching no file (just a word, not a path) —
    except a slash-less glob under a recursive command, which names
    whatever it matches there."""
    tok = substitute_home(raw_tok)
    has_glob = any(c in tok for c in GLOB_CHARS)
    if tok.startswith("/"):
        resolved = os.path.normpath(tok)
    elif tok.startswith("./") or tok.startswith("../") or "/" in tok:
        resolved = os.path.normpath(os.path.join(cwd, tok))
    else:
        candidate = os.path.join(cwd, tok)
        if not os.path.lexists(candidate) and not (has_glob and recursive):
            return []
        resolved = os.path.normpath(candidate)
    out = [(raw_tok, resolved, has_glob)]
    if not has_glob:
        rp = os.path.realpath(resolved)
        if rp != resolved:
            out.append((raw_tok, rp, False))
    return out


def token_variants(raw_tok):
    """The token, the text after its first `=` (`--opt=PATH`, dd's
    `key=PATH`), then each of those without a leading `@` (curl's `@PATH`).
    No duplicates, no empty strings."""
    base = [raw_tok, raw_tok.partition("=")[2]]
    out = []
    for v in base + [b[1:] for b in base if b.startswith("@")]:
        if v and v not in out:
            out.append(v)
    return out


def cd_targets(words, command_word, bases):
    """The absolute directories a `cd`/`pushd` simple command can leave the
    shell in, one per entry of `bases` for a relative target (none for a
    target unknown at scan time: `$...`, a backtick, or `-`). With no target
    word, home."""
    if command_word not in ("cd", "pushd"):
        return []
    target = next((w for w in words[1:] if w == "-" or not w.startswith("-")), None)
    if target == "-" or (target and ("$" in target or "`" in target)):
        return []
    target = substitute_home(target) if target else HOME
    if not target:
        return []
    if target.startswith("/"):
        return [os.path.normpath(target)]
    return [os.path.normpath(os.path.join(b, target)) for b in bases]


def implicit_cwd(words, command_word):
    """Does this ONE simple command search the directory it stands in when
    it is given no path? Never for a `--help` or `--version` call."""
    if "--help" in words or "--version" in words:
        return False
    if command_word in IMPLICIT_CWD:
        return True
    return (command_word in GREP_LIKE or command_word == "ls") \
        and recursion_signal(words, command_word)


def names_root(words, command_word, bases):
    """Does this ONE recursive simple command name a place to search? Decided
    by position and by existence, never by whether a word looks like a path:
    an option's value and the search pattern can both look like one. `find`
    takes its roots first, so the first word after its leading options is
    one. Elsewhere a positional (a word after the options, or after a lone
    `--`) counts when it has a glob character or exists; the first
    positional of a pattern-first command is the pattern, and a positional
    straight after an option may be that option's value, so neither counts
    (bar the options known to take none)."""
    rest = words[1:]
    if command_word == "find":
        i = 0
        while i < len(rest):
            if rest[i] in ("-H", "-L", "-P") or rest[i].startswith("-O"):
                i += 1
            elif rest[i] == "-D":
                i += 2
            else:
                break
        return i < len(rest) and not rest[i].startswith("-") and rest[i] != "!"
    pattern_first = command_word in PATTERN_FIRST
    if command_word in GREP_LIKE | {"rg", "ack"} and any(
            w == "--files" or w.startswith(("--regexp=", "--file=")) for w in rest):
        pattern_first = False
    options_over = False
    option = None  # the option the previous word was, if it was one
    number = 0
    for w in rest:
        if not options_over and w == "--":
            options_over, option = True, None
            continue
        if not options_over and w.startswith("-") and len(w) > 1:
            option = w
            continue
        number += 1
        guarded = option is not None and (
            (command_word in PATTERN_FIRST
             and option != "--files" and option not in GREP_RECURSIVE_FLAGS)
            or (command_word not in PATTERN_FIRST
                and (option.startswith("--") or option[-1] in "PI")))
        option = None
        if guarded or (pattern_first and number == 1):
            continue
        tok = substitute_home(w)
        if any(c in tok for c in GLOB_CHARS):
            return True
        if tok.startswith("/"):
            if os.path.lexists(tok):
                return True
        elif any(os.path.lexists(os.path.join(b, tok)) for b in bases):
            return True
    return False


def glob_reach(cand, prefix):
    """How an absolute glob-bearing `cand` can reach the denied `prefix`:
    "inside" (it can name the tree or something in it), "ancestor" (only a
    directory above it) or "" (neither). Components are compared one by
    one, so `.claude*` cannot name `~/code/x` just because both sit under
    the home directory. Case-sensitive on purpose (fnmatchcase)."""
    cparts = [p for p in cand.split("/") if p]
    pparts = [p for p in prefix.split("/") if p]
    for i, pp in enumerate(pparts):
        if i == len(cparts):
            return "ancestor"
        cp = cparts[i]
        if cp == "**":
            return "inside"
        if any(c in cp for c in GLOB_CHARS):
            if not fnmatch.fnmatchcase(pp, cp):
                return ""
        elif cp != pp:
            return ""
    return "inside"


def scan(text, cwd, rules):
    """First rule this text trips, as (fragment, rule, reason) — or None.
    A recursion signal only counts within the SAME simple command as the
    candidate token (`segments_of`); a data heredoc body never counts as
    one, so an ancestor guess never fires there — only a direct hit does.
    `bases` are the directories a relative token may be relative to: the
    cwd, then every directory a `cd`/`pushd` earlier in the text could have
    left the shell in. It only grows — a subshell's `cd` is not undone, the
    strict reading — and a `cd` that would take it past MAX_BASES is refused
    (rule None), not dropped. No rules, nothing to protect: None at once.
    A recursive command that names no search root (names_root) starts at
    each base: a base above a denied tree is refused. A slash-less glob is a
    path under a recursive command only."""
    if not rules:
        return None
    bases = [cwd]
    for words, command_word, is_heredoc, is_data, piped_in in segments_of(text):
        recursive = False if is_data else recursion_signal(words, command_word)
        for raw_tok in words:
            seen = set()
            cands = []
            for v in token_variants(raw_tok):
                for b in bases:
                    for c in candidate_of_token(v, b, recursive):
                        if c[1:] not in seen:
                            seen.add(c[1:])
                            cands.append(c)
            for tok, cand, has_glob in cands:
                key = canon(cand)
                if has_glob:
                    for rule in rules:
                        for k in rule.keys:
                            reach = glob_reach(key, k)
                            if reach == "inside":
                                return tok, rule, "%s may expand into %s" % (tok, rule.raw)
                            if reach == "ancestor" and recursive:
                                return tok, rule, (
                                    "%s is an ancestor of %s and %s recurses here; "
                                    "name the file under it directly, or drop the "
                                    "recursive flag" % (tok, rule.raw, command_word)
                                )
                    continue
                for rule in rules:
                    if rule.anchor == "any-depth":
                        if match_any_depth(key, rule.pattern_key):
                            return tok, rule, "%s is inside %s" % (tok, rule.raw)
                        continue
                    if inside(key, rule):
                        return tok, rule, "%s is inside %s" % (tok, rule.raw)
                    if not recursive or not ancestor_of(key, rule):
                        continue
                    return tok, rule, (
                        "%s is an ancestor of %s and %s recurses here; "
                        "name the file under it directly, or drop the "
                        "recursive flag" % (tok, rule.raw, command_word)
                    )
        if recursive and implicit_cwd(words, command_word) \
                and not (piped_in and command_word in STDIN_SEARCHERS) \
                and not names_root(words, command_word, bases):
            for b in bases:
                for rule in rules:
                    if ancestor_of(canon(b), rule):
                        return " ".join(words), rule, (
                            "%s recurses from %s, an ancestor of %s; name an "
                            "existing directory under it, after the pattern%s"
                            % (command_word, b, rule.raw, " (this line is "
                               "inside a heredoc read as commands; pass "
                               "prose through cat)" if is_heredoc else "")
                        )
        for d in cd_targets(words, command_word, bases):
            if d in bases:
                continue
            if len(bases) >= MAX_BASES:
                return " ".join(words), None, (
                    "this command line changes directory in more ways than "
                    "denyguard follows (limit %d), so a relative path after "
                    "it cannot be checked; split the command, or use "
                    "absolute paths" % MAX_BASES
                )
            bases.append(d)
    return None


def cwd_hit(cwd, rules):
    cands = {canon(cwd), canon(os.path.realpath(cwd))}
    for rule in rules:
        for cand in cands:
            if inside(cand, rule):
                return rule
    return None


def strings_of(obj):
    if isinstance(obj, str):
        yield obj
    elif isinstance(obj, dict):
        for v in obj.values():
            for s in strings_of(v):
                yield s
    elif isinstance(obj, list):
        for v in obj:
            for s in strings_of(v):
                yield s


def log_denial(dir_, rule_raw, fragment):
    path = os.environ.get("DENYGUARD_LOG") or os.path.join(
        os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local", "state"),
        "denyguard", "denied.log",
    )
    try:
        d = os.path.dirname(path)
        if d:
            os.makedirs(d, exist_ok=True)
        with open(path, "a") as f:
            f.write("%d\t%s\t%s\t%s\n" % (int(time.time()), os.path.basename(dir_.rstrip("/")), rule_raw, fragment))
    except Exception:
        pass  # the log is a record of the mechanism acting, not the gate


def deny(dir_, rule, fragment, reason):
    sys.stdout.write(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": reason,
        }
    }) + "\n")
    log_denial(dir_, rule.raw if rule else "(cd limit)", fragment)


def cmd_hook():
    try:
        payload = os.fdopen(3, "r").read()
        event = json.loads(payload)
        if not isinstance(event, dict):
            raise ValueError("not a JSON object")
    except Exception as exc:
        sys.stderr.write("denyguard: unreadable PreToolUse payload: %s\n" % exc)
        sys.exit(2)

    dir_ = profile_dir()
    cwd = event.get("cwd") or os.getcwd()
    rules = parse_deny_list(load_deny(dir_), cwd)

    hit = cwd_hit(cwd, rules)
    if hit is not None:
        deny(dir_, hit, cwd, "session cwd %s is inside %s" % (cwd, hit.raw))
        return

    tool_input = event.get("tool_input") or {}
    texts = [tool_input.get("command") or ""] \
        if event.get("tool_name") == "Bash" and isinstance(tool_input, dict) \
        else list(strings_of(tool_input))

    for text in texts:
        found = scan(text, cwd, rules)
        if found is not None:
            fragment, rule, reason = found
            deny(dir_, rule, fragment, reason)
            return
    # No rule tripped: no opinion. Silence is the correct "allow" here —
    # the hooks reference treats empty stdout on exit 0 as no decision.


def parse_profile_flag(argv):
    it = iter(argv)
    rest = []
    dir_ = None
    for a in it:
        if a == "--profile":
            dir_ = next(it, None)
        else:
            rest.append(a)
    return dir_, rest


def cmd_rules(argv):
    dir_flag, _ = parse_profile_flag(argv)
    dir_ = profile_dir(dir_flag)
    for rule in parse_deny_list(load_deny(dir_), cwd=None):
        print("%s\t%s\t%s\t%s" % (rule.tool, rule.raw, rule.prefix or "", rule.kind))


def check_unevaluable(rule):
    return not rule.evaluable or rule.anchor == "any-depth"


def cmd_check(argv):
    dir_flag, paths = parse_profile_flag(argv)
    dir_ = profile_dir(dir_flag)
    rules = parse_deny_list(load_deny(dir_), cwd=None)

    bad = [r for r in rules if check_unevaluable(r)]
    if bad:
        for r in bad:
            sys.stderr.write("denyguard: %s cannot be evaluated without a session cwd\n" % r.raw)
        sys.exit(2)

    found = False
    for p in paths:
        rp = canon(os.path.realpath(os.path.expanduser(p)))
        for rule in rules:
            if inside(rp, rule):
                sys.stderr.write("%s is inside %s\n" % (p, rule.raw))
                found = True
            elif ancestor_of(rp, rule):
                sys.stderr.write("%s contains %s's region\n" % (p, rule.raw))
                found = True
    sys.exit(1 if found else 0)


def cmd_settings():
    entry = {
        "matcher": "Bash",
        "hooks": [{
            "type": "command",
            "timeout": 10,
            "command": (
                "[ -x ~/bin/denyguard ] && exec ~/bin/denyguard hook || "
                "{ echo 'denyguard: ~/bin/denyguard is not installed; "
                "refusing Bash until `dotfiles` deploys it' >&2; exit 2; }"
            ),
        }],
    }
    print(json.dumps(entry, indent=2))


def main():
    argv = sys.argv[1:]
    if not argv:
        sys.stderr.write("usage: denyguard hook|rules|check|settings|dir\n")
        sys.exit(2)
    cmd, rest = argv[0], argv[1:]
    if cmd == "hook":
        cmd_hook()
    elif cmd == "rules":
        cmd_rules(rest)
    elif cmd == "check":
        cmd_check(rest)
    elif cmd == "settings":
        cmd_settings()
    elif cmd == "dir":
        print(profile_dir())
    else:
        sys.stderr.write("denyguard: unknown command %r\n" % cmd)
        sys.exit(2)


try:
    main()
except SystemExit:
    raise
except BaseException as exc:
    sys.stderr.write("denyguard: internal error: %s: %s\n" % (type(exc).__name__, exc))
    sys.exit(2)
PY
# `hook` exits only 0 (allow, or JSON deny on stdout) or 2 (block). Anything
# else — python3 present but unable to start, a crash the wrapper above did
# not catch — would be read by Claude Code as a non-blocking error and the
# command would run unchecked, so it is turned into 2. Other subcommands keep
# their own status: `check` uses 1 for "denied" and callers depend on it.
if [ "${1-}" = hook ] && [ "$rc" -ne 0 ] && [ "$rc" -ne 2 ]; then
  printf 'denyguard: the hook could not run (python3 exited %s); refusing Bash rather than passing the command unchecked\n' "$rc" >&2
  exit 2
fi
exit "$rc"
