#!/bin/sh
# claude-peer — one Claude Code instance as an iTerm2 Workgroup peer, on its
# own worktree.
#
# A Workgroup peer's shell starts in the leader's working directory and is
# pinned there (iTerm2 gives a peer no way to choose its own), so a second
# Claude started in a peer would be a second writer on the leader's checkout.
# The shell therefore has to move itself: `run` makes or reuses a worktree,
# cd's into it and only then starts claude, through an interactive shell so
# `claude` is the .functions wrapper (profile, browser pin, cache TTLs), not
# the bare binary. The worktree rules are the ones `workset checkout` follows
# (<repo>/.claude/worktrees/<slug>), ported from bin/executable_worktabs
# rather than called.
#
# A second Workgroup, not extra peers on the builtin Claude Code one: peers
# spawn eagerly when a workgroup is entered, and the builtin is entered on
# every claude job, so three more Claudes would start for every session.
# `default peers` makes that trade on purpose: it points every profile's
# Enter Workgroup trigger (the one iTerm2's onboarding fires on a `claude`
# job) at Claude Peers, so each claude tab starts Chat 2-4 at once;
# `default builtin` points it back.
#
# That makes the scratch path the normal one, so it is safe to run at once from
# several peers: `scratch_checkout` holds a per-repo lock (a symlink in the git
# common dir) while it picks a peer-N, and every `run` leaves a claim in its
# worktree's git directory (`claude-peer.claim`: pid, then the leader's
# directory) that marks the worktree in use for as long as that pid lives. A
# `claude --version` typed in a tab also enters the workgroup, so a scratch
# peer waits CLAUDE_PEER_SETTLE seconds (default 2) before it makes anything,
# and outside a repository it leaves a plain shell instead of failing.
# The sixth session, Hermes, runs `hermes` (the .functions wrapper, through
# `hermes_peer`) only where a Hermes profile routes this directory; elsewhere it
# is a plain shell. It needs no worktree and leaves no claim.
# `install` edits the preferences while iTerm2 is quit because iTerm2 writes
# its preferences back at quit (and, with a custom prefs folder, replaces the
# domain from the folder at launch); an edit made while it runs is lost.
#
# Usage: claude-peer <command> [args]
#   run [branch] [-- claude args...]
#                            make or reuse <repo>/.claude/worktrees/<slug> on
#                            <branch>, cd there, start claude through the
#                            shell (the wrapper applies); no branch: a scratch
#                            worktree detached at origin/HEAD (peer-N), the
#                            branch is claude's to make; outside a repository
#                            that form leaves a plain shell
#   hermes [-- hermes args...]
#                            the Hermes peer: wait CLAUDE_PEER_SETTLE, then an
#                            interactive shell that runs hermes_peer (hermes
#                            where a profile routes here, else a one-line
#                            notice); no repository or worktree needed
#   peers [--leader <dir>] [<dir>]
#                            worktree<TAB>pid<TAB>leader per live claim in
#                            the repository of <dir> (default $PWD), sorted;
#                            --leader keeps one leader's peers
#   path <branch>            print the worktree path for <branch> (nothing
#                            is created)
#   plan <branch>...         branch<TAB>worktree<TAB>create|reuse|conflict:<why>
#                            per branch, exit 1 on any conflict
#   workgroup                print the "Claude Peers" Workgroup definition JSON
#                            that install would write (reads the store only)
#   install                  write that definition into iTerm2's preferences;
#                            iTerm2 must be quit
#   default <peers|builtin>  which workgroup a `claude` job enters, in every
#                            profile; with iTerm2 quit, like install
#   status                   store, iTerm2, workgroup, builtin and default state
set -u

die() { printf 'claude-peer: %s\n' "$*" >&2; exit 1; }
warn() { printf 'claude-peer: %s\n' "$*" >&2; }
usage() { sed -n '/^# Usage:/,/^set -u/{ /^set -u/d; s/^# \{0,1\}//p; }' "$0" >&2; exit 2; }

# The main checkout, even when the caller stands in a linked worktree of it.
# repo_root_q is the same answer without the die: status 1 and no output.
repo_root_q() {
  common=$(git -C "$PWD" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || common=
  case $common in
    */.git) printf '%s\n' "${common%/.git}";;
    *) return 1;;
  esac
}
repo_root() { repo_root_q || die "not inside a non-bare git repository"; }

valid_branch() { git check-ref-format --branch "$1" >/dev/null 2>&1 || die "'$1' is not a branch name"; }

# --- worktrees ----------------------------------------------------------------
# Copied in behaviour from bin/executable_worktabs (slug_of ... worktree_checkout).

slug_of() { printf '%s' "${1-}" | tr '/' '-'; }

worktree_path() { # dir branch -> <dir>/.claude/worktrees/<slug>
  printf '%s/.claude/worktrees/%s\n' "$1" "$(slug_of "$2")"
}

# dir branch... -> branch<TAB>worktree<TAB>create|reuse|conflict:<reason>, one
# line per branch; exit 1 when any is a conflict. The reason is the whole
# human message.
worktree_plan() {
  d=$1; shift
  rd=$(cd "$d" && pwd -P) || return 1
  # path<TAB>branch of every registered worktree (empty branch: detached)
  trees=$(git -C "$d" worktree list --porcelain | awk '
    /^worktree / { p = substr($0, 10); b = "" }
    /^branch /   { b = $2; sub("^refs/heads/", "", b) }
    /^$/         { print p "\t" b }')
  rc=0
  for b in "$@"; do
    wt=$(worktree_path "$d" "$b")
    cur=$(printf '%s\n' "$trees" | awk -F'\t' -v w="$(worktree_path "$rd" "$b")" '$1 == w { print "x" $2; exit }')
    at=$(printf '%s\n' "$trees" | awk -F'\t' -v b="$b" '$2 == b { print $1; exit }')
    if [ -n "$cur" ]; then
      if [ "${cur#x}" = "$b" ]; then act=reuse
      else act="conflict:'$b': $wt exists on branch ${cur#x} — pick another name or remove it (git worktree remove)"; fi
    elif [ -e "$wt" ]; then act="conflict:'$b': $wt exists but is not a git worktree"
    elif [ -n "$at" ]; then act="conflict:'$b' is already checked out at $at"
    else act=create; fi
    case $act in conflict:*) rc=1;; esac
    printf '%s\t%s\t%s\n' "$b" "$wt" "$act"
  done
  return $rc
}

ensure_exclude() { # dir
  excl=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir)/info/exclude
  mkdir -p "$(dirname "$excl")" 2>/dev/null
  grep -qxF '**/.claude/worktrees/' "$excl" 2>/dev/null ||
    printf '**/.claude/worktrees/\n' >> "$excl"
}

# --- claims and the lock ---------------------------------------------------------
# A claim is <git dir of the worktree>/claude-peer.claim: line 1 the pid of the
# `claude-peer run` that owns the worktree (exec keeps it, so it becomes the
# shell that parents claude), line 2 the leader's directory. Live while the pid
# answers signal 0; never deleted here, it goes with the worktree.

claim_file() { d=$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null) && printf '%s/claude-peer.claim\n' "$d"; }

claim_live() { # worktree
  f=$(claim_file "$1") || return 1
  p=$(sed -n 1p "$f" 2>/dev/null)
  case $p in ''|*[!0-9]*) return 1;; esac
  kill -0 "$p" 2>/dev/null
}

write_claim() { # worktree
  f=$(claim_file "$1") || die "$(basename "$1"): cannot find its git directory"
  printf '%s\n%s\n' "$$" "$LEADER" >"$f"
  [ "$(sed -n 1p "$f")" = "$$" ] || die "$(basename "$1"): claimed by another peer"
}

# A symlink whose target is the holder's pid: ln -s is atomic and fails when the
# path exists (flock is not on macOS). A holder that is dead is broken, but the
# readlink/rm pair is not atomic: two waiters racing at the instant a holder was
# killed can both break and take it; write_claim's re-read is the backstop.
peer_lock() { # repo
  lock=$1/.git/claude-peer.lock
  wait_s=${CLAUDE_PEER_LOCK_WAIT:-120}
  tries=0
  while ! ln -s "$$" "$lock" 2>/dev/null; do
    holder=$(readlink "$lock" 2>/dev/null)
    if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then
      [ "$(readlink "$lock" 2>/dev/null)" = "$holder" ] && rm -f "$lock"
      continue
    fi
    tries=$((tries + 1))
    [ "$tries" -lt $((wait_s * 5)) ] || die "peer: could not lock $lock after ${wait_s}s (held by pid $holder)"
    sleep 0.2
  done
}

peer_unlock() { # repo
  [ "$(readlink "$1/.git/claude-peer.lock" 2>/dev/null)" = "$$" ] && rm -f "$1/.git/claude-peer.lock"
  return 0
}

# dir branch -> performs create/reuse, prints branch<TAB>worktree<TAB>created|reused
worktree_checkout() {
  p=$(worktree_plan "$1" "$2") || true
  wt=$(printf '%s\n' "$p" | cut -f2)
  act=$(printf '%s\n' "$p" | cut -f3)
  case $act in
    create)
      ensure_exclude "$1"
      base=HEAD
      git -C "$1" rev-parse --verify -q origin/HEAD >/dev/null 2>&1 && base=origin/HEAD
      if git -C "$1" show-ref --verify -q "refs/heads/$2"; then
        git -C "$1" worktree add "$wt" "$2" >/dev/null || die "'$2': git worktree add failed"
      else
        git -C "$1" worktree add -b "$2" "$wt" "$base" >/dev/null || die "'$2': git worktree add failed"
      fi
      write_claim "$wt"
      printf '%s\t%s\tcreated\n' "$2" "$wt";;
    reuse) write_claim "$wt"; printf '%s\t%s\treused\n' "$2" "$wt";;
    *) die "${act#conflict:}";;
  esac
}

# A registered peer worktree a new peer may take over: directory present, still
# detached, clean, and no live claim on it.
reusable() { # worktree
  [ -d "$1" ] && ! git -C "$1" symbolic-ref -q HEAD >/dev/null 2>&1 \
    && [ -z "$(git -C "$1" status --porcelain 2>/dev/null)" ] && ! claim_live "$1"
}

# `git worktree add` and `checkout` ignore hangup and terminate: a pane torn
# down mid-checkout would otherwise leave a half-made tree that looks dirty.
git_immune() { ( trap '' HUP TERM; exec git "$@" ) >/dev/null; }

# dir -> (detached)<TAB>wt<TAB>created|reused: a scratch worktree with no branch
# of its own, detached at the base (origin/HEAD, else HEAD), at the first
# <dir>/.claude/worktrees/peer-N that is free — unregistered, or registered and
# reusable (which is moved back to the base; a registered one whose directory
# is gone is skipped, `git worktree prune`). A branch is the session's to make
# once it knows what it is working on; a name picked here would only be one
# more branch to delete. The whole pick runs under the repo lock and ends by
# claiming the worktree.
scratch_checkout() {
  peer_lock "$1"
  ( scratch_pick "$1" )
  rc=$?
  peer_unlock "$1"
  return $rc
}

scratch_pick() {
  base=HEAD
  git -C "$1" rev-parse --verify -q origin/HEAD >/dev/null 2>&1 && base=origin/HEAD
  trees=$(git -C "$1" worktree list --porcelain)
  n=1
  while :; do
    wt=$1/.claude/worktrees/peer-$n
    if ! printf '%s\n' "$trees" | grep -qx "worktree $wt" && [ ! -e "$wt" ]; then
      ensure_exclude "$1"
      git_immune -C "$1" worktree add --detach "$wt" "$base" || die "peer-$n: git worktree add failed"
      write_claim "$wt"
      printf '(detached)\t%s\tcreated\n' "$wt"; return 0
    fi
    if printf '%s\n' "$trees" | grep -qx "worktree $wt" && reusable "$wt"; then
      git_immune -C "$wt" checkout -q --detach "$base" || die "peer-$n: cannot move to $base"
      write_claim "$wt"
      printf '(detached)\t%s\treused\n' "$wt"; return 0
    fi
    n=$((n + 1))
  done
}

# --- commands -----------------------------------------------------------------

cmd_run() {
  b=
  if [ $# -gt 0 ] && [ "$1" != -- ]; then b=$1; shift; fi
  if [ $# -gt 0 ]; then
    [ "$1" = -- ] || usage
    shift
  fi
  LEADER=$(pwd -P)
  if [ -z "$b" ]; then
    if ! repo_root_q >/dev/null; then
      echo 'claude-peer: not in a git repository, so there is no worktree to give this peer; plain shell'
      exec "${SHELL:-/bin/sh}" -i
    fi
    [ "${CLAUDE_PEER_SETTLE:-2}" -gt 0 ] && sleep "${CLAUDE_PEER_SETTLE:-2}"
    repo=$(repo_root) || exit 1
    out=$(scratch_checkout "$repo") || exit 1
  else
    repo=$(repo_root) || exit 1
    valid_branch "$b"
    out=$(worktree_checkout "$repo" "$b") || exit 1
  fi
  printf '%s\n' "$out"
  wt=$(printf '%s\n' "$out" | cut -f2)
  # `cd ""` is a silent no-op, which would start claude in the leader's checkout.
  cd -- "$wt" || die "cannot enter $wt"
  CLAUDE_PEER_WORKTREE=$wt
  export CLAUDE_PEER_WORKTREE
  # An interactive shell, so `claude` is the .functions wrapper; it stays the
  # parent because a function cannot be exec'd.
  exec "${SHELL:-/bin/sh}" -i -c 'claude "$@"' claude-peer "$@"
}

# [-- hermes args...]. The shell function does the routing (hermes_profile is
# zsh and lives in .functions), so this only settles, then starts a shell that
# calls it and stays a shell whatever it did.
cmd_hermes() {
  if [ $# -gt 0 ]; then
    [ "$1" = -- ] || usage
    shift
  fi
  [ "${CLAUDE_PEER_SETTLE:-2}" -gt 0 ] && sleep "${CLAUDE_PEER_SETTLE:-2}"
  HERMES_SH='if typeset -f hermes_peer >/dev/null 2>&1; then hermes_peer "$@"; else echo "claude-peer: hermes_peer is not defined in this shell; plain shell (chezmoi apply)"; fi; exec "${SHELL:-/bin/sh}" -i'
  exec "${SHELL:-/bin/sh}" -i -c "$HERMES_SH" claude-peer "$@"
}

# [--leader <dir>] [<dir>] -> worktree<TAB>pid<TAB>leader per live claim in the
# repository of <dir>, sorted by worktree. Silent outside a repository.
cmd_peers() {
  want=
  if [ "${1-}" = --leader ]; then
    [ $# -ge 2 ] || usage
    want=$(cd "$2" 2>/dev/null && pwd -P) || exit 0
    [ -n "$want" ] || exit 0
    shift 2
  fi
  [ $# -le 1 ] || usage
  common=$(git -C "${1:-$PWD}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0
  for c in "$common"/worktrees/*/claude-peer.claim; do
    [ -f "$c" ] || continue
    pid=$(sed -n 1p "$c"); lead=$(sed -n 2p "$c")
    case $pid in ''|*[!0-9]*) continue;; esac
    kill -0 "$pid" 2>/dev/null || continue
    [ -z "$want" ] || [ "$lead" = "$want" ] || continue
    gd=$(sed -n 1p "$(dirname "$c")/gitdir" 2>/dev/null)
    [ -n "$gd" ] || continue
    printf '%s\t%s\t%s\n' "$(dirname "$gd")" "$pid" "$lead"
  done | LC_ALL=C sort
}

cmd_path() {
  [ $# -eq 1 ] || usage
  valid_branch "$1"
  repo=$(repo_root) || exit 1
  worktree_path "$repo" "$1"
}

cmd_plan() {
  [ $# -ge 1 ] || usage
  for x in "$@"; do valid_branch "$x"; done
  repo=$(repo_root) || exit 1
  worktree_plan "$repo" "$@"
}

# --- the Workgroup ------------------------------------------------------------

os() { uname -s 2>/dev/null; }
# Exit 2 as for usage: the verb cannot be used here at all, nothing was refused.
need_macos() { [ "$(os)" = Darwin ] || { warn "$1 needs macOS"; exit 2; }; }

# `ps` rather than pgrep, as bin/executable_worktabs: pgrep cannot see
# processes of the caller's own session under some sandboxes.
proc_running() {
  ps -Ao ucomm= 2>/dev/null |
    awk -v n="$1" '{ sub(/[ \t]+$/, "", $0); if ($0 == n) f = 1 } END { exit !f }'
}

# Where iTerm2's preferences live: skind=folder spath=<plist> when it loads
# them from a custom folder (it replaces the domain from there at launch and
# writes back at quit), else skind=domain. CLAUDE_PEER_PREFS names a plist
# directly.
prefs_store() {
  if [ -n "${CLAUDE_PEER_PREFS:-}" ]; then skind=folder; spath=$CLAUDE_PEER_PREFS; return 0; fi
  skind=domain; spath=
  [ "$(defaults read com.googlecode.iterm2 LoadPrefsFromCustomFolder 2>/dev/null)" = 1 ] || return 0
  f=$(defaults read com.googlecode.iterm2 PrefsCustomFolder 2>/dev/null) || f=
  case $f in
    '') return 0;;
    *://*) die "prefs load from a URL; use Settings > Arrangements > Workgroups";;
    \~|\~/*) f=$HOME${f#\~};;
  esac
  skind=folder; spath=${f%/}/com.googlecode.iterm2.plist
}

# peer_py <workgroup|install|status|default> <folder|domain> <plist path> [peers|builtin]
# The stdlib only: plistlib for the store, json for the Workgroups value (an
# NSData holding a JSON array), defaults for the domain.
peer_py() {
  python3 -I - "$@" <<'PYEOF'
import copy, json, plistlib, subprocess, sys

GROUP, NAME, BUILTIN = "claudePeer.workgroup", "Claude Peers", "builtin.claudeCode"
mode, kind, path = sys.argv[1:4]
ENTER = "iTermEnterWorkgroupTrigger"

def fail(msg):
    sys.exit("claude-peer: " + msg)

def load(kind, path):
    """(plist, began with bplist); raises when the store cannot be read."""
    if kind == "folder":
        with open(path, "rb") as f:
            raw = f.read()
    else:
        raw = subprocess.run(["defaults", "export", "com.googlecode.iterm2", "-"],
                             capture_output=True, check=True).stdout
    return plistlib.loads(raw), raw.startswith(b"bplist")

def groups_of(pl):
    if "Workgroups" not in pl:
        return []
    g = json.loads(pl["Workgroups"])
    if not isinstance(g, list):
        raise ValueError("Workgroups is not a list")
    return g

def session(ident, name, kind, command="", items=None, parent=None):
    s = {"uniqueIdentifier": ident, "kind": {"kind": kind}, "displayName": name,
         "command": command, "perFileCommand": "", "urlString": "",
         "mode": "regular", "toolbarItems": items or [{"kind": "modeSwitcher"}]}
    if parent:
        s["parentID"] = parent
    return s

def build(groups):
    builtin = next((g for g in groups if g.get("uniqueIdentifier") == BUILTIN), {})
    def pick(i):
        return next((s for s in builtin.get("sessions", []) if s.get("uniqueIdentifier") == i), None)
    main = session("claudePeer.main", "Chat", "root",
                   items=[{"kind": "modeSwitcher"}, {"kind": "gitStatus"}])
    if pick(BUILTIN + ".main"):
        main["toolbarItems"] = copy.deepcopy(pick(BUILTIN + ".main")["toolbarItems"])
    diff = copy.deepcopy(pick(BUILTIN + ".diff"))
    if not diff:
        diff = session("", "Diff", "peer", "git difftool -y -x vimdiff \\(gitBase)", [
            {"kind": "modeSwitcher"}, {"kind": "changedFileSelector"}, {"kind": "gitBaseSelector"},
            {"kind": "navigation",
             "reloadShortcut": {"serialized": "0x72-0x100000-0xf"},
             "forwardShortcut": {"serialized": "0xf703-0x340000-0x7c"},
             "backShortcut": {"serialized": "0xf702-0x340000-0x7b"}}])
        diff.update(mode="diff", perFileCommand="git difftool -y -x vimdiff \\(gitBase) -- \\(file)")
    diff.update(uniqueIdentifier="claudePeer.diff", parentID="claudePeer.main")
    chats = [session("claudePeer.chat%d" % n, "Chat %d" % n, "peer", "claude-peer run",
                     parent="claudePeer.main") for n in (2, 3, 4)]
    hermes = session("claudePeer.hermes", "Hermes", "peer", "claude-peer hermes",
                     parent="claudePeer.main")
    return {"uniqueIdentifier": GROUP, "name": NAME, "sessions": [main, diff] + chats + [hermes]}

def enter_triggers(pl):
    """(profile name, trigger dict) for every Enter Workgroup trigger aimed at
    either workgroup; other workgroups' triggers are not ours to move."""
    for b in pl.get("New Bookmarks", []):
        for t in b.get("Triggers", []) or []:
            if t.get("action") == ENTER and t.get("parameter") in (BUILTIN, GROUP):
                yield b.get("Name", "?"), t

def save(pl, was_binary):
    data = plistlib.dumps(pl, fmt=plistlib.FMT_BINARY if was_binary else plistlib.FMT_XML)
    if kind == "folder":
        with open(path, "wb") as f:
            f.write(data)
    else:
        subprocess.run(["defaults", "import", "com.googlecode.iterm2", "-"], input=data, check=True)

if mode == "status":
    try:
        pl, _ = load("domain", "")
    except Exception as e:
        fail("cannot read the iTerm2 preferences domain: %s" % e)
    try:
        groups = groups_of(pl)
    except (ValueError, TypeError):
        groups = None
    mine = next((g for g in groups or [] if g.get("uniqueIdentifier") == GROUP), None)
    if groups is None:
        print("workgroup: unreadable (Workgroups is not JSON; install refuses until it is fixed)")
    elif mine:
        def shape(g):
            return [(s.get("uniqueIdentifier"), s.get("displayName"), s.get("command"))
                    for s in g.get("sessions", [])]
        names = [s.get("displayName", "?") for s in mine.get("sessions", [])]
        want = [n or "?" for _, n, _ in shape(build(groups))]
        if shape(mine) == shape(build(groups)):
            print("workgroup: installed (%d sessions: %s)" % (len(names), ", ".join(names)))
        else:
            print("workgroup: installed, out of date (%d sessions: %s); this version defines %d (%s) — claude-peer install (with iTerm2 quit)"
                  % (len(names), ", ".join(names), len(want), ", ".join(want)))
    else:
        print("workgroup: not installed — claude-peer install (with iTerm2 quit)")
    if any(g.get("uniqueIdentifier") == BUILTIN for g in groups or []):
        print("builtin: builtin.claudeCode present")
    else:
        print("builtin: builtin.claudeCode absent (the Diff would be the template)")
    found = list(enter_triggers(pl))
    peers = sum(1 for _, t in found if t["parameter"] == GROUP)
    if not found:
        print("default: no profile enters a workgroup on a claude job")
    elif peers == len(found):
        print("default: peers (%d profiles enter Claude Peers)" % peers)
    elif peers == 0:
        print("default: builtin (%d profiles enter Claude Code)" % len(found))
    else:
        print("default: mixed (%d of %d profiles enter Claude Peers) — claude-peer default peers|builtin" % (peers, len(found)))
elif mode == "workgroup":
    try:
        groups = groups_of(load(kind, path)[0])
    except Exception:
        groups = []   # unreadable store: the templates stand in
    print(json.dumps(build(groups), indent=2, sort_keys=True))
elif mode == "install":
    try:
        pl, was_binary = load(kind, path)
    except Exception as e:
        fail("cannot read the preferences: %s" % e)
    try:
        groups = groups_of(pl)
    except (ValueError, TypeError) as e:
        fail("the Workgroups value is not a JSON list (%s); nothing written" % e)
    wg = build(groups)
    idx = next((i for i, g in enumerate(groups) if g.get("uniqueIdentifier") == GROUP), None)
    if idx is None:
        groups.append(wg)
    else:
        groups[idx] = wg
    pl["Workgroups"] = json.dumps(groups, separators=(",", ":")).encode("utf-8")
    save(pl, was_binary)
    print("written" if idx is None else "replaced")
elif mode == "default":
    target = GROUP if sys.argv[4] == "peers" else BUILTIN
    try:
        pl, was_binary = load(kind, path)
    except Exception as e:
        fail("cannot read the preferences: %s" % e)
    if target == GROUP:
        try:
            ok = any(g.get("uniqueIdentifier") == GROUP for g in groups_of(pl))
        except (ValueError, TypeError):
            ok = False
        if not ok:
            fail("Claude Peers is not installed; run claude-peer install first, nothing written")
    found = list(enter_triggers(pl))
    if not found:
        fail("no profile has an Enter Workgroup trigger for Claude Code; set up iTerm2's Claude Code integration first")
    moved = [n for n, t in found if t["parameter"] != target]
    for _, t in found:
        t["parameter"] = target
    if moved:
        save(pl, was_binary)
    print("%d of %d profiles changed" % (len(moved), len(found)))
PYEOF
}

cmd_workgroup() {
  [ $# -eq 0 ] || usage
  prefs_store
  peer_py workgroup "$skind" "$spath"
}

cmd_install() {
  [ $# -eq 0 ] || usage
  need_macos install
  proc_running iTerm2 && die "quit iTerm2 first — it rewrites its preferences at quit and would overwrite this"
  prefs_store
  r=$(peer_py install "$skind" "$spath") || exit 1
  [ "$skind" = folder ] && where=$spath || where="the com.googlecode.iterm2 domain"
  printf 'claude-peer: workgroup "Claude Peers" (claudePeer.workgroup) %s in %s; start iTerm2, then Shell > Workgroups > Claude Peers in a plain tab\n' "$r" "$where"
}

cmd_default() {
  [ $# -eq 1 ] || usage
  case $1 in peers|builtin) ;; *) usage;; esac
  need_macos default
  proc_running iTerm2 && die "quit iTerm2 first — it rewrites its preferences at quit and would overwrite this"
  prefs_store
  r=$(peer_py default "$skind" "$spath" "$1") || exit 1
  [ "$1" = peers ] && what="Claude Peers (Chat 2-4 and Hermes start with every claude tab)" || what="Claude Code"
  printf 'claude-peer: a claude job now enters %s; %s\n' "$what" "$r"
}

cmd_status() {
  [ $# -eq 0 ] || usage
  need_macos status
  prefs_store
  if [ "$skind" = folder ]; then printf 'store: folder %s\n' "$spath"; else printf 'store: domain\n'; fi
  if proc_running iTerm2; then printf 'iterm2: running\n'; else printf 'iterm2: not running (install allowed)\n'; fi
  peer_py status "$skind" "$spath"
  scratch_summary
}

# One line on the peer-N worktrees of the repository the caller stands in; none
# outside one. In use is a live claim; free is what scratch_checkout would take
# over; the rest are kept (dirty, on a branch, or the directory is gone).
scratch_summary() {
  repo=$(repo_root_q) || return 0
  list=$(git -C "$repo" worktree list --porcelain | sed -n 's/^worktree //p')
  n_all=0 n_use=0 n_kept=0 n_free=0
  while IFS= read -r wt; do
    case $wt in "$repo"/.claude/worktrees/peer-[0-9]*) ;; *) continue;; esac
    n_all=$((n_all + 1))
    if claim_live "$wt"; then n_use=$((n_use + 1))
    elif reusable "$wt"; then n_free=$((n_free + 1))
    else n_kept=$((n_kept + 1)); fi
  done <<EOF
$list
EOF
  printf 'scratch: %d peer-N worktrees in %s (%d in use, %d kept: dirty, on a branch or directory gone, %d free)\n' "$n_all" "$repo" "$n_use" "$n_kept" "$n_free"
}

[ $# -ge 1 ] || usage
cmd=$1; shift
case $cmd in
  run) cmd_run "$@";;
  hermes) cmd_hermes "$@";;
  peers) cmd_peers "$@";;
  path) cmd_path "$@";;
  plan) cmd_plan "$@";;
  workgroup) cmd_workgroup "$@";;
  install) cmd_install "$@";;
  default) cmd_default "$@";;
  status) cmd_status "$@";;
  -h|--help|help) usage;;
  *) warn "unknown command '$cmd'"; usage;;
esac
