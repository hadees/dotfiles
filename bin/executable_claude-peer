#!/bin/sh
# claude-peer — one Claude Code instance as an iTerm2 Workgroup peer, on its
# own worktree.
#
# A Workgroup peer's shell starts in the leader's working directory and is
# pinned there (iTerm2 gives a peer no way to choose its own), so a second
# Claude started in a peer would be a second writer on the leader's checkout.
# The shell therefore has to move itself: `run` makes or reuses a worktree,
# cd's into it and only then starts claude, through an interactive shell so
# `claude` is the .functions wrapper (profile, browser pin, cache TTLs), not
# the bare binary. The worktree rules are the ones `workset checkout` follows
# (<repo>/.claude/worktrees/<slug>), ported from bin/executable_worktabs
# rather than called.
#
# Two more Workgroups, not extra peers on the builtin Claude Code one: peers
# spawn eagerly when a workgroup is entered, and the builtin is entered on
# every claude job. `Claude Peers` is Lead and the panes Alpha, Beta, Gamma, Delta, Epsilon; a
# pane waits (below), so entering it on every claude job costs five blocked
# shells, not five Claudes. `Claude Peers + Hermes` is the same plus a Hermes
# pane, a twin because a pane cannot remove itself from a workgroup: where no
# Hermes profile routes the directory the other definition must be the one
# entered. There is no Diff peer. Which one a tab enters is the claude()
# wrapper's choice, made before the job starts: it sets the session variable
# user.claudePeerEnter to "<key>:<nonce>" (`here` prints the key: base, or
# base/hermes where Hermes routes) and one variable-changed Enter Workgroup
# trigger per workgroup, matching its key, enters it. `default peers` disables
# the Enter trigger iTerm2's onboarding fires on a `claude` job in every profile
# and writes those triggers (the Settings window cannot make one: it drops their
# parameters), plus the state file claude() looks for; `default builtin` puts
# the job trigger back and removes them.
#
# A peer is a named slot (alpha, beta, ...): `run --as alpha` takes the worktree
# <repo>/.claude/worktrees/alpha, in whatever state it was left (detached at
# origin/HEAD when new), and runs claude as a child named <repo>-alpha. Taking a
# slot holds a per-repo lock (a symlink in the git common dir), and the `run`
# leaves a claim in the worktree's git directory (`claude-peer.claim`: pid,
# the leader's directory, the label) for as long as its claude runs; a claim whose
# pid is alive marks the slot in use, and the claim goes when the session does.
# A bare `run` is a pane of an older definition: one line, then a plain shell.
# A pane waits: `run --as <slot> --wait` makes no worktree, claim or Claude until
# Return is typed in it or `start` signals it (USR1, interrupting a `wait` on a
# background reader: no polling, no terminal mode changed); when that Claude
# ends the pane waits again. A pane's slot is a preference: it takes its own
# when free, else the first free name of the pool (git config
# claude-peer.slots; default the Greek alphabet), and `claude-peer.start = auto`
# makes the pane start one Claude at once. A waiting pane leaves a file in
# <git common dir>/claude-peer.wait/ (<slot>.<pid>, the leader's directory).
# The Hermes session runs `hermes` (the .functions wrapper, through
# `hermes_peer`) only where a Hermes profile routes this directory; elsewhere it
# is a plain shell. It needs no worktree and leaves no claim; with --wait it
# asks for Return first, and without it settles CLAUDE_PEER_SETTLE seconds
# (default 2, 0 disables) first, because a `claude --version` typed in a tab
# also enters the workgroup.
# A peer is a separate project, not a helper: the one shared thing is the log,
# <git common dir>/claude-peer.log, where each session says what it is doing and
# where. It is advisory: `log claim` warns of overlap and never fails on it.
# When a pane's session ends, the pane logs `end`: `<Label> ended after <dur>`
# and its task, which closes that label's claims as `stop` does.
# Overlay peers: a machine with private overlays (chezmoi configs other than
# chezmoi.toml whose source is a git repository) gets two more Workgroups, the two
# above plus one pane per overlay, entered only by a tab of the public chezmoi
# source and only once `install` has written the overlays state file. A pane is
# stored by position, `Overlay <N>` running `overlay <N>`: iTerm2's preferences can
# be a tracked file, so no overlay's name goes into them. The names are in the
# state file; `overlay <N>` reads the N-th, cd's into that overlay's main
# checkout and is a waiting pane of that repository, slot `overlay`, led from
# where it started.
# `install` edits the preferences while iTerm2 is quit because iTerm2 writes
# its preferences back at quit (and, with a custom prefs folder, replaces the
# domain from the folder at launch); an edit made while it runs is lost.
#
# Usage: claude-peer <command> [args]
#   run --as <slot> [-- claude args...]
#                            take <repo>/.claude/worktrees/<slot> (new: detached
#                            at origin/HEAD; else reused as it is), cd there and
#                            start claude -n <repo>-<slot> through the shell (the
#                            wrapper applies); exit 3 when a live claim holds it
#   run --as <slot> --wait [-- claude args...]
#                            a pane: show the picker of contexts at once (git
#                            config claude-peer.picker fzf|list|off; Esc hides
#                            it, Return brings it back, c continues the last
#                            session, q leaves a shell) or wait for `start`,
#                            take a slot of the pool, run claude, wait again
#   run <branch> [-- claude args...]
#                            the same on <repo>/.claude/worktrees/<slug> and
#                            <branch>
#   run [--]                 a pane of an older definition: one line, a shell
#   start <slot|next> [--continue] [--leader <dir>] [--context <name>] [--handoff] [--] [words...]
#                            wake a waiting pane to run claude in <slot> (next:
#                            whatever the pane would take; words - reads stdin);
#                            with --context the words are the value of that
#                            start context (a context carries its own mode, so
#                            --continue with it is exit 2; ask without a value
#                            is 2, an unknown context 1, a pane that predates
#                            contexts 4); --handoff (Lead's, from a Claude
#                            session) appends the hand-off note, so the peer
#                            reports with log done and its turn ends and exit
#                            reach Lead (2 without a prompt or context, from a
#                            peer, or without CLAUDE_PID; 4 for an older pane)
#                            -> slot<TAB>worktree<TAB>started<TAB>session name;
#                            exit 3 already running or no slot free, 4 no pane
#                            waiting, 1 not started in CLAUDE_PEER_START_WAIT s
#   stop <slot> [--force]    TERM the claude of a running slot when its registry
#                            record says idle -> slot<TAB>worktree<TAB>stopped;
#                            exit 3 not running, 5 busy (or no record) w/o --force
#   slots [<dir>]            slot<TAB>running|waiting<TAB>worktree<TAB>pid<TAB>
#                            leader<TAB>session name per slot of the repository
#   hermes [--wait] [-- hermes args...]
#                            the Hermes peer: wait CLAUDE_PEER_SETTLE (--wait:
#                            for Return, in hermes_peer), then an interactive
#                            shell that runs hermes_peer (hermes where a profile
#                            routes here, else a one-line notice); no
#                            repository or worktree needed
#   overlays                 name<TAB>root<TAB>state<TAB>leader<TAB>pid per
#                            private overlay of this machine (a chezmoi config
#                            whose source is a git repository); state is idle,
#                            waiting or running in a tab of another repository
#   overlay <name|N>         a waiting pane of the overlay <name>, or of the N-th
#                            overlay pane `install` wrote (the N-th name of the
#                            overlays state file, not the N-th row of `overlays`):
#                            enters its main checkout and takes the slot
#                            `overlay` there; an unknown one is one line and a
#                            plain shell
#   peers [--leader <dir>] [<dir>]
#                            worktree<TAB>pid<TAB>leader<TAB>label per live
#                            claim in the repository of <dir> (default $PWD), sorted;
#                            --leader keeps one leader's peers
#   log [--as <name>] claim <task> [-- <path>...]
#                            say what you are about to do and where; prints
#                            overlap<TAB>who<TAB>their path<TAB>their task per
#                            open claim of another that shares a path; exit 0
#   log [--as <name>] note <text> | done [<text>]
#                            a note; the end of your open claims
#   log [--as <name>] idle [<text>]
#                            written by the Stop hook of a handed-over peer: a
#                            turn that ended without a done or note (--as: the
#                            line as given, <text> required)
#   name <slot|lead> [<dir>] the session name that role gets in <dir>:
#                            <repo>-<slot>; <repo>-lead in the main checkout,
#                            <repo>-<worktree>-lead in a linked one
#   claim [<dir>]            key<TAB>value for the live claim of <dir>: pid,
#                            leader, label, by, context, task, started,
#                            handoff, lead-pid, lead-sid (- when missing);
#                            exit 1 without one
#   log show [--all]         open claims and the last 24 hours of notes (--all:
#                            the file), from <git common dir>/claude-peer.log
#   path <branch>            print the worktree path for <branch> (nothing
#                            is created)
#   plan <branch>...         branch<TAB>worktree<TAB>create|reuse|conflict:<why>
#                            per branch, exit 1 on any conflict
#   workgroup                print the "Claude Peers" Workgroup definition JSON
#                            (Lead, Alpha … Epsilon) that install would write
#   install                  write that and "Claude Peers + Hermes" (the same
#                            plus a Hermes pane) into iTerm2's preferences;
#                            iTerm2 must be quit. With private overlays on this
#                            machine, also "Claude Peers + Overlays" and
#                            "Claude Peers + Hermes + Overlays" (one pane per
#                            overlay, after the others, stored by position,
#                            `Overlay <N>` running `overlay <N>`, never a name)
#                            and the overlays state file, which holds the names;
#                            with none, it removes both
#   here                     the key claude() sends to choose the workgroup for
#                            this directory (base; overlays in the public
#                            chezmoi source once install wrote the overlay
#                            panes)
#   default <peers|builtin>  peers: disable the claude job trigger in every
#                            profile and add one variable trigger per
#                            workgroup (claude() sends the key); builtin: the
#                            job enters Claude Code again; iTerm2 quit
#   status                   store, iTerm2, workgroup, hermes and default state;
#                            with private overlays (or their workgroups) also
#                            what is installed against what this machine has,
#                            which pane is which overlay, and who is in each
#                            overlay's pane
#   context list [--all] [<dir>]
#                            name<TAB>title<TAB>ask<TAB>flags<TAB>path per start
#                            context of the repository of <dir> (default $PWD):
#                            the general ones, then its owner's, then its own;
#                            --all: every file under the root, no override
#   context show <name|@fresh|@continue|@resume|@task> [value words...]
#                            the context's file, scope, flags and first prompt
#   context dir [--repo [<dir>]]
#                            the contexts root, or this repository's directory
#                            in it (<root>/<owner>/<repo>)
#   art [--slot <slot>] [--frame <name>] [--z all|near|near-mid|none] [--truecolor|--256]
#                            print the sleeper a waiting pane shows (one frame,
#                            its z's; cap colour by slot, git config
#                            claude-peer.<slot>.cap; claude-peer.art false hides
#                            it in panes, claude-peer.art-file replaces it,
#                            claude-peer.art-seconds, default 20, is how long it
#                            moves in fzf after the last key; 0 holds it still;
#                            unset, and with `claude-peer look on`, it moves
#                            while the pane is the one looked at)
#   art --hermes [--at <n>] [--truecolor|--256] | art --hermes --wait
#                            the Hermes pane's figure, read from the installed
#                            Hermes: one frame of its glint (0, the default, is
#                            still), or the pane's wait (0 Return, 1 q, 3 none)
#   art --screen [--slot <slot>]
#                            the quiet waiting screen, padded as a pane pads it,
#                            for this terminal or CLAUDE_PEER_SIZE
#   look on|off              write / remove the iTerm2 trigger that tells a waiting
#                            pane it is looked at, in every profile that enters
#                            a workgroup, and the marker panes check; iTerm2
#                            must be quit
#   look gained|lost <session id>
#                            the pane of that iTerm2 session is now looked at /
#                            no longer is: its picker starts or stops moving;
#                            always exits 0, silent
#
# Exit codes of start and stop: 0 done; 1 failed; 2 usage; 3 already in
# the requested state; 4 nothing to act on; 5 refused because busy.
set -u

die() { printf 'claude-peer: %s\n' "$*" >&2; exit 1; }
warn() { printf 'claude-peer: %s\n' "$*" >&2; }
usage() { sed -n '/^# Usage:/,/^set -u/{ /^set -u/d; s/^# \{0,1\}//p; }' "$0" >&2; exit 2; }

# The main checkout, even when the caller stands in a linked worktree of it.
# repo_root_q is the same answer without the die: status 1 and no output.
repo_root_q() {
  common=$(git -C "$PWD" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || common=
  case $common in
    */.git) printf '%s\n' "${common%/.git}";;
    *) return 1;;
  esac
}
repo_root() { repo_root_q || die "not inside a non-bare git repository"; }

valid_branch() { git check-ref-format --branch "$1" >/dev/null 2>&1 || die "'$1' is not a branch name"; }

# --- worktrees ----------------------------------------------------------------
# Copied in behaviour from bin/executable_worktabs (slug_of ... worktree_checkout).

slug_of() { printf '%s' "${1-}" | tr '/' '-'; }

worktree_path() { # dir branch -> <dir>/.claude/worktrees/<slug>
  printf '%s/.claude/worktrees/%s\n' "$1" "$(slug_of "$2")"
}

# dir branch... -> branch<TAB>worktree<TAB>create|reuse|conflict:<reason>, one
# line per branch; exit 1 when any is a conflict. The reason is the whole
# human message.
worktree_plan() {
  d=$1; shift
  rd=$(cd "$d" && pwd -P) || return 1
  # path<TAB>branch of every registered worktree (empty branch: detached)
  trees=$(git -C "$d" worktree list --porcelain | awk '
    /^worktree / { p = substr($0, 10); b = "" }
    /^branch /   { b = $2; sub("^refs/heads/", "", b) }
    /^$/         { print p "\t" b }')
  rc=0
  for b in "$@"; do
    wt=$(worktree_path "$d" "$b")
    cur=$(printf '%s\n' "$trees" | awk -F'\t' -v w="$(worktree_path "$rd" "$b")" '$1 == w { print "x" $2; exit }')
    at=$(printf '%s\n' "$trees" | awk -F'\t' -v b="$b" '$2 == b { print $1; exit }')
    if [ -n "$cur" ]; then
      if [ "${cur#x}" = "$b" ]; then act=reuse
      else act="conflict:'$b': $wt exists on branch ${cur#x} — pick another name or remove it (git worktree remove)"; fi
    elif [ -e "$wt" ]; then act="conflict:'$b': $wt exists but is not a git worktree"
    elif [ -n "$at" ]; then act="conflict:'$b' is already checked out at $at"
    else act=create; fi
    case $act in conflict:*) rc=1;; esac
    printf '%s\t%s\t%s\n' "$b" "$wt" "$act"
  done
  return $rc
}

ensure_exclude() { # dir
  excl=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir)/info/exclude
  mkdir -p "$(dirname "$excl")" 2>/dev/null
  grep -qxF '**/.claude/worktrees/' "$excl" 2>/dev/null ||
    printf '**/.claude/worktrees/\n' >> "$excl"
}

# --- claims and the lock ---------------------------------------------------------
# A claim is <git dir of the worktree>/claude-peer.claim: line 1 the pid of the
# `claude-peer run` that owns the worktree, line 2 the leader's directory, line 3
# the label; a pane's start adds 4 by, 5 context, 6 task, 7 start epoch, 8
# `handoff` or -, 9 the handing-over session's pid or -, 10 its session id or -.
# Live while the pid answers signal 0; `run` removes it when its
# claude returns, so a live claim means a Claude is running there now.

claim_file() { d=$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null) && printf '%s/claude-peer.claim\n' "$d"; }

claim_live() { # worktree
  f=$(claim_file "$1") || return 1
  p=$(sed -n 1p "$f" 2>/dev/null)
  case $p in ''|*[!0-9]*) return 1;; esac
  kill -0 "$p" 2>/dev/null
}

# The turn mark of a handed-over peer: one UTC stamp beside the claim.
turn_file() { d=$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null) && printf '%s/claude-peer.turn\n' "$d"; }
# The stop mark: who asked `stop`, written before the signal, read by the pane.
stop_file() { d=$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null) && printf '%s/claude-peer.stop\n' "$d"; }

write_claim() { # worktree label
  f=$(claim_file "$1") || die "$(basename "$1"): cannot find its git directory"
  rm -f "$(turn_file "$1")" "$(stop_file "$1")"
  printf '%s\n%s\n%s\n' "$$" "$LEADER" "$2" >"$f"
  [ "$(sed -n 1p "$f")" = "$$" ] || die "$(basename "$1"): claimed by another peer"
}

# A symlink whose target is the holder's pid: ln -s is atomic and fails when the
# path exists (flock is not on macOS). A holder that is dead is broken, but the
# readlink/rm pair is not atomic: two waiters racing at the instant a holder was
# killed can both break and take it; write_claim's re-read is the backstop.
peer_lock() { # repo
  lock=$1/.git/claude-peer.lock
  wait_s=${CLAUDE_PEER_LOCK_WAIT:-120}
  tries=0
  while ! ln -s "$$" "$lock" 2>/dev/null; do
    holder=$(readlink "$lock" 2>/dev/null)
    if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then
      [ "$(readlink "$lock" 2>/dev/null)" = "$holder" ] && rm -f "$lock"
      continue
    fi
    tries=$((tries + 1))
    [ "$tries" -lt $((wait_s * 5)) ] || die "peer: could not lock $lock after ${wait_s}s (held by pid $holder)"
    sleep 0.2
  done
}

peer_unlock() { # repo
  [ "$(readlink "$1/.git/claude-peer.lock" 2>/dev/null)" = "$$" ] && rm -f "$1/.git/claude-peer.lock"
  return 0
}

# dir branch -> performs create/reuse, prints branch<TAB>worktree<TAB>created|reused
worktree_checkout() {
  p=$(worktree_plan "$1" "$2") || true
  wt=$(printf '%s\n' "$p" | cut -f2)
  act=$(printf '%s\n' "$p" | cut -f3)
  case $act in
    create)
      ensure_exclude "$1"
      base=HEAD
      git -C "$1" rev-parse --verify -q origin/HEAD >/dev/null 2>&1 && base=origin/HEAD
      if git -C "$1" show-ref --verify -q "refs/heads/$2"; then
        git -C "$1" worktree add "$wt" "$2" >/dev/null || die "'$2': git worktree add failed"
      else
        git -C "$1" worktree add -b "$2" "$wt" "$base" >/dev/null || die "'$2': git worktree add failed"
      fi
      write_claim "$wt" "$(slug_of "$2")"
      printf '%s\t%s\tcreated\n' "$2" "$wt";;
    reuse) write_claim "$wt" "$(slug_of "$2")"; printf '%s\t%s\treused\n' "$2" "$wt";;
    *) die "${act#conflict:}";;
  esac
}

# `git worktree add` and `checkout` ignore hangup and terminate: a pane torn
# down mid-checkout would otherwise leave a half-made tree that looks dirty.
# Only stdout is dropped: a slot's checkout is quieted with git's own -q, so a
# failure still shows git's fatal: line.
git_immune() { ( trap '' HUP TERM; exec git "$@" ) >/dev/null; }

# A slot's base is recorded in <git dir of the worktree>/claude-peer.base: line 1
# the name (main), line 2 the full ref. bin/branchname reads it to label a
# detached slot. Written once, from origin/HEAD, or on creation from the main
# checkout's branch; never rewritten, and a failed write is not an error.
base_file() { d=$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null) && printf '%s/claude-peer.base\n' "$d"; }

write_base() { # repo wt created|reused
  f=$(base_file "$2") || return 0
  [ -f "$f" ] && return 0
  if ref=$(git -C "$1" symbolic-ref --quiet refs/remotes/origin/HEAD); then
    name=${ref#refs/remotes/origin/}
  elif [ "$3" = created ] && ref=$(git -C "$1" symbolic-ref --quiet HEAD); then
    name=${ref#refs/heads/}
  else return 0
  fi
  { printf '%s\n%s\n' "$name" "$ref" >"$f"; } 2>/dev/null ||
    warn "$(basename "$2"): could not record the base; the status line will show the commit"
}

# repo slot label -> slot<TAB>wt<TAB>created|reused, claimed. The slot's
# worktree is the slot's: a registered one is reused as it was left (no checkout,
# no status or branch test); a new one is detached at the base (origin/HEAD, else
# HEAD), a branch being the session's to make once it knows its work. Exit 3 when
# a live claim holds it. The whole pick runs under the repo lock.
slot_checkout() {
  peer_lock "$1"
  ( slot_pick "$1" "$2" "$3" )
  rc=$?
  peer_unlock "$1"
  return $rc
}

slot_pick() {
  wt=$1/.claude/worktrees/$2
  if git -C "$1" worktree list --porcelain | grep -qx "worktree $wt"; then
    [ -d "$wt" ] || die "$2: $wt is registered but missing; git worktree prune (from $1), then start it again"
    if claim_live "$wt"; then
      cf=$(claim_file "$wt")
      warn "$2: in use by the peers of $(sed -n 2p "$cf") (pid $(sed -n 1p "$cf"))"
      return 3
    fi
    act=reused
  elif [ -e "$wt" ]; then
    die "$2: $wt exists but is not a git worktree"
  else
    ensure_exclude "$1"
    base=HEAD
    git -C "$1" rev-parse --verify -q origin/HEAD >/dev/null 2>&1 && base=origin/HEAD
    git_immune -C "$1" worktree add -q --detach "$wt" "$base" || die "$2: git worktree add failed"
    act=created
  fi
  write_base "$1" "$wt" "$act"
  write_claim "$wt" "$3"
  printf '%s\t%s\t%s\n' "$2" "$wt" "$act"
}

# wt name [claude args...]: the only place a session starts. A child, not an
# exec, so the claim can be removed when it returns. An interactive shell, so
# `claude` is the .functions wrapper; -n names the session (and its status row).
run_session() {
  rs_wt=$1 rs_name=$2; shift 2
  ( cd -- "$rs_wt" || exit 97
    trap - TTIN TTOU   # a waiting pane ignores them; claude must not inherit that
    CLAUDE_PEER_WORKTREE=$rs_wt; export CLAUDE_PEER_WORKTREE
    exec "${SHELL:-/bin/sh}" -i -c 'n=$1; shift; claude -n "$n" "$@"' claude-peer "$rs_name" "$@" )
  rs_rc=$?
  rm -f "$(claim_file "$rs_wt")" "$(turn_file "$rs_wt")"
  return $rs_rc
}

# --- slot names, the pool, waiting panes ---------------------------------------------

POOL_DEFAULT='alpha beta gamma delta epsilon zeta eta theta iota kappa lambda mu nu xi omicron pi rho sigma tau upsilon phi chi psi omega'

# LC_ALL=C: in a UTF-8 locale [a-z] also matches capitals. `next` is the word
# `start` uses for "whatever the pane would take", so it is not a slot.
# next is `start`'s word for "whatever the pane would take"; lead is Lead's
# name; claude and hermes are kept free for an agent segment in names later.
slot_ok() { case $1 in next|lead|claude|hermes) return 1;; esac; printf '%s\n' "$1" | LC_ALL=C grep -Eq '^[a-z][a-z0-9_-]*$'; }
# The one place a session name is composed: <repo>-<slot>. Needs rname.
session_name() { printf '%s-%s\n' "$rname" "$1"; }
label_of() { printf '%s%s' "$(printf '%s' "$1" | cut -c1 | tr a-z A-Z)" "$(printf '%s' "$1" | cut -c2-)"; }
rname_of() { printf '%s' "${1##*/}" | tr -c 'A-Za-z0-9._-' '-'; }
settle() { st=${CLAUDE_PEER_SETTLE:-2}; [ "$st" -gt 0 ] && sleep "$st"; return 0; }

# The words of claude-peer.slots (read where the caller stands), else the default
# pool. Its first five are the bar's names. Dies on a word that is not a slot.
pool_words() {
  pw=$(git config --get claude-peer.slots 2>/dev/null) || pw=
  [ -n "$pw" ] || pw=$POOL_DEFAULT
  for pw_s in $pw; do slot_ok "$pw_s" || die "claude-peer.slots: '$pw_s' is not a slot name"; done
  printf '%s\n' "$pw"
}

# repo own pool -> the slot line of the first slot that can be taken, claimed:
# own, then the pool from its sixth name on, then its first five. A slot with a
# live claim is skipped; one that cannot be made says why (stderr) and is skipped.
# Exit 3 and one line when none can. Under the repo lock, taken once.
pool_checkout() {
  peer_lock "$1"
  ( pool_pick "$@" )
  rc=$?
  peer_unlock "$1"
  return $rc
}

pool_pick() {
  pk_repo=$1 pk_own=$2
  pk_order=$pk_own pk_i=0 pk_n=0 pk_first=
  for s in $3; do
    pk_n=$((pk_n + 1)); pk_i=$((pk_i + 1))
    if [ "$pk_i" -le 5 ]; then pk_first="$pk_first $s"
    elif [ "$s" != "$pk_own" ]; then pk_order="$pk_order $s"; fi
  done
  for s in $pk_first; do [ "$s" = "$pk_own" ] || pk_order="$pk_order $s"; done
  for s in $pk_order; do
    claim_live "$pk_repo/.claude/worktrees/$s" && continue
    pk_line=$(slot_pick "$pk_repo" "$s" "$(label_of "$s")") || continue
    printf '%s\n' "$pk_line"
    return 0
  done
  warn "all $pk_n slots are in use in $pk_repo"
  return 3
}

wait_dir() { printf '%s/claude-peer.wait\n' "$(git -C "$1" rev-parse --path-format=absolute --git-common-dir)"; }

# Where a waiting pane's fzf listens to be told it is looked at. Fixed under $HOME,
# not XDG_STATE_HOME: iTerm2's trigger command runs in iTerm2's environment, not the
# pane's, and both must name one directory.
look_dir() { printf '%s\n' "${CLAUDE_PEER_LOOK:-$HOME/.local/state/claude-peer/look}"; }

# A session id: the GUID after the colon of $ITERM_SESSION_ID, 36 of 0-9A-Fa-f-.
look_ok() {
  [ "${#1}" -eq 36 ] || return 1
  case $1 in *[!0-9A-Fa-f-]*) return 1;; esac
}

# repo -> slot<TAB>pid<TAB>leader of every live waiting pane, sorted by slot
waiters() {
  ww_dir=$(wait_dir "$1")
  for ww_f in "$ww_dir"/*; do
    [ -f "$ww_f" ] || continue
    ww_b=${ww_f##*/}
    case $ww_b in *.*.*) continue;; esac
    ww_p=${ww_b#*.}
    case $ww_p in ''|*[!0-9]*) continue;; esac
    kill -0 "$ww_p" 2>/dev/null || continue
    printf '%s\t%s\t%s\n' "${ww_b%%.*}" "$ww_p" "$(sed -n 1p "$ww_f")"
  done | LC_ALL=C sort
}

# A wait file belongs to a pane that is gone when its pid is.
pane_reap() {
  for pr_f in "$1"/*; do
    [ -e "$pr_f" ] || continue
    pr_b=${pr_f##*/}; pr_p=${pr_b#*.}; pr_p=${pr_p%%.*}
    case $pr_p in ''|*[!0-9]*) rm -f "$pr_f"; continue;; esac
    kill -0 "$pr_p" 2>/dev/null || rm -f "$pr_f"
  done
}

# The pane's blocker: a reader of one line from the terminal, else (no terminal)
# a long sleep. `wait` on it is what a USR1 interrupts. Sets pn_ended=1 when the
# blocker finished by itself, 0 when it was cut short.
pane_block() {
  rm -f "$pn_me.key"
  if [ "$pn_reader" = 1 ]; then
    ( IFS= read -r l 2>/dev/null <"$pn_tty" || exit 1; printf '%s\n' "$l" >"$pn_me.key" ) &
  else
    sleep 3600 &
  fi
  pn_rpid=$!
  pn_intr=
  wait "$pn_rpid"
  if kill -0 "$pn_rpid" 2>/dev/null; then kill "$pn_rpid" 2>/dev/null; pn_ended=0; else pn_ended=1; fi
  wait "$pn_rpid" 2>/dev/null
  pn_rpid=
}

# A signal can land between forking the blocker and recording its pid, so the
# shell's own job list (jobs -p, through a file: a substitution may not see it)
# is the cleanup, and pn_rpid only the second line.
pane_cleanup() {
  [ -n "${pn_me-}" ] || return 0
  jobs -p >"$pn_me.jobs" 2>/dev/null
  # shellcheck disable=SC2046
  kill $(cat "$pn_me.jobs" 2>/dev/null) 2>/dev/null
  [ -z "${pn_rpid-}" ] || kill "$pn_rpid" 2>/dev/null
  [ -z "${pn_look-}" ] || rm -f "$pn_look"
  rm -f "$pn_me" "$pn_me".*
}

pane_shell() { # leave: forget this pane, hand the terminal back, become a shell
  pane_cleanup
  trap - EXIT TTIN TTOU
  exec "${SHELL:-/bin/sh}" -i
}

# seconds -> 45s, 12m, 3h, 2d (whole units, rounded down)
dur_of() {
  if [ "$1" -lt 60 ]; then echo "${1}s"; elif [ "$1" -lt 3600 ]; then echo "$(( $1 / 60 ))m"
  elif [ "$1" -lt 86400 ]; then echo "$(( $1 / 3600 ))h"; else echo "$(( $1 / 86400 ))d"; fi
}

# What a hand-off adds to the peer's prompt, printed literally.
handoff_note() {
  # shellcheck disable=SC2016
  printf '%s\n' 'Hand-off from Lead. When you finish, or cannot go on, write your report to a file under ${TMPDIR:-/tmp}/claude-reports/<this repository'"'"'s directory name>/ and then run: claude-peer log done "<DONE|DONE_WITH_CONCERNS|BLOCKED|NEEDS_CONTEXT>: <one line; the commit or pull request; the report'"'"'s path>". That line reaches Lead by itself. A report left only in this pane reaches nobody.'
}

# One line of at most 80 characters, tabs as spaces, for a claim and the pane's
# header.
task_line() { printf '%s\n' "$1" | sed -n 1p | tr '\t\r' '  ' | cut -c1-80; }

# mode(fresh|continue|resume) slot(or -) prompt claude-args...: take a slot, run one
# session in it, return. Never exits: a refusal is printed and the pane waits on.
# The caller sets PG_CTX (a context path), PG_CTXNAME, PG_BY (who started it) and
# PG_TASK (one line), and for a hand-off PG_HANDOFF (1), PG_LEADPID, PG_LEADSID;
# they are read, and cleared, here.
pane_go() {
  pg_mode=$1 pg_req=$2 pg_prompt=$3; shift 3
  pg_ctx=${PG_CTX-} pg_ctxname=${PG_CTXNAME-} pg_by=${PG_BY-} pg_task=${PG_TASK-} pg_wake=${PG_WAKE-}
  pg_ho=${PG_HANDOFF-} pg_lpid=${PG_LEADPID-} pg_lsid=${PG_LEADSID-}
  PG_CTX= PG_CTXNAME= PG_BY= PG_TASK= PG_WAKE= PG_HANDOFF= PG_LEADPID= PG_LEADSID=
  if [ "$pg_req" != - ]; then
    out=$(slot_checkout "$repo" "$pg_req" "$(label_of "$pg_req")"); pg_rc=$?
  else
    pg_pool=$(pool_words) || return 0
    out=$(pool_checkout "$repo" "$slot" "$pg_pool"); pg_rc=$?
  fi
  if [ "$pg_rc" -ne 0 ]; then
    [ "$pg_rc" -ne 3 ] || [ "$pg_req" != - ] || echo "claude-peer: Return tries again"
    return 0
  fi
  pg_taken=$(printf '%s\n' "$out" | cut -f1)
  pg_wt=$(printf '%s\n' "$out" | cut -f2)
  pg_msg=$(label_of "$pg_taken")
  if [ "$pg_taken" != "$slot" ] && [ "$pg_req" = - ] && claim_live "$repo/.claude/worktrees/$slot"; then
    pg_msg="$pg_msg (this pane's $label is in use by the peers of $(sed -n 2p "$(claim_file "$repo/.claude/worktrees/$slot")"))"
  fi
  case $pg_by in ''|pane) ;; *) pg_msg="$pg_msg · started by $pg_by";; esac
  [ -z "$pg_task" ] || pg_msg="$pg_msg · $pg_task"
  [ -z "$pg_wake" ] || [ "${pn_lay:-none}" = none ] || art_wake
  echo "$pg_msg"
  pg_t0=$(date +%s)
  printf '%s\n%s\n%s\n%s\n%s\n%s\n%s\n' "${pg_by:--}" "${pg_ctxname:--}" "${pg_task:--}" "$pg_t0" \
    "$([ "$pg_ho" = 1 ] && echo handoff || echo -)" "${pg_lpid:--}" "${pg_lsid:--}" >>"$(claim_file "$pg_wt")"
  if [ "$pg_ho" = 1 ] && [ -n "$pg_prompt" ]; then pg_prompt="$pg_prompt

$(handoff_note)"; fi
  [ "$pg_mode" != continue ] || set -- --continue "$@"
  if [ -n "$pg_ctx" ]; then
    for pg_k in agent model effort; do
      pg_v=$(ctx_get "$pg_ctx" "$pg_k"); [ -z "$pg_v" ] || set -- "$@" "--$pg_k" "$pg_v"
    done
    pg_v=$(ctx_get "$pg_ctx" system); [ -z "$pg_v" ] || set -- "$@" --append-system-prompt "$pg_v"
  fi
  [ -z "$pg_prompt" ] || set -- "$@" "$pg_prompt"
  [ "$pg_mode" != resume ] || set -- "$@" --resume   # no value: Claude's own list chooses
  run_session "$pg_wt" "$(session_name "$pg_taken")" "$@"
  # only after a session ran: a refused start returned above, and its `end`
  # would close a live peer's claims
  # A requested stop says who asked and wakes nobody; a hand-off that ended by
  # itself is `gone` and tells Lead; anything else is a plain end.
  pg_l=$(label_of "$pg_taken")
  pg_txt="$pg_l ended after $(dur_of $(( $(date +%s) - pg_t0 )))${pg_task:+ ($pg_task)}"
  pg_sf=$(stop_file "$pg_wt")
  if [ -f "$pg_sf" ]; then
    pg_sw=$(sed -n 1p "$pg_sf"); rm -f "$pg_sf"
    ( cd -- "$repo" && log_add "$pg_l" end "$pg_txt (stopped by ${pg_sw:--})" ) 2>/dev/null
  elif [ "$pg_ho" = 1 ]; then
    ( cd -- "$repo" && log_add "$pg_l" gone "$pg_txt" ) 2>/dev/null && tell_lead "$LEADER" "$pg_lpid" "$pg_lsid"
  else
    ( cd -- "$repo" && log_add "$pg_l" end "$pg_txt" ) 2>/dev/null
  fi
  [ ! -t 1 ] || printf '\033]21337;status=;indicator=;status-color=;detail=\a'
  return 0
}

# --- the picker: what a waiting pane shows ------------------------------------------

# slug -> id<TAB>display per row. The display is the name, padded so every title
# starts in one column (the longest name, 8 to 16 wide), two spaces, the title.
pick_rows() {
  { printf '@fresh\tfresh\tA new session, no prompt\n'
    ctx_files "$1" | while IFS=$ctx_tab read -r pk_n pk_p; do
      pk_t=$(ctx_get "$pk_p" title)
      printf '%s\t%s\t%s\n' "$pk_n" "$pk_n" "${pk_t:-$pk_n}"
    done
    printf '@continue\tcontinue\tPick up the last conversation\n'
    printf '@resume\tresume\tChoose an earlier conversation\n'
    printf '@task\ttask\tType a task and start it\n'
    printf '@shell\tshell\tDrop to a shell\n'
  } | awk -F'\t' '{ id[NR] = $1; n[NR] = $2; t[NR] = $3; if (length($2) > w) w = length($2) }
    END { if (w < 8) w = 8; if (w > 16) w = 16
          for (i = 1; i <= NR; i++) printf "%s\t%-" w "s  %s\n", id[i], n[i], t[i] }'
}

# fzf_ok: fzf is 0.75 or newer (major.minor compared as numbers); fzf_ver is its version.
fzf_ok() {
  fzf_ver=$(fzf --version 2>/dev/null | sed -n 1p); fzf_ver=${fzf_ver%% *}
  printf '%s\n' "$fzf_ver" | awk -F. '{ exit !($1 + 0 > 0 || $2 + 0 >= 75) }'
}

# --- the sleeper: the figure above the picker -----------------------------------------

