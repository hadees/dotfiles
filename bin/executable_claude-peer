# frame z(all|near|near-mid|none) mode(truecolor|256) cap band, art format on stdin
# -> one line per character row: two pixel rows each, the same colour above and
# below a space on that background, two colours ▀ over a background, one ▀ or ▄,
# an eye a bold ▬ in K on O; each cell then a reset. A file that does not parse:
# one line, the reason, and status 3. A frame that is not there is `asleep`.
art_awk() {
  awk -v want="$1" -v zs="$2" -v mode="$3" -v cap="$4" -v band="$5" '
    function bad(m) { print m; err = 1; exit 3 }
    function lvl(v,   i, d, best, bi) {
      best = 999
      for (i = 0; i < 6; i++) { d = v - L[i]; if (d < 0) d = -d; if (d < best) { best = d; bi = i } }
      return bi
    }
    function c256(r, g, b,   ri, gi, bi, dc, gr, gv, dg) {
      ri = lvl(r); gi = lvl(g); bi = lvl(b)
      dc = (r - L[ri]) * (r - L[ri]) + (g - L[gi]) * (g - L[gi]) + (b - L[bi]) * (b - L[bi])
      gr = int(((r + g + b) / 3 - 8) / 10 + 0.5); if (gr < 0) gr = 0; if (gr > 23) gr = 23
      gv = 8 + 10 * gr
      dg = (r - gv) * (r - gv) + (g - gv) * (g - gv) + (b - gv) * (b - gv)
      return dg < dc ? 232 + gr : 16 + 36 * ri + 6 * gi + bi
    }
    function col(k, fb,   c) {
      split(pal[k], c, " ")
      if (mode == "truecolor") return fb ";2;" c[1] ";" c[2] ";" c[3]
      return fb ";5;" c256(c[1] + 0, c[2] + 0, c[3] + 0)
    }
    function cell(a, b) {
      if (a == "." && b == ".") return " "
      if (a == "E") return "\033[1;" col("K", 38) ";" col("O", 48) "m▬\033[0m"
      if (a == b) return "\033[" col(a, 48) "m \033[0m"
      if (b == ".") return "\033[" col(a, 38) "m▀\033[0m"
      if (a == ".") return "\033[" col(b, 38) "m▄\033[0m"
      return "\033[" col(a, 38) ";" col(b, 48) "m▀\033[0m"
    }
    BEGIN { split("0 95 135 175 215 255", t, " "); for (i = 0; i < 6; i++) L[i] = t[i + 1] + 0; fr = "" }
    { sub(/\r$/, "") }
    /^[ \t]*(#|$)/ { next }
    $1 == "palette" {
      if (NF != 5 || length($2) != 1 || $2 !~ /^[A-Za-z]$/ || $2 == "E") bad("line " NR ": palette <letter> <r> <g> <b>")
      for (i = 3; i <= 5; i++) if ($i !~ /^[0-9]+$/ || $i + 0 > 255) bad("line " NR ": a colour channel is 0 to 255")
      pal[$2] = ($3 + 0) " " ($4 + 0) " " ($5 + 0); fr = ""; next
    }
    $1 == "margin" { if (NF != 2 || $2 !~ /^[0-9]+$/) bad("line " NR ": margin <columns>"); margin = $2 + 0; fr = ""; next }
    $1 == "z" {
      if (NF != 4 || $2 !~ /^(near|mid|far)$/ || $3 !~ /^[0-9]+$/ || $4 !~ /^[0-9]+$/) bad("line " NR ": z near|mid|far <row> <column>")
      zr[$2] = $3 + 0; zc[$2] = $4 + 0; fr = ""; next
    }
    $1 == "cap" { if (NF != 2 || $2 != "fixed") bad("line " NR ": cap fixed"); fixed = 1; fr = ""; next }
    $1 == "frame" {
      if (NF != 2) bad("line " NR ": frame <name>")
      fr = $2; if (fr in nrow) bad("line " NR ": frame " fr " twice"); nrow[fr] = 0; next
    }
    NF == 1 && fr != "" {
      if ($1 !~ /^[A-Za-z.]+$/) bad("line " NR ": a pixel row is palette letters, . and E")
      n = ++nrow[fr]; row[fr, n] = $1
      if (length($1) != length(row[fr, 1])) bad("line " NR ": frame " fr " has rows of unequal width")
      next
    }
    { bad("line " NR ": not understood") }
    END {
      if (err) exit 3
      if (!("asleep" in nrow)) bad("no frame asleep")
      for (f in nrow) {
        if (nrow[f] == 0 || nrow[f] % 2) bad("frame " f ": rows must be an even number")
        for (n = 1; n <= nrow[f]; n++) for (j = 1; j <= length(row[f, n]); j++) {
          a = substr(row[f, n], j, 1)
          if (a != "." && a != "E" && !(a in pal)) bad("frame " f ": " a " is not in the palette")
          if (n % 2) { b = substr(row[f, n + 1], j, 1); if ((a == "E") != (b == "E")) bad("frame " f ": an eye must fill both pixel rows of its cell") }
          if (a == "E" && !(("K" in pal) && ("O" in pal))) bad("eyes need palette K and O")
        }
      }
      for (k in zr) if (zc[k] >= margin) bad("z " k ": column " zc[k] " is not inside the margin")
      if (!fixed && cap != "") { pal["C"] = cap; pal["B"] = band }
      f = (want in nrow) ? want : "asleep"
      if (zs == "all" || zs == "near-mid" || zs == "near") on["near"] = 1
      if (zs == "all" || zs == "near-mid") on["mid"] = 1
      if (zs == "all") on["far"] = 1
      zt["far"] = "\033[1mZ\033[0m"; zt["mid"] = "\033[38;5;250mz\033[0m"; zt["near"] = "\033[2mz\033[0m"
      w = length(row[f, 1])
      for (i = 0; i < nrow[f] / 2; i++) {
        line = ""
        for (m = 0; m < margin; m++) {
          s = " "
          for (k in on) if ((k in zr) && zr[k] == i && zc[k] == m) s = zt[k]
          line = line s
        }
        up = row[f, 2 * i + 1]; lo = row[f, 2 * i + 2]
        for (j = 1; j <= w; j++) line = line cell(substr(up, j, 1), substr(lo, j, 1))
        print line
      }
    }'
}

# slot -> ac_cap and ac_band, "r g b": git config claude-peer.<slot>.cap, else by
# the slot's place in the pool (Base16 Eighties hues; the second is the approved blue).
art_cap() {
  ac_h=$(git config --get "claude-peer.$1.cap" 2>/dev/null) || ac_h=
  ac_h=${ac_h#\#}
  if ! printf '%s\n' "$ac_h" | LC_ALL=C grep -Eq '^[0-9A-Fa-f]{6}$'; then
    ac_i=0 ac_pos=0
    for ac_w in $(pool_words 2>/dev/null); do
      [ "$ac_w" != "$1" ] || { ac_pos=$ac_i; break; }
      ac_i=$((ac_i + 1))
    done
    set -- 99cc99 5a78c8 cc99cc 66cccc ffcc66 f2777a
    shift $((ac_pos % 6)); ac_h=$1
  fi
  ac_r=$((0x$(printf '%s' "$ac_h" | cut -c1-2))) ac_g=$((0x$(printf '%s' "$ac_h" | cut -c3-4))) ac_b=$((0x$(printf '%s' "$ac_h" | cut -c5-6)))
  ac_cap="$ac_r $ac_g $ac_b"
  case $ac_h in
    5a78c8|5A78C8) ac_band='60 85 160';;
    *) ac_band="$((ac_r * 7 / 10)) $((ac_g * 7 / 10)) $((ac_b * 7 / 10))";;
  esac
}

# frame z slot [mode] -> the rendered rows: from git config claude-peer.art-file when
# it parses (else one line saying why, and the built-in). Mode: truecolor when
# COLORTERM says so, else 256.
art_mode() { case ${COLORTERM-} in truecolor|24bit) echo truecolor;; *) echo 256;; esac; }

art_lines() {
  al_m=${4:-$(art_mode)}
  art_cap "$3"
  al_f=$(git config --path --get claude-peer.art-file 2>/dev/null) || al_f=
  if [ -n "$al_f" ]; then
    if [ ! -r "$al_f" ]; then warn "$al_f: cannot be read"
    elif al_o=$(art_awk "$1" "$2" "$al_m" "$ac_cap" "$ac_band" <"$al_f"); then printf '%s\n' "$al_o"; return 0
    else warn "$al_f: $(printf '%s\n' "$al_o" | sed -n 1p)"; fi
  fi
  art_default | art_awk "$1" "$2" "$al_m" "$ac_cap" "$ac_band"
}

# slot -> hat_fzf (#rrggbb, or the 256-colour index the art draws the hat in) and
# hat_sgr (the same as an SGR foreground), for the selector to match the hat.
art_hat() {
  art_cap "$1"
  if [ "$(art_mode)" = truecolor ]; then
    # shellcheck disable=SC2086
    hat_fzf=$(printf '#%02x%02x%02x' $ac_cap) hat_sgr="38;2;$(echo "$ac_cap" | tr ' ' ';')"
  else
    hat_fzf=$(art_c256 "$ac_cap") hat_sgr="38;5;$hat_fzf"
  fi
}

# "r g b" -> the 256-colour index the art draws that colour in
art_c256() {
  printf 'palette C %s\nmargin 0\nframe asleep\nC\nC\n' "$1" |
    art_awk asleep none 256 '' '' | sed 's/.*48;5;\([0-9]*\)m.*/\1/'
}

# --- Hermes's caduceus: the figure the Hermes pane waits under ------------------------
# Read at run time from the installed Hermes (HERMES_CADUCEUS in hermes_cli/banner.py;
# MIT, Nous Research) and never kept here. Dark bronze, a light band about three cells
# wide sweeping down it, then a pause; no z's, it is not asleep. The band's seven
# levels are worked out here, in the sleeper's colour mode.
# Hermes's own install places: the user install, then the root one on Linux.
herm_banner() {
  for hb in "$HOME/.hermes/hermes-agent" /usr/local/lib/hermes-agent; do
    [ -r "$hb/hermes_cli/banner.py" ] && break
  done
  printf '%s\n' "$hb/hermes_cli/banner.py"
}

herm_levels() {
  hl_m=${1:-$(art_mode)}
  for hl_k in 0 1 2 3 4 5 6; do
    hl_c="$((150 + 105 * hl_k / 6)) $((92 + 122 * hl_k / 6)) $((36 + 114 * hl_k / 6))"
    if [ "$hl_m" = truecolor ]; then echo "38;2;$(echo "$hl_c" | tr ' ' ';')"
    else echo "38;5;$(art_c256 "$hl_c")"; fi
  done
}

# banner <at>|<dir> level×7 -> frame <at> (0 is still) on stdout, or every frame into
# <dir>/0… and "<count> <columns>" on stdout. Status 3, silent, when there is no figure.
herm_py() {
  python3 -I - "$@" 2>/dev/null <<'PYEOF'
import re, sys
src, out, lv = sys.argv[1], sys.argv[2], sys.argv[3:10]
try:
    text = open(src, encoding="utf-8").read()
except (OSError, UnicodeError):
    sys.exit(3)
m = re.search(r'^HERMES_CADUCEUS\s*=\s*r?"""(.*?)"""', text, re.S | re.M)
if not m:
    sys.exit(3)
esc = re.compile(r"\x1b(\[[0-?]*[ -/]*[@-~]|\][^\x07\x1b]*(\x07|\x1b\\)?|.)?")
ctl = re.compile(r"[\x00-\x1f\x7f-\x9f]")
rows = [ctl.sub("", re.sub(r"\[[^\]]*\]", "", esc.sub("", l))).rstrip() for l in m.group(1).split("\n")]
while rows and not rows[-1].strip("\u2800 "):
    rows.pop()
while rows and not rows[0].strip("\u2800 "):
    rows.pop(0)
if not rows or len(rows) > 40 or max(map(len, rows)) > 100:
    sys.exit(3)
H, W = len(rows), max(map(len, rows))
HINT = "\n  \x1b[2mwaiting \u00b7 \u23ce to start Hermes \u00b7 q for a shell\x1b[0m\x1b[K\n"
ESC = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")

def frame(t):
    p, lines = t - 6, []
    for i, r in enumerate(rows):
        cur, line = None, "  "
        for j, ch in enumerate(r):
            k = max(0, 6 - int(2 * abs(i + j / 2 - p)))
            if k != cur:
                line += "\x1b[" + lv[k] + "m"
                cur = k
            line += ch
        lines.append(line + "\x1b[0m\x1b[K\n")
    return "".join(lines) + HINT

if out.isdigit():
    sys.stdout.write(frame(int(out)))
else:
    n = H + W + 40
    for t in range(n):
        with open("%s/%d" % (out, t), "w", encoding="utf-8") as f:
            f.write(frame(t))
    print(n, max(W + 2, len(ESC.sub("", HINT).strip("\n"))))
PYEOF
}

# The Hermes pane's wait: the figure, glinting for art-seconds from the start and after
# each line typed, then still. Typing is not echoed; a line of q leaves. 0: Return. 1:
# q, or end of input. 3, silent: not a terminal, claude-peer.art false, no figure, or a
# pane too small to hold it (the caller then asks in words, as it did before the art).
herm_wait() {
  [ -t 0 ] && [ -t 1 ] || return 3
  [ "$(git config --get claude-peer.art 2>/dev/null)" != false ] || return 3
  hw_s=$(git config --get claude-peer.art-seconds 2>/dev/null) || hw_s=20
  case $hw_s in ''|*[!0-9]*) hw_s=20;; esac
  hw_d=$(mktemp -d "${TMPDIR:-/tmp}/claude-peer-hermes.XXXXXX") || return 3
  # shellcheck disable=SC2046
  hw_n=$(herm_py "$(herm_banner)" "$hw_d" $(herm_levels)) || { rm -rf "$hw_d"; return 3; }
  hw_w=${hw_n#* } hw_n=${hw_n% *}
  hw_h=$(wc -l <"$hw_d/0" | tr -d ' ')
  # shellcheck disable=SC2046
  set -- $(stty size 2>/dev/null)
  # ponytail: sized once; a pane resized while it waits can smear the figure until Return
  if [ $# -lt 2 ] || [ "$1" -le "$hw_h" ] || [ "$2" -lt "$hw_w" ]; then rm -rf "$hw_d"; return 3; fi
  hw_t=$(stty -g)
  trap 'stty "$hw_t"; printf "\033[?25h"; rm -rf "$hw_d"; exit 1' HUP INT TERM
  stty -echo; printf '\033[?25l'
  cat "$hw_d/0"
  while :; do
    rm -f "$hw_d/stop"
    hw_p=
    if [ "$hw_s" -gt 0 ]; then
      # one frame each 70 ms for art-seconds, then the still one; a stop file ends it
      # between frames, so the cursor is always back under the figure
      ( i=1 end=$((hw_s * 1000 / 70))
        while [ "$i" -le "$end" ] && [ ! -e "$hw_d/stop" ]; do
          sleep 0.07
          printf '\033[%dA' "$hw_h"; cat "$hw_d/$((i % hw_n))"; i=$((i + 1))
        done
        printf '\033[%dA' "$hw_h"; cat "$hw_d/0" ) &
      hw_p=$!
    fi
    read -r hw_a || hw_a=q
    : >"$hw_d/stop"; [ -z "$hw_p" ] || wait "$hw_p"
    case $hw_a in ''|q) break;; esac
  done
  stty "$hw_t"; printf '\033[%dA\033[J\033[?25h' "$hw_h"
  trap - HUP INT TERM
  rm -rf "$hw_d"
  [ -z "$hw_a" ]
}

# second-line [frame [z]] -> the art block: the frame (asleep, all z's) and, beside it on
# character rows 4 and 5 (pn_lay beside) or under it (under), `✻ <Label> · <repo>`
# and the second line, dim. <repo> is cut, never the label, to fit pn_w - 3 columns.
art_block() {
  ab_room=$((pn_w - 3)); [ "$pn_lay" != beside ] || ab_room=$((ab_room - 29))
  ab_r=$((ab_room - 5 - ${#label})); [ "$ab_r" -ge 0 ] || ab_r=0
  ab_repo=$(printf '%s' "$rname" | cut -c1-"$((ab_r > 0 ? ab_r : 1))"); [ "$ab_r" -gt 0 ] || ab_repo=
  ab_t=$(printf '✻ \033[1m%s\033[0m · %s' "$label" "$ab_repo") ab_s=$(printf '\033[2m%s\033[0m' "$1")
  art_lines "${2:-asleep}" "${3:-all}" "$slot" | AB_T=$ab_t AB_S=$ab_s AB_L=$pn_lay awk '
      { print $0 (ENVIRON["AB_L"] == "beside" ? (NR == 5 ? "  " ENVIRON["AB_T"] : NR == 6 ? "  " ENVIRON["AB_S"] : "") : "") }
      END { if (ENVIRON["AB_L"] == "under") { print ENVIRON["AB_T"]; print ENVIRON["AB_S"] } }'
}

# pn_rows pn_cols: CLAUDE_PEER_SIZE ("rows cols"), else the terminal's, else empty.
pane_size() {
  pn_rows= pn_cols=
  if [ -n "${CLAUDE_PEER_SIZE-}" ]; then
    # shellcheck disable=SC2086
    set -- $CLAUDE_PEER_SIZE
  elif [ -c "$pn_tty" ]; then
    # shellcheck disable=SC2046
    set -- $(stty size <"$pn_tty" 2>/dev/null)
  else
    set --
  fi
  [ $# -ge 2 ] || return 0
  case $1$2 in ''|*[!0-9]*) return 0;; esac
  pn_rows=$1 pn_cols=$2
}

# The block: pn_n rows, pn_head header lines, pn_w wide, centred by pn_left and
# pn_right (pn_pad: pn_left spaces) from 80 columns, pn_vis rows shown, pn_h high.
# pn_lay: where the sleeper goes (beside, under, none) and pn_al its block's lines.
pane_geom() {
  pn_n=$(wc -l <"$pn_me.rows" | tr -d ' ')
  pn_lay=none pn_al=0
  if [ -n "$pn_cols" ] && [ "$(git config --get claude-peer.art 2>/dev/null)" != false ]; then
    if [ "$pn_cols" -ge 80 ] && [ "$pn_rows" -ge 16 ]; then pn_lay=beside
    elif [ "$pn_cols" -ge 30 ] && [ "$pn_rows" -ge 18 ]; then pn_lay=under; fi
  fi
  pn_head=1
  pn_w=$(awk -F'\t' '{ if (length($2) + 3 > w) w = length($2) + 3 } END { print (w > 58 ? w : 58) }' "$pn_me.rows")
  if [ "$pn_lay" != none ]; then
    pn_al=$(art_lines asleep none "$slot" 2>/dev/null | wc -l | tr -d ' ')
    [ "$pn_lay" = beside ] || pn_al=$((pn_al + 2))
    pn_head=$((pn_al + 2))
    # the beside title row: 3 of fzf's, 27 of art, 2, then `✻ <Label> · <repo>`
    pg_t=$((3 + 29 + 5 + ${#label} + ${#rname}))
    [ "$pg_t" -le $((pn_cols - 2)) ] || pg_t=$((pn_cols - 2))
    [ "$pn_w" -ge "$pg_t" ] || pn_w=$pg_t
  fi
  pn_left=0 pn_right=0
  if [ -n "$pn_cols" ] && [ "$pn_cols" -ge 80 ] && [ $((pn_w + 2)) -le "$pn_cols" ]; then
    pn_left=$(( (pn_cols - pn_w) / 2 )); pn_right=$((pn_cols - pn_w - pn_left))
  fi
  pn_pad=$(printf "%${pn_left}s" '')
  pn_vis=$pn_n
  [ "$pn_vis" -le 12 ] || pn_vis=12
  [ -z "$pn_rows" ] || [ $((pn_rows - pn_head - 1)) -ge "$pn_vis" ] || pn_vis=$((pn_rows - pn_head - 1))
  [ "$pn_vis" -ge 1 ] || pn_vis=1
  pn_h=$((pn_head + 1 + pn_vis))
}

# [frame [z]] -> fzf's header: the sleeper's block and an empty line when it shows,
# then the hint, dim; the short one under 56 columns.
pane_head() {
  [ "$pn_lay" = none ] || { art_block 'waiting · ⏎ pick a context' "$@"; echo; }
  if [ -n "$pn_cols" ] && [ "$pn_cols" -lt 56 ]; then ph_t='↵ start · ^T type a task · esc hide'
  else ph_t='↵ start · ^T type a task · ^S …and save it · esc hide'; fi
  printf '\033[2m%s\033[0m' "$ph_t"
}

# fzf's input in look mode: the header lines (a `-` id, then line i of the four poses
# and the still frame in fields 2-6, so change-with-nth rotates them), then every row
# with its display in fields 2-6.
pane_feed() {
  awk -v n="$pn_head" -v f="$pn_me.frame" -v rows="$pn_me.rows" '
    BEGIN {
      split("0 1 2 3 still", k, " ")
      for (j = 1; j <= 5; j++) {
        i = 0
        while ((getline l < (f "." k[j])) > 0) { i++; gsub(/\t/, " ", l); a[j, i] = l }
        close(f "." k[j])
      }
      for (i = 1; i <= n; i++) printf "-\t%s\t%s\t%s\t%s\t%s\n", a[1, i], a[2, i], a[3, i], a[4, i], a[5, i]
      while ((getline l < rows) > 0) {
        c = split(l, p, "\t"); d = p[2]
        for (q = 3; q <= c; q++) d = d " " p[q]
        printf "%s\t%s\t%s\t%s\t%s\t%s\n", p[1], d, d, d, d, d
      }
    }'
}

# second-line: the sleeper's block in ordinary output, where fzf's header would put
# it (pn_pad and two), then an empty line; nothing with pn_lay none.
pane_art() {
  [ "$pn_lay" != none ] || return 0
  art_block "$1" | sed "s/^/$pn_pad  /"
  echo
}

# The sleeper wakes where fzf has just erased itself: wake-1, then wake-2 over it.
art_wake() {
  aw_n=$pn_al
  [ "$pn_lay" = beside ] || aw_n=$((pn_al + 2))
  art_block '' wake-1 none | sed "s/^/$pn_pad  /"
  sleep 0.25 2>/dev/null || :
  printf '\033[%sA\r' "$aw_n"
  art_block '' wake-2 none | sed "s/^/$pn_pad  /"
  sleep 0.25 2>/dev/null || :
}

# The quiet state: the sleeper with the hint as its second line, else C4b's line.
# pn_qn: how many lines to erase before it is drawn again (0: leave them).
pane_quiet() {
  pane_size
  [ -f "$pn_me.rows" ] || pick_rows "$pn_slug" >"$pn_me.rows"
  pane_geom
  pn_qn=0
  if [ "$pn_lay" != none ]; then
    if [ "$pn_pick" = off ]; then pane_art '⏎ start · c continue · q shell'
    else pane_art '⏎ picker · c continue · q shell'; fi
    pn_qn=$((pn_al + 2))
  elif [ "$pn_pick" = off ]; then printf '%s: Return starts a Claude here, c continues the last session, q leaves a shell\n' "$label"
  else printf '%s: Return picks a context, c continues the last session, q leaves a shell\n' "$label"; fi
}

# The quiet block, the empty line and the typed line go before the block is drawn
# again or the picker opens, so one sleeper is ever on screen.
pane_unquiet() {
  [ "$pn_qn" -le 0 ] || printf '\033[%sA\r\033[J' "$pn_qn"
  pn_qn=0
}

# prompt -> the answer in pn_ans; status 1 when a request, Ctrl-C or end of input
# cut it short, and pn_why says which (request, intr, eof). A request is handled
# by the pane's loop; a reader that ended with no line means no terminal.
pane_ask() {
  printf '%s%s' "$pn_pad" "$1"
  pane_block
  # a request leaves the cursor after the prompt: end its line for the header
  if [ -f "$pn_me.start" ]; then echo; pn_why=request; return 1; fi
  if [ -n "$pn_intr" ]; then pn_intr=; pn_why=intr; return 1; fi
  if [ ! -f "$pn_me.key" ]; then
    [ "$pn_ended" != 1 ] || pn_reader=0
    pn_why=eof; return 1
  fi
  pn_ans=$(cat "$pn_me.key"); rm -f "$pn_me.key"
  return 0
}

# task-text: write <root>/<slug>/90-<name>.ctx when a name is given. Status 1 only
# when the question was cut short; every refusal is one line and status 0.
pane_save() {
  [ -n "$pn_slug" ] || { echo 'not saved: this repository has no origin remote, so it has no context directory'; return 0; }
  pane_ask 'Save as (a name like fix-ci, Return skips): ' || return 1
  [ -n "$pn_ans" ] || return 0
  sv_n=$pn_ans
  printf '%s\n' "$sv_n" | LC_ALL=C grep -Eq '^[a-z][a-z0-9_-]*$' ||
    { echo "not saved: '$sv_n' is not a name (lowercase letters, digits, - and _)"; return 0; }
  sv_d=$(ctx_dir)/$pn_slug
  for sv_f in "$sv_d"/*.ctx; do
    [ -f "$sv_f" ] || continue
    [ "$(ctx_name_of "$sv_f")" != "$sv_n" ] || { echo "not saved: $sv_n already exists in $sv_d"; return 0; }
  done
  mkdir -p "$sv_d" || { echo "not saved: cannot create $sv_d"; return 0; }
  { printf 'title: %s\n\n' "$(printf '%s\n' "$1" | sed -n 1p | tr '\t\r' '  ' | cut -c1-40)"; printf '%s\n' "$1"; } >"$sv_d/90-$sv_n.ctx" &&
    echo "saved as $sv_n ($sv_d/90-$sv_n.ctx)"
  return 0
}

# task-text save("" or 1) definition-args...: a fresh session whose prompt is the text
pane_task() {
  pt_t=$1 pt_s=$2; shift 2
  [ -z "$pt_s" ] || pane_save "$pt_t" || return 0
  rm -f "$pn_me"
  PG_BY=pane PG_TASK=$(task_line "$pt_t")
  pane_go fresh - "$pt_t" "$@"
}

# save("" or 1) definition-args...: ask for the task, then start it
pane_newtask() {
  pw_s=$1; shift
  pane_ask 'Task: ' || return 0
  [ -z "$pn_ans" ] || pane_task "$pn_ans" "$pw_s" "$@"
}

# context-name definition-args...: ask for its value when it has `ask`, then start it
pane_named() {
  px_n=$1; shift
  px_p=$(ctx_find "$px_n" "$pn_slug") && ctx_check "$px_p" || return 0
  px_a=$(ctx_get "$px_p" ask); px_v=
  if [ -n "$px_a" ]; then
    pane_ask "$px_a: " || return 0
    px_v=$pn_ans
    [ -n "$px_v" ] || return 0
  fi
  px_m=$(ctx_get "$px_p" mode)
  rm -f "$pn_me"
  PG_CTX=$px_p PG_CTXNAME=$px_n PG_BY=pane
  PG_TASK=$(task_line "$px_n${px_v:+: $px_v}")
  pane_go "${px_m:-fresh}" - "$(ctx_prompt "$px_p" "$px_v")" "$@"
}

# row-id definition-args...: what each row runs
pane_choose() {
  pc_id=$1; shift
  case $pc_id in
    @fresh|@continue|@resume) rm -f "$pn_me"; PG_BY=pane; pane_go "${pc_id#@}" - '' "$@";;
    @task) pane_newtask "" "$@";;
    @shell) pane_shell;;
    *) pane_named "$pc_id" "$@";;
  esac
  return 0
}

# Is the typed line the name of a context of this repository?
pane_has_ctx() { ctx_files "$pn_slug" 2>/dev/null | cut -f1 | grep -qxF -- "$1"; }

# The colour words of the caller's FZF_DEFAULT_OPTS, as --color=<v>, and nothing
# else from it: the theme arrives, a --border or --height does not.
fzf_colors() {
  fc_out= fc_next=
  set -f
  for fc_w in ${FZF_DEFAULT_OPTS-}; do
    if [ -n "$fc_next" ]; then fc_next= fc_v=$fc_w
    else
      case $fc_w in
        --color) fc_next=1; continue;;
        --color=*) fc_v=${fc_w#--color=};;
        *) continue;;
      esac
    fi
    printf '%s\n' "$fc_v" | LC_ALL=C grep -Eq '^[A-Za-z0-9#:,+_-]+$' && fc_out="$fc_out --color=$fc_v"
  done
  set +f
  printf '%s' "$fc_out"
}

# fzf's timer, once a second while a key was pressed in the last art-seconds: the
# pose for that second (z's each second, the pom-pom every two), then the still
# frame and the timer unbound, so an idle picker starts no process at all.
PANE_TICK='t=$(( (FZF_IDLE_TIME_MS + 500) / 1000 ))
if [ "$t" -ge "$CLAUDE_PEER_ART_SECONDS" ]; then
  printf '"'"'unbind(every(1))+change-header:'"'"'; cat "$CLAUDE_PEER_FRAMES.still"
else
  printf '"'"'change-header:'"'"'; cat "$CLAUDE_PEER_FRAMES.$((t % 4))"
fi'

# fzf as a background child the pane waits on, like the reader, so a request
# (USR1) still interrupts it. Status 1: fzf failed, use the list. Sets
# pn_state=quiet on Esc, or when fzf ends with nothing chosen.
pane_fzf() {
  while :; do
    rm -f "$pn_me.pick"
    # the moving sleeper: one header file per pose, which fzf's own timer shows; drawn
    # again only when the layout changed, so a picker reopened at one size renders nothing
    # Three modes: look (told by `claude-peer look` when it is looked at; fzf listens on
    # a socket), limited (today's timer, pn_secs after the last key), still.
    pn_anim= pn_lk= pn_lku=
    if [ "$pn_lay" != none ] && [ -n "$pn_look" ] && mkdir -p "$(look_dir)" 2>/dev/null && chmod 700 "$(look_dir)" 2>/dev/null; then
      pn_lk=1
      pf_fo=; [ ! -r "$(look_dir)/focus" ] || read -r pf_fo <"$(look_dir)/focus"
      [ "$pf_fo" = "$pn_look_id" ] || pn_lku=1
    elif [ "$pn_lay" != none ] && [ "$pn_secs" -gt 0 ]; then pn_anim=1; fi
    if [ -n "$pn_anim$pn_lk" ]; then
      pf_key="$pn_lay $pn_w $pn_cols"
      if [ "$(cat "$pn_me.frame.key" 2>/dev/null)" != "$pf_key" ]; then
        pane_head asleep near >"$pn_me.frame.0"; pane_head asleep near-mid >"$pn_me.frame.1"
        pane_head asleep-sway all >"$pn_me.frame.2"; pane_head asleep-sway none >"$pn_me.frame.3"
        pane_head >"$pn_me.frame.still"
        printf '%s\n' "$pf_key" >"$pn_me.frame.key"
      fi
      pn_header=$(cat "$pn_me.frame.0") pn_in=$pn_me.rows
      [ -z "$pn_lk" ] || { pn_header= pn_in=$pn_me.frame.feed; pane_feed >"$pn_in"; }
    else
      pn_header=$(pane_head) pn_in=$pn_me.rows
    fi
    # shellcheck disable=SC2086
    ( trap - TTIN TTOU; unset FZF_DEFAULT_OPTS FZF_DEFAULT_OPTS_FILE
      CLAUDE_PEER_FRAMES=$pn_me.frame CLAUDE_PEER_ART_SECONDS=$pn_secs
      export CLAUDE_PEER_FRAMES CLAUDE_PEER_ART_SECONDS
      exec fzf $pn_colors --color=header:-1 $pn_hatc \
        --no-multi --no-sort --no-mouse --layout=reverse --header-first \
        --height="$pn_h" --info=hidden --no-separator \
        --margin="0,$pn_right,0,$pn_left" --pointer='▸' --gutter=' ' \
        --delimiter='\t' --with-nth=2 --prompt="$label ▸ " \
        ${pn_lk:+--ansi} ${pn_lk:+"--header-lines=$pn_head"} ${pn_header:+"--header=$pn_header"} \
        --print-query --expect=ctrl-t,ctrl-s \
        ${pn_anim:+"--with-shell=sh -c"} ${pn_anim:+"--bind=change,focus:rebind(every(1))"} \
        ${pn_anim:+"--bind=every(1):bg-transform:$PANE_TICK"} \
        ${pn_lk:+"--listen=$pn_look"} ${pn_lku:+"--bind=start:unbind(every(1))"} \
        ${pn_lk:+"--bind=every(1):change-with-nth(2|3|4|5)"} \
        <"$pn_in" >"$pn_me.pick" ) &
    pn_rpid=$!
    while :; do
      wait "$pn_rpid"; pf_rc=$?
      if [ -f "$pn_me.start" ]; then
        kill "$pn_rpid" 2>/dev/null; wait "$pn_rpid" 2>/dev/null
        pn_rpid= pn_cut=1   # the request closed an open fzf: its session wakes the sleeper
        [ -z "$pn_lk" ] || rm -f "$pn_look"
        # a FIFO (the tests' terminal) would block the open until a writer comes
        [ ! -c "$pn_tty" ] || stty sane <"$pn_tty" 2>/dev/null
        return 0
      fi
      kill -0 "$pn_rpid" 2>/dev/null || break
    done
    pn_rpid=
    [ -z "$pn_lk" ] || rm -f "$pn_look"
    case $pf_rc in
      0|1) ;;
      130) pn_state=quiet; return 0;;
      *) echo "claude-peer: fzf failed (exit $pf_rc); using the list"; pn_pick=list; return 1;;
    esac
    pf_q=$(sed -n 1p "$pn_me.pick"); pf_k=$(sed -n 2p "$pn_me.pick"); pf_id=$(sed -n 3p "$pn_me.pick" | cut -f1)
    case $pf_k in
      ctrl-t|ctrl-s)
        [ -n "$pf_q" ] || continue   # nothing typed: the picker again
        PG_WAKE=1; pane_task "$pf_q" "$([ "$pf_k" = ctrl-s ] && echo 1)" "$@"; PG_WAKE=
        return 0;;
    esac
    if [ "$pf_rc" = 0 ] && [ -n "$pf_id" ]; then PG_WAKE=1; pane_choose "$pf_id" "$@"; PG_WAKE=
    elif [ "$pf_rc" = 1 ] && [ -n "$pf_q" ]; then PG_WAKE=1; pane_task "$pf_q" "" "$@"; PG_WAKE=
    else pn_state=quiet
    fi
    return 0
  done
}

# The numbered list, read by the pane's own line reader.
pane_list() {
  while :; do
    pane_art 'waiting · ⏎ pick a context'
    awk -F'\t' -v p="$pn_pad" '{ printf "%s%2d  %s\n", p, NR, $2 }' "$pn_me.rows"
    printf '%sc continue · r resume · n task · s task, saved · q shell\n' "$pn_pad"
    if ! pane_ask "$pn_prompt"; then
      case $pn_why in intr) pane_shell;; eof) pn_state=quiet;; esac
      return 0
    fi
    pl_id=
    case $pn_ans in
      '') pl_id=@fresh;;
      c) pl_id=@continue;;
      r) pl_id=@resume;;
      n) pane_newtask "" "$@"; return 0;;
      s) pane_newtask 1 "$@"; return 0;;
      q) pane_shell;;
      *[!0-9]*)
        pl_id=$(cut -f1 "$pn_me.rows" | grep -xF -- "$pn_ans" | sed -n 1p)
        [ -n "$pl_id" ] || case $pn_ans in fresh|continue|resume|task|shell) pl_id=@$pn_ans;; esac;;
      *) pl_id=$(awk -F'\t' -v n="$pn_ans" 'NR == n { print $1 }' "$pn_me.rows");;
    esac
    [ -z "$pl_id" ] || { pane_choose "$pl_id" "$@"; return 0; }
  done
}

# The picker state of a waiting pane: show fzf or the list at once, start what is
# chosen, or set pn_state=quiet.
pane_pick() {
  pane_size
  pick_rows "$pn_slug" >"$pn_me.rows"
  pane_geom
  # the selector takes the hat's colour while the sleeper shows
  pn_hatc= pn_prompt="$label ▸ "
  if [ "$pn_lay" != none ]; then
    art_hat "$slot"
    pn_hatc="--color=pointer:$hat_fzf,prompt:$hat_fzf"
    pn_prompt=$(printf '\033[%sm%s ▸\033[0m ' "$hat_sgr" "$label")
  fi
  if [ "$pn_pick" = fzf ]; then
    pane_fzf "$@" && return 0
  fi
  pane_list "$@"
}

# "$@": the definition's claude args. Needs repo rname slot label LEADER.
pane() {
  pn_wd=$(wait_dir "$repo")
  mkdir -p "$pn_wd" || die "cannot create $pn_wd"
  pn_me=$pn_wd/$slot.$$
  pn_tty=${CLAUDE_PEER_TTY:-/dev/tty}
  pn_rpid= pn_reader=1 pn_intr= pn_ended=0 pn_pad= pn_rows= pn_cols= pn_lay=none pn_al=0 pn_qn=0
  trap : USR1
  trap 'pn_intr=1' INT
  trap '' TTIN TTOU
  trap 'exit 143' TERM
  trap 'exit 129' HUP
  trap pane_cleanup EXIT
  pn_pick=$(git config --get claude-peer.picker 2>/dev/null)
  case $pn_pick in
    fzf|list|off) ;;
    *) if command -v fzf >/dev/null 2>&1 && [ -t 1 ]; then pn_pick=fzf; else pn_pick=list; fi;;
  esac
  if [ "$pn_pick" = fzf ]; then
    if ! command -v fzf >/dev/null 2>&1; then pn_pick=list
    elif ! fzf_ok; then echo "claude-peer: fzf $fzf_ver is older than 0.75; using the list"; pn_pick=list
    fi
  fi
  pn_colors=$(fzf_colors)
  pn_secs=$(git config --get claude-peer.art-seconds 2>/dev/null) || pn_secs=20
  case $pn_secs in ''|*[!0-9]*) pn_secs=20;; esac
  # look mode needs no limit of the operator's own, the marker, a valid session id
  # and a socket path short enough (sun_path is 104 bytes on macOS)
  pn_look= pn_look_id=
  case $(git config --get claude-peer.art-seconds 2>/dev/null) in
    ''|*[!0-9]*)
      pk_d=$(look_dir) pk_id=${ITERM_SESSION_ID-}
      case $pk_id in *:*) pk_id=${pk_id#*:};; *) pk_id=;; esac
      if [ -r "$pk_d/kind" ] && look_ok "$pk_id" && [ $(( $(printf %s "$pk_d" | wc -c) + 42 )) -le 100 ]; then
        pn_look=$pk_d/$pk_id.sock pn_look_id=$pk_id
      fi;;
  esac
  pn_cut=
  pn_slug=
  [ "$pn_pick" = off ] || pn_slug=$(origin_slug) || pn_slug=
  if [ "$(git config --get claude-peer.start 2>/dev/null)" = auto ]; then
    settle
    PG_BY=pane
    pane_go fresh - '' "$@"
  fi
  pn_show=1 pn_state=picker
  while :; do
    pane_reap "$pn_wd"
    printf '%s\n3\n' "$LEADER" >"$pn_me"
    [ "$pn_pick" != off ] || pn_state=quiet
    pn_ev=
    while [ -z "$pn_ev" ]; do
      if [ -f "$pn_me.start" ]; then pn_ev=request; break; fi
      if [ "$pn_state" = picker ]; then pn_ev=pick; break; fi
      [ -z "$pn_show" ] || pane_quiet
      pn_show=
      pane_block
      if [ -f "$pn_me.start" ]; then pn_ev=request
      elif [ -n "$pn_intr" ]; then pn_ev=quit
      elif [ -f "$pn_me.key" ]; then
        pn_k=$(cat "$pn_me.key"); rm -f "$pn_me.key"
        case $pn_k in
          '') if [ "$pn_pick" = off ]; then pn_ev=fresh; else pane_unquiet; pn_ev=pick; fi;;
          c) pn_ev=continue;;
          q) pn_ev=quit;;
          *) if [ "$pn_pick" != off ] && pane_has_ctx "$pn_k"; then pn_ev=named; else pane_unquiet; pn_show=1; fi;;
        esac
      elif [ "$pn_ended" = 1 ] && [ "$pn_reader" = 1 ]; then
        pn_reader=0   # the reader ended with no line: no terminal, only a request wakes this pane
      fi
    done
    pn_state=picker   # each session's end, and each answer, shows the picker again
    case $pn_ev in
      quit) pane_shell;;
      request)
        pn_mode=$(sed -n 1p "$pn_me.start"); pn_req=$(sed -n 2p "$pn_me.start")
        pn_prompt=$(sed -n '3,$p' "$pn_me.start")
        pn_by=$(sed -n 's/^by=//p' "$pn_me.meta" 2>/dev/null | sed -n 1p)
        pn_cx=$(sed -n 's/^context=//p' "$pn_me.meta" 2>/dev/null | sed -n 1p)
        pn_ho=$(sed -n 's/^handoff=//p' "$pn_me.meta" 2>/dev/null | sed -n 1p)
        pn_lp=$(sed -n 's/^lead_pid=//p' "$pn_me.meta" 2>/dev/null | sed -n 1p)
        pn_ls=$(sed -n 's/^lead_sid=//p' "$pn_me.meta" 2>/dev/null | sed -n 1p)
        rm -f "$pn_me.start" "$pn_me.meta" "$pn_me"
        slot_ok "$pn_req" || pn_req=-
        PG_BY=$pn_by PG_WAKE=$pn_cut pn_cut= PG_HANDOFF=$pn_ho PG_LEADPID=$pn_lp PG_LEADSID=$pn_ls
        if [ -z "$pn_cx" ]; then
          PG_TASK=$(task_line "$pn_prompt")
        else
          # the file can have gone since `start` looked; the reason is printed and the pane waits on
          pn_cxp=$(ctx_find "$pn_cx" "$(origin_slug)") && ctx_check "$pn_cxp" || { PG_BY= PG_WAKE= PG_HANDOFF= PG_LEADPID= PG_LEADSID=; pn_show=1; continue; }
          PG_CTX=$pn_cxp PG_CTXNAME=$pn_cx
          PG_TASK=$(task_line "$pn_cx${pn_prompt:+: $pn_prompt}")
          pn_prompt=$(ctx_prompt "$pn_cxp" "$pn_prompt")
        fi
        pane_go "$pn_mode" "$pn_req" "$pn_prompt" "$@";;
      pick) pane_pick "$@";;
      named) pane_choose "$pn_k" "$@";;
      *) rm -f "$pn_me"; PG_BY=pane; pane_go "$pn_ev" - '' "$@";;
    esac
    pn_show=1
  done
}

# --- commands -----------------------------------------------------------------

cmd_run() {
  slot= b= wait=0
  if [ "${1-}" = --as ]; then
    [ $# -ge 2 ] || usage
    slot=$2; shift 2
    if [ "${1-}" = --wait ]; then wait=1; shift; fi
  elif [ $# -gt 0 ] && [ "$1" != -- ]; then b=$1; shift; fi
  if [ $# -gt 0 ]; then
    [ "$1" = -- ] || usage
    shift
  fi
  if [ -z "$slot$b" ]; then
    echo "claude-peer: this pane's workgroup definition predates named slots; quit iTerm2 and run claude-peer install. Plain shell."
    exec "${SHELL:-/bin/sh}" -i
  fi
  LEADER=$(pwd -P)
  if [ -n "$slot" ]; then
    slot_ok "$slot" || die "'$slot' is not a slot name (lowercase letters, digits, - and _)"
    label=$(label_of "$slot")
  fi
  if [ "$wait" = 1 ]; then
    repo=$(repo_root_q) || {
      echo "claude-peer: not in a git repository, so there is no worktree to give this peer; plain shell"
      exec "${SHELL:-/bin/sh}" -i
    }
    rname=$(rname_of "$repo")
    pane "$@"
  fi
  repo=$(repo_root) || exit 1
  rname=$(rname_of "$repo")
  if [ -n "$slot" ]; then
    out=$(slot_checkout "$repo" "$slot" "$label") || exit $?
    name=$(session_name "$slot")
  else
    valid_branch "$b"
    [ "$(slug_of "$b")" != lead ] || die "'$b' is not a branch a peer can run on: lead is Lead's name"
    out=$(worktree_checkout "$repo" "$b") || exit 1
    name=$(session_name "$(slug_of "$b")")
  fi
  printf '%s\n' "$out"
  wt=$(printf '%s\n' "$out" | cut -f2)
  # `cd ""` is a silent no-op, which would start claude in the leader's checkout.
  [ -d "$wt" ] || die "cannot enter $wt"
  run_session "$wt" "$name" "$@"
  exit $?
}

# [--wait] [-- hermes args...]. The shell function does the routing
# (hermes_profile is zsh and lives in .functions), so this only settles, then
# starts a shell that calls it and stays a shell whatever it did. --wait hands
# the waiting to hermes_peer (CLAUDE_PEER_HERMES_WAIT=1, no settle) unless
# claude-peer.start is auto.
cmd_hermes() {
  hw=0
  if [ "${1-}" = --wait ]; then hw=1; shift; fi
  if [ $# -gt 0 ]; then
    [ "$1" = -- ] || usage
    shift
  fi
  if [ "$hw" = 1 ] && [ "$(git config --get claude-peer.start 2>/dev/null)" != auto ]; then
    CLAUDE_PEER_HERMES_WAIT=1; export CLAUDE_PEER_HERMES_WAIT
  else
    settle
  fi
  HERMES_SH='if typeset -f hermes_peer >/dev/null 2>&1; then hermes_peer "$@"; else echo "claude-peer: hermes_peer is not defined in this shell; plain shell (chezmoi apply)"; fi; exec "${SHELL:-/bin/sh}" -i'
  exec "${SHELL:-/bin/sh}" -i -c "$HERMES_SH" claude-peer "$@"
}

# [--leader <dir>] [<dir>] -> worktree<TAB>pid<TAB>leader<TAB>label per live claim in the
# repository of <dir>, sorted by worktree. Silent outside a repository.
cmd_peers() {
  want=
  if [ "${1-}" = --leader ]; then
    [ $# -ge 2 ] || usage
    want=$(cd "$2" 2>/dev/null && pwd -P) || exit 0
    [ -n "$want" ] || exit 0
    shift 2
  fi
  [ $# -le 1 ] || usage
  common=$(git -C "${1:-$PWD}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0
  for c in "$common"/worktrees/*/claude-peer.claim; do
    [ -f "$c" ] || continue
    pid=$(sed -n 1p "$c"); lead=$(sed -n 2p "$c")
    case $pid in ''|*[!0-9]*) continue;; esac
    kill -0 "$pid" 2>/dev/null || continue
    [ -z "$want" ] || [ "$lead" = "$want" ] || continue
    lab=$(sed -n 3p "$c")
    gd=$(sed -n 1p "$(dirname "$c")/gitdir" 2>/dev/null)
    [ -n "$gd" ] || continue
    printf '%s\t%s\t%s\t%s\n' "$(dirname "$gd")" "$pid" "$lead" "${lab:--}"
  done | LC_ALL=C sort
}

# <slot|next> [--continue] [--leader <dir>] [--context <name>] [--] [words...]
cmd_start() {
  [ $# -ge 1 ] || usage
  st_req=$1; shift
  [ "$st_req" = next ] || slot_ok "$st_req" || die "'$st_req' is not a slot name (lowercase letters, digits, - and _)"
  st_mode=fresh st_leader= st_cont=0 st_cx= st_ho=0
  while [ $# -gt 0 ]; do
    case $1 in
      --continue) st_mode=continue st_cont=1; shift;;
      --handoff) st_ho=1; shift;;
      --leader) [ $# -ge 2 ] || usage; st_leader=$2; shift 2;;
      --context) [ $# -ge 2 ] || usage; st_cx=$2; shift 2;;
      --) shift; break;;
      *) break;;
    esac
  done
  case ${1-} in
    -) [ $# -eq 1 ] || usage; st_prompt=$(cat);;
    -*) usage;;
    *) st_prompt="$*";;
  esac
  st_cpid=${CLAUDE_PID-}; case $st_cpid in ''|*[!0-9]*) st_cpid=;; esac
  if [ "$st_ho" = 1 ]; then
    [ -n "$st_prompt$st_cx" ] || { warn "--handoff needs something to hand over"; exit 2; }
    [ -z "${CLAUDE_PEER_WORKTREE-}" ] || { warn "--handoff is Lead's; a peer tells Lead with claude-peer log"; exit 2; }
    [ -n "$st_cpid" ] || { warn "--handoff needs a Claude session to tell; run it from one"; exit 2; }
  fi
  st_csid=-
  case ${CLAUDE_CODE_SESSION_ID-} in ''|*[!A-Za-z0-9-]*) ;; *) st_csid=$CLAUDE_CODE_SESSION_ID;; esac
  if [ -n "$st_cx" ]; then
    [ "$st_cont" = 0 ] || { warn "--context carries its own mode; --continue cannot go with it"; exit 2; }
    st_cxp=$(ctx_find "$st_cx" "$(origin_slug)") && ctx_check "$st_cxp" || exit 1
    st_ask=$(ctx_get "$st_cxp" ask)
    [ -z "$st_ask" ] || [ -n "$st_prompt" ] || { warn "context $st_cx needs a value: $st_ask"; exit 2; }
    st_mode=$(ctx_get "$st_cxp" mode); st_mode=${st_mode:-fresh}
  fi
  repo=$(repo_root) || exit 1
  rname=$(rname_of "$repo")
  if [ "$st_req" != next ]; then
    st_wt=$repo/.claude/worktrees/$st_req
    if claim_live "$st_wt"; then
      printf '%s\t%s\trunning\t%s\n' "$st_req" "$st_wt" "$(session_name "$st_req")"
      exit 3
    fi
  fi
  st_all=$(waiters "$repo")
  [ -n "$st_all" ] || { warn "no pane is waiting in this repository"; exit 4; }
  st_leaders=$(printf '%s\n' "$st_all" | cut -f3 | LC_ALL=C sort -u)
  if [ "$(printf '%s\n' "$st_leaders" | wc -l | tr -d ' ')" -gt 1 ]; then
    if [ -n "$st_leader" ]; then st_want=$(cd "$st_leader" 2>/dev/null && pwd -P) || st_want=$st_leader
    else st_want=$(pwd -P); fi
    st_all=$(printf '%s\n' "$st_all" | awk -F'\t' -v l="$st_want" '$3 == l')
    [ -n "$st_all" ] || {
      warn "no pane is waiting for $st_want; the waiting panes belong to: $(printf '%s' "$st_leaders" | tr '\n' ' ')(--leader <dir>)"
      exit 4
    }
  fi
  st_pick=$(printf '%s\n' "$st_all" | awk -F'\t' -v s="$st_req" '$1 == s { print; exit }')
  [ -n "$st_pick" ] || st_pick=$(printf '%s\n' "$st_all" | sed -n 1p)
  st_own=$(printf '%s' "$st_pick" | cut -f1); st_pid=$(printf '%s' "$st_pick" | cut -f2)
  st_dir=$(wait_dir "$repo")
  st_proto=$(sed -n 2p "$st_dir/$st_own.$st_pid" 2>/dev/null); case $st_proto in ''|*[!0-9]*) st_proto=0;; esac
  if [ -n "$st_cx" ] && [ "$st_proto" -lt 2 ]; then
    warn "the waiting pane (pid $st_pid) predates contexts; reopen its tab"
    exit 4
  fi
  if [ "$st_ho" = 1 ] && [ "$st_proto" -lt 3 ]; then
    warn "the waiting pane (pid $st_pid) predates hand-offs; reopen its tab"
    exit 4
  fi
  # who is asking: the label of the slot worktree the caller stands in, else Lead
  # when the caller is where the woken pane's leader is, else the directory's name
  st_by=
  if claim_live "$PWD"; then st_by=$(sed -n 3p "$(claim_file "$PWD")"); fi
  if [ -z "$st_by" ]; then
    st_here=$(pwd -P)
    st_top=$(cd "$(git rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null && pwd -P)
    st_pl=$(printf '%s' "$st_pick" | cut -f3)
    if [ "$st_here" = "$st_pl" ] || [ "${st_top:-$st_here}" = "$st_pl" ]; then st_by=Lead
    else st_by=$(basename "$PWD"); fi
  fi
  if [ "$st_req" = next ]; then
    st_pool=$(pool_words) || exit 1
    st_n=0 st_free=0
    for s in $st_pool; do
      st_n=$((st_n + 1))
      claim_live "$repo/.claude/worktrees/$s" || st_free=1
    done
    [ "$st_free" = 1 ] || { warn "all $st_n slots are in use in $repo"; exit 3; }
  fi
  st_file=$st_dir/$st_own.$st_pid.start
  st_meta=$st_dir/$st_own.$st_pid.meta
  { printf 'by=%s\n' "$(log_clean "$st_by")"; [ -z "$st_cx" ] || printf 'context=%s\n' "$st_cx"
    if [ -n "$st_cpid" ] && [ -z "${CLAUDE_PEER_WORKTREE-}" ]; then printf 'lead_pid=%s\nlead_sid=%s\n' "$st_cpid" "$st_csid"; fi
    [ "$st_ho" = 0 ] || printf 'handoff=1\n'
  } >"$st_meta" || die "cannot write the request in $st_dir"
  { printf '%s\n%s\n' "$st_mode" "$([ "$st_req" = next ] && echo - || echo "$st_req")"; printf '%s' "$st_prompt"; } >"$st_file.tmp" &&
    mv "$st_file.tmp" "$st_file" || die "cannot write the request in $st_dir"
  kill -USR1 "$st_pid" 2>/dev/null || { rm -f "$st_file" "$st_meta"; warn "the pane (pid $st_pid) is gone"; exit 4; }
  st_limit=$(( ${CLAUDE_PEER_START_WAIT:-60} * 5 )); st_i=0
  while [ "$st_i" -lt "$st_limit" ]; do
    sleep 0.2
    st_i=$((st_i + 1))
    st_got=$(cmd_peers "$repo" | awk -F'\t' -v p="$st_pid" '$2 == p { print $1; exit }')
    if [ -n "$st_got" ]; then
      st_who=$(log_who)
      log_add "$st_who" start "$(label_of "${st_got##*/}") by $st_who" 2>/dev/null
      printf '%s\t%s\tstarted\t%s\n' "${st_got##*/}" "$st_got" "$(session_name "${st_got##*/}")"
      # the stall clock: one detached postbox per hand-off, see postbox handoff-check
      st_pb=${CLAUDE_PEER_POSTBOX:-$HOME/bin/postbox}
      st_ld=$(printf '%s' "$st_pick" | cut -f3)
      st_sm=$(git -C "$st_ld" config --get claude-peer.stall-minutes 2>/dev/null) || st_sm=10
      case $st_sm in ''|*[!0-9]*) st_sm=0;; esac
      if [ "$st_ho" = 1 ] && [ "$st_sm" -gt 0 ] && [ -x "$st_pb" ]; then
        ( "$st_pb" handoff-check "$st_ld" "$st_got" "$st_pid" "$st_cpid" "$st_csid" </dev/null >/dev/null 2>&1 & )
      fi
      if [ "$st_ho" = 0 ] && [ -n "$st_prompt$st_cx" ] && [ -n "$st_cpid" ] && [ -z "${CLAUDE_PEER_WORKTREE-}" ]; then
        warn "not a hand-off: nobody is told when $(label_of "${st_got##*/}") finishes (--handoff)"
      fi
      exit 0
    fi
    # a USR1 that landed before the pane's wait began is lost; send it again
    [ $((st_i % 5)) -ne 0 ] || [ ! -f "$st_file" ] || kill -USR1 "$st_pid" 2>/dev/null
  done
  rm -f "$st_file" "$st_meta"
  warn "$st_req did not start within ${CLAUDE_PEER_START_WAIT:-60}s; its pane shows why"
  exit 1
}

# Every Claude profile directory a registry could be in: the caller's
# CLAUDE_CONFIG_DIR, Claude Code's own default (what an unset one means, so a
# profile that stays there is found whatever the mapping says) and each
# claude.profile.* value. No other line names one.
profile_dirs() {
  { printf '%s\n%s\n' "${CLAUDE_CONFIG_DIR-}" "$HOME/.claude"
    git config --get-regexp '^claude\.profile\.' 2>/dev/null | cut -d' ' -f2-
  } | while IFS= read -r d; do
        [ -n "$d" ] || continue
        case $d in "~/"*) d="$HOME/${d#\~/}";; esac
        [ -d "$d" ] && printf '%s\n' "$d"
      done | awk '!seen[$0]++'
}

# pid -> every descendant pid, one per line
descendants() {
  ps -Ao pid=,ppid= 2>/dev/null | awk -v r="$1" '
    { pp[$1] = $2 }
    END { for (;;) { ch = 0
            for (p in pp) if (!(p in d) && (pp[p] == r || (pp[p] in d))) { d[p] = 1; ch = 1 }
            if (!ch) break }
          for (p in d) print p }'
}

# <slot> [--force]
cmd_stop() {
  [ $# -ge 1 ] && [ $# -le 2 ] || usage
  sp_slot=$1 sp_force=0
  if [ $# -eq 2 ]; then [ "$2" = --force ] || usage; sp_force=1; fi
  slot_ok "$sp_slot" || die "'$sp_slot' is not a slot name (lowercase letters, digits, - and _)"
  repo=$(repo_root) || exit 1
  sp_wt=$repo/.claude/worktrees/$sp_slot
  if ! claim_live "$sp_wt"; then
    printf '%s\t%s\tnot-running\n' "$sp_slot" "$sp_wt"
    exit 3
  fi
  sp_who=$(log_who) # before the kill: the claim that makes this Lead goes with it
  sp_claim=$(sed -n 1p "$(claim_file "$sp_wt")")
  sp_kids=$(descendants "$sp_claim")
  sp_target= sp_status=
  for sp_pid in $sp_kids; do
    for sp_d in $(profile_dirs); do
      [ -f "$sp_d/sessions/$sp_pid.json" ] || continue
      sp_target=$sp_pid
      sp_status=$(sed -n 's/.*"status"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$sp_d/sessions/$sp_pid.json" | sed -n 1p)
      break 2
    done
  done
  if [ "$sp_force" = 0 ] && [ "$sp_status" != idle ]; then
    warn "$sp_slot is ${sp_status:-unknown}; stop --force to stop it anyway"
    exit 5
  fi
  printf '%s\n' "$sp_who" >"$(stop_file "$sp_wt")" 2>/dev/null
  if [ -n "$sp_target" ]; then kill -TERM "$sp_target" 2>/dev/null
  else for sp_pid in $sp_kids; do kill -TERM "$sp_pid" 2>/dev/null; done; fi
  sp_limit=$(( ${CLAUDE_PEER_STOP_WAIT:-15} * 5 )); sp_i=0
  while [ "$sp_i" -lt "$sp_limit" ]; do
    claim_live "$sp_wt" || { log_add "$sp_who" stop "$(label_of "$sp_slot") by $sp_who" 2>/dev/null; printf '%s\t%s\tstopped\n' "$sp_slot" "$sp_wt"; exit 0; }
    sleep 0.2
    sp_i=$((sp_i + 1))
  done
  rm -f "$(stop_file "$sp_wt")"
  warn "$sp_slot did not exit within ${CLAUDE_PEER_STOP_WAIT:-15}s"
  exit 1
}

# [<dir>] -> slot<TAB>running|waiting<TAB>worktree<TAB>pid<TAB>leader<TAB>session name
cmd_slots() {
  [ $# -le 1 ] || usage
  [ -z "${1-}" ] || cd -- "$1" 2>/dev/null || exit 0
  repo=$(repo_root_q) || exit 0
  rname=$(rname_of "$repo")
  { cmd_peers "$repo" | while IFS='	' read -r w p l _; do
      printf '%s\trunning\t%s\t%s\t%s\t%s\n' "${w##*/}" "$w" "$p" "$l" "$(session_name "${w##*/}")"
    done
    waiters "$repo" | while IFS='	' read -r sl p l; do
      printf '%s\twaiting\t%s\t%s\t%s\t%s\n' "$sl" "$repo/.claude/worktrees/$sl" "$p" "$l" "$(session_name "$sl")"
    done
  } | LC_ALL=C sort
}

# --- the coordination log -------------------------------------------------------
# <git common dir>/claude-peer.log: append-only, one line per entry,
# <UTC time> TAB <who> TAB <kind> TAB <text> [TAB <path>...]; kind is claim, note,
# done, start or stop. A claim is open until the same who logs done, or a stop
# line for that label follows it. Advisory: nothing here ever blocks.

log_file() { c=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) && printf '%s/claude-peer.log\n' "$c"; }

log_clean() { printf '%s' "$*" | tr '\t\n\r' '   '; }

# who is acting from here: the label of a live slot worktree, else Lead when a
# live claim names this directory as its leader, else the directory's name
log_who() {
  if claim_live "$PWD"; then
    lw=$(sed -n 3p "$(claim_file "$PWD")")
    [ -z "$lw" ] || { printf '%s\n' "$lw"; return; }
  fi
  lw_here=$(pwd -P)
  lw_top=$(cd "$(git rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null && pwd -P)
  if cmd_peers "$PWD" | awk -F'\t' -v h="$lw_here" -v t="${lw_top:-$lw_here}" '$3 == h || $3 == t { f = 1 } END { exit !f }'; then
    echo Lead
  else basename "$PWD"; fi
}

log_add() { # who kind text [TAB path...]
  f=$(log_file) || return 1
  printf '%s\t%s\t%s\t%s%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(log_clean "$1")" "$2" "$(log_clean "$3")" "${4-}" >>"$f"
}

# path -> relative to the repository top, no ./ or trailing /, . for the top
# ponytail: .. is not resolved; add when a session is seen passing one
log_rel() {
  p=$(log_clean "$1")
  case $p in
    /*) if [ "$p" = "$lg_top" ]; then p=; else case $p in "$lg_top"/*) p=${p#"$lg_top"/};; esac; fi;;
    *) p=$lg_pre$p;;
  esac
  while :; do case $p in ./*) p=${p#./};; */) p=${p%/};; .) p=;; *) break;; esac; done
  printf '%s\n' "${p:-.}"
}

# the log on stdin; mode overlap prints the open claims of anyone but $LG_ME that
# share a path with $LG_MINE (tab-separated); mode show prints every open claim
# and the notes stamped at or after $LG_CUT
log_scan() { # mode
  awk -F'\t' -v mode="$1" '
    function ov(a, b) { return a == b || a == "." || b == "." || index(a "/", b "/") == 1 || index(b "/", a "/") == 1 }
    { n++; line[n] = $0; kind[n] = $3; who[n] = $2; ts[n] = $1
      if ($3 == "claim") open[n] = 1
      else if ($3 == "done" || $3 == "stop" || $3 == "end" || $3 == "gone") {
        l = $2; if ($3 != "done") { l = $4; sub(/ .*/, "", l) }
        for (i = 1; i < n; i++) if (who[i] == l && kind[i] == "claim") open[i] = 0 } }
    END {
      nm = split(ENVIRON["LG_MINE"], mine, "\t")
      for (i = 1; i <= n; i++) {
        if (mode == "show") {
          if (kind[i] == "claim" ? open[i] : (kind[i] == "note" && ts[i] >= ENVIRON["LG_CUT"])) print line[i]
          continue }
        if (!open[i] || who[i] == ENVIRON["LG_ME"]) continue
        split(line[i], f, "\t")
        for (k = 5; k in f; k++) for (m = 1; m <= nm; m++)
          if (mine[m] != "" && ov(f[k], mine[m])) { printf "overlap\t%s\t%s\t%s\n", f[2], f[k], f[4]; break }
      } }'
}

# A line by anyone but Lead reaches Lead: postbox lead-news, detached and
# silent, for the leader of this directory's live claim (and the handing-over
# session, claim lines 9 and 10), else the main checkout. Always returns 0.
log_tell() {
  [ "$lg_me" != Lead ] || return 0
  lt_lead= lt_pid=- lt_sid=-
  if claim_live "$PWD"; then
    lt_f=$(claim_file "$PWD")
    lt_lead=$(sed -n 2p "$lt_f"); lt_pid=$(sed -n 9p "$lt_f"); lt_sid=$(sed -n 10p "$lt_f")
  fi
  [ -n "$lt_lead" ] || lt_lead=$(repo_root_q) || return 0
  tell_lead "$lt_lead" "$lt_pid" "$lt_sid"
}

# leader pid sid: postbox lead-news, detached and silent, when postbox is there
tell_lead() {
  tl_pb=${CLAUDE_PEER_POSTBOX:-$HOME/bin/postbox}
  [ -x "$tl_pb" ] || return 0
  ( "$tl_pb" lead-news "$1" "${2:--}" "${3:--}" </dev/null >/dev/null 2>&1 & )
  return 0
}

# <slot|lead> [<dir>]: the session name that role gets in <dir>. Lead's is
# <repo>-lead in the main checkout and <repo>-<worktree>-lead in a linked one,
# so two leaders of one repository never share a name.
cmd_name() {
  [ $# -ge 1 ] && [ $# -le 2 ] || usage
  nm_role=$1
  cd -- "${2:-$PWD}" 2>/dev/null || exit 1
  repo=$(repo_root_q) || exit 1
  rname=$(rname_of "$repo")
  if [ "$nm_role" = lead ]; then
    nm_top=$(git rev-parse --show-toplevel 2>/dev/null) || exit 1
    if [ "$(cd "$nm_top" && pwd -P)" = "$(cd "$repo" && pwd -P)" ]; then session_name lead
    else session_name "$(rname_of "$nm_top")-lead"; fi
  else
    slot_ok "$nm_role" || die "'$nm_role' is not a slot name (lowercase letters, digits, - and _)"
    session_name "$nm_role"
  fi
}

# [<dir>]: the live claim's ten lines as key<TAB>value, - for a missing one
cmd_claim() {
  [ $# -le 1 ] || usage
  cc_d=${1:-$PWD}
  claim_live "$cc_d" || exit 1
  awk -v OFS='\t' 'BEGIN { split("pid leader label by context task started handoff lead-pid lead-sid", k, " ") }
    { v[NR] = $0 } END { for (i = 1; i <= 10; i++) print k[i], (v[i] == "" ? "-" : v[i]) }' "$(claim_file "$cc_d")"
}

# idle without --as: a handed-over peer's turn ended; one line unless it logged
# done or note since the last mark, and the mark moves to now either way
log_idle() { # text
  claim_live "$PWD" || exit 0
  li_f=$(claim_file "$PWD")
  [ "$(sed -n 8p "$li_f")" = handoff ] || exit 0
  li_tf=$(turn_file "$PWD")
  li_t0=$(sed -n 7p "$li_f"); case $li_t0 in ''|*[!0-9]*) li_t0=$(date +%s);; esac
  li_mark=$(sed -n 1p "$li_tf" 2>/dev/null)
  [ -n "$li_mark" ] || li_mark=$(date -u -d "@$li_t0" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -r "$li_t0" +%Y-%m-%dT%H:%M:%SZ)
  li_now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  if [ -f "$lg_file" ] && awk -F'\t' -v w="$lg_me" -v m="$li_mark" '$2 == w && ($3 == "done" || $3 == "note") && $1 > m { f = 1 } END { exit !f }' "$lg_file"; then
    printf '%s\n' "$li_now" >"$li_tf"
    exit 0
  fi
  li_txt=$(log_clean "$1" | cut -c1-200)
  log_add "$lg_me" idle "$lg_me stopped after $(dur_of $(( $(date +%s) - li_t0 ))) without logging done${li_txt:+: $li_txt}" || exit 1
  printf '%s\n' "$li_now" >"$li_tf"
  log_tell
}

# [--as <name>] claim <task> [-- <path>...] | note <text> | done [<text>] | idle [<text>] | show [--all]
cmd_log() {
  lg_as=
  if [ "${1-}" = --as ]; then [ $# -ge 2 ] || usage; lg_as=$2; shift 2; fi
  [ $# -ge 1 ] || usage
  lg_verb=$1; shift
  case $lg_verb in claim|note|done|idle|show) ;; *) usage;; esac
  lg_file=$(log_file) || { [ "$lg_verb" = show ] && exit 0; die "not inside a git repository"; }
  lg_me=${lg_as:-$(log_who)}
  case $lg_verb in
    show)
      [ $# -eq 0 ] || { [ "$1" = --all ] && [ $# -eq 1 ]; } || usage
      [ -f "$lg_file" ] || exit 0
      if [ "${1-}" = --all ]; then cat "$lg_file"
      else
        lg_t=$(( $(date -u +%s) - 86400 ))
        LG_CUT=$(date -u -d "@$lg_t" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -r "$lg_t" +%Y-%m-%dT%H:%M:%SZ) \
          log_scan show <"$lg_file"
      fi;;
    note) [ $# -ge 1 ] || usage; log_add "$lg_me" note "$*" && log_tell;;
    done) log_add "$lg_me" done "$*" && log_tell;;
    idle)
      if [ -n "$lg_as" ]; then [ $# -ge 1 ] || usage; log_add "$lg_me" idle "$*" && log_tell
      else log_idle "$*"; fi;;
    claim)
      lg_task=
      while [ $# -gt 0 ] && [ "$1" != -- ]; do lg_task=${lg_task:+$lg_task }$1; shift; done
      [ -n "$lg_task" ] || usage
      [ $# -eq 0 ] || shift
      lg_top=$(git rev-parse --show-toplevel) lg_pre=$(git rev-parse --show-prefix)
      lg_tab=$(printf '\t') lg_paths= lg_mine=
      for lg_p in "$@"; do
        lg_r=$(log_rel "$lg_p")
        lg_paths=$lg_paths$lg_tab$lg_r lg_mine=${lg_mine:+$lg_mine$lg_tab}$lg_r
      done
      log_add "$lg_me" claim "$lg_task" "$lg_paths" || exit 1
      log_tell
      [ -n "$lg_mine" ] && LG_ME=$lg_me LG_MINE=$lg_mine log_scan overlap <"$lg_file"
      exit 0;;
  esac
}

cmd_path() {
  [ $# -eq 1 ] || usage
  valid_branch "$1"
  repo=$(repo_root) || exit 1
  worktree_path "$repo" "$1"
}

cmd_plan() {
  [ $# -ge 1 ] || usage
  for x in "$@"; do valid_branch "$x"; done
  repo=$(repo_root) || exit 1
  worktree_plan "$repo" "$@"
}

# --- overlays -----------------------------------------------------------------
# An overlay is a private chezmoi source of this machine: a ~/.config/chezmoi
# config other than chezmoi.toml whose `chezmoi --config <cfg> source-path` is in
# a git repository (the rule dotfiles() applies). This section only finds them and
# says whether a session runs in one; it reads git metadata and this script's own
# files, nothing from an overlay's tree. Every compare is on `pwd -P` output.

overlays_file() { printf '%s/claude-peer/overlays\n' "${XDG_STATE_HOME:-$HOME/.local/state}"; }

# dir -> the physical main checkout of the non-bare repository holding dir
root_of() {
  ro_c=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  case $ro_c in
    */.git) ( cd "${ro_c%/.git}" 2>/dev/null && pwd -P );;
    *) return 1;;
  esac
}

# The main checkout of the repository holding `chezmoi source-path`.
public_root() {
  command -v chezmoi >/dev/null 2>&1 || return 1
  pr_s=$(chezmoi source-path 2>/dev/null) || return 1
  [ -d "$pr_s" ] || return 1
  root_of "$pr_s"
}

# config path -> the label source: its base name, lowercase, [a-z0-9_-], starting with a letter
overlay_name() {
  on_n=${1##*/}
  on_n=$(printf '%s' "${on_n%.toml}" | LC_ALL=C tr 'A-Z' 'a-z' | LC_ALL=C tr -c 'a-z0-9_-' '-')
  case $on_n in [a-z]*) ;; *) on_n=o-$on_n;; esac
  printf '%s\n' "$on_n"
}

# rows column value -> the config base name of the first row with that value in that column
overlay_seen() {
  printf '%s' "$1" | OS_V=$3 awk -F'\t' -v c="$2" '$c == ENVIRON["OS_V"] { n = split($3, p, "/"); print p[n]; exit }'
}

# name<TAB>root<TAB>config per overlay, sorted by name; a candidate that cannot be
# one is named on stderr and left out
overlay_list() {
  ol_cand=
  for ol_c in "$HOME"/.config/chezmoi/*.toml; do
    [ -f "$ol_c" ] || continue
    [ "${ol_c##*/}" != chezmoi.toml ] || continue
    ol_cand="$ol_cand$(overlay_name "$ol_c")	$ol_c
"
  done
  [ -n "$ol_cand" ] || return 0
  command -v chezmoi >/dev/null 2>&1 || { warn "chezmoi is not on PATH; overlays cannot be resolved"; return 0; }
  ol_pub=$(public_root) || ol_pub=
  ol_cand=$(printf '%s' "$ol_cand" | LC_ALL=C sort)
  ol_rows=
  while IFS='	' read -r ol_n ol_c; do
    ol_why=
    ol_s=$(chezmoi --config "$ol_c" source-path 2>/dev/null </dev/null) || ol_s=
    if [ ! -d "$ol_s" ]; then ol_why='chezmoi names no source directory'
    elif ! ol_r=$(root_of "$ol_s"); then ol_why="$ol_s is not inside a non-bare git repository"
    elif [ "$ol_r" = "$ol_pub" ]; then ol_why='its source is the public source'
    elif ol_o=$(overlay_seen "$ol_rows" 2 "$ol_r") && [ -n "$ol_o" ]; then ol_why="same repository as $ol_o"
    elif ol_o=$(overlay_seen "$ol_rows" 1 "$ol_n") && [ -n "$ol_o" ]; then ol_why="the name '$ol_n' is already taken by $ol_o"
    fi
    if [ -n "$ol_why" ]; then warn "overlay config ${ol_c##*/}: $ol_why; skipped"; continue; fi
    ol_rows="$ol_rows$ol_n	$ol_r	$ol_c
"
    printf '%s\t%s\t%s\n' "$ol_n" "$ol_r" "$ol_c"
  done <<EOF
$ol_cand
EOF
}

overlay_names() { overlay_list | awk -F'\t' '{ s = s (NR > 1 ? " " : "") $1 } END { print s }'; }

# name -> the root of that overlay; status 1 when none
overlay_root() {
  or_r=$(overlay_list 2>/dev/null | OR_A=$1 awk -F'\t' '$1 == ENVIRON["OR_A"] { print $2; exit }')
  [ -n "$or_r" ] && printf '%s\n' "$or_r"
}

# N -> the name of the N-th overlay pane install wrote (the N-th name of the state
# file); status 1 when there is none: no state file, N is 0 or past the last name
overlay_installed() {
  oi_n=$(sed -n 1p "$(overlays_file)" 2>/dev/null |
    OI_N=$1 awk '{ n = ENVIRON["OI_N"] + 0; if (n >= 1 && n <= NF) print $n }')
  [ -n "$oi_n" ] && printf '%s\n' "$oi_n"
}

# names (space separated) -> one bar label per name, TAB separated, in order. The
# label is the position: the names stay out of iTerm2's preferences.
overlay_labels() { printf '%s\n' "$1" | awk '{ for (i = 1; i <= NF; i++) printf "%sOverlay %d", (i > 1 ? "\t" : ""), i; print "" }'; }

# stdin: rows with a pid in column 2 and a leader in column 3 -> leader<TAB>pid of
# the first led from outside root (a pane of another repository's tab)
overlay_foreign() {
  OF_R=$1 awk -F'\t' 'BEGIN { r = ENVIRON["OF_R"] } $3 != r && index($3, r "/") != 1 { print $3 "\t" $2; exit }'
}

# root -> state<TAB>leader<TAB>pid
overlay_state() {
  os_x=$(cmd_peers "$1" | overlay_foreign "$1")
  [ -z "$os_x" ] || { printf 'running\t%s\n' "$os_x"; return 0; }
  os_x=$(waiters "$1" | overlay_foreign "$1")
  [ -z "$os_x" ] || { printf 'waiting\t%s\n' "$os_x"; return 0; }
  printf 'idle\t-\t-\n'
}

cmd_overlays() {
  [ $# -eq 0 ] || usage
  overlay_list | while IFS='	' read -r co_n co_r _; do
    printf '%s\t%s\t%s\n' "$co_n" "$co_r" "$(overlay_state "$co_r")"
  done
}

# <name|N>. The pane of an overlay in the public source's workgroup: stands in the
# overlay's main checkout and is an ordinary waiting pane of that repository,
# slot `overlay`, led from the directory it started in. N is the N-th pane install
# wrote (the state file), resolved against the overlays now, so a changed set
# never re-points a pane. Never ends at iTerm2's restart banner: a missing overlay
# is one line and a plain shell.
cmd_overlay() {
  [ $# -eq 1 ] || usage
  LEADER=$(pwd -P)
  co_name=$1
  case $1 in
    ''|*[!0-9]*) ;;
    *) co_name=$(overlay_installed "$1") || {
         echo "claude-peer: no overlay pane $1 is installed on this machine (claude-peer status says what is; claude-peer install with iTerm2 quit writes them); plain shell"
         exec "${SHELL:-/bin/sh}" -i
       };;
  esac
  if ! co_root=$(overlay_root "$co_name"); then
    echo "claude-peer: no overlay '$co_name' on this machine (claude-peer overlays lists them; a changed set needs claude-peer install with iTerm2 quit); plain shell"
    exec "${SHELL:-/bin/sh}" -i
  fi
  unset CLAUDE_PROFILE
  if ! cd -- "$co_root" 2>/dev/null; then
    echo "claude-peer: cannot enter $co_root; plain shell"
    exec "${SHELL:-/bin/sh}" -i
  fi
  repo=$co_root
  rname=$(rname_of "$repo")
  slot=overlay
  label=$(label_of "$co_name")
  pane
}

# --- the Workgroup ------------------------------------------------------------

os() { uname -s 2>/dev/null; }
# Exit 2 as for usage: the verb cannot be used here at all, nothing was refused.
need_macos() { [ "$(os)" = Darwin ] || { warn "$1 needs macOS"; exit 2; }; }

# `ps` rather than pgrep, as bin/executable_worktabs: pgrep cannot see
# processes of the caller's own session under some sandboxes.
proc_running() {
  ps -Ao ucomm= 2>/dev/null |
    awk -v n="$1" '{ sub(/[ \t]+$/, "", $0); if ($0 == n) f = 1 } END { exit !f }'
}

# Where iTerm2's preferences live: skind=folder spath=<plist> when it loads
# them from a custom folder (it replaces the domain from there at launch and
# writes back at quit), else skind=domain. CLAUDE_PEER_PREFS names a plist
# directly.
prefs_store() {
  if [ -n "${CLAUDE_PEER_PREFS:-}" ]; then skind=folder; spath=$CLAUDE_PEER_PREFS; return 0; fi
  skind=domain; spath=
  [ "$(defaults read com.googlecode.iterm2 LoadPrefsFromCustomFolder 2>/dev/null)" = 1 ] || return 0
  f=$(defaults read com.googlecode.iterm2 PrefsCustomFolder 2>/dev/null) || f=
  case $f in
    '') return 0;;
    *://*) die "prefs load from a URL; use Settings > Arrangements > Workgroups";;
    \~|\~/*) f=$HOME${f#\~};;
  esac
  skind=folder; spath=${f%/}/com.googlecode.iterm2.plist
}

# peer_py <workgroup|install|status|default> <folder|domain> <plist path> [peers|builtin [overlay labels]]
# (the 5th of install is the overlay panes' bar labels, TAB separated, from overlay_labels;
# install is given no overlay name. status: the 4th is the enter state, then the overlay
# names now, the state file's first line, and the labels now)
# The stdlib only: plistlib for the store, json for the Workgroups value (an
# NSData holding a JSON array), defaults for the domain.
peer_py() {
  python3 -I - "$@" <<'PYEOF'
import copy, json, os, plistlib, socket, stat, subprocess, sys, time

GROUP, NAME, HGROUP, BUILTIN = "claudePeer.workgroup", "Claude Peers", "claudePeer.h", "builtin.claudeCode"
mode, kind, path = sys.argv[1:4]
ENTER = "iTermEnterWorkgroupTrigger"

def fail(msg):
    sys.exit("claude-peer: " + msg)

def load(kind, path):
    """(plist, began with bplist); raises when the store cannot be read."""
    if kind == "folder":
        with open(path, "rb") as f:
            raw = f.read()
    else:
        raw = subprocess.run(["defaults", "export", "com.googlecode.iterm2", "-"],
                             capture_output=True, check=True).stdout
    return plistlib.loads(raw), raw.startswith(b"bplist")

def groups_of(pl):
    if "Workgroups" not in pl:
        return []
    g = json.loads(pl["Workgroups"])
    if not isinstance(g, list):
        raise ValueError("Workgroups is not a list")
    return g

def session(ident, name, kind, command="", items=None, parent=None):
    s = {"uniqueIdentifier": ident, "kind": {"kind": kind}, "displayName": name,
         "command": command, "perFileCommand": "", "urlString": "",
         "mode": "regular", "toolbarItems": items or [{"kind": "modeSwitcher"}]}
    if parent:
        s["parentID"] = parent
    return s

def build_base(prefix):
    """Lead and the five slot panes, ids under prefix. A pane waits (--wait):
    nothing starts in it until Return or `claude-peer start`."""
    root = prefix + ".main"
    return [session(root, "Lead", "root", items=[{"kind": "modeSwitcher"}, {"kind": "gitStatus"}])] + [
        session("%s.%s" % (prefix, slot), slot.capitalize(), "peer",
                "claude-peer run --as %s --wait" % slot, parent=root)
        for slot in ("alpha", "beta", "gamma", "delta", "epsilon")]

def with_hermes(group):
    """The twin of a definition with a Hermes pane: id <id>.h (claudePeer.h for
    the base), name "<name> + Hermes", every session id moved under the new id."""
    gid = HGROUP if group["uniqueIdentifier"] == GROUP else group["uniqueIdentifier"] + ".h"
    old = next(s for s in group["sessions"] if s["kind"] == {"kind": "root"})["uniqueIdentifier"][:-len(".main")]
    twin = copy.deepcopy(group)
    twin.update(uniqueIdentifier=gid, name=group["name"] + " + Hermes")
    for s in twin["sessions"]:
        s["uniqueIdentifier"] = gid + s["uniqueIdentifier"][len(old):]
        if "parentID" in s:
            s["parentID"] = gid + s["parentID"][len(old):]
    twin["sessions"].append(session(gid + ".hermes", "Hermes", "peer", "claude-peer hermes --wait",
                                    parent=gid + ".main"))
    return twin

def build():
    """[Claude Peers, Claude Peers + Hermes]"""
    base = {"uniqueIdentifier": GROUP, "name": NAME, "sessions": build_base("claudePeer")}
    return [base, with_hermes(base)]

OGROUP, OHGROUP = "claudePeer.v.overlays", "claudePeer.v.overlays.h"

def with_overlays(group, gid, name, labels):
    """A copy of a definition under id gid and name, every session id moved under
    gid, and one pane per bar label appended after the others. A pane is stored by
    position, never by overlay name: the store can be a tracked file."""
    old = next(s for s in group["sessions"] if s["kind"] == {"kind": "root"})["uniqueIdentifier"][:-len(".main")]
    out = copy.deepcopy(group)
    out.update(uniqueIdentifier=gid, name=name)
    for s in out["sessions"]:
        s["uniqueIdentifier"] = gid + s["uniqueIdentifier"][len(old):]
        if "parentID" in s:
            s["parentID"] = gid + s["parentID"][len(old):]
    out["sessions"] += [session("%s.o.%d" % (gid, n), label, "peer", "claude-peer overlay %d" % n,
                                parent=gid + ".main") for n, label in enumerate(labels, 1)]
    return out

def build_overlays(labels):
    """[] for no overlays, else [Claude Peers + Overlays, Claude Peers + Hermes + Overlays];
    Hermes keeps its place, so the second is built from the Hermes twin."""
    if not labels:
        return []
    base, hermes_twin = build()
    return [with_overlays(base, OGROUP, "Claude Peers + Overlays", labels),
            with_overlays(hermes_twin, OHGROUP, "Claude Peers + Hermes + Overlays", labels)]

def labels_arg(i):
    """argv[i] as the overlay panes' bar labels, TAB separated; [] when absent or empty."""
    return [l for l in sys.argv[i].split("\t") if l] if len(sys.argv) > i else []

VAR = "user.claudePeerEnter"
VAR_ENTER = 115  # iTermTriggerMatchTypeEventVariableChanged

def key_of(gid):
    """The key the wrapper sends to enter a workgroup (claude() sets the variable
    to <key>:<nonce>); None for an id that is not one of ours."""
    if gid == GROUP:
        return "base"
    if gid == HGROUP:
        return "base/hermes"
    if gid.startswith("claudePeer.v."):
        name = gid[len("claudePeer.v."):]
        return name[:-2] + "/hermes" if name.endswith(".h") else name
    return None

def is_var(t):
    return t.get("action") == ENTER and (t.get("eventParams") or {}).get("variableName") == VAR

def job_triggers(pl):
    """(profile dict, job trigger) for every Enter Workgroup trigger that fires on
    the claude job and is aimed at the builtin or Claude Peers; the variable
    triggers and other workgroups' triggers are not ours to move."""
    for b in pl.get("New Bookmarks", []):
        for t in b.get("Triggers", []) or []:
            if t.get("action") == ENTER and not is_var(t) and t.get("parameter") in (BUILTIN, GROUP):
                yield b, t

def var_trigger(gid, key):
    return {"action": ENTER, "matchType": VAR_ENTER, "parameter": gid,
            "eventParams": {"variableName": VAR, "variableValueRegex": "^%s:" % key},
            "disabled": 0, "regex": "", "contentregex": "", "partial": False}

def sync_var_triggers(pl, groups):
    """In every profile that has the job trigger, make the variable triggers one
    per installed workgroup of ours, nothing else touched. Returns the ids of the
    profiles it changed."""
    want = [(g["uniqueIdentifier"], key_of(g["uniqueIdentifier"])) for g in groups
            if str(g.get("uniqueIdentifier", "")).startswith("claudePeer") and key_of(g["uniqueIdentifier"])]
    changed = set()
    for b in {id(b): b for b, _ in job_triggers(pl)}.values():
        trig = b.setdefault("Triggers", [])
        keep = [t for t in trig if not is_var(t)]
        have = {t.get("parameter"): t for t in trig if is_var(t)}
        mine = [have.get(gid) if have.get(gid) and have[gid]["eventParams"].get("variableValueRegex") == "^%s:" % key
                else var_trigger(gid, key) for gid, key in want]
        if [t for t in trig if is_var(t)] != mine:
            changed.add(id(b))
        b["Triggers"] = keep + mine
    return changed

# The look trigger: when the session now active in the selected tab changes, tell
# `claude-peer look gained` which one it is. The parameter holds no `\(`, only the
# `\0` of the changed value, so iTerm2 never evaluates it against a session's
# variables (the shape that crashed 3.7.7 on a half-built split); the command skips
# the call when focus already names the session. is_look is how `look off` tells
# its own trigger from somebody else's Run Command trigger.
LOOK_VAR = "tab.window.currentTab.currentSession.id"
LOOK_RE = "^[0-9A-Fa-f-]{36}$"
LOOK_CMD = ('g=\'\\0\'; p="$HOME/bin/claude-peer"; f="$HOME/.local/state/claude-peer/look/focus"; '
            '[ -x "$p" ] || exit 0; o=; [ -r "$f" ] && read -r o <"$f"; '
            '[ "$o" = "$g" ] || exec "$p" look gained "$g"')
LOOK_TRIGGER = {"action": "ScriptTrigger", "matchType": VAR_ENTER, "parameter": LOOK_CMD,
                "eventParams": {"variableName": LOOK_VAR, "variableValueRegex": LOOK_RE},
                "disabled": 0, "regex": "", "contentregex": "", "partial": False}

def is_look(t):
    p = t.get("parameter")
    return (t.get("action") == "ScriptTrigger" and isinstance(p, str)
            and "/bin/claude-peer" in p and " look gained " in p)

def look_of(b):
    return [t for t in b.get("Triggers") or [] if is_look(t)]

def socks(d):
    try:
        return [os.path.join(d, f) for f in sorted(os.listdir(d))
                if f.endswith(".sock") and stat.S_ISSOCK(os.lstat(os.path.join(d, f)).st_mode)]
    except OSError:
        return []

def listening(p):
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(1)
    try:
        s.connect(p)
        return True
    except OSError:
        return False
    finally:
        s.close()

def dur(n):
    return "%ds" % n if n < 60 else "%dm" % (n // 60) if n < 3600 else "%dh" % (n // 3600) if n < 86400 else "%dd" % (n // 86400)

def save(pl, was_binary):
    data = plistlib.dumps(pl, fmt=plistlib.FMT_BINARY if was_binary else plistlib.FMT_XML)
    if kind == "folder":
        with open(path, "wb") as f:
            f.write(data)
    else:
        subprocess.run(["defaults", "import", "com.googlecode.iterm2", "-"], input=data, check=True)

if mode == "status":
    try:
        pl, _ = load(kind, path)
    except Exception as e:
        fail("cannot read the iTerm2 preferences (%s): %s" % (kind, e))
    try:
        groups = groups_of(pl)
    except (ValueError, TypeError):
        groups = None
    def shape(g):
        return [(s.get("uniqueIdentifier"), s.get("displayName"), s.get("command"))
                for s in g.get("sessions", [])]
    if groups is None:
        print("workgroup: unreadable (Workgroups is not JSON; install refuses until it is fixed)")
    else:
        for label, want in zip(("workgroup", "hermes"), build()):
            mine = next((g for g in groups if g.get("uniqueIdentifier") == want["uniqueIdentifier"]), None)
            names = [s.get("displayName", "?") for s in (mine or {}).get("sessions", [])]
            wnames = [s["displayName"] for s in want["sessions"]]
            if not mine:
                print("%s: not installed — claude-peer install (with iTerm2 quit)" % label)
            elif shape(mine) == shape(want):
                print("%s: installed (%d sessions: %s)" % (label, len(names), ", ".join(names)))
            else:
                print("%s: installed, out of date (%d sessions: %s); this version defines %d (%s) — claude-peer install (with iTerm2 quit)"
                      % (label, len(names), ", ".join(names), len(wnames), ", ".join(wnames)))
        # overlays: said only when this machine, the store or the state file has any
        ovs = sys.argv[5].split() if len(sys.argv) > 5 else []
        ofile = sys.argv[6].split() if len(sys.argv) > 6 else []
        labels = labels_arg(7)
        def paired(bar, names):
            return ", ".join("%s = %s" % (b, names[i].capitalize() if i < len(names) else "?") for i, b in enumerate(bar))
        have = [g for g in groups if g.get("uniqueIdentifier") in (OGROUP, OHGROUP)]
        nowl = ", ".join(o.capitalize() for o in ovs)
        if ovs and not have:
            print("overlays: not installed — this machine has %d (%s); claude-peer install (with iTerm2 quit)" % (len(ovs), nowl))
        elif have:
            first = have[0]["uniqueIdentifier"]
            bar = [s.get("displayName", "?") for s in have[0].get("sessions", [])
                   if str(s.get("uniqueIdentifier", "")).startswith(first + ".o.")]
            instl = paired(bar, ofile)
            if not ovs:
                print("overlays: installed (%s), but this machine has none now — claude-peer install (with iTerm2 quit) removes them" % instl)
            elif (len(labels) == len(ovs)
                  and all(shape(next((g for g in have if g["uniqueIdentifier"] == w["uniqueIdentifier"]), {})) == shape(w)
                          for w in build_overlays(labels))
                  and (not ofile or ofile == ovs)):
                print("overlays: installed (%d panes: %s)" % (len(ovs), paired(labels, ovs)))
            else:
                print("overlays: installed, out of date (%s); this machine has %d (%s) — claude-peer install (with iTerm2 quit)"
                      % (instl, len(ovs), paired(labels, ovs)))
        if ofile and not have:
            print("overlays: the state file lists %s but no overlay workgroup is installed, so a claude tab in the chezmoi source enters no workgroup — claude-peer install (with iTerm2 quit)" % " ".join(ofile))
        elif have and not ofile:
            print("overlays: installed, but the state file is missing, so claude-peer here stays base and no overlay pane finds its overlay — claude-peer install (with iTerm2 quit)")
    prof = {}
    for b, t in job_triggers(pl):
        st = prof.setdefault(b.get("Name", "?"), [])
        st.append(t)
    def state(b_name, ts):
        b = next(x for x in pl["New Bookmarks"] if x.get("Name", "?") == b_name)
        vs = [t for t in b.get("Triggers", []) or [] if is_var(t)]
        if all(t.get("disabled") for t in ts) and vs:
            return "peers"
        if not any(t.get("disabled") for t in ts) and not vs and all(t["parameter"] == BUILTIN for t in ts):
            return "builtin"
        return "mixed"
    states = {n: state(n, ts) for n, ts in prof.items()}
    npeers = sum(1 for v in states.values() if v == "peers")
    kinds = {t.get("parameter") for b in pl.get("New Bookmarks", []) for t in b.get("Triggers", []) or [] if is_var(t)}
    if not states:
        overall = "none"
        print("default: no profile enters a workgroup on a claude job")
    elif npeers == len(states):
        overall = "peers"
        print("default: peers (%d profiles, %d workgroups by variable)" % (npeers, len(kinds)))
    elif npeers == 0 and all(v == "builtin" for v in states.values()):
        overall = "builtin"
        print("default: builtin (%d profiles enter Claude Code)" % len(states))
    else:
        overall = "mixed"
        print("default: mixed (%d of %d profiles enter by variable) — claude-peer default peers|builtin" % (npeers, len(states)))
    filed = len(sys.argv) > 4 and sys.argv[4] == "peers"
    if filed and overall != "peers":
        print("default: the enter file says peers but the triggers do not (iTerm2's Reinstall rewrites them) — claude-peer default peers")
    elif overall == "peers" and not filed:
        print("default: the triggers say peers but the enter file is missing, so claude() sends no key and nothing enters — claude-peer default peers")
elif mode == "workgroup":
    print(json.dumps(build()[0], indent=2, sort_keys=True))
elif mode == "install":
    try:
        pl, was_binary = load(kind, path)
    except Exception as e:
        fail("cannot read the preferences: %s" % e)
    try:
        groups = groups_of(pl)
    except (ValueError, TypeError) as e:
        fail("the Workgroups value is not a JSON list (%s); nothing written" % e)
    done = []
    labels = labels_arg(5)
    for wg in build() + build_overlays(labels):
        idx = next((i for i, g in enumerate(groups) if g.get("uniqueIdentifier") == wg["uniqueIdentifier"]), None)
        if idx is None:
            groups.append(wg)
        else:
            groups[idx] = wg
        done.append('"%s" %s' % (wg["name"], "written" if idx is None else "replaced"))
    if not labels:  # no overlay on this machine: a pair installed earlier goes
        for g in [g for g in groups if g.get("uniqueIdentifier") in (OGROUP, OHGROUP)]:
            groups.remove(g)
            done.append('"%s" removed' % g.get("name"))
    pl["Workgroups"] = json.dumps(groups, separators=(",", ":")).encode("utf-8")
    if len(sys.argv) > 4 and sys.argv[4] == "peers":
        n = len(sync_var_triggers(pl, groups))
        extra = "; variable triggers changed in %d profiles" % n
    else:
        extra = ""
    save(pl, was_binary)
    print(" and ".join(done) + extra)
elif mode == "default":
    peers = sys.argv[4] == "peers"
    try:
        pl, was_binary = load(kind, path)
    except Exception as e:
        fail("cannot read the preferences: %s" % e)
    groups = []
    if peers:
        try:
            groups = groups_of(pl)
            ok = any(g.get("uniqueIdentifier") == GROUP for g in groups)
        except (ValueError, TypeError):
            ok = False
        if not ok:
            fail("Claude Peers is not installed; run claude-peer install first, nothing written")
    found = list(job_triggers(pl))
    if not found:
        fail("no profile has an Enter Workgroup trigger for Claude Code; set up iTerm2's Claude Code integration first")
    moved = {id(b) for b, t in found if bool(t.get("disabled")) != peers or (not peers and t["parameter"] != BUILTIN)}
    for _, t in found:
        t["disabled"] = 1 if peers else 0
        if not peers:
            t["parameter"] = BUILTIN
    moved |= sync_var_triggers(pl, groups)
    if moved:
        save(pl, was_binary)
    print("%d of %d profiles changed" % (len(moved), len({id(b) for b, _ in found})))
elif mode == "look":
    on = sys.argv[4] == "on"
    try:
        pl, was_binary = load(kind, path)
    except Exception as e:
        fail("cannot read the preferences: %s" % e)
    profs = list({id(b): b for b, _ in job_triggers(pl)}.values())
    if not profs:
        fail("no profile has an Enter Workgroup trigger for Claude Code; set up iTerm2's Claude Code integration first")
    changed = 0
    for b in profs:
        trig = b.get("Triggers") or []
        new = [t for t in trig if not is_look(t)] + ([copy.deepcopy(LOOK_TRIGGER)] if on else [])
        if new != trig:
            b["Triggers"] = new
            changed += 1
    if changed:
        save(pl, was_binary)
    if on:  # iTerm2 is quit, so a socket that answers nobody is a leftover
        for p in socks(sys.argv[5]):
            if not listening(p):
                try:
                    os.unlink(p)
                except OSError:
                    pass
    print("%d of %d profiles changed" % (changed, len(profs)))
elif mode == "lookstatus":
    d = sys.argv[4]
    try:
        pl, _ = load(kind, path)
    except Exception as e:
        fail("cannot read the iTerm2 preferences (%s): %s" % (kind, e))
    profs = list({id(b): b for b, _ in job_triggers(pl)}.values())
    m = len(profs)
    n = sum(1 for b in profs if look_of(b) == [LOOK_TRIGGER])
    mine = [look_of(b) for b in pl.get("New Bookmarks", [])]
    carry = sum(1 for ts in mine if ts)
    marker = os.access(os.path.join(d, "kind"), os.R_OK)
    fix = "claude-peer look on (with iTerm2 quit)"
    if not marker and not carry:
        print("look: off")
    elif not marker:
        print("look: %d profiles carry the trigger but the marker is missing, so no pane listens \u2014 %s" % (carry, fix))
    elif any(ts and ts != [LOOK_TRIGGER] for ts in mine):
        print("look: installed, out of date (this version's trigger differs) \u2014 %s" % fix)
    elif n < m:
        print("look: the marker says on but %d of %d profiles lack the trigger (iTerm2's Reinstall rewrites triggers) \u2014 %s" % (m - n, m, fix))
    else:
        ps = socks(d)
        k = sum(1 for p in ps if listening(p))
        try:
            age = "%s ago" % dur(max(0, int(time.time() - os.stat(os.path.join(d, "focus")).st_mtime)))
        except OSError:
            age = "never"
        try:
            with open(os.path.join(d, "unlocked")) as f:
                lines = f.read().splitlines()
        except OSError:
            lines = []
        if not lines:
            tail = ""
        elif lines[0] == "notool":
            tail = "; events are not serialised (no flock, and no lockf that locks a descriptor)"
        else:
            tail = "; %d events passed a held lock" % len(lines)
        print("look: on (variable trigger in %d of %d profiles); %d panes listening, %d stale; last event %s%s"
              % (n, m, k, len(ps) - k, age, tail))
PYEOF
}

# The file `default peers` writes and claude() looks for before it sends a key:
# without it the wrapper stays silent, so a stale trigger enters nothing.
enter_file() { printf '%s/claude-peer/enter\n' "${XDG_STATE_HOME:-$HOME/.local/state}"; }
enter_state() { [ -r "$(enter_file)" ] && sed -n 1p "$(enter_file)"; return 0; }

# The key the wrapper sends for this directory: the workgroup to enter.
# `overlays` only inside the public chezmoi source, only when install has written
# the state file (so the definitions exist) and only while this machine has an
# overlay; every other directory, and any failure on the way, is `base`.
cmd_here() {
  [ $# -eq 0 ] || usage
  he_k=base
  if [ -s "$(overlays_file)" ] && he_r=$(root_of "$PWD") && he_p=$(public_root) \
     && [ "$he_r" = "$he_p" ] && [ -n "$(overlay_list 2>/dev/null)" ]; then
    he_k=overlays
  fi
  printf '%s\n' "$he_k"
}

cmd_workgroup() {
  [ $# -eq 0 ] || usage
  peer_py workgroup domain ""
}

cmd_install() {
  [ $# -eq 0 ] || usage
  need_macos install
  proc_running iTerm2 && die "quit iTerm2 first — it rewrites its preferences at quit and would overwrite this"
  prefs_store
  ovs=$(overlay_names)
  r=$(peer_py install "$skind" "$spath" "$(enter_state)" "$(overlay_labels "$ovs")") || exit 1
  # after peer_py succeeded: `here` answers overlays only for a definition that is there
  ovf=$(overlays_file)
  if [ -n "$ovs" ]; then
    mkdir -p "${ovf%/*}" && printf '%s\n' "$ovs" >"$ovf" || die "cannot write $ovf"
  else
    rm -f "$ovf"
  fi
  [ "$skind" = folder ] && where=$spath || where="the com.googlecode.iterm2 domain"
  printf 'claude-peer: %s in %s; start iTerm2, then Shell > Workgroups > Claude Peers in a plain tab\n' "$r" "$where"
}

cmd_default() {
  [ $# -eq 1 ] || usage
  case $1 in peers|builtin) ;; *) usage;; esac
  need_macos default
  proc_running iTerm2 && die "quit iTerm2 first — it rewrites its preferences at quit and would overwrite this"
  prefs_store
  r=$(peer_py default "$skind" "$spath" "$1") || exit 1
  f=$(enter_file)
  if [ "$1" = peers ]; then
    mkdir -p "${f%/*}" && printf 'peers\n' >"$f" || die "cannot write $f"
    printf 'claude-peer: claude() now picks the workgroup of each tab (Claude Peers: Alpha to Epsilon wait until started); the claude job trigger is disabled; %s\n' "$r"
  else
    rm -f "$f"
    printf 'claude-peer: a claude job now enters Claude Code; the variable triggers are gone; %s\n' "$r"
  fi
}

cmd_status() {
  [ $# -eq 0 ] || usage
  need_macos status
  prefs_store
  if [ "$skind" = folder ]; then printf 'store: folder %s\n' "$spath"; else printf 'store: domain\n'; fi
  if proc_running iTerm2; then printf 'iterm2: running\n'; else printf 'iterm2: not running (install allowed)\n'; fi
  # the store that is true now: iTerm2's memory (the domain) while it runs, the
  # folder file it only writes at quit otherwise
  ovs=$(overlay_names)
  ovs_filed=$(sed -n 1p "$(overlays_file)" 2>/dev/null)
  ovs_lab=$(overlay_labels "$ovs")
  if proc_running iTerm2; then peer_py status domain "" "$(enter_state)" "$ovs" "$ovs_filed" "$ovs_lab"; else peer_py status "$skind" "$spath" "$(enter_state)" "$ovs" "$ovs_filed" "$ovs_lab"; fi
  if proc_running iTerm2; then peer_py lookstatus domain "" "$(look_dir)"; else peer_py lookstatus "$skind" "$spath" "$(look_dir)"; fi
  peers_summary
  [ -n "$ovs" ] || return 0
  if st_pub=$(public_root); then printf 'overlays: entered from %s\n' "$st_pub"
  else printf 'overlays: chezmoi names no source directory in a git repository, so no tab enters them\n'; fi
  overlay_list 2>/dev/null | while IFS='	' read -r st_n st_r _; do
    overlay_state "$st_r" | ST_N=$st_n ST_R=$st_r awk -F'\t' '
      $1 == "idle" { printf "overlay: %s idle in %s\n", ENVIRON["ST_N"], ENVIRON["ST_R"]; next }
      { printf "overlay: %s %s in %s (tab of %s, pid %s)\n", ENVIRON["ST_N"], $1, ENVIRON["ST_R"], $2, $3 }'
  done
}

# peers: how many Claudes run and how many panes wait in the repository the
# caller stands in, with the running labels; leftover: peer-N worktrees from the
# retired scratch layout, which nothing uses or removes any more. Nothing
# outside a repository.
peers_summary() {
  repo=$(repo_root_q) || return 0
  live=$(cmd_peers "$repo")
  nw=$(waiters "$repo" | grep -c .)
  if [ -n "$live" ]; then
    printf '%s\n' "$live" | awk -F'\t' -v repo="$repo" -v w="$nw" '{ n = split($1, p, "/"); r = r (NR > 1 ? ", " : "") $4 " (" p[n] ")" }
      END { printf "peers: %d running, %d waiting in %s: %s\n", NR, w, repo, r }'
  else printf 'peers: 0 running, %d waiting in %s\n' "$nw" "$repo"; fi
  left=$(git -C "$repo" worktree list --porcelain | sed -n 's/^worktree //p' |
    awk -v pre="$repo/.claude/worktrees/peer-" 'index($0, pre) == 1 && substr($0, length(pre) + 1) ~ /^[0-9]/ { n = split($0, p, "/"); printf "%s%s", (c++ ? ", " : ""), p[n] } END { printf "\t%d", c }')
  k=${left##*	}
  [ "$k" -gt 0 ] && printf 'leftover: %d peer-N worktrees from the retired scratch layout (%s); git worktree remove <path> for each\n' "$k" "${left%	*}"
  return 0
}

# --- contexts -----------------------------------------------------------------
# A context is a small text file: `key: value` header lines, an empty line, then
# the body, which is the first prompt. They live under ctx_dir at three levels
# (everywhere, <owner>/, <owner>/<repo>/); a deeper file replaces a shallower
# one of the same name. Nothing else in this script reads them yet.

ctx_tab=$(printf '\t')

ctx_dir() { printf '%s\n' "${CLAUDE_PEER_CONTEXTS:-${XDG_CONFIG_HOME:-$HOME/.config}/claude-peer/contexts}"; }

# Lowercase owner/repo of the origin of the main checkout of <dir> (default $PWD),
# or status 1. A worktree shares its main checkout's config, so a peer finds its
# leader's slug. An origin that is set but gives no usable slug says so once.
origin_slug() {
  os_top=$(cd "${1:-$PWD}" 2>/dev/null && repo_root_q) || return 1
  os_u=$(git -C "$os_top" config --get remote.origin.url 2>/dev/null) || return 1
  [ -n "$os_u" ] || return 1
  os_s=${os_u%/}; os_s=${os_s%.git}
  case $os_s in
    *://*) os_s=${os_s#*://}; os_s=${os_s#*/};;
    *:*) os_s=${os_s#*:};;
    *) os_s=;;
  esac
  os_s=$(printf '%s' "${os_s#/}" | LC_ALL=C tr 'A-Z' 'a-z')
  if printf '%s\n' "$os_s" | LC_ALL=C grep -Eq '^[a-z0-9._-]+(/[a-z0-9._-]+)+$' &&
    ! printf '%s\n' "$os_s" | LC_ALL=C grep -Eq '(^|/)\.\.?(/|$)'; then
    printf '%s\n' "$os_s"
    return 0
  fi
  warn "origin '$os_u' gives no owner/repo; only the general contexts apply"
  return 1
}

# <slug> -> the directories to read, shallow to deep.
ctx_levels() {
  cl_r=$(ctx_dir)
  printf '%s\n' "$cl_r"
  [ -z "$1" ] || printf '%s\n%s\n' "$cl_r/${1%%/*}" "$cl_r/$1"
  return 0
}

# <file> -> its context name (the file name without NN- and .ctx), or status 1.
ctx_name_of() {
  cn=${1##*/}; cn=${cn%.ctx}
  case $cn in
    [0-9]*-*) cn_p=${cn%%-*}; case $cn_p in *[!0-9]*) ;; *) cn=${cn#*-};; esac;;
  esac
  printf '%s\n' "$cn" | LC_ALL=C grep -Eq '^[a-z][a-z0-9_-]*$' || return 1
  printf '%s\n' "$cn"
}

# <slug> -> name<TAB>path per effective context, in display order, validity not
# looked at. The later of two files with one name wins and takes the later place.
ctx_scan() {
  ctx_levels "$1" | while IFS= read -r sc_d; do
    ( LC_ALL=C; export LC_ALL
      for sc_f in "$sc_d"/*.ctx; do
        [ -f "$sc_f" ] || continue
        sc_n=$(ctx_name_of "$sc_f") || continue
        printf '%s\t%s\n' "$sc_n" "$sc_f"
      done )
  done | awk -F'\t' '{ l[NR] = $0; last[$1] = NR } END { for (i = 1; i <= NR; i++) { split(l[i], a, "\t"); if (last[a[1]] == i) print l[i] } }'
}

# <path> -> status 0, or 1 and why on stderr.
ctx_bad() { warn "$1: $2"; return 1; }
ctx_check() {
  cc_h=$(sed '/^$/,$d' "$1")
  while IFS= read -r cc_l; do
    [ -n "$cc_l" ] || continue
    case $cc_l in *': '*) ;; *) ctx_bad "$1" "header line without ': ': $cc_l" || return 1;; esac
    cc_k=${cc_l%%: *}; cc_v=${cc_l#*: }
    case $cc_k in
      title|ask|system) ;;
      agent|model|effort)
        printf '%s\n' "$cc_v" | LC_ALL=C grep -Eq '^[A-Za-z0-9][]A-Za-z0-9._:[-]*$' || ctx_bad "$1" "$cc_k: '$cc_v' is not a plain value" || return 1;;
      mode) case $cc_v in fresh|continue) ;; *) ctx_bad "$1" 'mode: must be fresh or continue' || return 1;; esac;;
      repo) ctx_bad "$1" 'repo: is not a key (a per-repository context goes in <owner>/<repo>/)' || return 1;;
      *) ctx_bad "$1" "unknown key '$cc_k'" || return 1;;
    esac
  done <<EOT
$cc_h
EOT
  return 0
}

# <slug> -> its valid contexts, as ctx_scan prints them; invalid ones are
# reported on stderr and left out.
ctx_files() {
  ctx_scan "$1" | while IFS=$ctx_tab read -r cf_n cf_p; do
    ctx_check "$cf_p" && printf '%s\t%s\n' "$cf_n" "$cf_p"
  done
}

# <name> <slug> -> the path, or status 1.
ctx_find() {
  cf_p=$(ctx_scan "$2" | CF_N=$1 awk -F'\t' '$1 == ENVIRON["CF_N"] { print $2; exit }')
  [ -n "$cf_p" ] || { warn "no context '$1' here (claude-peer context list)"; return 1; }
  printf '%s\n' "$cf_p"
}

# <path> <key> -> the first value of that header key.
ctx_get() { sed '/^$/,$d' "$1" | CG_P="$2: " awk 'index($0, ENVIRON["CG_P"]) == 1 { print substr($0, length(ENVIRON["CG_P"]) + 1); exit }'; }

# <path> -> the body: after the first empty line, trailing blank lines dropped.
ctx_body() { awk 'b { l[++n] = $0; if ($0 != "") last = n; next } /^$/ { b = 1 } END { for (i = 1; i <= last; i++) print l[i] }' "$1"; }

# <path> <value> -> the first prompt. The value goes through the environment and
# awk index/substr, so backslashes and & arrive as typed.
ctx_prompt() {
  CP_BODY=$(ctx_body "$1") CP_VALUE=$2 awk 'BEGIN {
    s = ENVIRON["CP_BODY"]; v = ENVIRON["CP_VALUE"]
    if (index(s, "{input}") == 0) { print (s == "" || v == "" ? s v : s "\n\n" v); exit }
    while ((i = index(s, "{input}")) > 0) { o = o substr(s, 1, i - 1) v; s = substr(s, i + 7) }
    print o s }'
}

# <path> -> the claude flags it sets, one per line, in the order start passes them.
ctx_flag_lines() {
  [ "$(ctx_get "$1" mode)" != continue ] || echo '--continue'
  for ff_k in agent model effort; do
    ff_v=$(ctx_get "$1" "$ff_k"); [ -z "$ff_v" ] || echo "--$ff_k $ff_v"
  done
  ff_v=$(ctx_get "$1" system); [ -z "$ff_v" ] || echo "--append-system-prompt $ff_v"
  return 0
}

# <name> <path> -> name<TAB>title<TAB>ask<TAB>flags<TAB>path
ctx_row() {
  cw_f=
  for cw_k in agent model effort; do
    cw_v=$(ctx_get "$2" "$cw_k"); [ -z "$cw_v" ] || cw_f="$cw_f $cw_k=$cw_v"
  done
  [ "$(ctx_get "$2" mode)" != continue ] || cw_f="$cw_f mode=continue"
  [ -z "$(ctx_get "$2" system)" ] || cw_f="$cw_f system"
  cw_t=$(ctx_get "$2" title); cw_a=$(ctx_get "$2" ask)
  cw_f=${cw_f# }
  printf '%s\t%s\t%s\t%s\t%s\n' "$1" "${cw_t:-$1}" "${cw_a:--}" "${cw_f:--}" "$2"
}

# list [--all] [<dir>] | show <name|@builtin> [value words...] | dir [--repo [<dir>]]
cmd_context() {
  [ $# -ge 1 ] || usage
  cx_verb=$1; shift
  case $cx_verb in
    list)
      cx_all=0
      if [ "${1-}" = --all ]; then cx_all=1; shift; fi
      [ $# -le 1 ] || usage
      if [ "$cx_all" = 1 ]; then
        find "$(ctx_dir)" -type f -name '*.ctx' 2>/dev/null | LC_ALL=C sort | while IFS= read -r cx_p; do
          cx_n=$(ctx_name_of "$cx_p") && ctx_check "$cx_p" && ctx_row "$cx_n" "$cx_p"
        done
      else
        cx_slug=$(origin_slug "${1:-$PWD}") || cx_slug=
        ctx_files "$cx_slug" | while IFS=$ctx_tab read -r cx_n cx_p; do ctx_row "$cx_n" "$cx_p"; done
      fi
      return 0;;
    show)
      [ $# -ge 1 ] || usage
      cx_name=$1; shift
      case $cx_name in
        @fresh) printf '@fresh — Blank session\nclaude -n <name> with no prompt\n'; return 0;;
        @continue) printf '@continue — Continue the last session\nclaude -n <name> --continue with no prompt\n'; return 0;;
        @resume) printf '@resume — Resume a session\nclaude -n <name> --resume alone: Claude'"'"'s own list chooses\n'; return 0;;
        @task) printf '@task — New task\nclaude -n <name> with the text typed in the pane as the prompt\n'; return 0;;
      esac
      cx_slug=$(origin_slug) || cx_slug=
      cx_p=$(ctx_find "$cx_name" "$cx_slug") || exit 1
      ctx_check "$cx_p" || exit 1
      cx_t=$(ctx_get "$cx_p" title); cx_a=$(ctx_get "$cx_p" ask)
      cx_rel=${cx_p#"$(ctx_dir)"/}
      case $cx_rel in */*) cx_scope=${cx_rel%/*};; *) cx_scope=everywhere;; esac
      printf '%s — %s\nfile: %s\nscope: %s\n' "$cx_name" "${cx_t:-$cx_name}" "$cx_p" "$cx_scope"
      [ -z "$cx_a" ] || printf 'asks: %s\n' "$cx_a"
      ctx_flag_lines "$cx_p" | sed 's/^/flag: /'
      echo
      if [ $# -eq 0 ]; then ctx_body "$cx_p"; else ctx_prompt "$cx_p" "$*"; fi
      return 0;;
    dir)
      if [ "${1-}" = --repo ]; then
        shift; [ $# -le 1 ] || usage
        cx_slug=$(origin_slug "${1:-$PWD}") || die "this repository has no origin remote, so it has no context directory"
        printf '%s/%s\n' "$(ctx_dir)" "$cx_slug"
      else
        [ $# -eq 0 ] || usage
        ctx_dir
      fi
      return 0;;
    *) usage;;
  esac
}

# [--slot <slot>] [--frame <name>] [--z all|near|near-mid|none] [--truecolor|--256]
# | --screen [--slot <slot>]: the operator's preview of the sleeper, and the tests' handle.
cmd_art() {
  slot= ar_f=asleep ar_z=all ar_m= ar_s= ar_h= ar_at=0 ar_w=
  while [ $# -gt 0 ]; do
    case $1 in
      --hermes) ar_h=1;;
      --at) [ $# -ge 2 ] || usage; case $2 in ''|*[!0-9]*) usage;; esac; ar_at=$2; shift;;
      --wait) ar_w=1;;
      --slot) [ $# -ge 2 ] || usage; slot=$2; shift;;
      --frame) [ $# -ge 2 ] || usage; ar_f=$2; shift;;
      --z) [ $# -ge 2 ] || usage; case $2 in all|near|near-mid|none) ar_z=$2;; *) usage;; esac; shift;;
      --truecolor) ar_m=truecolor;;
      --256) ar_m=256;;
      --screen) ar_s=1;;
      *) usage;;
    esac
    shift
  done
  if [ -n "$ar_h" ]; then
    [ -z "$ar_w" ] || { herm_wait; return; }
    # shellcheck disable=SC2046
    herm_py "$(herm_banner)" "$ar_at" $(herm_levels "$ar_m"); return
  fi
  [ -n "$slot" ] || slot=$(pool_words | awk '{ print $1 }')
  slot_ok "$slot" || die "'$slot' is not a slot name (lowercase letters, digits, - and _)"
  [ -n "$ar_s" ] || { art_lines "$ar_f" "$ar_z" "$slot" "$ar_m"; return 0; }
  # the quiet waiting screen, worked out as the pane works it out
  label=$(label_of "$slot")
  repo=$(repo_root_q) || repo=$(pwd -P)
  rname=$(rname_of "$repo")
  pn_pick=$(git config --get claude-peer.picker 2>/dev/null) || pn_pick=
  pn_slug=
  [ "$pn_pick" = off ] || pn_slug=$(origin_slug 2>/dev/null) || pn_slug=
  pn_tty=/dev/tty
  ar_d=$(mktemp -d "${TMPDIR:-/tmp}/claude-peer-art.XXXXXX") || die "cannot make a temporary directory"
  pn_me=$ar_d/screen
  pane_quiet
  rm -rf "$ar_d"
}

# Tell a waiting pane's fzf (socket of session <id> in the look directory) to run
# <action>. A socket that does not answer is left alone: removing it here could
# unlink the socket of an fzf that is just starting.
look_post() {
  look_ok "$1" && [ -S "$lk_d/$1.sock" ] || return 0
  curl -s -o /dev/null -m 1 --unix-socket "$lk_d/$1.sock" -X POST -d "$2" http://localhost/ || :
}

# Hold the look lock: descriptor 9 is open on <look directory>/lock. 0 held, 1 a live
# holder kept it past CLAUDE_PEER_LOOK_WAIT seconds (default 5), 2 no tool here locks a
# descriptor. flock (util-linux) and lockf (macOS) take the same flock(2) lock, which the
# kernel drops when the descriptor closes: a killed holder leaves nothing to break.
look_lock() {
  lk_w=${CLAUDE_PEER_LOOK_WAIT-}
  case $lk_w in '' | *[!0-9]*) lk_w=5;; esac
  if command -v flock >/dev/null 2>&1; then
    if [ "$lk_w" -eq 0 ]; then flock -n 9; else flock -w "$lk_w" 9; fi
    case $? in 0) return 0;; 1) return 1;; esac
  fi
  if command -v lockf >/dev/null 2>&1; then
    lockf -s -t "$lk_w" 9
    case $? in 0) return 0;; 75) return 1;; esac
  fi
  return 2
}

# One look event, with $lk_d and $lk_id set; the caller holds the lock.
look_turn() {
  lk_old=
  [ ! -r "$lk_d/focus" ] || read -r lk_old <"$lk_d/focus" || :
  case $1 in
    gained)
      [ "$lk_old" != "$lk_id" ] || return 0
      printf '%s\n' "$lk_id" >"$lk_d/focus.$$" && mv -f "$lk_d/focus.$$" "$lk_d/focus"
      look_post "$lk_old" 'unbind(every(1))'
      look_post "$lk_id" 'rebind(every(1))';;
    lost)
      [ "$lk_old" != "$lk_id" ] || { : >"$lk_d/focus.$$" && mv -f "$lk_d/focus.$$" "$lk_d/focus"; }
      look_post "$lk_id" 'unbind(every(1))';;
  esac
  return 0
}

# on|off: write (or remove) the trigger that calls `look gained` in every profile that
# enters a workgroup on a claude job, and the marker that tells panes to listen. The
# marker goes after the store, so a pane never listens for a trigger that is not there;
# `lock` stays, because a new file at its path would be a second lock beside a live
# holder's.
look_switch() {
  [ $# -eq 1 ] || usage
  need_macos "look $1"
  proc_running iTerm2 && die "quit iTerm2 first — it rewrites its preferences at quit and would overwrite this"
  prefs_store
  lk_d=$(look_dir)
  r=$(peer_py look "$skind" "$spath" "$1" "$lk_d") || exit 1
  if [ "$1" = on ]; then
    mkdir -p "$lk_d" && chmod 700 "$lk_d" && rm -f "$lk_d/focus" "$lk_d/unlocked" &&
      echo variable >"$lk_d/kind" || die "cannot write $lk_d"
    printf 'claude-peer: a waiting pane now moves while it is looked at; %s\n' "$r"
  else
    rm -f "$lk_d/kind" "$lk_d/focus" "$lk_d/unlocked"
    printf 'claude-peer: a waiting pane is no longer told when it is looked at; %s\n' "$r"
  fi
}

# gained|lost <session id>: what iTerm2's trigger calls when the session now looked
# at changes. Always exit 0 and print nothing, whatever happens: iTerm2 posts a
# notification for a failed command and logs its output. A burst of calls (one tab
# switch fires 1-4, a stale id may come between) ends with the last id bound. iTerm2
# starts a burst's commands together and in no fixed order, so one call runs at a time
# (look_lock); with no lock tool, or a holder past the wait, the call goes ahead and
# `unlocked` says so.
cmd_look() {
  case ${1-} in on|off) look_switch "$@"; return;; gained|lost) ;; *) usage;; esac
  {
    lk_d=$(look_dir) lk_id=${2-}
    [ -d "$lk_d" ] && look_ok "$lk_id" || return 0
    { look_lock
      case $? in
        1) echo timeout >>"$lk_d/unlocked";;
        2) echo notool >"$lk_d/unlocked";;
      esac
      look_turn "$1"
    } 9>>"$lk_d/lock" || look_turn "$1"
  } >/dev/null 2>&1
  return 0
}

[ $# -ge 1 ] || usage
cmd=$1; shift
case $cmd in
  run) cmd_run "$@";;
  hermes) cmd_hermes "$@";;
  overlays) cmd_overlays "$@";;
  overlay) cmd_overlay "$@";;
  peers) cmd_peers "$@";;
  start) cmd_start "$@";;
  stop) cmd_stop "$@";;
  slots) cmd_slots "$@";;
  log) cmd_log "$@";;
  claim) cmd_claim "$@";;
  name) cmd_name "$@";;
  path) cmd_path "$@";;
  plan) cmd_plan "$@";;
  here) cmd_here "$@";;
  workgroup) cmd_workgroup "$@";;
  install) cmd_install "$@";;
  default) cmd_default "$@";;
  status) cmd_status "$@";;
  context) cmd_context "$@";;
  art) cmd_art "$@";;
  look) cmd_look "$@";;
  -h|--help|help) usage;;
  *) warn "unknown command '$cmd'"; usage;;
esac
