#!/bin/sh
# claude-peer — one Claude Code instance as an iTerm2 Workgroup peer, on its
# own worktree.
#
# A Workgroup peer's shell starts in the leader's working directory and is
# pinned there (iTerm2 gives a peer no way to choose its own), so a second
# Claude started in a peer would be a second writer on the leader's checkout.
# The shell therefore has to move itself: `run` makes or reuses a worktree,
# cd's into it and only then starts claude, through an interactive shell so
# `claude` is the .functions wrapper (profile, browser pin, cache TTLs), not
# the bare binary. The worktree rules are the ones `workset checkout` follows
# (<repo>/.claude/worktrees/<slug>), ported from bin/executable_worktabs
# rather than called.
#
# A second Workgroup, not extra peers on the builtin Claude Code one: peers
# spawn eagerly when a workgroup is entered, and the builtin is entered on
# every claude job, so three more Claudes would start for every session.
# `install` edits the preferences while iTerm2 is quit because iTerm2 writes
# its preferences back at quit (and, with a custom prefs folder, replaces the
# domain from the folder at launch); an edit made while it runs is lost.
#
# Usage: claude-peer <command> [args]
#   run [branch] [-- claude args...]
#                            make or reuse <repo>/.claude/worktrees/<slug> on
#                            <branch>, cd there, start claude through the
#                            shell (the wrapper applies); no branch: a scratch
#                            worktree detached at origin/HEAD (peer-N), the
#                            branch is claude's to make
#   path <branch>            print the worktree path for <branch> (nothing
#                            is created)
#   plan <branch>...         branch<TAB>worktree<TAB>create|reuse|conflict:<why>
#                            per branch, exit 1 on any conflict
#   workgroup                print the "Claude Peers" Workgroup definition JSON
#                            that install would write (reads the store only)
#   install                  write that definition into iTerm2's preferences;
#                            iTerm2 must be quit
#   status                   store, iTerm2, workgroup and builtin state
set -u

die() { printf 'claude-peer: %s\n' "$*" >&2; exit 1; }
warn() { printf 'claude-peer: %s\n' "$*" >&2; }
usage() { sed -n '/^# Usage:/,/^set -u/{ /^set -u/d; s/^# \{0,1\}//p; }' "$0" >&2; exit 2; }

# The main checkout, even when the caller stands in a linked worktree of it.
repo_root() {
  common=$(git -C "$PWD" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || common=
  case $common in
    */.git) printf '%s\n' "${common%/.git}";;
    *) die "not inside a non-bare git repository";;
  esac
}

valid_branch() { git check-ref-format --branch "$1" >/dev/null 2>&1 || die "'$1' is not a branch name"; }

# --- worktrees ----------------------------------------------------------------
# Copied in behaviour from bin/executable_worktabs (slug_of ... worktree_checkout).

slug_of() { printf '%s' "${1-}" | tr '/' '-'; }

worktree_path() { # dir branch -> <dir>/.claude/worktrees/<slug>
  printf '%s/.claude/worktrees/%s\n' "$1" "$(slug_of "$2")"
}

# dir branch... -> branch<TAB>worktree<TAB>create|reuse|conflict:<reason>, one
# line per branch; exit 1 when any is a conflict. The reason is the whole
# human message.
worktree_plan() {
  d=$1; shift
  rd=$(cd "$d" && pwd -P) || return 1
  # path<TAB>branch of every registered worktree (empty branch: detached)
  trees=$(git -C "$d" worktree list --porcelain | awk '
    /^worktree / { p = substr($0, 10); b = "" }
    /^branch /   { b = $2; sub("^refs/heads/", "", b) }
    /^$/         { print p "\t" b }')
  rc=0
  for b in "$@"; do
    wt=$(worktree_path "$d" "$b")
    cur=$(printf '%s\n' "$trees" | awk -F'\t' -v w="$(worktree_path "$rd" "$b")" '$1 == w { print "x" $2; exit }')
    at=$(printf '%s\n' "$trees" | awk -F'\t' -v b="$b" '$2 == b { print $1; exit }')
    if [ -n "$cur" ]; then
      if [ "${cur#x}" = "$b" ]; then act=reuse
      else act="conflict:'$b': $wt exists on branch ${cur#x} — pick another name or remove it (git worktree remove)"; fi
    elif [ -e "$wt" ]; then act="conflict:'$b': $wt exists but is not a git worktree"
    elif [ -n "$at" ]; then act="conflict:'$b' is already checked out at $at"
    else act=create; fi
    case $act in conflict:*) rc=1;; esac
    printf '%s\t%s\t%s\n' "$b" "$wt" "$act"
  done
  return $rc
}

ensure_exclude() { # dir
  excl=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir)/info/exclude
  mkdir -p "$(dirname "$excl")" 2>/dev/null
  grep -qxF '**/.claude/worktrees/' "$excl" 2>/dev/null ||
    printf '**/.claude/worktrees/\n' >> "$excl"
}

# dir branch -> performs create/reuse, prints branch<TAB>worktree<TAB>created|reused
worktree_checkout() {
  p=$(worktree_plan "$1" "$2") || true
  wt=$(printf '%s\n' "$p" | cut -f2)
  act=$(printf '%s\n' "$p" | cut -f3)
  case $act in
    create)
      ensure_exclude "$1"
      base=HEAD
      git -C "$1" rev-parse --verify -q origin/HEAD >/dev/null 2>&1 && base=origin/HEAD
      if git -C "$1" show-ref --verify -q "refs/heads/$2"; then
        git -C "$1" worktree add "$wt" "$2" >/dev/null || die "'$2': git worktree add failed"
      else
        git -C "$1" worktree add -b "$2" "$wt" "$base" >/dev/null || die "'$2': git worktree add failed"
      fi
      printf '%s\t%s\tcreated\n' "$2" "$wt";;
    reuse) printf '%s\t%s\treused\n' "$2" "$wt";;
    *) die "${act#conflict:}";;
  esac
}

# dir -> (detached)<TAB>wt<TAB>created|reused: a scratch worktree with no branch
# of its own, detached at the base (origin/HEAD, else HEAD), at the first
# <dir>/.claude/worktrees/peer-N that is free — unregistered, or registered,
# still detached and clean, which is moved back to the base. A branch is the
# session's to make once it knows what it is working on; a name picked here
# would only be one more branch to delete.
scratch_checkout() {
  base=HEAD
  git -C "$1" rev-parse --verify -q origin/HEAD >/dev/null 2>&1 && base=origin/HEAD
  trees=$(git -C "$1" worktree list --porcelain)
  n=1
  while :; do
    wt=$1/.claude/worktrees/peer-$n
    if ! printf '%s\n' "$trees" | grep -qx "worktree $wt" && [ ! -e "$wt" ]; then
      ensure_exclude "$1"
      git -C "$1" worktree add --detach "$wt" "$base" >/dev/null || die "peer-$n: git worktree add failed"
      printf '(detached)\t%s\tcreated\n' "$wt"; return 0
    fi
    if printf '%s\n' "$trees" | grep -qx "worktree $wt" \
       && ! git -C "$wt" symbolic-ref -q HEAD >/dev/null 2>&1 \
       && [ -z "$(git -C "$wt" status --porcelain 2>/dev/null)" ]; then
      git -C "$wt" checkout -q --detach "$base" 2>/dev/null || die "peer-$n: cannot move to $base"
      printf '(detached)\t%s\treused\n' "$wt"; return 0
    fi
    n=$((n + 1))
  done
}

# --- commands -----------------------------------------------------------------

cmd_run() {
  b=
  if [ $# -gt 0 ] && [ "$1" != -- ]; then b=$1; shift; fi
  if [ $# -gt 0 ]; then
    [ "$1" = -- ] || usage
    shift
  fi
  repo=$(repo_root) || exit 1
  if [ -z "$b" ]; then
    out=$(scratch_checkout "$repo") || exit 1
  else
    valid_branch "$b"
    out=$(worktree_checkout "$repo" "$b") || exit 1
  fi
  printf '%s\n' "$out"
  wt=$(printf '%s\n' "$out" | cut -f2)
  # `cd ""` is a silent no-op, which would start claude in the leader's checkout.
  cd -- "$wt" || die "cannot enter $wt"
  # An interactive shell, so `claude` is the .functions wrapper; it stays the
  # parent because a function cannot be exec'd.
  exec "${SHELL:-/bin/sh}" -i -c 'claude "$@"' claude-peer "$@"
}

cmd_path() {
  [ $# -eq 1 ] || usage
  valid_branch "$1"
  repo=$(repo_root) || exit 1
  worktree_path "$repo" "$1"
}

cmd_plan() {
  [ $# -ge 1 ] || usage
  for x in "$@"; do valid_branch "$x"; done
  repo=$(repo_root) || exit 1
  worktree_plan "$repo" "$@"
}

# --- the Workgroup ------------------------------------------------------------

os() { uname -s 2>/dev/null; }
# Exit 2 as for usage: the verb cannot be used here at all, nothing was refused.
need_macos() { [ "$(os)" = Darwin ] || { warn "$1 needs macOS"; exit 2; }; }

# `ps` rather than pgrep, as bin/executable_worktabs: pgrep cannot see
# processes of the caller's own session under some sandboxes.
proc_running() {
  ps -Ao ucomm= 2>/dev/null |
    awk -v n="$1" '{ sub(/[ \t]+$/, "", $0); if ($0 == n) f = 1 } END { exit !f }'
}

# Where iTerm2's preferences live: skind=folder spath=<plist> when it loads
# them from a custom folder (it replaces the domain from there at launch and
# writes back at quit), else skind=domain. CLAUDE_PEER_PREFS names a plist
# directly.
prefs_store() {
  if [ -n "${CLAUDE_PEER_PREFS:-}" ]; then skind=folder; spath=$CLAUDE_PEER_PREFS; return 0; fi
  skind=domain; spath=
  [ "$(defaults read com.googlecode.iterm2 LoadPrefsFromCustomFolder 2>/dev/null)" = 1 ] || return 0
  f=$(defaults read com.googlecode.iterm2 PrefsCustomFolder 2>/dev/null) || f=
  case $f in
    '') return 0;;
    *://*) die "prefs load from a URL; use Settings > Arrangements > Workgroups";;
    \~|\~/*) f=$HOME${f#\~};;
  esac
  skind=folder; spath=${f%/}/com.googlecode.iterm2.plist
}

# peer_py <workgroup|install|status> <folder|domain> <plist path>
# The stdlib only: plistlib for the store, json for the Workgroups value (an
# NSData holding a JSON array), defaults for the domain.
peer_py() {
  python3 -I - "$@" <<'PYEOF'
import copy, json, plistlib, subprocess, sys

GROUP, NAME, BUILTIN = "claudePeer.workgroup", "Claude Peers", "builtin.claudeCode"
mode, kind, path = sys.argv[1:4]

def fail(msg):
    sys.exit("claude-peer: " + msg)

def load(kind, path):
    """(plist, began with bplist); raises when the store cannot be read."""
    if kind == "folder":
        with open(path, "rb") as f:
            raw = f.read()
    else:
        raw = subprocess.run(["defaults", "export", "com.googlecode.iterm2", "-"],
                             capture_output=True, check=True).stdout
    return plistlib.loads(raw), raw.startswith(b"bplist")

def groups_of(pl):
    if "Workgroups" not in pl:
        return []
    g = json.loads(pl["Workgroups"])
    if not isinstance(g, list):
        raise ValueError("Workgroups is not a list")
    return g

def session(ident, name, kind, command="", items=None, parent=None):
    s = {"uniqueIdentifier": ident, "kind": {"kind": kind}, "displayName": name,
         "command": command, "perFileCommand": "", "urlString": "",
         "mode": "regular", "toolbarItems": items or [{"kind": "modeSwitcher"}]}
    if parent:
        s["parentID"] = parent
    return s

def build(groups):
    builtin = next((g for g in groups if g.get("uniqueIdentifier") == BUILTIN), {})
    def pick(i):
        return next((s for s in builtin.get("sessions", []) if s.get("uniqueIdentifier") == i), None)
    main = session("claudePeer.main", "Chat", "root",
                   items=[{"kind": "modeSwitcher"}, {"kind": "gitStatus"}])
    if pick(BUILTIN + ".main"):
        main["toolbarItems"] = copy.deepcopy(pick(BUILTIN + ".main")["toolbarItems"])
    diff = copy.deepcopy(pick(BUILTIN + ".diff"))
    if not diff:
        diff = session("", "Diff", "peer", "git difftool -y -x vimdiff \\(gitBase)", [
            {"kind": "modeSwitcher"}, {"kind": "changedFileSelector"}, {"kind": "gitBaseSelector"},
            {"kind": "navigation",
             "reloadShortcut": {"serialized": "0x72-0x100000-0xf"},
             "forwardShortcut": {"serialized": "0xf703-0x340000-0x7c"},
             "backShortcut": {"serialized": "0xf702-0x340000-0x7b"}}])
        diff.update(mode="diff", perFileCommand="git difftool -y -x vimdiff \\(gitBase) -- \\(file)")
    diff.update(uniqueIdentifier="claudePeer.diff", parentID="claudePeer.main")
    chats = [session("claudePeer.chat%d" % n, "Chat %d" % n, "peer", "claude-peer run",
                     parent="claudePeer.main") for n in (2, 3, 4)]
    return {"uniqueIdentifier": GROUP, "name": NAME, "sessions": [main, diff] + chats}

if mode == "status":
    try:
        pl, _ = load("domain", "")
    except Exception as e:
        fail("cannot read the iTerm2 preferences domain: %s" % e)
    try:
        groups = groups_of(pl)
    except (ValueError, TypeError):
        groups = None
    mine = next((g for g in groups or [] if g.get("uniqueIdentifier") == GROUP), None)
    if groups is None:
        print("workgroup: unreadable (Workgroups is not JSON; install refuses until it is fixed)")
    elif mine:
        names = [s.get("displayName", "?") for s in mine.get("sessions", [])]
        print("workgroup: installed (%d sessions: %s)" % (len(names), ", ".join(names)))
    else:
        print("workgroup: not installed — claude-peer install (with iTerm2 quit)")
    if any(g.get("uniqueIdentifier") == BUILTIN for g in groups or []):
        print("builtin: builtin.claudeCode present")
    else:
        print("builtin: builtin.claudeCode absent (the Diff would be the template)")
elif mode == "workgroup":
    try:
        groups = groups_of(load(kind, path)[0])
    except Exception:
        groups = []   # unreadable store: the templates stand in
    print(json.dumps(build(groups), indent=2, sort_keys=True))
elif mode == "install":
    try:
        pl, was_binary = load(kind, path)
    except Exception as e:
        fail("cannot read the preferences: %s" % e)
    try:
        groups = groups_of(pl)
    except (ValueError, TypeError) as e:
        fail("the Workgroups value is not a JSON list (%s); nothing written" % e)
    wg = build(groups)
    idx = next((i for i, g in enumerate(groups) if g.get("uniqueIdentifier") == GROUP), None)
    if idx is None:
        groups.append(wg)
    else:
        groups[idx] = wg
    pl["Workgroups"] = json.dumps(groups, separators=(",", ":")).encode("utf-8")
    data = plistlib.dumps(pl, fmt=plistlib.FMT_BINARY if was_binary else plistlib.FMT_XML)
    if kind == "folder":
        with open(path, "wb") as f:
            f.write(data)
    else:
        subprocess.run(["defaults", "import", "com.googlecode.iterm2", "-"], input=data, check=True)
    print("written" if idx is None else "replaced")
PYEOF
}

cmd_workgroup() {
  [ $# -eq 0 ] || usage
  prefs_store
  peer_py workgroup "$skind" "$spath"
}

cmd_install() {
  [ $# -eq 0 ] || usage
  need_macos install
  proc_running iTerm2 && die "quit iTerm2 first — it rewrites its preferences at quit and would overwrite this"
  prefs_store
  r=$(peer_py install "$skind" "$spath") || exit 1
  [ "$skind" = folder ] && where=$spath || where="the com.googlecode.iterm2 domain"
  printf 'claude-peer: workgroup "Claude Peers" (claudePeer.workgroup) %s in %s; start iTerm2, then Shell > Workgroups > Claude Peers in a plain tab\n' "$r" "$where"
}

cmd_status() {
  [ $# -eq 0 ] || usage
  need_macos status
  prefs_store
  if [ "$skind" = folder ]; then printf 'store: folder %s\n' "$spath"; else printf 'store: domain\n'; fi
  if proc_running iTerm2; then printf 'iterm2: running\n'; else printf 'iterm2: not running (install allowed)\n'; fi
  peer_py status "$skind" "$spath"
}

[ $# -ge 1 ] || usage
cmd=$1; shift
case $cmd in
  run) cmd_run "$@";;
  path) cmd_path "$@";;
  plan) cmd_plan "$@";;
  workgroup) cmd_workgroup "$@";;
  install) cmd_install "$@";;
  status) cmd_status "$@";;
  -h|--help|help) usage;;
  *) warn "unknown command '$cmd'"; usage;;
esac
