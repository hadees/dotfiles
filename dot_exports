#!/usr/bin/env zsh

# Preferred editors: VS Code when installed, else vim, else vi.
if command -v code >/dev/null 2>&1; then
	export EDITOR='code --wait'
	export GEM_EDITOR='code'
elif command -v vim >/dev/null 2>&1; then
	export EDITOR='vim'
	export GEM_EDITOR='vim'
else
	export EDITOR='vi'
	export GEM_EDITOR='vi'
fi

# Enable persistent REPL history for `node`.
export NODE_REPL_HISTORY="$HOME/.node_history"
export NODE_REPL_HISTORY_SIZE='32768'

# Make Python use UTF-8 encoding for input/output streams.
export PYTHONIOENCODING='UTF-8'

# Prefer US English and use UTF-8, but only fill in a missing LANG: a forwarded
# or terminal-set one is left alone, and LC_ALL is never exported (it would
# override every LC_* the user or a tool set deliberately). macOS always has the
# locale; elsewhere it must be installed, or setlocale warns on every command.
if [[ -z ${LANG:-} ]]; then
	if [[ $OSTYPE == darwin* ]] || locale -a 2>/dev/null | grep -qiE '^en_US\.utf-?8$'; then
		export LANG='en_US.UTF-8'
	fi
fi

# Use bat for man pages when available, otherwise fall back to less.
if (( $+commands[bat] )); then
	export BAT_THEME="base16-256"
	export MANPAGER="sh -c 'col -bx | bat -l man -p'"
	export MANROFFOPT='-c'
else
	export MANPAGER='less -X'
fi

# fzf: use fd for file finding (Debian and Ubuntu call it fdfind), bat for
# previews. With neither, fzf keeps its own default command.
if (( $+commands[fzf] )); then
	if (( $+commands[fd] )); then
		_fzf_fd=fd
	elif (( $+commands[fdfind] )); then
		_fzf_fd=fdfind
	fi
	if [[ -n ${_fzf_fd:-} ]]; then
		export FZF_DEFAULT_COMMAND="$_fzf_fd --type f --hidden --follow --exclude .git"
		export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
		export FZF_ALT_C_COMMAND="$_fzf_fd --type d --hidden --follow --exclude .git"
	fi
	unset _fzf_fd
	# Base16 Eighties palette (darkened bg #1a1a1a/#262626).
	export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --color=bg+:#262626,bg:#1a1a1a,spinner:#f2777a,hl:#747369,fg:#d3d0c8,header:#747369,info:#66cccc,pointer:#f2777a,marker:#f2777a,fg+:#d3d0c8,prompt:#f2777a,hl+:#f2777a'
	if (( $+commands[bat] )); then
		export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:200 {}'"
	fi
fi

# Homebrew preferences. -gU, not -U: a bare typeset localizes (and empties)
# path/PATH when this file is sourced from inside a function, e.g. via
# bootstrap.sh's doIt.
#
# Homebrew's bin AND sbin go first (what `brew shellenv` does). Apple's
# path_helper only appends /opt/homebrew/bin, after /usr/bin and /bin, so
# without this every Homebrew tool that macOS also ships — bash, git, ssh,
# curl, python3, vim, openssl — is shadowed by the system copy. The visible
# casualty was bats: its `#!/usr/bin/env bash` picked /bin/bash 3.2, under
# which a failing `[[ ]]` that is not a test's last command is silently
# ignored, so the whole suite ran with inert assertions (tests/shell.bats
# now refuses bash < 4).
typeset -gU path PATH
if (( $+commands[brew] )); then
	path=("$(brew --prefix)/bin" "$(brew --prefix)/sbin" $path)
fi
export PATH
export HOMEBREW_CASK_OPTS='--appdir=/Applications'

# This keeps apple from throwing a forking error.
export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES

# Avoid issues with `gpg` as installed via Homebrew.
# https://stackoverflow.com/a/42265848/96656
export GPG_TTY="$(tty)"
