#!/bin/sh
# Refuse a commit whose author or committer email does not belong to the
# GitHub account this repo's origin is pinned to — the same pins gh(),
# claude(), and wrangler() route on (`credential.https://github.com/<owner>
# .username`), plus an `identity.<account>.email` mapping (repeatable) that
# the private overlays declare next to them. Turns `git-doctor`'s "author:"
# line from advice into a gate: a work repo cloned with a URL shape the
# includeIf routing doesn't match, or a fresh clone before the overlay is
# applied, fails closed instead of committing under the wrong identity.
#
# A repo that commits as an identity other than its owner's (a side project
# hosted under a personal account but run under its own name) is pinned by
# slug instead — `identity.<owner>/<repo>.email` (lowercase, repeatable)
# outranks the account's emails, mirroring wrangler's per-repo pin.
#
# No opinion (passes) when: the repo has no origin, the owner is unpinned,
# no email is declared for the account, or GIT_IDENTITY_CHECK=0 is set for
# the one commit. Never touches the network. Chains to the repo's own
# .git/hooks/pre-commit afterwards (see run-local-hook).
#
# Before that, the branch gate: a commit is refused in a claude-peer slot that
# has no branch yet — HEAD detached, with the base record `branchname --state`
# reports as "base" (no rebase or bisect in progress). Such a commit would land
# on no branch while the prompt names the branch the slot was cut from. It runs
# first because every exit of the identity gate leaves through chain's exec.
# No opinion when: GIT_BRANCH_CHECK=0 (one commit), hook.pre-commit.branch is
# false/0/no/off, HEAD is on a branch (no helper is run), or no branchname
# helper is found. The two bypasses are independent.
hooks_dir=$(dirname "$0")
chain() { HOOK_NAME=pre-commit exec "$hooks_dir/run-local-hook" "$@"; }

branch_gate() {
	[ "${GIT_BRANCH_CHECK:-1}" = 0 ] && return 0
	case $(git config --get hook.pre-commit.branch 2>/dev/null) in
		false|0|no|off) return 0 ;;
	esac
	git symbolic-ref --quiet HEAD >/dev/null 2>&1 && return 0
	# ~/bin first: an unrelated `branchname` on PATH must never run in a commit hook.
	bn=$HOME/bin/branchname
	[ -x "$bn" ] || bn=$(command -v branchname 2>/dev/null) || return 0
	[ -x "$bn" ] || return 0
	st=$("$bn" --state 2>/dev/null) || return 0
	tab=$(printf '\t')
	IFS=$tab read -r state _label ref _name <<EOF_STATE
$st
EOF_STATE
	[ "$state" = base ] || return 0
	# The ref, not the label: a custom format cannot change what this says.
	ref=${ref#refs/remotes/}; ref=${ref#refs/heads/}
	echo "pre-commit: this worktree has no branch yet (HEAD is detached at $ref). Create one, then commit again: git switch -c <type>/<slug>. Bypass once with GIT_BRANCH_CHECK=0." >&2
	exit 1
}
branch_gate

[ "${GIT_IDENTITY_CHECK:-1}" = 0 ] && chain "$@"

url=$(git config --get remote.origin.url 2>/dev/null)
[ -n "$url" ] || chain "$@"
url=${url%/}; url=${url%.git}
case $url in
	*://*) path=${url#*://*/} ;;   # https://host/owner/repo
	*:*)   path=${url#*:} ;;       # [user@]host:owner/repo (ssh, incl. aliases)
	*)     chain "$@" ;;           # local path — no owner
esac
slug=$(printf '%s' "$path" | tr '[:upper:]' '[:lower:]')
owner=${slug%%/*}
[ -n "$owner" ] || chain "$@"

acct=$(git config --get "credential.https://github.com/$owner.username" 2>/dev/null)
[ -n "$acct" ] || chain "$@"
# Per-repo pin first, else the account's declared emails.
scope="repo '$slug'"
expected=$(git config --get-all "identity.$slug.email" 2>/dev/null | tr '[:upper:]' '[:lower:]')
if [ -z "$expected" ]; then
	scope="account '$acct'"
	expected=$(git config --get-all "identity.$acct.email" 2>/dev/null | tr '[:upper:]' '[:lower:]')
fi
if [ -z "$expected" ]; then
	echo "pre-commit: origin owner '$owner' is pinned to account '$acct' but no identity.$acct.email is declared; cannot verify the author (declare it in the overlay's gitconfig)" >&2
	chain "$@"
fi

# What git will actually record — honours user.*, GIT_AUTHOR_EMAIL, --author.
author=$(git var GIT_AUTHOR_IDENT 2>/dev/null);   author=${author#*<};   author=${author%%>*}
committer=$(git var GIT_COMMITTER_IDENT 2>/dev/null); committer=${committer#*<}; committer=${committer%%>*}
bad=""
for who in "$author" "$committer"; do
	lc=$(printf '%s' "$who" | tr '[:upper:]' '[:lower:]')
	case "
$expected
" in
		*"
$lc
"*) ;;
		*) bad="$bad $who" ;;
	esac
done
if [ -n "$bad" ]; then
	echo "pre-commit: refusing to commit as$bad in a repo owned by '$owner' (pinned to $scope, whose email(s):" >&2
	printf '  %s\n' $expected >&2
	echo "  ). Fix the identity (git-doctor shows which config file supplied it), or bypass once with GIT_IDENTITY_CHECK=0." >&2
	exit 1
fi
chain "$@"
