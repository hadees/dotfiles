#!/bin/sh
# Global git hooks (core.hooksPath = ~/.git-hooks) replace a repo's own
# .git/hooks directory, so every hook name here first hands off to the
# repo-local hook of the same name when one exists — tools that install
# into .git/hooks (lefthook, pre-commit, husky's older mode, ...) keep
# working. Invoked directly for hooks that have no global behaviour (the
# symlinks next to this file) and by pre-commit after its own check.
#
# A repo that sets core.hooksPath itself (husky ≥ 5) overrides the global
# path entirely and never reaches here — also fine.
#
# Before the local hook, every `hook.<name>.run` git-config value (repeatable;
# usually set in a repo's own .git/config) is run as a shell command from
# the repo root, and any failure blocks like a hook would. This is how an
# untracked, machine-local check gets attached to a repo without touching
# its tree — e.g. the private overlay pointing the public dotfiles clone's
# pre-push at its own leak guard (docs/private-overlays.md).
#
# Each command sees exactly what the hook itself was given: git's arguments
# as $1.., and git's stdin. That stdin is the whole point for pre-push — it
# is the list of refs about to be pushed, and a guard that cannot read it
# can only grep the checkout it happens to be standing in, which is not
# what is being pushed when the push comes from a worktree. Since several
# commands and then the local hook all need to read it, it is copied to a
# file once and replayed to each; git already hands hooks with no input
# /dev/null, so the copy is empty for those and costs nothing.
name=${HOOK_NAME:-${0##*/}}
# HOOK_NAME is how pre-commit hands its name over after its own check; drop
# it before anything else runs, or a hook that itself invokes git (the
# pre-commit framework's stash/checkout dance) would see nested hooks —
# post-checkout — resolve to the wrong name and get the wrong arguments.
unset HOOK_NAME
stdin_copy=$(mktemp "${TMPDIR:-/tmp}/git-hook-stdin.XXXXXX") || exit 1
trap 'rm -f "$stdin_copy"' EXIT
# A terminal would block cat forever; only a hand-run hook ever has one.
if [ -t 0 ]; then :; else cat >"$stdin_copy"; fi
top="$(git rev-parse --show-toplevel 2>/dev/null)"
git config --get-all "hook.$name.run" 2>/dev/null | while IFS= read -r cmd; do
	[ -n "$cmd" ] || continue
	(cd "${top:-.}" && sh -c "$cmd" sh "$@" <"$stdin_copy") || {
		echo "$name: hook.$name.run command failed: $cmd" >&2
		exit 1
	}
done || exit 1
# NOT `git rev-parse --git-path hooks`: that honours core.hooksPath and would
# resolve to this very directory (an exec loop). The repo's own hooks live
# in its common git dir (shared by worktrees).
common_dir="$(git rev-parse --git-common-dir 2>/dev/null)"
[ -n "$common_dir" ] || exit 0
local_hook="$common_dir/hooks/$name"
if [ -x "$local_hook" ]; then
	"$local_hook" "$@" <"$stdin_copy"
	exit $?
fi
exit 0
